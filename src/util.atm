;; Port of c/src/util.c: the functions on strings and paths that the port
;; needs so far. In C they allocate; here, paths are Atmos strings.

include "ctypes.atm"
include "lib.atm"
include "os/unix/osdefs.atm"

;; `util_concat(s, ..., NULL)`: the strings joined.
func util_concat (...) {
    vector.join([...], "")
}

;; The directory and the name of a path; `nil` for a part that is absent,
;; as in C.
func util_fname_split (path) {
    if path == nil {
        return nil, nil
    }
    var p = nil
    loop i in #path {
        if string.sub(path, i, i) == FSDEV_DIR_SEP_STR {
            set p = i
        }
    }
    if p == nil {
        return nil, path
    }
    return string.sub(path, 0, p - 1), string.sub(path, p + 1)
}

;; On a vector of bytes (a `char[]`), in place.
func util_trim_whitespace (buf, bufsize) {
    var i = 0
    loop {
        while (buf@(i) == 32) || (buf@(i) == 9)     ;; ' ' '\t'
        set i = i + 1
    }
    if i > 0 {
        lib_strcpy(buf, cstr(buf, i), bufsize)
    }
    set i = 0
    loop {
        while (i < bufsize) && (buf@(i) != 0)
        set i = i + 1
    }
    set i = i - 1
    loop {
        while (i >= 0) && ((buf@(i) == 32) || (buf@(i) == 9))
        set buf@(i) = 0
        set i = i - 1
    }
}


;; `util_table_remove_item_any_order(itemi, tbl, itemsz, itemnum)`: the last
;; of the `itemnum` items copied over the item `itemi` (the size of an item
;; is that of its table here).
func util_table_remove_item_any_order (itemi, tbl, itemnum) {
    if (itemi < 0) || (itemi >= (itemnum - 1)) {
        return nil
    }
    cstruct_copy(tbl@(itemi), tbl@(itemnum - 1))
}

;; `util_table_remove_item_keep_order(itemi, tbl, itemsz, itemnum)`: the
;; items after `itemi` moved one down; the last one stays as it was.
func util_table_remove_item_keep_order (itemi, tbl, itemnum) {
    if (itemi < 0) || (itemi >= (itemnum - 1)) {
        return nil
    }
    loop i in (itemi, itemnum - 2) {
        cstruct_copy(tbl@(i), tbl@(i + 1))
    }
}

;; `util_str_tolower(&buf[offs], bufsize)`: the letters A to Z of a vector of
;; bytes lowered, up to its zero (`tolower` of the C locale).
func util_str_tolower (buf, offs, bufsize) {
    var i = offs
    loop {
        while (i < (offs + bufsize)) && (buf@(i) != 0)
        val c = buf@(i)
        if (c >= 65) && (c <= 90) {
            set buf@(i) = c + 32
        }
        set i = i + 1
    }
}

;; `util_table_remove_item_keep_order_zero(itemi, tbl, itemsz, itemnum)`: the
;; items after `itemi` moved one down, and the last one zeroed (`zero` makes
;; an item of zeros).
func util_table_remove_item_keep_order_zero (itemi, tbl, itemnum, zero) {
    if (itemi < 0) || (itemi >= itemnum) {
        return nil
    }
    if itemi < (itemnum - 1) {
        loop i in (itemi, itemnum - 2) {
            cstruct_copy(tbl@(i), tbl@(i + 1))
        }
    }
    cstruct_copy(tbl@(itemnum - 1), zero())
}

;; `util_parse_signed_number(str, &v)` (`strtol` base 10 in C), on a string:
;; gives (ok, v). As `strtol`: blanks before, a sign, the digits; ok if
;; nothing follows (so "" is 0 and ok).
func util_parse_signed_number (str) {
    var i = 0
    val n = #str
    loop {
        while (i < n) && ((string.byte(str, i) == 32) || ((string.byte(str, i) >= 9) && (string.byte(str, i) <= 13)))
        set i = i + 1
    }
    var neg = false
    if (i < n) && ((string.byte(str, i) == 43) || (string.byte(str, i) == 45)) {   ;; + -
        set neg = string.byte(str, i) == 45
        set i = i + 1
    }
    val d0 = i
    var v = 0
    loop {
        while (i < n) && (string.byte(str, i) >= 48) && (string.byte(str, i) <= 57)
        set v = (v * 10) + (string.byte(str, i) - 48)
        set i = i + 1
    }
    if i == d0 {
        ;; no digits: strtol gives 0 and the end at the start
        return (n == 0, 0)
    }
    set v = i32(if neg => -v => v)
    (i == n, v)
}

;; `util_parse_number(str, &v)` (`strtoul` base 0 in C), on a string: gives
;; (ok, v). Blanks, a sign, then "0x" hex, "0" octal or decimal; ok if
;; nothing follows. A '-' negates in 32 bits, as `strtoul`.
func util_parse_number (str) {
    val n = #str
    var i = 0
    loop {
        while (i < n) && ((string.byte(str, i) == 32) || ((string.byte(str, i) >= 9) && (string.byte(str, i) <= 13)))
        set i = i + 1
    }
    var neg = false
    if (i < n) && ((string.byte(str, i) == 43) || (string.byte(str, i) == 45)) {
        set neg = string.byte(str, i) == 45
        set i = i + 1
    }
    var base = 10
    if (i < n) && (string.byte(str, i) == 48) {
        if ((i + 2) < (n + 1)) && ((i + 1) < n) && ((string.byte(str, i + 1) == 120) || (string.byte(str, i + 1) == 88)) && ((i + 2) < n) && (util_digit(string.byte(str, i + 2), 16) >= 0) {
            set base = 16
            set i = i + 2
        } else {
            set base = 8
        }
    }
    val d0 = i
    var v = 0
    loop {
        while (i < n) && (util_digit(string.byte(str, i), base) >= 0)
        set v = (v * base) + util_digit(string.byte(str, i), base)
        set i = i + 1
    }
    if i == d0 {
        return (n == 0, 0)
    }
    set v = u32(if neg => -v => v)
    (i == n, v)
}

func util_digit (c, base) {
    val d = ifs {
        (c >= 48) && (c <= 57) => c - 48
        (c >= 97) && (c <= 122) => c - 87
        (c >= 65) && (c <= 90) => c - 55
        else => 99
    }
    if d < base => d => -1
}

;; `util_get_line(buf, bufsize, f)`: the next line of the file `f`, without
;; the line breaks (0x0a, 0x0d) and the spaces at its ends; `nil` at the end
;; of the file (-1 in C, which gives the length). C reads with `fgets` into
;; `bufsize` bytes, so it cuts a longer line in pieces; the lines read here
;; (of the config file) are not so long.
func util_get_line (f) {
    val r = io.read(f)
    if r == nil {
        return nil
    }
    var b = 0
    var e = #r
    loop {
        while (e > 0) && ((string.byte(r, e - 1) == 0x0d) || (string.byte(r, e - 1) == 0x0a))
        set e = e - 1
    }
    loop {
        while (e > 0) && (string.byte(r, e - 1) == 32)
        set e = e - 1
    }
    loop {
        while (b < e) && (string.byte(r, b) == 32)
        set b = b + 1
    }
    if b < e => string.sub(r, b, e - 1) => ""
}
