;; Port of c/src/util.c: the functions on strings and paths that the port
;; needs so far. In C they allocate; here, paths are Atmos strings.

include "ctypes.atm"
include "lib.atm"
include "os/unix/osdefs.atm"

;; `util_concat(s, ..., NULL)`: the strings joined.
func util_concat (...) {
    vector.join([...], "")
}

;; The directory and the name of a path; `nil` for a part that is absent,
;; as in C.
func util_fname_split (path) {
    if path == nil {
        return nil, nil
    }
    var p = nil
    loop i in #path {
        if string.sub(path, i, i) == FSDEV_DIR_SEP_STR {
            set p = i
        }
    }
    if p == nil {
        return nil, path
    }
    return string.sub(path, 0, p - 1), string.sub(path, p + 1)
}

;; On a vector of bytes (a `char[]`), in place.
func util_trim_whitespace (buf, bufsize) {
    var i = 0
    loop {
        while (buf@(i) == 32) || (buf@(i) == 9)     ;; ' ' '\t'
        set i = i + 1
    }
    if i > 0 {
        lib_strcpy(buf, cstr(buf, i), bufsize)
    }
    set i = 0
    loop {
        while (i < bufsize) && (buf@(i) != 0)
        set i = i + 1
    }
    set i = i - 1
    loop {
        while (i >= 0) && ((buf@(i) == 32) || (buf@(i) == 9))
        set buf@(i) = 0
        set i = i - 1
    }
}


;; `util_table_remove_item_any_order(itemi, tbl, itemsz, itemnum)`: the last
;; of the `itemnum` items copied over the item `itemi` (the size of an item
;; is that of its table here).
func util_table_remove_item_any_order (itemi, tbl, itemnum) {
    if (itemi < 0) || (itemi >= (itemnum - 1)) {
        return nil
    }
    cstruct_copy(tbl@(itemi), tbl@(itemnum - 1))
}

;; `util_table_remove_item_keep_order(itemi, tbl, itemsz, itemnum)`: the
;; items after `itemi` moved one down; the last one stays as it was.
func util_table_remove_item_keep_order (itemi, tbl, itemnum) {
    if (itemi < 0) || (itemi >= (itemnum - 1)) {
        return nil
    }
    loop i in (itemi, itemnum - 2) {
        cstruct_copy(tbl@(i), tbl@(i + 1))
    }
}
