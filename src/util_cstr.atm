;; Port of c/src/util_cstr.c: strings with C escapes, as in the config file.
;; `util_cstr_parse` is used only by the tools (pbxmake, lbxedit), not
;; ported.

include "log.atm"

;; `util_cstr_out(fd, str)`: writes `str` with '\' before '\' and '"';
;; 0 (C gives -1 if a write fails).
func util_cstr_out (fd, str) {
    loop i in #str {
        val c = string.sub(str, i, i)
        if (c == "\\") || (c == "\"") {
            io.write(fd, "\\")
        }
        io.write(fd, c)
    }
    0
}

;; `util_cstr_parse_in_place(str)`: the string up to a '"', with the escapes
;; \\ \" \n \t replaced; gives (0, string), or (-1, nil) on another escape.
func util_cstr_parse_in_place (str) {
    val out = []
    var i = 0
    loop {
        while i < #str
        var c = string.byte(str, i)
        set i = i + 1
        while c != 34       ;; '"'
        if c == 92 {        ;; '\'
            set c = if i < #str => string.byte(str, i) => 0
            set i = i + 1
            ifs {
                (c == 92) || (c == 34) => nil
                c == 110 => { set c = 10 }
                c == 116 => { set c = 9 }
                else => {
                    log_error("%s: unhandled escape 0x%02x\n", "util_cstr_parse_in_place", c)
                    return (-1, nil)
                }
            }
        }
        set out@(#out) = string.char(c)
    }
    (0, vector.join(out, ""))
}
