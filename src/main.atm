;; Port of c/src/main.c (with ui/cmdline and hw/nop): the program
;; `1oom_cmdline`.
;;   atmos -o 1oom_cmdline src/main.atm

include "lbx.atm"
include "log.atm"
include "os/unix/os.atm"
include "hw/nop/hwnop.atm"
include "game/game_main.atm"
include "ui/cmdline/uicmdline.atm"
include "game/game_ai_classic.atm"
include "options.atm"
include "pbx.atm"

var main_startup_ok = false

;; ---------------------------------------------------------------------------

func main_early_init () {
    if (os_early_init() != 0)
        || (hw_early_init() != 0)
        || (ui_early_init() != 0)
        || (lbxfile_init() != 0)
    {
        return 1
    }
    0
}

func main_init () {
    if (os_init() != 0)
        || (hw_init() != 0)
        || (ui_init() != 0)
    {
        return 1
    }
    0
}

func main_shutdown () {
    options_shutdown(main_startup_ok)
    main_do_shutdown()
    lbxfile_shutdown()
    ui_shutdown()
    hw_shutdown()
    os_shutdown()
    log_file_close()
    log_message("Thanks for playing 1oom.\n")
}

;; ---------------------------------------------------------------------------

;; `argv`: the arguments, without the program name.
func main_1oom (argv) {
    if main_early_init() != 0 {
        return 1
    }
    if options_parse_early(argv) != 0 {
        return 1
    }
    log_message("1oom v1.11.9: main:%s ui:%s hw:%s os:%s\n", idstr_main, idstr_ui, idstr_hw, idstr_os)
    os_atexit(main_shutdown)
    if main_init() != 0 {
        return 2
    }
    if options_parse(argv) != 0 {
        return 3
    }
    if lbxfile_find_dir() != 0 {
        ui_early_show_message_box("Error: could not find\nthe LBX files!\n"
                            ++ "1oom requires a copy\nof the Master of Orion\n(v1.3) LBX files.\n"
                            ++ "Simply copy the EXE and\nDLLs to your MOO1\ndirectory.\n"
                            ++ "Alternatively copy your\nMOO1 LBX files to your\n1oom directory.")
        return 4
    }
    game_apply_rules()
    if pbx_apply_queued_files() != 0 {
        return 5
    }

    log_message("USER: '%s'\n", os_get_path_user())
    set main_startup_ok = true
    options_finish()
    main_do()
}

;; `main` of hwnop.c: `return main_1oom(argc, argv)`, through `exit`.
val r = main_1oom([...])
os_exit(r)
