        report_stars        = 0,        ;; uint8_t
        coup                = BOOLVEC_DECLARE(PLAYER_NUM),
        newtech             = carrayf(PLAYER_NUM, newtechs_t),
        new_ships           = carray2(PLAYER_NUM, NUM_SHIPDESIGNS), ;; shipsum_t[][]
        spies_caught        = carray2(PLAYER_NUM, PLAYER_NUM),  ;; uint16_t[][] [catcher][spy]
        spied_num           = carray2(PLAYER_NUM, PLAYER_NUM),  ;; uint16_t[][] [victim][spy]
        spied_spy           = carray2(PLAYER_NUM, PLAYER_NUM),  ;; int16_t[][] [victim][spy]
