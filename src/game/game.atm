        quake_player        = 0,        ;; player_id_t
        quake_planet_i      = 0,        ;; uint8_t
        have_nova           = 0,        ;; uint8_t (0..3)
        nova_player         = 0,        ;; player_id_t
        nova_planet_i       = 0,        ;; uint8_t
        nova_years          = 0,        ;; int8_t
        nova_val            = 0,        ;; int
