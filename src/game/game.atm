val NEWTECH_MAX = 15

func monster_t () {
    [
        exists  = 0,    ;; uint8_t (0..3)
        x       = 0,    ;; int16_t
        y       = 0,    ;; int16_t
        killer  = 0,    ;; player_id_t (MOO1: 0 or id+1)
        dest    = 0,    ;; uint8_t
        counter = 0,    ;; int8_t
        nuked   = 0,    ;; int8_t (planets destroyed)
    ]
}

func newtech_t () {
    [
        field       = 0,        ;; tech_field_t
        tech        = 0,        ;; uint8_t
        source      = 0,        ;; techsource_t
        v06         = 0,        ;; int8_t
        stolen_from = 0,        ;; player_id_t
        frame       = false,    ;; bool
        other1      = 0,        ;; player_id_t
        other2      = 0,        ;; player_id_t
    ]
}

func nexttech_t () {
    [
        num  = 0,                       ;; uint8_t
        tech = carray(TECH_NEXT_MAX),   ;; uint8_t[]
    ]
}

val NEWTECH_V06_ORION = PLANETS_MAX

func newtechs_t () {
    [
        num  = 0,   ;; uint8_t
        d    = carrayf(NEWTECH_MAX, newtech_t),
        next = carrayf(TECH_FIELD_NUM, nexttech_t),
    ]
}

