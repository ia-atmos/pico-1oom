;; Port of c/src/game/game.h: the state of the game.
;;
;; Each structure of C is a function that makes a table with all of its
;; fields, as C after `memset(0)`. The comments give the C type of each
;; field, which says how a value is converted when stored (see ctypes.atm).

include "../boolvec.atm"
include "../ctypes.atm"
include "game_planet.atm"
include "game_shipdesign.atm"
include "game_shiptech.atm"
include "game_types.atm"

func fleet_enroute_t () {
    [
        owner   = 0,        ;; player_id_t
        x       = 0,        ;; uint16_t
        y       = 0,        ;; uint16_t
        dest    = 0,        ;; uint8_t (planet index)
        speed   = 0,        ;; uint8_t
        retreat = false,    ;; bool
        visible = BOOLVEC_DECLARE(PLAYER_NUM),
        ships   = carray(NUM_SHIPDESIGNS),  ;; shipcount_t[]
    ]
}

func transport_t () {
    [
        owner   = 0,        ;; player_id_t
        x       = 0,        ;; uint16_t
        y       = 0,        ;; uint16_t
        dest    = 0,        ;; uint8_t (planet index)
        speed   = 0,        ;; uint8_t
        visible = BOOLVEC_DECLARE(PLAYER_NUM),
        pop     = 0,        ;; uint16_t
    ]
}

func fleet_orbit_t () {
    [
        visible = BOOLVEC_DECLARE(PLAYER_NUM),
        ships   = carray(NUM_SHIPDESIGNS),  ;; shipcount_t[]
    ]
}

func techdata_t () {
    [
        percent     = carray(TECH_FIELD_NUM),   ;; uint8_t[] (tech level %)
        slider      = carray(TECH_FIELD_NUM),   ;; int16_t[] (%)
        slider_lock = carray(TECH_FIELD_NUM),   ;; uint16_t[]
        investment  = carray(TECH_FIELD_NUM),   ;; uint32_t[]
        project     = carray(TECH_FIELD_NUM),   ;; uint8_t[]
        cost        = carray(TECH_FIELD_NUM),   ;; uint32_t[]
        completed   = carray(TECH_FIELD_NUM),   ;; uint16_t[] (number of completed projects)
    ]
}

val TECH_TIER_NUM  = 10
val TECH_PER_FIELD = 60
val TECH_MAX_LEVEL = 100

func shipresearch_t () {
    [
        design            = carrayf(NUM_SHIPDESIGNS, shipdesign_t),
        researchlist      = carrayf(TECH_FIELD_NUM, \{ carray2(TECH_TIER_NUM, 3) }),  ;; uint8_t[][][]
        researchcompleted = carray2(TECH_FIELD_NUM, TECH_PER_FIELD),    ;; uint8_t[][]
        have_reserve_fuel = carray(NUM_SHIPDESIGNS, false),             ;; bool[]
        year              = carray(NUM_SHIPDESIGNS),    ;; uint16_t[]
        shipcount         = carray(NUM_SHIPDESIGNS),    ;; shipsum_t[]
    ]
}

