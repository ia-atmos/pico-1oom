        sabotage_num        = carray2(PLAYER_NUM, PLAYER_NUM),  ;; uint16_t[][] [victim][spy]
        sabotage_spy        = carray2(PLAYER_NUM, PLAYER_NUM),  ;; player_id_t[][] [victim][spy]
