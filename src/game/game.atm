        help_shown          = BOOLVEC_TBL_DECLARE(PLAYER_NUM, HELP_SHOWN_NUM),
        build_finished_num  = carray(PLAYER_NUM),   ;; uint16_t[]
        voted               = carray(PLAYER_NUM),   ;; player_id_t[]
        best_ecorestore     = carray(PLAYER_NUM),   ;; uint8_t[]
        best_wastereduce    = carray(PLAYER_NUM),   ;; uint8_t[]
        best_roboctrl       = carray(PLAYER_NUM),   ;; uint8_t[]
        best_terraform      = carray(PLAYER_NUM),   ;; uint8_t[]
    ]
}

func seen_t () {
    [
        owner     = 0,  ;; player_id_t
        pop       = 0,  ;; uint16_t
        bases     = 0,  ;; uint16_t
        factories = 0,  ;; uint16_t
    ]
}

val EMPEROR_NAME_LEN = 15
val NEBULA_MAX = 4
val YEAR_BASE = 2299

func game_s () {
    [
        enroute_num     = 0,    ;; uint16_t
        transport_num   = 0,    ;; uint16_t
        year            = 0,    ;; uint16_t (init to 1)
        players         = 0,    ;; uint8_t
        ai_id           = 0,    ;; uint8_t
        is_ai           = BOOLVEC_DECLARE(PLAYER_NUM),
        active_player   = 0,    ;; player_id_t
        difficulty      = 0,    ;; difficulty_t
        galaxy_size     = 0,    ;; galaxy_size_t
        galaxy_w        = 0,    ;; uint8_t (6 8 a c)
        galaxy_h        = 0,    ;; uint8_t (4 6 7 9)
        galaxy_stars    = 0,    ;; uint8_t (w*h)
        galaxy_maxx     = 0,    ;; uint16_t
        galaxy_maxy     = 0,    ;; uint16_t
        seed            = 0,    ;; uint32_t (current random seed)
        galaxy_seed     = 0,    ;; uint32_t (seed of generated galaxy)
        end             = 0,    ;; game_end_type_t
        winner          = 0,    ;; player_id_t
        guardian_killer = 0,    ;; player_id_t
        election_held   = false,    ;; bool
        refuse          = BOOLVEC_DECLARE(PLAYER_NUM),
        planet_focus_i  = carray(PLAYER_NUM),   ;; uint8_t[]
        nebula_num      = 0,    ;; uint8_t (0..4)
        nebula_type     = carray(NEBULA_MAX),   ;; uint8_t[] (0..9)
        nebula_x        = carray(NEBULA_MAX),   ;; uint16_t[]
        nebula_y        = carray(NEBULA_MAX),   ;; uint16_t[]
        nebula_x0       = carray2(NEBULA_MAX, 4),   ;; uint16_t[][]
        nebula_x1       = carray2(NEBULA_MAX, 4),   ;; uint16_t[][]
        nebula_y0       = carray2(NEBULA_MAX, 4),   ;; uint16_t[][]
        nebula_y1       = carray2(NEBULA_MAX, 4),   ;; uint16_t[][]
        planet          = carrayf(PLANETS_MAX, planet_t),
        enroute         = carrayf(FLEET_ENROUTE_MAX, fleet_enroute_t),
        transport       = carrayf(TRANSPORT_MAX, transport_t),
        eto             = carrayf(PLAYER_NUM, empiretechorbit_t),
        srd             = carrayf(PLAYER_NUM, shipresearch_t),
        evn             = gameevents_t(),
        emperor_names   = carray2(PLAYER_NUM, EMPEROR_NAME_LEN),    ;; char[][]
        seen            = carrayf(PLAYER_NUM, \{ carrayf(PLANETS_MAX, seen_t) }),
        current_design  = carrayf(PLAYER_NUM, shipdesign_t),
        gaux            = nil,  ;; struct game_aux_s *
    ]
}

;; The inline functions of game.h.

func IS_PLAYER (g, i) {
    (i >= 0) && (i < g.players)
}

func IS_HUMAN (g, i) {
    ;; In MOO1, instead of IS_HUMAN, the index is checked for equality to zero,
    ;; which in turn implicitly guarantees that the index is less than g->players.
    ;; The IS_PLAYER check eliminates the potential for memory corruption.
    IS_PLAYER(g, i) && BOOLVEC_IS0(g.is_ai, i)
}

func IS_ALIVE (g, i) {
    g.evn.home@(i) != PLANET_NONE
}

func IS_AI (g, i) {
    BOOLVEC_IS1(g.is_ai, i)
}
