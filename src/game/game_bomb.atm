;; Port of c/src/game/game_bomb.c and game_bomb.h.

include "../boolvec.atm"
include "../comp.atm"
include "../ctypes.atm"
include "../rnd.atm"
include "../ui.atm"
include "game.atm"
include "game_ai.atm"
include "game_aux.atm"
