;; Port of c/src/game/game_planet.c. (The structure and the enums of
;; game_planet.h are in game_planet.atm.)

include "../boolvec.atm"
include "../comp.atm"
include "../ctypes.atm"
include "../lib.atm"
include "../rnd.atm"
include "game.atm"
include "game_num.atm"
include "game_planet.atm"
include "game_str.atm"

func game_planet_get_random (g, owner) {
    pin tbl = carray(PLANETS_MAX)
    var num = 0
    loop i in g.galaxy_stars {
        if g.planet@(i).owner == owner {
            set tbl@(num) = i
            set num = num + 1
        }
    }
    if num == 0 => PLANET_NONE => tbl@(rnd_0_nm1(num, g))
}

;; `r_waste` is an `int *` in C: here a table that receives `.waste`, or nil.
func game_planet_get_waste_percent (r_waste, g, p, subtract_transports) {
    if p.owner == PLAYER_NONE {
        return 0
    }
    val e = g.eto@(p.owner)
    var fact = p.factories
    var pop = p.pop
    if subtract_transports {
        set pop = pop - p.trans_num
    }
    set fact = SETMIN(fact, pop * game_planet_get_pop_oper_fact(g, p))
    val waste = if e.race == RACE_SILICOID => 0 => ((((fact * e.ind_waste_scale) // 10) + p.waste) // e.have_eco_restoration_n)
    var prod = p.prod_after_maint
    if prod == 0 {
        set prod = 1000
    }
    var w = ((waste * 100) + prod - 1) // prod
    set w = SETRANGE(w, 0, 100)
    if r_waste != nil {
        set r_waste.waste = waste
    }
    w
}

func game_planet_destroy (g, planet_i, attacker) {
    var p = g.planet@(planet_i)
    val owner = p.owner
    if IS_PLAYER(g, owner) {
        ;; g->seen is not used by classical AI, so the original skips this for AI.
        set g.seen@(owner)@(planet_i).owner = PLAYER_NONE
        set g.seen@(owner)@(planet_i).pop = 0
        set g.seen@(owner)@(planet_i).bases = 0
        set g.seen@(owner)@(planet_i).factories = 0
    }
    if IS_HUMAN(g, owner) {
        ;; WASBUG there was an unreliable mess here
        set g.gaux.human_killer = attacker
    }
    set p.rebels = 0
    set p.unrest = 0
    set p.reserve = 0
    set p.prev_owner = owner
    set p.owner = PLAYER_NONE
    set p.bc_to_ecoproj = 0
    set p.pop = 0
    set p.pop_prev = 0
    set p.prod_after_maint = 0
    set p.bc_to_ship = 0
    loop i in PLAYER_NUM {
        set p.inbound@(i) = 0
    }
    set p.buildship = 0
    loop i in PLANET_SLIDER_NUM {
        set p.slider@(i) = 0
        set p.slider_lock@(i) = 0
    }
    set p.slider@(PLANET_SLIDER_IND) = 100
    set p.reloc = planet_i
    set p.missile_bases = 0
    set p.bc_upgrade_base = 0
    set p.bc_to_base = 0
    set p.trans_num = 0
    set p.bc_to_ship = 0
    set p.bc_to_factory = 0
    set p.have_stargate = false
    set p.shield = 0
    set p.bc_to_shield = 0
    BOOLVEC_CLEAR(p.finished, FINISHED_NUM)
    if game_num.extended_reloc_range {
        return nil
    }
    loop i in g.galaxy_stars {
        set p = g.planet@(i)
        if p.reloc == planet_i {
            set p.reloc = i
        }
    }
}

func game_planet_adjust_percent2 (g, planet_i, si, percent, respect_locks) {
    val p = g.planet@(planet_i)
    if respect_locks && (p.slider_lock@(si) != 0) {
        return nil
    }
    loop j in PLANET_SLIDER_NUM {
        if respect_locks && (p.slider_lock@(j) != 0) {
            skip
        }
        if si == j {
            skip
        }
        var diff = 0
        if j == PLANET_SLIDER_ECO {
            val w = game_planet_get_waste_percent(nil, g, p, true)
            if w < p.slider@(j) {
                set diff = ((p.slider@(j) - w) * percent) // 100
            }
        } else {
            set diff = (p.slider@(j) * percent) // 100
        }
        set p.slider@(si) = i16(p.slider@(si) + diff)
        set p.slider@(j) = i16(p.slider@(j) - diff)
    }
}

func game_planet_adjust_percent (g, owner, si, percent, growth) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        if p.owner == owner {
            if (growth == 0) || ((growth == 1) && (p.growth > PLANET_GROWTH_HOSTILE)) || ((growth == 2) && (p.growth == PLANET_GROWTH_HOSTILE)) {
                ;; Summing up all sliders except for the one that is going to be
                ;; increased and ECO, because ECO is set to the minimum for waste
                ;; cleanup before this function is called. SHIP and TECH are never
                ;; increased in this function.
                var sum = p.slider@(PLANET_SLIDER_SHIP) + p.slider@(PLANET_SLIDER_TECH)
                if si != PLANET_SLIDER_DEF {
                    set sum = sum + p.slider@(PLANET_SLIDER_DEF)
                }
                if si != PLANET_SLIDER_IND {
                    set sum = sum + p.slider@(PLANET_SLIDER_IND)
                }
                if game_num.newtech_adjust_fix && (si != PLANET_SLIDER_ECO) {
                    var eco = p.slider@(PLANET_SLIDER_ECO) - game_planet_get_waste_percent(nil, g, p, false)
                    set eco = SETMAX(eco, 0)
                    set sum = sum + eco
                    set p.slider@(PLANET_SLIDER_ECO) = i16(p.slider@(PLANET_SLIDER_ECO) - ((eco * percent) // 100))
                }
                val slider_increase = (sum * percent) // 100
                set p.slider@(PLANET_SLIDER_SHIP) = i16((p.slider@(PLANET_SLIDER_SHIP) * (100 - percent)) // 100)
                if si == PLANET_SLIDER_DEF {
                    set p.slider@(PLANET_SLIDER_DEF) = i16(p.slider@(PLANET_SLIDER_DEF) + slider_increase)
                } else {
                    set p.slider@(PLANET_SLIDER_DEF) = i16((p.slider@(PLANET_SLIDER_DEF) * (100 - percent)) // 100)
                }
                if si == PLANET_SLIDER_IND {
                    set p.slider@(PLANET_SLIDER_IND) = i16(p.slider@(PLANET_SLIDER_IND) + slider_increase)
                } else {
                    set p.slider@(PLANET_SLIDER_IND) = i16((p.slider@(PLANET_SLIDER_IND) * (100 - percent)) // 100)
                }
                if si == PLANET_SLIDER_ECO {
                    set p.slider@(PLANET_SLIDER_ECO) = i16(p.slider@(PLANET_SLIDER_ECO) + slider_increase)
                }
                set p.slider@(PLANET_SLIDER_TECH) = i16(100 - p.slider@(PLANET_SLIDER_SHIP) - p.slider@(PLANET_SLIDER_ECO) - p.slider@(PLANET_SLIDER_DEF) - p.slider@(PLANET_SLIDER_IND))
                set p.slider@(PLANET_SLIDER_TECH) = SETMAX(p.slider@(PLANET_SLIDER_TECH), 0)
            }
        }
    }
}

func game_planet_can_terraform (g, p, active_player, soilatmos) {
    val e = g.eto@(active_player)
    if soilatmos {
        if e.have_atmos_terra && (p.growth == PLANET_GROWTH_HOSTILE) {
            return true
        }
        if e.have_soil_enrich && (p.growth == PLANET_GROWTH_NORMAL) {
            return true
        }
        if e.have_adv_soil_enrich && ((p.growth == PLANET_GROWTH_NORMAL) || (p.growth == PLANET_GROWTH_FERTILE)) {
            return true
        }
    }
    ((p.max_pop2 + e.have_terraform_n) > p.max_pop3) && (p.max_pop3 < game_num.max_pop)
}

func game_planet_update_home (g) {
    loop i in g.galaxy_stars {
        val pi = g.planet@(i).owner
        if (pi != PLAYER_NONE) && (g.evn.home@(pi) == PLANET_NONE) {
            set g.evn.home@(pi) = i    ;; WASBUG? MOO1 sets to 0 which affects rebellion event check
        }
    }
}


;; ---------------------------------------------------------------------------
;; The texts for the interface. `buf` is a vector of bytes.

func tenths_2str (str, num) {
    strbuild_catf(str, "%i", num // 10)
    if (num < 100) && ((num % 10) != 0) {
        strbuild_catf(str, ".%i", num % 10)
    }
}

func game_planet_get_finished_text (g, p, type, buf, bufsize) {
    val name = cstr(p.name)
    match type {
        FINISHED_FACT => {
            val num = p.max_pop3 * g.eto@(p.owner).colonist_oper_factories
            lib_sprintf(buf, bufsize, "%s %s %s %i %s. %s", name, game_str_sm_hasreached, game_str_sm_indmaxof, num, game_str_sm_factories, game_str_sm_extrares)
        }
        FINISHED_POPMAX => {
            val num = p.max_pop3
            lib_sprintf(buf, bufsize, "%s %s %s %i %s. %s", name, game_str_sm_hasreached, game_str_sm_popmaxof, num, game_str_sm_colonists, game_str_sm_extrares)
        }
        FINISHED_SOILATMOS => {
            lib_sprintf(buf, bufsize, "%s %s %s %s %s%s.", name, game_str_sm_hasterraf, game_str_tbl_sm_terraf@(p.growth - 1), game_str_sm_envwith, game_str_tbl_sm_envmore@(p.growth - 1), game_str_sm_stdgrow)
        }
        FINISHED_STARGATE => {
            lib_sprintf(buf, bufsize, "%s %s.", name, game_str_sm_hasfsgate)
        }
        FINISHED_SHIELD => {
            lib_sprintf(buf, bufsize, "%s %s %s %s.", name, game_str_sm_hasfshield, game_str_tbl_roman@(p.shield), game_str_sm_planshield)
        }
        else => {
            lib_sprintf(buf, bufsize, "BUG: invalid finished tyoe %i at '%s'", type, name)
        }
    }
    buf
}

func game_planet_get_slider_text (g, p, si, buf, bufsize) {
    val player = p.owner
    val e = g.eto@(player)
    var retval = -1
    match si {
        PLANET_SLIDER_SHIP => {
            val vthis = game_adjust_prod_by_special((p.prod_after_maint * p.slider@(PLANET_SLIDER_SHIP)) // 100, p.special)
            val vtotal = vthis + p.bc_to_ship
            var cost = if p.buildship == BUILDSHIP_STARGATE => game_num.stargate_cost => g.srd@(player).design@(p.buildship).cost
            if (vtotal < cost) || (p.buildship == BUILDSHIP_STARGATE) {
                if vthis < 1 {
                    lib_strcpy(buf, game_str_sm_prodnone, bufsize)
                    set retval = 0
                } else {
                    var num = 0
                    var over = cost - p.bc_to_ship
                    loop {
                        while over > 0
                        set over = over - vthis
                        set num = num + 1
                    }
                    set num = SETMAX(num, 1)
                    lib_sprintf(buf, bufsize, "%i %s", num, game_str_sm_prod_y)
                    if p.buildship != BUILDSHIP_STARGATE {
                        set retval = 1
                    }
                }
            } else {
                ;; TODO this adjusted sd->cost directly!
                set cost = SETMAX(cost, 1)
                val num = vtotal // cost
                lib_sprintf(buf, bufsize, "1 %s", game_str_sm_prod_y)
                set retval = num
            }
        }
        PLANET_SLIDER_DEF => {
            val cost = game_get_base_cost(g, player)
            val vthis = game_adjust_prod_by_special((p.prod_after_maint * p.slider@(PLANET_SLIDER_DEF)) // 100, p.special)
            var vtotal = vthis + p.bc_to_base
            val v8 = p.bc_upgrade_base
            ifs {
                vthis == 0 => { lib_strcpy(buf, game_str_sm_prodnone, bufsize) }
                vtotal <= v8 => { lib_strcpy(buf, game_str_sm_defupg, bufsize) }
                else => {
                    set vtotal = vtotal - v8
                    set vtotal = SETMAX(vtotal, 0)
                    var va = e.planet_shield_cost - p.bc_to_shield
                    if p.battlebg == 0 {
                        set va = 0
                    }
                    set va = SETMAX(va, 0)
                    if vtotal <= va {
                        lib_strcpy(buf, game_str_sm_defshld, bufsize)
                    } else {
                        set vtotal = vtotal - va
                        set vtotal = SETMAX(vtotal, 0)
                        if (cost * 2) > vtotal {
                            var num = 1
                            var over = cost - vtotal
                            loop {
                                while over > 0
                                set over = over - vthis
                                set num = num + 1
                            }
                            lib_sprintf(buf, bufsize, "%i %s", num, game_str_sm_prod_y)
                        } else {
                            val num = vtotal // cost
                            lib_sprintf(buf, bufsize, "%i/%s", num, game_str_sm_prod_y)
                        }
                    }
                }
            }
        }
        PLANET_SLIDER_IND => {
            var str = nil
            val cost = game_planet_get_fact_adj_cost(g, p)
            val vthis = game_adjust_prod_by_special((p.prod_after_maint * p.slider@(PLANET_SLIDER_IND)) // 100, p.special)
            if vthis != 0 {
                val v20 = (vthis * 10) // cost
                if ((v20 // 10) + p.factories) >= ((p.pop - p.trans_num) * p.pop_oper_fact) {
                    if p.pop_oper_fact < e.colonist_oper_factories {
                        if e.race != RACE_MEKLAR {
                            set str = game_str_sm_refit
                            if game_num.factory_cost_fix {
                                ;; FIXME: Doesn't always match the result
                                set str = game_str_sm_irc@(p.pop_oper_fact - 1)
                            }
                        } else {
                            val strbuild = strbuild_init(buf, bufsize)
                            tenths_2str(strbuild, v20)
                            strbuild_catf(strbuild, "/%s", game_str_sm_prod_y)
                        }
                    } else {
                        set str = game_str_sm_indres
                        if p.factories < (p.max_pop3 * e.colonist_oper_factories) {
                            set str = game_str_sm_indmax
                        }
                    }
                } else {
                    val strbuild = strbuild_init(buf, bufsize)
                    tenths_2str(strbuild, v20)
                    strbuild_catf(strbuild, "/%s", game_str_sm_prod_y)
                }
            } else {
                set str = game_str_sm_prodnone
            }
            if str != nil {
                lib_strcpy(buf, str, bufsize)
            }
        }
        PLANET_SLIDER_ECO => {
            set retval = game_planet_get_slider_text_eco(g, p, false, buf, bufsize)
        }
        PLANET_SLIDER_TECH => {
            val v = game_get_tech_prod(p.prod_after_maint, p.slider@(PLANET_SLIDER_TECH), e.race, p.special)
            lib_sprintf(buf, bufsize, "%i", v)
            set retval = v
        }
        else => {
            set buf@(0) = 0
        }
    }
    retval
}

func game_planet_get_slider_text_eco (g, p, flag_tenths, buf, bufsize) {
    val player = p.owner
    val e = g.eto@(player)
    var retval = -1
    var str = nil
    var flag_ecoproj = false
    var vthis = (p.prod_after_maint * p.slider@(PLANET_SLIDER_ECO)) // 100
    pin rw = [ waste = 0 ]
    game_planet_get_waste_percent(rw, g, p, true)
    val adjwaste = rw.waste
    if (vthis < adjwaste) || (vthis == 0) {
        set str = if vthis < adjwaste => game_str_sm_ecowaste => game_str_sm_prodnone
    } else {
        set vthis = SUBSAT0(vthis, adjwaste)
        if (vthis > 0) && e.have_atmos_terra && (p.growth == PLANET_GROWTH_HOSTILE) {
            set vthis = vthis - (game_num.atmos_cost - p.bc_to_ecoproj)
            if vthis < 0 {
                set flag_ecoproj = true
                set str = game_str_sm_ecoatmos
            }
        }
        if (vthis > 0) && e.have_soil_enrich && (p.growth == PLANET_GROWTH_NORMAL) {
            set vthis = vthis - (game_num.soil_cost - p.bc_to_ecoproj)
            if vthis < 0 {
                set flag_ecoproj = true
                set str = game_str_sm_ecosoil
            }
        }
        if (vthis > 0) && e.have_adv_soil_enrich && ((p.growth == PLANET_GROWTH_NORMAL) || (p.growth == PLANET_GROWTH_FERTILE)) {
            set vthis = vthis - (game_num.adv_soil_cost - p.bc_to_ecoproj)
            if vthis < 0 {
                set flag_ecoproj = true
                set str = game_str_sm_ecogaia
            }
        }
        if vthis > 0 {
            var tform_cost
            if p.max_pop3 < game_num.max_pop {
                ;; WASBUG In MOO 1.3, if you conquered a planet from a race
                ;; with more advanced terraforming than you, a negative
                ;; terraforming cost would be calculated here. This affected
                ;; the displayed pop growth estimate but not actual growth.
                set tform_cost = (p.max_pop2 + (e.have_terraform_n - p.max_pop3)) * e.terraform_cost_per_inc
                set tform_cost = SETMAX(tform_cost, 0)
            } else {
                set tform_cost = 0
            }
            if vthis < tform_cost {
                set str = game_str_sm_ecotform
            } else {
                var max = false
                var flag_tform = false
                var max_pop = p.max_pop3
                if tform_cost > 0 {
                    if vthis < tform_cost {
                        set flag_tform = true
                    } else {
                        if flag_tenths {    ;; keep same +N as MOO1 for developing planets on -nouiextra
                            set max_pop = p.max_pop2 + e.have_terraform_n
                        }
                    }
                }
                set vthis = vthis - tform_cost
                var growth = game_get_pop_growth_max(g, p, max_pop) + p.pop_tenths
                var growth2
                if !flag_tenths {
                    if ((p.pop - p.trans_num) + (growth // 10)) > max_pop {
                        set growth = (max_pop - (p.pop - p.trans_num)) * 10
                    }
                    set growth2 = game_get_pop_growth_for_eco(g, p, vthis) + growth
                    if ((p.pop - p.trans_num) + (growth2 // 10)) > max_pop {
                        set growth2 = (max_pop - (p.pop - p.trans_num)) * 10
                    }
                    set growth = (growth2 // 10) - (growth // 10)
                } else {
                    if (((p.pop - p.trans_num) * 10) + growth) > (max_pop * 10) {
                        set growth = (max_pop - (p.pop - p.trans_num)) * 10
                        if !game_num.pop_tenths_fix {
                            set growth = growth + p.pop_tenths
                        }
                    }
                    set growth2 = game_get_pop_growth_for_eco(g, p, vthis) + growth
                    if (((p.pop - p.trans_num) * 10) + growth2) >= (max_pop * 10) {
                        set growth2 = (max_pop - (p.pop - p.trans_num)) * 10
                        if !game_num.pop_tenths_fix {
                            set growth2 = growth2 + p.pop_tenths
                        }
                        set max = growth != growth2
                    }
                    set growth = growth2 - growth
                }
                ifs {
                    growth <= 0 => { set str = if flag_tform => game_str_sm_ecotform => game_str_sm_ecoclean }
                    max => { set str = game_str_sm_max }
                    else => {
                        set retval = growth
                        set str = game_str_sm_ecopop
                    }
                }
            }
        } else {
            if (flag_ecoproj == false) && (e.race != RACE_SILICOID) {
                set str = game_str_sm_ecoclean
            }
        }
    }
    if str != nil {
        lib_strcpy(buf, str, bufsize)
    }
    retval
}
