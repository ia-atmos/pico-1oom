;; `*dst = *src` of two `shipdesign_t`.
func shipdesign_copy (dst, src) {
    loop k,v in src {
        if type(v) == "table" {
            loop i,x in v {
                set dst@(k)@(i) = x
            }
        } else {
            set dst@(k) = v
        }
    }
}

func game_generate_planets (g) {
    ;; assumes the planet data is already 0'd by caller
    pin tblpx = carray(PLANETS_MAX)     ;; uint16_t[]
    pin tblpy = carray(PLANETS_MAX)     ;; uint16_t[]

    loop h in g.galaxy_h {
        loop w in g.galaxy_w {
            var x
            var y
            loop {  ;; again:
                set x = u16(rnd_1_n(0x2b, g) + (w * 0x1c) + 9)
                set y = u16(rnd_1_n(0x33, g) + (h * 0x20) + 7)
                var again = false
                loop i in ((h * g.galaxy_w) + w) {
                    if (tblpx@(i) < x) || (tblpy@(i) < y) {
                        if util_math_dist_fast(tblpx@(i), tblpy@(i), x, y) < 20 {
                            set again = true
                            break
                        }
                    } else {
                        if util_math_dist_fast(tblpx@(i), tblpy@(i), x, y) < 10 {
                            set again = true
                            break
                        }
                    }
                }
                until !again
            }
            set tblpx@((h * g.galaxy_w) + w) = x
            set tblpy@((h * g.galaxy_w) + w) = y
        }
    }

    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        set p.x = u16(tblpx@(i) + 4)
        set p.y = u16(tblpy@(i) + 4)

        match rnd_0_nm1(0x14, g) {
            \{ (it >= 0x03) && (it <= 0x08) } => {
                set p.star_type = STAR_TYPE_RED
            }
            \{ (it >= 0x09) && (it <= 0x0d) } => {
                set p.star_type = STAR_TYPE_GREEN
            }
            \{ (it >= 0x0e) && (it <= 0x10) } => {
                set p.star_type = STAR_TYPE_BLUE
            }
            \{ (it >= 0x11) && (it <= 0x12) } => {
                set p.star_type = STAR_TYPE_WHITE
            }
            0x13 => {
                set p.star_type = STAR_TYPE_NEUTRON
            }
            else => {  ;; 0x00, 0x01, 0x02
                set p.star_type = STAR_TYPE_YELLOW
            }
        }

        set p.look = u8(rnd_0_nm1(2, g) * 6)
        set p.frame = u8(rnd_0_nm1(50, g))
        ;; Needed for the original sequence of random numbers
        rnd_0_nm1(4, g)    ;; p->field_16

        var in_nebula = false
        loop k in g.nebula_num {
            loop j in 4 {
                if (p.x >= g.nebula_x0@(k)@(j)) && (p.x <= g.nebula_x1@(k)@(j)) && (p.y >= g.nebula_y0@(k)@(j)) && (p.y <= g.nebula_y1@(k)@(j)) {
                    set in_nebula = true
                    ;; could break out here
                }
            }
        }

        do {
            var t = PLANET_TYPE_NOT_HABITABLE
            val r = i16(rnd_1_n(20, g) - (if in_nebula => 4 => 0))
            match p.star_type {
            STAR_TYPE_YELLOW => {
                if r == -1 {
                    set t = PLANET_TYPE_RADIATED
                }
                if r == 0 {
                    set t = PLANET_TYPE_TOXIC
                }
                if r == 1 {
                    set t = PLANET_TYPE_INFERNO
                }
                if r == 2 {
                    set t = PLANET_TYPE_TUNDRA
                }
                if r == 3 {
                    set t = PLANET_TYPE_BARREN
                }
                if r == 4 {
                    set t = PLANET_TYPE_MINIMAL
                }
                if r == 5 {
                    set t = PLANET_TYPE_DESERT
                }
                if r == 6 {
                    set t = PLANET_TYPE_STEPPE
                }
                if (r > 6) && (r < 9) {
                    set t = PLANET_TYPE_ARID
                }
                if (r > 8) && (r < 0xb) {
                    set t = PLANET_TYPE_OCEAN
                }
                if (r > 0xa) && (r < 0xd) {
                    set t = PLANET_TYPE_JUNGLE
                }
                if r > 0xc {
                    set t = PLANET_TYPE_TERRAN
                }
            }
            STAR_TYPE_RED => {
                if r == 2 {
                    set t = PLANET_TYPE_RADIATED
                }
                if r == 3 {
                    set t = PLANET_TYPE_TOXIC
                }
                if r == 4 {
                    set t = PLANET_TYPE_INFERNO
                }
                if r == 5 {
                    set t = PLANET_TYPE_DEAD
                }
                if r == 6 {
                    set t = PLANET_TYPE_TUNDRA
                }
                if r == 7 {
                    set t = PLANET_TYPE_BARREN
                }
                if r == 8 {
                    set t = PLANET_TYPE_MINIMAL
                }
                if (r > 8) && (r < 0xb) {
                    set t = PLANET_TYPE_DESERT
                }
                if (r > 0xa) && (r < 0xd) {
                    set t = PLANET_TYPE_STEPPE
                }
                if (r > 0xc) && (r < 0x10) {
                    set t = PLANET_TYPE_ARID
                }
                if (r > 0xf) && (r < 0x12) {
                    set t = PLANET_TYPE_OCEAN
                }
                if (r > 0x11) && (r < 0x14) {
                    set t = PLANET_TYPE_JUNGLE
                }
                if r == 0x14 {
                    set t = PLANET_TYPE_TERRAN
                }
            }
            STAR_TYPE_GREEN => {
                if r == 2 {
                    set t = PLANET_TYPE_RADIATED
                }
                if r == 3 {
                    set t = PLANET_TYPE_TOXIC
                }
                if r == 4 {
                    set t = PLANET_TYPE_INFERNO
                }
                if r == 5 {
                    set t = PLANET_TYPE_DEAD
                }
                if r == 6 {
                    set t = PLANET_TYPE_TUNDRA
                }
                if r == 7 {
                    set t = PLANET_TYPE_BARREN
                }
                if r == 8 {
                    set t = PLANET_TYPE_MINIMAL
                }
                if r == 9 {
                    set t = PLANET_TYPE_DESERT
                }
                if (r > 9) && (r < 0xc) {
                    set t = PLANET_TYPE_STEPPE
                }
                if (r > 0xb) && (r < 0xe) {
                    set t = PLANET_TYPE_ARID
                }
                if (r > 0xd) && (r < 0x10) {
                    set t = PLANET_TYPE_OCEAN
                }
                if (r > 0xf) && (r < 0x12) {
                    set t = PLANET_TYPE_JUNGLE
                }
                if r > 0x11 {
                    set t = PLANET_TYPE_TERRAN
                }
            }
            STAR_TYPE_WHITE => {
                if r == 3 {
                    set t = PLANET_TYPE_RADIATED
                }
                if (r > 3) && (r < 6) {
                    set t = PLANET_TYPE_TOXIC
                }
                if (r > 5) && (r < 8) {
                    set t = PLANET_TYPE_INFERNO
                }
                if (r > 7) && (r < 0xa) {
                    set t = PLANET_TYPE_DEAD
                }
                if (r > 9) && (r < 0xc) {
                    set t = PLANET_TYPE_TUNDRA
                }
                if (r > 0xb) && (r < 0xe) {
                    set t = PLANET_TYPE_BARREN
                }
                if (r > 0xd) && (r < 0x10) {
                    set t = PLANET_TYPE_MINIMAL
                }
                if (r > 0xf) && (r < 0x12) {
                    set t = PLANET_TYPE_DESERT
                }
                if r == 0x12 {
                    set t = PLANET_TYPE_STEPPE
                }
                if r == 0x13 {
                    set t = PLANET_TYPE_ARID
                }
                if r == 0x14 {
                    set t = PLANET_TYPE_OCEAN
                }
            }
            STAR_TYPE_BLUE => {
                if (r > 3) && (r < 6) {
                    set t = PLANET_TYPE_RADIATED
                }
                if (r > 5) && (r < 8) {
                    set t = PLANET_TYPE_TOXIC
                }
                if (r > 7) && (r < 0xa) {
                    set t = PLANET_TYPE_INFERNO
                }
                if (r > 9) && (r < 0xc) {
                    set t = PLANET_TYPE_DEAD
                }
                if (r > 0xb) && (r < 0xe) {
                    set t = PLANET_TYPE_TUNDRA
                }
                if (r > 0xd) && (r < 0x10) {
                    set t = PLANET_TYPE_BARREN
                }
                if (r > 0xf) && (r < 0x12) {
                    set t = PLANET_TYPE_MINIMAL
                }
                if r == 0x12 {
                    set t = PLANET_TYPE_DESERT
                }
                if r == 0x13 {
                    set t = PLANET_TYPE_STEPPE
                }
                if r == 0x14 {
                    set t = PLANET_TYPE_ARID
                }
            }
            STAR_TYPE_NEUTRON => {
                if (r > 4) && (r < 0xa) {
                    set t = PLANET_TYPE_RADIATED
                }
                if (r > 9) && (r < 0xd) {
                    set t = PLANET_TYPE_TOXIC
                }
                if (r > 0xc) && (r < 0x10) {
                    set t = PLANET_TYPE_INFERNO
                }
                if (r > 0xf) && (r < 0x12) {
                    set t = PLANET_TYPE_DEAD
                }
                if r == 0x12 {
                    set t = PLANET_TYPE_TUNDRA
                }
                if r == 0x13 {
                    set t = PLANET_TYPE_BARREN
                }
                if r == 0x14 {
                    set t = PLANET_TYPE_MINIMAL
                }
            }
                else => {}
            }
            set p.type = t
        }

        do {
            var a  ;; uint16_t
            match p.type {
                PLANET_TYPE_NOT_HABITABLE => {
                    set a = 10
                }
                \{ (it == PLANET_TYPE_RADIATED) || (it == PLANET_TYPE_TOXIC) || (it == PLANET_TYPE_INFERNO) } => {
                    set a = u16((rnd_1_n(7, g) * 5) + 5)
                }
                \{ (it == PLANET_TYPE_DEAD) || (it == PLANET_TYPE_TUNDRA) } => {
                    set a = u16((rnd_1_n(7, g) * 5) + 0xf)
                }
                \{ (it == PLANET_TYPE_BARREN) || (it == PLANET_TYPE_MINIMAL) } => {
                    set a = u16((rnd_1_n(5, g) * 5) + 0x19)
                }
                PLANET_TYPE_JUNGLE => {
                    set a = u16((rnd_1_n(4, g) * 5) + 0x46)
                }
                PLANET_TYPE_TERRAN => {
                    set a = u16((rnd_1_n(4, g) * 5) + 0x50)
                }
                else => {  ;; DESERT, STEPPE, ARID, OCEAN
                    set a = u16((rnd_1_n(4, g) * 5) + ((p.type - PLANET_TYPE_DESERT) * 0xa) + 0x1e)
                }
            }
            set p.max_pop2 = i16(a)
        }

        do {
            var di = u8(rnd_1_n(10, g))
            loop {
                while (di == 1) || (di == 10)
                if di == 1 {
                    set p.max_pop2 = i16(p.max_pop2 - 20)
                } else {
                    set p.max_pop2 = i16(p.max_pop2 + 20)
                }
                set di = u8(rnd_1_n(10, g))
                set p.max_pop2 = SETMAX(p.max_pop2, 10)
            }
            set p.max_pop2 = SETMIN(p.max_pop2, 120)
        }

        set p.max_pop3 = p.max_pop2
        set p.max_pop1 = p.max_pop2
        set p.battlebg = if in_nebula => 0 => u8(rnd_1_n(4, g))
        set p.special = PLANET_SPECIAL_NORMAL
        do {
            val star_type = p.star_type
            var di  ;; int16_t
            if p.type >= PLANET_TYPE_STEPPE {
                set di = i16(rnd_1_n(0x14, g))
                if star_type == STAR_TYPE_RED {
                    set di = i16(di - 4)
                } else {
                    if star_type == STAR_TYPE_GREEN {
                        set di = i16(di - 2)
                    }
                }
                if di <= 2 {
                    set p.special = PLANET_SPECIAL_POOR
                }
                set di = i16(rnd_1_n(0x14, g))
                if star_type == STAR_TYPE_RED {
                    set di = i16(di - 4)
                } else {
                    if star_type == STAR_TYPE_GREEN {
                        set di = i16(di - 2)
                    }
                }
                if di <= 5 {
                    if p.special == PLANET_SPECIAL_POOR {
                        set p.special = PLANET_SPECIAL_ULTRA_POOR
                    }
                }
            }
            set di = i16(rnd_1_n(0x14, g) - (if in_nebula => 8 => 0))
            if star_type == STAR_TYPE_BLUE {
                set di = i16(di - 2)
            } else {
                if star_type == STAR_TYPE_NEUTRON {
                    set di = i16(di - 5)
                }
            }
            if (PLANET_TYPE_STEPPE - p.type) > di {
                set p.special = PLANET_SPECIAL_RICH
            }
            set di = i16(rnd_1_n(0x14, g) - (if in_nebula => 8 => 0))
            if star_type == STAR_TYPE_BLUE {
                set di = i16(di - 2)
            } else {
                if star_type == STAR_TYPE_NEUTRON {
                    set di = i16(di - 5)
                }
            }
            if di < 6 {
                if p.special == PLANET_SPECIAL_RICH {
                    set p.special = PLANET_SPECIAL_ULTRA_RICH
                }
            }
        }
        if (p.type >= PLANET_TYPE_MINIMAL) && (p.type <= PLANET_TYPE_OCEAN) && (p.special == PLANET_SPECIAL_NORMAL) && (rnd_1_n(10, g) == 1) {
            set p.special = PLANET_SPECIAL_ARTIFACTS
        }
        do {
            var di = i16(rnd_1_n(100, g))
            if p.special == PLANET_SPECIAL_ULTRA_RICH {
                set di = i16(di - 20)
            } else {
                if p.special == PLANET_SPECIAL_RICH {
                    set di = i16(di - 10)
                }
            }
            set di = i16(di - (15 - p.type))
            ifs {
                di < 15 => {
                    set p.rocks = PLANET_ROCKS_MANY
                }
                di < 40 => {
                    set p.rocks = PLANET_ROCKS_SOME
                }
                else => {
                    set p.rocks = PLANET_ROCKS_NONE
                }
            }
        }
        set p.growth = PLANET_GROWTH_NORMAL
        if p.type < PLANET_TYPE_MINIMAL {
            set p.growth = PLANET_GROWTH_HOSTILE
        } else {
            if (p.type > PLANET_TYPE_DESERT) && (rnd_1_n(12, g) == 1) {
                set p.growth = PLANET_GROWTH_FERTILE
                val v = u16(p.max_pop2 + ((p.max_pop2 // 20) * 5))
                set p.max_pop2 = i16(v)
                set p.max_pop3 = i16(v)
                set p.max_pop1 = i16(v)
            }
        }
        set p.owner = PLAYER_NONE
        set p.prev_owner = PLAYER_NONE
        set p.claim = PLAYER_NONE
        if p.type == PLANET_TYPE_NOT_HABITABLE {
            set p.growth = PLANET_GROWTH_NORMAL
            set p.special = PLANET_SPECIAL_NORMAL
        }
        set p.pop_oper_fact = 2
        set p.infogfx = u8(tbl_planet_type_infogfx@(p.type)@(rnd_0_nm1(6, g)) - 1)
        set p.slider@(PLANET_SLIDER_IND) = 100
        set p.reloc = i
    }

    do {
        var tx = 0
        var ty = 0
        loop i in g.galaxy_stars {
            val p = g.planet@(i)
            if p.x > tx {
                set tx = p.x
            }
            if p.y > ty {
                set ty = p.y
            }
        }
        set g.galaxy_maxx = u16(tx + 27)
        set g.galaxy_maxy = u16(ty + 25)
    }

    loop i in PLAYER_NUM {
        set g.evn.voted@(i) = PLAYER_NONE
    }

    do {
        val i = rnd_0_nm1(g.galaxy_stars, g)
        set g.evn.planet_orion_i = u8(i)
        set g.evn.have_guardian = true
        val p = g.planet@(i)
        set p.type = PLANET_TYPE_TERRAN
        set p.max_pop3 = 120
        set p.max_pop2 = 120
        set p.max_pop1 = 120
        set p.special = PLANET_SPECIAL_4XTECH
        set p.growth = PLANET_GROWTH_NORMAL
        set p.infogfx = u8(tbl_planet_type_infogfx@(p.type)@(rnd_0_nm1(6, g)) - 1)
    }
}

func game_generate_galaxy (g, opts) {
    do {
        var a = 0
        var w = 0
        var h = 0
        match g.galaxy_size {
            GALAXY_SIZE_MEDIUM => {
                set a = rnd_1_n(3, g)
                set w = 8
                set h = 6
            }
            GALAXY_SIZE_LARGE => {
                set a = u16(rnd_1_n(2, g) + 1)
                set w = 10
                set h = 7
            }
            GALAXY_SIZE_HUGE => {
                set a = u16(rnd_1_n(3, g) + 1)
                set w = 12
                set h = 9
            }
            else => {  ;; GALAXY_SIZE_SMALL
                set a = rnd_0_nm1(2, g)
                set w = 6
                set h = 4
            }
        }
        set g.nebula_num = if opts.nebulae => u8(a) => 0
        set g.galaxy_w = w
        set g.galaxy_h = h
        set g.galaxy_maxx = u16(((w - 1) * 0x1c) + 0x14)
        set g.galaxy_maxy = u16(((h - 1) * 0x20) + 0x10)
        set g.galaxy_stars = u8(w * h)
    }

    set g.guardian_killer = PLAYER_NONE

    do {
        val gw = u16(g.galaxy_maxx - 70)
        val gh = u16(g.galaxy_maxy - 70)
        var v8 = 0
        var i = 0
        loop {
            while i < g.nebula_num
            set g.nebula_type@(i) = u8(rnd_0_nm1(NEBULA_TYPE_NUM, g))
            set g.nebula_x@(i) = u16(rnd_1_n(gw, g) + 4)
            set g.nebula_y@(i) = u16(rnd_1_n(gh, g) + 4)
            var found = 0
            var j = 0
            loop {
                while j < i
                if (g.nebula_type@(i) == g.nebula_type@(j)) || ((math.abs(g.nebula_x@(i) - g.nebula_x@(j)) < 0x3c) && (math.abs(g.nebula_y@(i) - g.nebula_y@(j)) < 0x3c)) {
                    set found = 1
                }
                set j = j + 1
            }
            if found == 0 {
                set i = i + 1
            }
            set v8 = v8 + 1
            if v8 > 200 {
                set g.nebula_num = u8(i)
                set i = 0
            }
        }
    }

    loop i in g.nebula_num {
        val type = g.nebula_type@(i)
        loop j in 4 {
            set g.nebula_x0@(i)@(j) = u16(tbl_nebula_data@(type)@0@(j) + g.nebula_x@(i))
            set g.nebula_x1@(i)@(j) = u16(tbl_nebula_data@(type)@2@(j) + g.nebula_x@(i))
            set g.nebula_y0@(i)@(j) = u16(tbl_nebula_data@(type)@1@(j) + g.nebula_y@(i))
            set g.nebula_y1@(i)@(j) = u16(tbl_nebula_data@(type)@3@(j) + g.nebula_y@(i))
        }
    }

    game_generate_planets(g)
}

func game_generate_planet_names (g) {
    pin in_use = BOOLVEC_DECLARE(PLANETS_MAX)
    BOOLVEC_CLEAR(in_use, PLANETS_MAX)
    loop i in g.galaxy_stars {
        var j
        loop {
            set j = rnd_0_nm1(PLANETS_MAX, g)
            while BOOLVEC_IS1(in_use, j)
        }
        BOOLVEC_SET1(in_use, j)
        lib_strcpy(g.planet@(i).name, game_str_tbl_planet_names@(j), PLANET_NAME_LEN)
    }
    lib_strcpy(g.planet@(g.evn.planet_orion_i).name, game_str_planet_name_orion, PLANET_NAME_LEN)
}

func game_generate_race_banner (g) {
    pin race_tbl = [7, 1, 5, 0, 3, 9, 4, 6, 2, 8]
    pin in_use = BOOLVEC_DECLARE(BANNER_NUM)
    var loops = 0
    ;; The `for` of C with `--i` (try again), as a `loop` with `i`.
    var i = 0
    loop {
        while i < g.players
        var race = g.eto@(i).race
        if race == RACE_RANDOM {
            var used = false
            set race = race_tbl@(rnd_0_nm1(RACE_NUM, g))
            loop j in i {
                if g.eto@(j).race == race {
                    set used = true
                    set i = i - 1
                    break
                }
            }
            if !used {
                set g.eto@(i).race = race
            }
        }
        set i = i + 1
    }
    set loops = 0
    BOOLVEC_CLEAR(in_use, BANNER_NUM)
    set i = 0
    loop {
        while i < g.players
        var banner = g.eto@(i).banner
        if banner != BANNER_RANDOM {
            BOOLVEC_SET1(in_use, banner)
        } else {
            set banner = rnd_0_nm1(BANNER_NUM, g)
            if BOOLVEC_IS0(in_use, banner) {
                BOOLVEC_SET1(in_use, banner)
                set g.eto@(i).banner = banner
            } else {
                set i = i - 1  ;; try again
                set loops = u16(loops + 1)
                if loops == 100 {
                    loop b in BANNER_NUM {
                        if BOOLVEC_IS0(in_use, b) {
                            BOOLVEC_SET1(in_use, b)
                            ;; NOTE: `i` was decreased above, as in C.
                            set g.eto@(i).banner = b
                            break
                        }
                    }
                    set loops = 0
                }
            }
        }
        set i = i + 1
    }
    loop k in g.players {
        if IS_AI(g, k) {
            val r = g.eto@(k).race
            set g.eto@(k).trait2 = game_num.tbl_trait2@(r)@(rnd_0_nm1(TRAIT2_TBL_NUM, g))
        }
    }
    loop k in g.players {
        val r = g.eto@(k).race
        set g.eto@(k).trait1 = game_num.tbl_trait1@(r)@(rnd_0_nm1(TRAIT1_TBL_NUM, g))
    }
}

;; NOTE: Bottleneck for SMALL galaxy and 6 PLAYERS
func game_generate_home_improved_do_i (g, opts, tblhome, i) {
    val mindist = 80
    pin ok_home_i = carray(PLANETS_MAX)     ;; uint8_t[]
    var ok_home_count = 0                   ;; uint16_t
    val safe_mindist = if (g.galaxy_size > GALAXY_SIZE_SMALL) || (g.players < 6) => mindist => (mindist - 10)
    loop pi in g.galaxy_stars {
        val x = g.planet@(pi).x
        val y = g.planet@(pi).y
        do {
            var next = false
            val num_checks = opts.homeworlds.num_dist_checks
            loop j in i {
                val p = g.planet@(tblhome@(j))
                if tblhome@(j) == pi {
                    set next = true
                    break
                }
                if (j < num_checks) && (util_math_dist_fast(x, y, p.x, p.y) < safe_mindist) {
                    set next = true
                    break
                }
            }
            if next {
                skip
            }
        }
        if (i < opts.homeworlds.num_ok_planet_checks) && ((i < 5) || (g.galaxy_size > GALAXY_SIZE_SMALL)) {
            var next = true
            loop j in g.galaxy_stars {
                val p = g.planet@(j)
                if (p.type >= PLANET_TYPE_MINIMAL) && (j != g.evn.planet_orion_i) && (j != pi) {
                    if util_math_dist_fast(x, y, p.x, p.y) <= 29 {
                        set next = false
                        break
                    }
                }
            }
            if next {
                skip
            }
        }
        if pi == g.evn.planet_orion_i {
            skip
        }
        set ok_home_i@(ok_home_count) = pi
        set ok_home_count = ok_home_count + 1
    }
    loop {
        while ok_home_count > 0
        val k = rnd_0_nm1(ok_home_count, g)
        set tblhome@(i) = ok_home_i@(k)
        set ok_home_count = ok_home_count - 1
        set ok_home_i@(k) = ok_home_i@(ok_home_count)
        if (i + 1) >= g.players {
            return true
        }
        if (i < (PLAYER_NUM - 1)) && game_generate_home_improved_do_i(g, opts, tblhome, i + 1) {
            return true
        }
    }
    false
}

func game_generate_home_improved_do (g, opts, tblhome) {
    pin homes = carray(PLAYER_NUM, PLANET_NONE)     ;; uint8_t[]
    game_generate_race_banner(g)
    val result = game_generate_home_improved_do_i(g, opts, homes, PLAYER_0)
    loop i in PLAYER_NUM {
        set tblhome@(i) = homes@(i)
    }
    result
}

func game_generate_home_do (g, tblhome) {
    var flag_all_ok = false
    var loops = 0
    game_generate_race_banner(g)
    loop {
        while (!flag_all_ok) && (loops < 200)
        set flag_all_ok = true
        loop i in g.players {
            var pi  ;; uint16_t
            var flag_again2 = true
            loop {
                while flag_again2
                ifs {
                    g.galaxy_stars > 24 => {
                        set pi = u16(rnd_1_n(g.galaxy_w - 2, g) + (rnd_1_n(g.galaxy_h - 2, g) * g.galaxy_w))
                    }
                    g.players > 3 => {
                        set pi = rnd_0_nm1(g.galaxy_stars, g)
                    }
                    else => {
                        set pi = u16(rnd_1_n(g.galaxy_w - 2, g) + (rnd_1_n(g.galaxy_h - 2, g) * g.galaxy_w))
                    }
                }
                set flag_again2 = false
                loop j in i {
                    if tblhome@(j) == pi {
                        set flag_again2 = true
                    }
                }
                if pi == g.evn.planet_orion_i {
                    set flag_again2 = true
                }
            }
            set tblhome@(i) = pi
        }
        do {
            var mindist = 10000     ;; uint16_t
            loop i in math.min(g.players, 2) {
                loop j in g.players {
                    if i == j {
                        skip
                    }
                    val dist = u16(util_math_dist_fast(g.planet@(tblhome@(i)).x, g.planet@(tblhome@(i)).y, g.planet@(tblhome@(j)).x, g.planet@(tblhome@(j)).y))
                    set mindist = SETMIN(mindist, dist)
                }
            }
            if mindist < 80 {
                ;; homeworlds too close
                set flag_all_ok = false    ;; could break out here
            }
            loop i in math.min(g.players, 2) {
                set mindist = 10000
                loop j in g.galaxy_stars {
                    val p = g.planet@(j)
                    if (p.type >= PLANET_TYPE_MINIMAL) && (j != g.evn.planet_orion_i) && (j != tblhome@(i)) {
                        val dist = u16(util_math_dist_fast(g.planet@(tblhome@(i)).x, g.planet@(tblhome@(i)).y, p.x, p.y))
                        set mindist = SETMIN(mindist, dist)
                    }
                }
                if mindist > 29 {
                    ;; ok planet too far away
                    set flag_all_ok = false    ;; could break out here
                }
            }
            loop i in math.min(g.players, 2) {
                set mindist = 10000
                loop j in g.galaxy_stars {
                    val p = g.planet@(j)
                    if (j != g.evn.planet_orion_i) && (j != tblhome@(i)) {
                        val dist = u16(util_math_dist_fast(g.planet@(tblhome@(i)).x, g.planet@(tblhome@(i)).y, p.x, p.y))
                        set mindist = SETMIN(mindist, dist)
                    }
                }
                if mindist > 29 {
                    ;; regular planet too far away
                    set flag_all_ok = false    ;; could break out here
                }
            }
        }
        set loops = loops + 1
    }
    ;; (an `#if 0` of C is left out: in MOO1 it is ineffective)
    flag_all_ok
}

func game_generate_home_etc (g, opts) {
    pin tblhome = carray(PLAYER_NUM)    ;; uint16_t[]
    var flag_all_ok
    loop {
        game_generate_galaxy(g, opts)
        game_generate_planet_names(g)
        if opts.improved_galaxy_generator {
            set flag_all_ok = game_generate_home_improved_do(g, opts, tblhome)
        } else {
            set flag_all_ok = game_generate_home_do(g, tblhome)
        }
        until flag_all_ok
    }
    loop i in g.players {
        val homei = tblhome@(i)
        set g.evn.home@(i) = u8(homei)
        set g.planet_focus_i@(i) = u8(homei)
        val p = g.planet@(homei)
        set p.owner = i
        set p.claim = i
        set p.type = PLANET_TYPE_TERRAN
        set p.star_type = STAR_TYPE_YELLOW
        if (opts.homeworlds.max_pop < 50) || (opts.homeworlds.max_pop > 120) {
            set opts.homeworlds.max_pop = 100
        }
        set p.max_pop2 = i16(opts.homeworlds.max_pop)
        set p.max_pop3 = i16(opts.homeworlds.max_pop)
        set p.max_pop1 = i16(opts.homeworlds.max_pop)
        set p.infogfx = u8(tbl_planet_type_infogfx@(p.type)@(rnd_0_nm1(6, g)) - 1)
        set p.growth = PLANET_GROWTH_NORMAL
        if (opts.homeworlds.special < PLANET_SPECIAL_ULTRA_POOR) || (opts.homeworlds.special >= PLANET_SPECIAL_NUM) {
            set opts.homeworlds.special = PLANET_SPECIAL_NORMAL
        }
        set p.special = opts.homeworlds.special
        BOOLVEC_SET1(p.explored, i)
        BOOLVEC_SET1(p.within_srange, i)
        set p.within_frange@(i) = 1

        match g.difficulty {
            \{ (it == DIFFICULTY_SIMPLE) || (it == DIFFICULTY_EASY) || (it == DIFFICULTY_AVERAGE) } => {
                set p.pop = 50
                set p.factories = 30
                set p.total_prod = 55
            }
            \{ (it == DIFFICULTY_HARD) || (it == DIFFICULTY_IMPOSSIBLE) } => {
                set p.pop = 40
                set p.factories = 30
                set p.total_prod = 50
            }
            else => {}
        }
        set p.pop_prev = p.pop
        game_new_generate_home_name(g.eto@(i).race, p.name, PLANET_NAME_LEN)
    }
    loop j in g.galaxy_stars {
        val owner = g.planet@(j).owner
        loop i in g.players {
            set g.seen@(i)@(j).owner = if owner == i => i => PLAYER_NONE
        }
        ;; seen_pop.._factories cleared here
    }
    ;; (the options are uint32_t: they are never below 0)
    if (opts.homeworlds.num_scouts < 0) || (opts.homeworlds.num_scouts > 5) {
        set opts.homeworlds.num_scouts = 2
    }
    set startfleet_ships@0 = u16(opts.homeworlds.num_scouts)
    if (opts.homeworlds.num_fighters < 0) || (opts.homeworlds.num_fighters > 10) {
        set opts.homeworlds.num_fighters = 0
    }
    set startfleet_ships@1 = u16(opts.homeworlds.num_fighters)
    if (opts.homeworlds.num_colony_ships < 0) || (opts.homeworlds.num_colony_ships > 2) {
        set opts.homeworlds.num_colony_ships = 1
    }
    set startfleet_ships@4 = u16(opts.homeworlds.num_colony_ships)
    loop i in g.players {
        val e = g.eto@(i)
        set e.have_colony_for = PLANET_TYPE_MINIMAL
        set e.factory_adj_cost = 10
        set e.factory_cost = 10
        set e.have_engine = 1
        set e.colonist_oper_factories = 2
        loop field in TECH_FIELD_NUM {
            set e.tech.percent@(field) = 1
        }
        do {
            val srd = g.srd@(i)
            set e.shipdesigns_num = u8(startship_num)
            loop j in startship_num {
                val sd = srd.design@(j)
                shipdesign_copy(sd, tbl_startship@(j))
                lib_strcpy(sd.name, game_str_tbl_stship_names@(j), SHIP_NAME_LEN)
                set sd.look = u8(sd.look + (e.banner * SHIP_LOOK_PER_BANNER))
            }
            shipdesign_copy(g.current_design@(i), srd.design@0)
            loop j in NUM_SHIPDESIGNS {
                val n = startfleet_ships@(j)
                set e.orbit@(tblhome@(i)).ships@(j) = n
                set srd.shipcount@(j) = n
                if (j == 4) && opts.homeworlds.armed_colony_ships && (srd.design@4.wpnt@0 == 0) {
                    set srd.design@4.wpnn@0 = 1
                    set srd.design@4.wpnt@0 = 2
                }
            }
        }
        set e.fuel_range = 3
        if IS_AI(g, i) {
            game_ai.new_game_init(g, i, u8(tblhome@(i)))
        } else {
            set e.tech.slider@(TECH_FIELD_COMPUTER) = 20
            set e.tech.slider@(TECH_FIELD_CONSTRUCTION) = 10
            set e.tech.slider@(TECH_FIELD_FORCE_FIELD) = 15
            set e.tech.slider@(TECH_FIELD_PLANETOLOGY) = 15
            set e.tech.slider@(TECH_FIELD_PROPULSION) = 20
            set e.tech.slider@(TECH_FIELD_WEAPON) = 20
        }
    }
}

func game_generate_relation_etc (g) {
    loop i in g.players {
        val e = g.eto@(i)
        loop j in g.players {
            val v = u16(tbl_orion_race_relation@(e.race)@(g.eto@(j).race) * 12)
            set e.relation1@(j) = i16(v)
            set e.relation2@(j) = i16(v)
            loop k in TECH_FIELD_NUM {
                set e.spyreportfield@(j)@(k) = 1
            }
        }
    }
}

func game_generate_research_check_field (rl, field, rr) {
    var rmask = 0
    var got = 0
    loop i in (1, 50) {
        set rmask = rmask | rr@(i)
    }
    set rmask = rmask & u8(~(GAME_NG_TECH_NEVER | GAME_NG_TECH_ALWAYS))
    if rmask == 0 {
        return true
    }
    loop tier in TECH_TIER_NUM {
        loop l in 3 {
            val v = rl@(field)@(tier)@(l)
            set got = got | rr@(v)
        }
    }
    (rmask & got) == rmask
}

func game_generate_research (g, rflag) {
    var flag_got_essentials = false
    loop {
        while !flag_got_essentials
        set flag_got_essentials = true
        loop pli in g.players {
            val race = g.eto@(pli).race
            val rl = g.srd@(pli).researchlist
            val rmax = if g.eto@(pli).race == RACE_PSILON => 3 => 2
            loop field in TECH_FIELD_NUM {
                val rr = game_num.ng_tech@(race)@(field)
                loop tier in TECH_TIER_NUM {
                    var num_taken = 0
                    loop l in 3 {
                        set rl@(field)@(tier)@(l) = 0
                    }
                    loop {
                        while num_taken == 0
                        do {
                            var ti = (tier * 5) + 4
                            loop {
                                while (ti >= (tier * 5)) && (num_taken < 3)
                                if (rr@(ti + 1) & GAME_NG_TECH_ALWAYS) != 0 {
                                    set rl@(field)@(tier)@(num_taken) = ti + 1
                                    set num_taken = num_taken + 1
                                }
                                set ti = ti - 1
                            }
                        }
                        do {
                            var ti = (tier * 5) + 4
                            loop {
                                while ti >= (tier * 5)
                                var flag_skip = false
                                if ((rr@(ti + 1) & (GAME_NG_TECH_NEVER | GAME_NG_TECH_ALWAYS)) != 0) || (rflag@((field * 50) + ti) == 0) {
                                    set flag_skip = true
                                }
                                if (!flag_skip) && (rnd_1_n(4, g) <= rmax) && (num_taken < 3) {
                                    set rl@(field)@(tier)@(num_taken) = ti + 1
                                    set num_taken = num_taken + 1
                                }
                                set ti = ti - 1
                            }
                        }
                        loop loops in 3 {
                            loop l in 2 {
                                val v1 = rl@(field)@(tier)@(l + 1)
                                if v1 != 0 {
                                    val v0 = rl@(field)@(tier)@(l)
                                    if v0 > v1 {
                                        set rl@(field)@(tier)@(l) = v1
                                        set rl@(field)@(tier)@(l + 1) = v0
                                    }
                                }
                            }
                        }
                    }
                }
                if !game_generate_research_check_field(rl, field, rr) {
                    set flag_got_essentials = false
                }
            }
        }
    }

    loop pli in g.players {
        val e = g.eto@(pli)
        val srd = g.srd@(pli)
        set e.base_shield = SHIP_SHIELD_CLASS_I
        set e.base_comp = SHIP_COMP_MARK_I
        set e.base_weapon = WEAPON_NUCLEAR_MISSILE_2
        loop field in TECH_FIELD_NUM {
            set e.tech.completed@(field) = 1
            set srd.researchcompleted@(field)@0 = 1
        }
    }

    game_ai.new_game_tech(g)
}

func game_generate_misc (g) {
    set g.year = 1
    set g.evn.year = 40
    loop pli in g.players {
        val e = g.eto@(pli)
        loop pli2 in g.players {
            set e.attack_bounty@(pli2) = PLAYER_NONE
            set e.bounty_collect@(pli2) = PLAYER_NONE
        }
    }
}

;; (game_misc.atm and game_tech.atm, which the programs include.)
func game_generate_load (g) {
    ;; MOO1 does these when loading a game; moved here to maintain slider state after save/load
    game_update_production(g)
    game_update_tech_util(g)
    loop pli in g.players {
        game_update_eco_on_waste(g, pli, false)
        game_update_seen_by_orbit(g, pli)
    }
    game_update_within_range(g)
    game_update_visibility(g)
    game_update_have_reserve_fuel(g)
}

func game_generate_emperor_names (g, namedata, offs) {
    loop pli in g.players {
        if g.emperor_names@(pli)@0 != 0 {
            skip
        }
        val base = u16(g.eto@(pli).race * EMPEROR_NAMES_PER_RACE)
        loop loops in 200 {
            pin buf = carray(EMPEROR_NAME_LBX_LEN)
            val str = cstr(namedata, offs + 4 + ((base + rnd_0_nm1(EMPEROR_NAMES_PER_RACE, g)) * EMPEROR_NAME_LBX_LEN))
            lib_strcpy(buf, str, EMPEROR_NAME_LBX_LEN)
            util_trim_whitespace(buf, EMPEROR_NAME_LBX_LEN)  ;; fix "Zygot  "
            var flag_name_used = false
            loop i in g.players {
                if strcasecmp(buf, g.emperor_names@(i)) == 0 {
                    set flag_name_used = true
                    break
                }
            }
            if !flag_name_used {
                lib_strcpy(g.emperor_names@(pli), cstr(buf), EMPEROR_NAME_LEN)
                break
            }
        }
    }
}

;; ---------------------------------------------------------------------------

func game_new (g, gaux, opt) {
    pin researchflag = carray(6 * 50)   ;; uint8_t[]
    loop k,v in game_s() {
        set g@(k) = v
    }
    set g.gaux = gaux
    if opt.galaxy_seed == 0 {
        set g.galaxy_seed = rnd_get_new_seed()
    } else {
        set g.galaxy_seed = u32(opt.galaxy_seed)
    }
    set g.seed = g.galaxy_seed
    set g.ai_id = u8(opt.ai_id)
    set game_ai = game_ais@(g.ai_id)
    set g.players = u8(opt.players)
    set g.difficulty = opt.difficulty
    set g.galaxy_size = opt.galaxy_size
    loop i in g.players {
        set g.eto@(i).race = opt.pdata@(i).race
        set g.eto@(i).banner = opt.pdata@(i).banner
        if opt.pdata@(i).is_ai {
            BOOLVEC_SET1(g.is_ai, i)
        }
    }
    do {
        val rawdata = gaux.research.d0
        loop f in 6 {
            loop t in 50 {
                set researchflag@((f * 50) + t) = if rawdata@(((f * 50) + t) * 6) != 0xff => 1 => 0
            }
            set researchflag@(f * 50) = 0
        }
    }
    set researchflag@((TECH_FIELD_WEAPON * 50) + (TECH_WEAP_DEATH_RAY - 1)) = 0
    do {
        var vr = 0
        var vb = 0
        var m = 1
        var va = 0
        val vo = g.difficulty + (g.galaxy_size * 10) + (g.players * 100)
        loop i in g.players {
            set vr = vr + (((g.eto@(i).race + 1) % (RACE_NUM + 1)) * m)
            set m = m * 0x10
        }
        set m = 1
        loop i in g.players {
            set vb = vb + (((g.eto@(i).banner + 1) % (BANNER_NUM + 1)) * m)
            if IS_HUMAN(g, i) {
                set va = va + m
            }
            set m = m * 10
        }
        log_message("Game: new game -new %u:0x%x:%u:0x%x:%u -nga %u\n", u32(vo), vr, u32(vb), g.galaxy_seed, u32(va), u32(g.ai_id))
    }
    game_generate_home_etc(g, opt)
    game_generate_relation_etc(g)
    game_generate_research(g, researchflag)
    game_generate_misc(g)
    if !game_num.update_on_load {
        game_generate_load(g)
    }
    loop i in g.players {
        do {
            val b = g.emperor_names@(i)
            lib_strcpy(b, opt.pdata@(i).playername, EMPEROR_NAME_LEN)
            util_trim_whitespace(b, EMPEROR_NAME_LEN)
        }
        val str = opt.pdata@(i).homename
        if str != "" {
            val b = g.planet@(g.planet_focus_i@(i)).name
            lib_strcpy(b, str, PLANET_NAME_LEN)
            util_trim_whitespace(b, PLANET_NAME_LEN)
        }
    }
    do {
        val namedata, offs = lbxfile_item_get(LBXFILE_NAMES, 0)
        game_generate_emperor_names(g, namedata, offs)
        lbxfile_item_release(LBXFILE_NAMES, namedata, offs)
    }
    set g.active_player = PLAYER_0
    0
}

func game_new_tutor (g, gaux) {
    pin opt = game_new_options_s()
    set opt.galaxy_size = GALAXY_SIZE_MEDIUM
    set opt.players = 4
    set opt.difficulty = DIFFICULTY_SIMPLE
    set opt.pdata@(PLAYER_0).race = RACE_KLACKON
    set opt.pdata@(PLAYER_0).banner = BANNER_WHITE
    set opt.pdata@(PLAYER_0).playername = "Mr Tutor"
    set opt.pdata@(PLAYER_0).homename = "SOL"
    set opt.galaxy_seed = 0xfda3f
    game_new(g, gaux, opt)
}

;; In C into `buf`; here the string.
func game_new_generate_emperor_name (race, bufsize) {
    if race == RACE_RANDOM {
        game_str_rndempname
    } else {
        pin seed = [seed = rnd_get_new_seed()]
        val namedata, offs = lbxfile_item_get(LBXFILE_NAMES, 0)
        val base = race * EMPEROR_NAMES_PER_RACE
        val str = cstr(namedata, offs + 4 + ((base + rnd_0_nm1(EMPEROR_NAMES_PER_RACE, seed)) * EMPEROR_NAME_LBX_LEN))
        ;; TODO check if in use for the case of forced same races
        pin buf = carray(bufsize)
        lib_strcpy(buf, str, bufsize)
        util_trim_whitespace(buf, bufsize)   ;; fix "Zygot  "
        lbxfile_item_release(LBXFILE_NAMES, namedata, offs)
        cstr(buf)
    }
}

func game_new_generate_home_name (race, buf, bufsize) {
    ;; TODO check if in use for the case of forced same races
    lib_strcpy(buf, game_str_tbl_home_names@(race), bufsize)
}

func game_new_generate_other_emperor_name (g, player) {
    val namedata, offs = lbxfile_item_get(LBXFILE_NAMES, 0)
    val base = g.eto@(player).race * EMPEROR_NAMES_PER_RACE
    loop loops in 500 {
        pin buf = carray(EMPEROR_NAME_LBX_LEN + 1)
        val str = cstr(namedata, offs + 4 + ((base + rnd_0_nm1(EMPEROR_NAMES_PER_RACE, g)) * EMPEROR_NAME_LBX_LEN))
        lib_strcpy(buf, str, EMPEROR_NAME_LBX_LEN + 1)
        util_trim_whitespace(buf, EMPEROR_NAME_LBX_LEN + 1)  ;; fix "Zygot  "
        var flag_in_use = true
        loop i in g.players {
            if strcasecmp(g.emperor_names@(i), buf) == 0 {
                set flag_in_use = false
                break
            }
        }
        if !flag_in_use {
            lib_strcpy(g.emperor_names@(player), cstr(buf), EMPEROR_NAME_LEN)
            break
        }
    }
    lbxfile_item_release(LBXFILE_NAMES, namedata, offs)
}
