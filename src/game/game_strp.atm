;; END game_str_id_tbl

;; ---------------------------------------------------------------------------

;; `find_match(strid, i)`: the item, where C gives `&s->ptr[i]`.
func game_str_find_match (strid, i) {
    loop _, s in game_str_id_tbl {
        if s.strid == strid {
            if i < s.size {
                return s
            } else {
                log_error("STR: strid '%s' index %i >= size %i\n", strid, i, s.size)
                return nil
            }
        }
    }
    log_error("STR: unknown strid '%s'\n", strid)
    nil
}

;; ---------------------------------------------------------------------------

;; C keeps the copies of the strings in `patch_tbl` to free them in
;; `game_str_shutdown` (and grows it by `patch_num + 1` bytes, not
;; pointers); here the strings are values.
func game_str_patch (strid, patchstr, i) {
    val s = game_str_find_match(strid, i)
    if s != nil {
        s.put(i, patchstr)
        return true
    } else {
        return false
    }
}

func game_str_dump () {
    log_message("# dump of all game strings\n")
    loop _, s in game_str_id_tbl {
        loop i in s.size {
            log_message("3,%s,%i,\"%s\"\n", s.strid, i, s.get(i))
        }
    }
}

func game_str_shutdown () {
    nil
}
