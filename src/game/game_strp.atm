;; Port of c/src/game/game_strp.c: the strings of the game that a PBX file
;; may replace (`3,strid,i,"text"`), and their dump (-dumpstr).
;; In C an item points to the `const char *`; here it has `get(i)` and
;; `put(i, s)`. The table is generated from the C by tools/game_strp.py.
;; `find_match` of C is `game_str_find_match` here (Atmos has no `static`).

include "../log.atm"
include "game_str.atm"
include "game_str_shipnames.atm"

func strtbl_s (strid, size, get, put) {
    [ strid = strid, size = size, get = get, put = put ]
}

;; BEGIN game_str_id_tbl (generated by tools/game_strp.py)
pin game_str_id_tbl = [
    strtbl_s("mm_continue", 1, \{ game_str_mm_continue }, \(i, s) { set game_str_mm_continue = s }),
