func get_best_armor (g, owner) {
    val e = g.eto@(owner)
    val srd = g.srd@(owner)
    var best = 0    ;; uint8_t
    ;; (i <= completed: one more than the techs completed, as C does)
    loop i in (0, e.tech.completed@(TECH_FIELD_CONSTRUCTION)) {
        match srd.researchcompleted@(TECH_FIELD_CONSTRUCTION)@(i) {
            TECH_CONS_DURALLOY_ARMOR => { set best = 1 }
            TECH_CONS_ZORTIUM_ARMOR => { set best = 2 }
            TECH_CONS_ANDRIUM_ARMOR => { set best = 3 }
            TECH_CONS_TRITANIUM_ARMOR => { set best = 4 }
            TECH_CONS_ADAMANTIUM_ARMOR => { set best = 5 }
            TECH_CONS_NEUTRONIUM_ARMOR => { set best = 6 }
            else => nil
        }
    }
    best
}

;; `COPY_MAX_SPECIAL`: the highest value of a field of the specials of a
;; design.
func copy_max_special (sd, key) {
    var smax = 0
    loop i in SPECIAL_SLOT_NUM {
        val v = tbl_shiptech_special@(sd.special@(i))@(key)
        set smax = SETMAX(smax, v)
    }
    smax
}

;; ---------------------------------------------------------------------------

func game_parsed_from_design (sp, sd, num) {
    lib_strcpy(sp.name, sd.name, SHIP_NAME_LEN)
    set sp.hull = sd.hull
    set sp.comp = sd.comp
    set sp.jammer = sd.jammer
    set sp.shield = sd.shield
    set sp.armor = sd.armor
    set sp.engine = sd.engine
    loop i in SPECIAL_SLOT_NUM {
        set sp.special@(i) = sd.special@(i)
    }
    set sp.pshield = 0
    loop i in WEAPON_SLOT_NUM {
        set sp.wpnt@(i) = sd.wpnt@(i)
        set sp.wpnn@(i) = sd.wpnn@(i)
    }
    set sp.hp = sd.hp
    set sp.repair = u8(copy_max_special(sd, "repair"))
    val extraman = u8(copy_max_special(sd, "extraman"))     ;; uint8_t
    set sp.man = u8(((sd.man + 3) // 2) + (extraman // 2))
    set sp.complevel = tbl_shiptech_comp@(sd.comp).level
    set sp.defense = u8(sd.man + tbl_shiptech_hull@(sd.hull).defense + extraman + 1)
    set sp.misdefense = u8(sp.defense + tbl_shiptech_jammer@(sd.jammer).level)
    set sp.absorb = tbl_shiptech_shield@(sd.shield).absorb
    set sp.misshield = u8(copy_max_special(sd, "misshield"))
    set sp.extrarange = u8(copy_max_special(sd, "extrarange"))
    set sp.num = u16(num)
    set sp.look = sd.look
    set sp.pulsar = u8(copy_max_special(sd, "pulsar"))
    set sp.stream = u8(copy_max_special(sd, "stream"))
    do {
        var m = 0   ;; uint16_t
        loop i in SPECIAL_SLOT_NUM {
            set m = m | tbl_shiptech_special@(sd.special@(i)).boolmask
        }
        set sp.sbmask = m
        if (m & (1 << SHIP_SPECIAL_BOOL_SCANNER)) != 0 {
            set sp.complevel = u8(sp.complevel + 1)
        }
    }
}

func game_parsed_from_planet (sp, g, p) {
    val e = g.eto@(p.owner)
    cstruct_copy(sp, shipparsed_t())
    lib_strcpy(sp.name, p.name, SHIP_NAME_LEN)
    set sp.comp = e.base_comp + 1
    set sp.complevel = sp.comp
    if e.race == RACE_MRRSHAN {
        set sp.complevel = u8(sp.complevel + 4)
    }
    set sp.shield = e.base_shield
    set sp.absorb = tbl_shiptech_shield@(e.base_shield).absorb
    set sp.hp = game_num_base_hp@(get_best_armor(g, p.owner))
    set sp.defense = 1
    set sp.misdefense = u8(game_get_best_jammer(g, p.owner, e.tech.percent@(TECH_FIELD_COMPUTER)) + 1)
    if p.missile_bases > 0 {
        var m = 1 << SHIP_SPECIAL_BOOL_SCANNER  ;; uint16_t
        set sp.num = p.missile_bases
        if e.have_sub_space_int {
            set m = m | (1 << SHIP_SPECIAL_BOOL_SUBSPACE)
        }
        set sp.sbmask = m
    }
    set sp.pulsar = e.antidote  ;; HACK
    set sp.look = p.infogfx
    set sp.pshield = p.shield
    set sp.wpnt@(0) = e.base_weapon
    set sp.wpnn@(0) = 3
    set sp.wpnt@(1) = game_get_base_weapon_2(g, p.owner, e.tech.percent@(TECH_FIELD_WEAPON), e.base_weapon)
    set sp.wpnn@(1) = 3
    if p.battlebg == 0 {
        set sp.pshield = 0
        set sp.absorb = 0
        set sp.shield = 0
    }
}
