func shipparsed_t () {
    [
        name       = carray(SHIP_NAME_LEN),     ;; char[]
        hull       = 0,     ;; ship_hull_t
        comp       = 0,     ;; ship_comp_t
        jammer     = 0,     ;; ship_jammer_t
        shield     = 0,     ;; ship_shield_t
        armor      = 0,     ;; ship_armor_t
        engine     = 0,     ;; ship_engine_t
        special    = carray(SPECIAL_SLOT_NUM),  ;; ship_special_t[]
        wpnt       = carray(WEAPON_SLOT_NUM),   ;; weapon_t[] (weapon type)
        wpnn       = carray(WEAPON_SLOT_NUM),   ;; uint8_t[] (weapon num)
        hp         = 0,     ;; uint16_t (hit points)
        man        = 0,     ;; uint8_t (maneuverability)
        complevel  = 0,     ;; uint8_t
        defense    = 0,     ;; uint8_t
        misdefense = 0,     ;; uint8_t
        absorb     = 0,     ;; uint8_t
        repair     = 0,     ;; uint8_t
        misshield  = 0,     ;; uint8_t
        pshield    = 0,     ;; uint8_t
        extrarange = 0,     ;; uint8_t
        num        = 0,     ;; shipcount_t
        look       = 0,     ;; uint8_t
        pulsar     = 0,     ;; uint8_t (also antidote for planets)
        stream     = 0,     ;; uint8_t
        sbmask     = 0,     ;; uint16_t
    ]
}

;; A `shipparsed_t` of an initializer of C: the fields given, the others 0.
func shipparsed_with (fields) {
    val sp = shipparsed_t()
    cstruct_copy(sp, fields)
    sp
}

