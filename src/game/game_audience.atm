;; Port of c/src/game/game_audience.c and game_audience.h.
;;
;; The `const char *` of `struct audience_s` are strings: `buf` is a string,
;; or the vector `diplo_msg`, or nil; `strtbl` holds strings, `false` for the
;; `NULL` that ends it; `condtbl` is a vector of booleans, or nil.

include "../boolvec.atm"
include "../comp.atm"
include "../ctypes.atm"
include "../lib.atm"
include "../log.atm"
include "../rnd.atm"
include "../ui.atm"
include "game.atm"
include "game_ai.atm"
include "game_aux.atm"
include "game_diplo.atm"
include "game_misc.atm"
include "game_num.atm"
include "game_spy.atm"
include "game_str.atm"
include "game_tech.atm"

val AUDIENCE_STR_MAX = 7
val AUDIENCE_BC_MAX = 5
val AUDIENCE_DIPLO_MSG_SIZE = 320
val AUDIENCE_STRTBL_BUFSIZE = 640
val AUDIENCE_BUF2_POS = 320
val AUDIENCE_CBUF_POS = 640

func audience_s () {
    [
        g             = nil,    ;; struct game_s *
        uictx         = nil,    ;; void *
        buf           = nil,    ;; const char *
        diplo_msg     = carray(AUDIENCE_DIPLO_MSG_SIZE),    ;; char[]
        ph            = 0,      ;; player_id_t
        pa            = 0,      ;; player_id_t
        pwar          = 0,      ;; player_id_t
        pstartwar     = 0,      ;; player_id_t
        mode          = 0,      ;; uint8_t (0, 1, 2, 6)
        dtype         = 0,      ;; uint8_t
        dtype_next    = 0,      ;; uint8_t
        gfxi          = 0,      ;; uint8_t (0..2)
        musi          = 0,      ;; uint8_t (0..2)
        num_bc        = 0,      ;; uint8_t (0..5)
        new_trade_bc  = 0,      ;; int
        tribute_bc    = 0,      ;; int16_t
        tribute_field = 0,      ;; tech_field_t
        tribute_tech  = 0,      ;; uint8_t
        strtbl_buf    = carray(AUDIENCE_STRTBL_BUFSIZE),    ;; char[]
        strtbl        = carray(AUDIENCE_STR_MAX, false),    ;; const char *[]
        condtbl       = nil,    ;; const bool *
        bctbl         = carray(AUDIENCE_BC_MAX),            ;; uint16_t[]
    ]
}

;; The bytes 2 and 1 of the messages (the colors of the text).
val AU_C2 = string.char(2)
val AU_C1 = string.char(1)

;; ---------------------------------------------------------------------------

func game_audience_clear_strtbl (au) {
    loop i in AUDIENCE_STR_MAX {
        set au.strtbl@(i) = false
    }
}

;; Prepare a menu with options for the player; condtbl indicates which options
;; are active. As a shortcut, if it is NULL, all options are active. The menu
;; can be presented to the player using the ui_audience_ask* functions.
func game_audience_choice (au, query, options, condtbl, num_entries) {
    set au.buf = query
    if num_entries >= AUDIENCE_STR_MAX {
        log_fatal_and_die("Too many strings in au->strtbl\n")
    }
    loop i in num_entries {
        set au.strtbl@(i) = options@(i)
    }
    set au.strtbl@(num_entries) = false
    set au.condtbl = condtbl
}

func game_audience_tech_choice (au, query, fields, techs, num_techs, forget_it_opt) {
    pin strbuild = strbuild_init(au.strtbl_buf, AUDIENCE_STRTBL_BUFSIZE)
    val num_entries = if forget_it_opt => (num_techs + 1) => num_techs
    pin tech_name = carray(64)  ;; char[]
    set au.buf = query
    if num_entries >= AUDIENCE_STR_MAX {
        log_fatal_and_die("Too many strings in au->strtbl\n")
    }
    var i = 0
    loop {
        while i < num_techs
        game_tech_get_name(au.g.gaux, fields@(i), techs@(i), tech_name, 64)
        strbuild_catf(strbuild, "%s %s", game_str_au_bull, cstr(tech_name))
        set au.strtbl@(i) = cstr(au.strtbl_buf, strbuild_finish(strbuild))
        set i = i + 1
    }
    if forget_it_opt {
        set au.strtbl@(i) = game_str_au_opts_agree@(1)  ;; "Forget It"
        set i = i + 1
    }
    set au.strtbl@(i) = false
    set au.condtbl = nil
}

func game_audience_prepare (au, ph, pa) {
    set au.buf = nil
    set au.ph = ph
    set au.pa = pa
    game_audience_clear_strtbl(au)
    set au.gfxi = 0
    set au.musi = 0
    set au.dtype_next = 0
}

func game_audience_start_human (au) {
    game_ai.aud_start_human(au)
}

func game_audience_str_append_offer (strbuild, g, field, tech, bc) {
    strbuild_append_char(strbuild, string.byte(" ", 0))
    if tech != 0 {
        pin tech_name = carray(64)  ;; char[]
        game_tech_get_name(g.gaux, field, tech, tech_name, 64)
        strbuild_catf(strbuild, "%s", cstr(tech_name))
        strbuild_catf(strbuild, " %s", game_str_au_tech)
    } else {
        if bc != 0 {
            strbuild_catf(strbuild, "%d %s", bc, game_str_bc)
        }
    }
}

func game_audience_append_tech (str, g, field, tech) {
    pin tech_name = carray(64)  ;; char[]
    game_tech_get_name(g.gaux, field, tech, tech_name, 64)
    strbuild_catf(str, "%s", cstr(tech_name))
}

;; `tolower` of the C locale, on a byte.
func au_tolower (c) {
    if (c >= 65) && (c <= 90) => (c + 32) => c
}

func audience_build_diplo_msg (au, framed) {
    val g = au.g
    val dtype = au.dtype
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    pin strbuild = strbuild_init(au.diplo_msg, AUDIENCE_DIPLO_MSG_SIZE)

    ;; Randomly select a varation of the message type.
    var v = rnd_0_nm1(g.gaux.diplomat.d0@(dtype), g)
    if g.players == 2 {
        set v = v - 1
        set v = SETMAX(v, 0)
    }
    set g.evn.diplo_msg_subtype = i8(v)
    val msg = g.gaux.diplomat.msg
    val m0 = DIPLOMAT_MSG_PTR(g.gaux, v, dtype)

    ;; Fill in placeholders in the message.
    var i = 0
    loop {
        while (i < DIPLOMAT_MSG_LEN) && (msg@(m0 + i) != 0)
        val c = msg@(m0 + i)
        if (c & 0x80) != 0 {
            var s = nil
            match c & 0x7f {
                0 => { set s = game_str_tbl_race@(eh.race) }   ;; Player race
                1 => { set s = game_str_tbl_race@(ea.race) }   ;; AI race
                0x16 => {   ;; "a" or "an"
                    val c0 = au_tolower(string.byte(game_str_tbl_race@(ea.race), 0))
                    set s = if (c0 == 97) || (c0 == 101) || (c0 == 105) || (c0 == 111) || (c0 == 117) => "n" => ""
                }
                2 => { set s = if eh.diplo_p2@(pa) == 0 => game_str_au_facts => game_str_au_bases }     ;; "factories" or "bases" (sabotage)
                0xb => {    ;; Current treaty
                    ifs {
                        eh.treaty@(pa) == TREATY_ALLIANCE => { set s = game_str_au_allian }
                        eh.treaty@(pa) == TREATY_NONAGGRESSION => { set s = game_str_au_nonagg }
                        eh.trade_bc@(pa) != 0 => { set s = game_str_au_tradea }
                        else => { set s = game_str_au_treaty }
                    }
                }
                0x17 => {   ;; Broken treaty (by AI)
                    ifs {
                        ea.broken_treaty@(ph) == TREATY_ALLIANCE => { set s = game_str_au_allian }
                        ea.broken_treaty@(ph) == TREATY_NONAGGRESSION => { set s = game_str_au_nonagg }
                        ea.broken_treaty@(ph) == TREATY_NONE => { set s = game_str_au_tradea }
                        else => { set s = game_str_au_treaty }
                    }
                }
                3 => { set s = cstr(g.emperor_names@(ph)) }    ;; Player name
                9 => { set s = cstr(g.emperor_names@(pa)) }    ;; AI leader name
                4 => {
                    val field = game_str_tbl_te_field@(eh.diplo_p2@(pa))
                    loop k in #field {
                        strbuild_append_char(strbuild, au_tolower(string.byte(field, k)))
                    }
                    ;; WASBUG MOO1 printed "force Field"
                }
                5 => { set s = cstr(g.planet@(eh.diplo_p1@(pa)).name) }
                6 => { set s = game_str_tbl_race@(g.eto@(eh.diplo_p2@(pa)).race) }
                8 => { set s = game_str_tbl_race@(g.eto@(eh.attack_bounty@(pa)).race) }
                0xc => { set s = game_str_tbl_race@(g.eto@(eh.au_ask_break_treaty@(pa)).race) }
                0xf => strbuild_catf(strbuild, "%i", g.year + YEAR_BASE)
                0x13 => strbuild_catf(strbuild, "%i", au.tribute_bc)
                7 => strbuild_catf(strbuild, "%d", eh.au_want_trade@(pa))
                0x15 => strbuild_catf(strbuild, "%d", eh.trade_bc@(pa))
                0xa => strbuild_catf(strbuild, AU_C2 ++ " %s" ++ AU_C1, game_str_au_amreca)
                0x11 => { set s = game_str_tbl_race@(g.eto@(au.pstartwar).race) }
                0x12 => { set s = game_str_tbl_race@(g.eto@(au.pwar).race) }
                0xd => {
                    if eh.attack_gift_bc@(pa) != 0 {
                        strbuild_catf(strbuild, "%i %s.", eh.attack_gift_bc@(pa), game_str_bc)
                    } else {
                        game_audience_append_tech(strbuild, g, eh.attack_gift_field@(pa), eh.attack_gift_tech@(pa))
                        strbuild_catf(strbuild, " %s.", game_str_au_tech)
                    }
                }
                0xe => {
                    game_audience_append_tech(strbuild, g, eh.au_want_field@(pa), eh.au_want_tech@(pa))
                    strbuild_catf(strbuild, " %s.", game_str_au_tech)
                }
                0x10 => game_audience_append_tech(strbuild, g, au.tribute_field, au.tribute_tech)
                0x14 => {
                    game_audience_append_tech(strbuild, g, au.tribute_field, au.tribute_tech)
                    strbuild_catf(strbuild, " %s.", game_str_au_tech)
                }
                else => strbuild_append_char(strbuild, c)
            }
            if s != nil {
                strbuild_catf(strbuild, "%s", s)
            }
        } else {
            strbuild_append_char(strbuild, c)
        }
        set i = i + 1
    }
    if framed {
        strbuild_catf(strbuild, AU_C2 ++ " %s" ++ AU_C1, game_str_au_framed)
    }
    set au.gfxi = DIPLOMAT_MSG_GFX(g.gaux, m0)
    set au.musi = DIPLOMAT_MSG_MUS(g.gaux, m0)
}

;; Build the diplomat message if necessary and set it to be displayed.
func game_audience_get_diplo_msg (au) {
    val g = au.g
    val dtype = au.dtype
    var framed = false
    if (dtype == 5) || (dtype == 7) || (dtype == 35) || (dtype == 37) || (dtype == 43) || (dtype == 45) || (dtype == 51) || (dtype == 53) {
        set framed = true
        set au.dtype = au.dtype - 1
    }
    if g.evn.diplo_msg_subtype == -1 {
        audience_build_diplo_msg(au, framed)    ;; Sets diplo_msg_subtype.
    }
    set au.buf = au.diplo_msg
}

func game_audience_ai_offers_bounty (au) {
    ui_audience_show2(au)
}

func game_audience_ai_pays_bounty (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    ui_audience_show2(au)
    if game_num_aud_bounty_give {   ;; WASBUG MOO1 never gives the bounty
        set eh.reserve_bc = u32(eh.reserve_bc + eh.attack_gift_bc@(pa))
        if eh.attack_gift_tech@(pa) != 0 {
            game_tech_get_new(g, ph, eh.attack_gift_field@(pa), eh.attack_gift_tech@(pa), TECHSOURCE_TRADE, pa, PLAYER_NONE, false)
        }
    }
}

func game_audience_set_dtype (au, dtype, a2) {
    val g = au.g
    set au.dtype = u8(game_ai.aud_get_dtype(au, dtype, a2))
    set g.evn.diplo_msg_subtype = -1
    game_audience_get_diplo_msg(au)
    ui_audience_show3(au)
}

func game_audience_ai_offers_tech_trade (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val num_techs = SETMIN(eh.au_tech_trade_num@(pa), 4)
    var selected = -1   ;; int16_t
    val default_selected = num_techs + 1
    ui_audience_show2(au)
    game_audience_tech_choice(au, game_str_au_inxchng, eh.au_tech_trade_field@(pa), eh.au_tech_trade_tech@(pa), num_techs, true)
    set selected = ui_audience_ask2a(au)
    set selected = if selected != -1 => selected => default_selected
    game_tech_get_new(g, ph, eh.au_tech_trade_field@(pa)@(selected), eh.au_tech_trade_tech@(pa)@(selected), TECHSOURCE_TRADE, pa, PLAYER_NONE, false)
    ;; WASBUG? 1oom v1.0 did not give a tech to the AI. Not sure if this bug
    ;; was present in MOO1 or introduced in 1oom.
    game_tech_get_new(g, pa, eh.au_want_field@(pa), eh.au_want_tech@(pa), TECHSOURCE_TRADE, pa, PLAYER_NONE, false)
}

func game_audience_ai_breaks_alliance (au) {
    game_diplo_break_treaty(au.g, au.pa, au.ph)
    set au.mode = 6
    game_audience_set_dtype(au, 77, 3)
}

func game_audience_ai_offers_treaty (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val dtype = au.dtype
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var selected = -1   ;; int16_t
    game_audience_clear_strtbl(au)
    if dtype == 27 {
        game_audience_choice(au, au.diplo_msg, game_str_au_opts_agree, nil, 2)
    } else {
        game_audience_choice(au, au.diplo_msg, game_str_au_opts_accept, nil, 2)
    }
    set selected = ui_audience_ask2b(au)
    ;; If the player refuses, the AI may offer to sweeten the deal.
    if ((selected == 1) || (selected == -1)) && ((eh.offer_tech@(pa) != 0) || (eh.offer_bc@(pa) != 0)) {
        pin strbuild = strbuild_init(au.diplo_msg, AUDIENCE_DIPLO_MSG_SIZE)
        val flag_qtype = rnd_0_nm1(2, g) == 0
        strbuild_catf(strbuild, "%s", if flag_qtype => game_str_au_whatif1 => game_str_au_perrec1)
        game_audience_str_append_offer(strbuild, g, eh.offer_field@(pa), eh.offer_tech@(pa), eh.offer_bc@(pa))
        if flag_qtype {
            strbuild_catf(strbuild, " %s", game_str_au_whatif2)
        }
        strbuild_catf(strbuild, "%s", game_str_au_ques)
        set au.buf = au.diplo_msg
        ;; We still have accept/reject or agree/forget-it in au->strtbl.
        set selected = ui_audience_ask2b(au)
    }
    if selected == 0 {  ;; Player accepted.
        match au.dtype {
            24 => game_diplo_set_treaty(g, ph, pa, TREATY_NONAGGRESSION)
            25 => game_diplo_set_treaty(g, ph, pa, TREATY_ALLIANCE)
            26 => game_diplo_set_trade(g, ph, pa, eh.au_want_trade@(pa))
            27 => game_diplo_break_treaty(g, ph, eh.au_ask_break_treaty@(pa))   ;; Player breaks alliance with the AI's enemy.
            30 => {
                game_diplo_stop_war(g, ph, pa)
                if eh.relation1@(pa) < 80 {
                    set eh.relation1@(pa) = eh.relation1@(pa) + 20
                    set ea.relation1@(ph) = eh.relation1@(pa)
                }
                game_diplo_annoy(g, ph, pa, 2)
            }
            76 => {     ;; Player joins their ally's war.
                game_diplo_start_war(g, ph, au.pwar)
                set au.mode = 6
                game_audience_set_dtype(au, 78, 3)
            }
            else => log_fatal_and_die("%s: BUG unhandled dtype %d\n", "game_audience_ai_offers_treaty", au.dtype)
        }
        ;; BUG? Give the deal-sweetener. Note that this happens even if the
        ;; player didn't refuse at first and thus didn't see the sweetener.
        ;; This may silently add some money to the player's reserve.

        ;; BUG? AI doesn't give a deal-sweetener for honoring your alliance.
        ;; That makes some sense, but can it ever happen that the AI offers
        ;; a sweetener and doesn't give it?
        if dtype != 76 {
            set eh.reserve_bc = u32(eh.reserve_bc + eh.offer_bc@(pa))
            ;; BUG? AI doesn't lose money?
            if eh.offer_tech@(pa) != 0 {
                game_tech_get_new(g, ph, eh.offer_field@(pa), eh.offer_tech@(pa), TECHSOURCE_TRADE, pa, PLAYER_NONE, false)
            }
        }
    } else {    ;; Player refused.
        match dtype {
            27 => {     ;; Player didn't break alliance with the AI's enemy.
                ;; ea->relation1[ph] -= rnd_1_n(6, &g->seed) + 6; SETMAX(ea->relation1[ph], -100); BUG? useless
                set ea.relation1@(ph) = -100
                set eh.relation1@(pa) = -100
            }
            76 => game_audience_ai_breaks_alliance(au)  ;; Player did not honor their alliance.
            else => nil
        }
    }
    selected == 0
}

;; If the AI wants to offer a deal to the player, but the player is
;; allied with one of its war enemies, it asks the player to break the
;; alliance and does not make the offer if they refuse.
;;
;; The function returns true if either
;;   - the player is not allied with an enemy of the AI, or
;;   - the player chose to break the alliance
;; and false otherwise.
func game_audience_check_alliances (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    var pf = PLAYER_NONE
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    loop i in g.players {
        if (i != ph) && (i != pa) && (ea.treaty@(i) >= TREATY_WAR) && (eh.treaty@(i) == TREATY_ALLIANCE) {
            set pf = i
        }
    }
    if pf == PLAYER_NONE {
        return true
    }
    set au.dtype = 27
    set eh.au_ask_break_treaty@(pa) = pf
    set g.evn.diplo_msg_subtype = -1
    game_audience_get_diplo_msg(au)
    ;; Note: The below game_audience_ai_offers_treaty call is for asking the
    ;; player to break the alliance. The main offer will be made in
    ;; game_audience_do.
    val retval = game_audience_ai_offers_treaty(au)
    if (au.dtype_next == 76) && (!retval) {
        ;; The AI is allied with the player and was going to ask them to join
        ;; a war against an enemy. But the player also has an alliance with one
        ;; of the AI's enemies and refused to break it, so the AI now cancels
        ;; the alliance with the player. In the grimdark future of the 23rd
        ;; century, you can't be friends with everyone.
        game_audience_ai_breaks_alliance(au)
    }
    retval
}

func game_audience_sweeten (au, a0) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var selected = 0    ;; int16_t
    pin query = carray(320)     ;; char[]
    val ok, bc, field, tech0 = game_ai.aud_sweeten(au)
    var tech = tech0
    var flag_bc
    if !ok {
        return 0
    }
    if (bc == 0) && (tech == 0) {
        return 0
    }
    if ((tech != 0) && (a0 == 1)) || (bc == 0) {
        set flag_bc = false
    } else {
        set tech = 0
        set flag_bc = true
    }
    pin strbuild = strbuild_init(query, 320)
    if rnd_0_nm1(2, g) == 0 {
        strbuild_catf(strbuild, "%s", game_str_au_perthr1)
        game_audience_str_append_offer(strbuild, g, field, tech, bc)
        strbuild_catf(strbuild, " %s", game_str_au_perthr2)
    } else {
        strbuild_catf(strbuild, "%s", game_str_au_alsoof1)
        game_audience_str_append_offer(strbuild, g, field, tech, bc)
        strbuild_catf(strbuild, " %s", game_str_au_alsoof2)
    }
    game_audience_choice(au, cstr(query), game_str_au_opts_agree, nil, 2)
    set selected = ui_audience_ask3(au)
    if (selected == -1) || (selected == 1) {
        return 1
    }
    if !flag_bc {
        game_tech_get_new(g, pa, field, tech, TECHSOURCE_TRADE, ph, PLAYER_NONE, false)
    } else {
        set eh.reserve_bc = u32(eh.reserve_bc - bc)
        set ea.reserve_bc = u32(ea.reserve_bc + bc)
    }
    3
}

func audience_menu_race (au, rtbl, rnum, titlestr) {
    val g = au.g
    pin strtbl_build = strbuild_init(au.strtbl_buf, AUDIENCE_STRTBL_BUFSIZE)
    var selected = 0    ;; int16_t
    loop i in rnum {
        val e = g.eto@(rtbl@(i))
        strbuild_catf(strtbl_build, "%s %s", game_str_au_bull, game_str_tbl_races@(e.race))
        set au.strtbl@(i) = cstr(au.strtbl_buf, strbuild_finish(strtbl_build))
    }
    set au.strtbl@(rnum) = game_str_au_opts_agree@(1)   ;; "Forget It"
    set au.strtbl@(rnum + 1) = false
    set au.buf = titlestr
    set au.condtbl = nil
    set selected = ui_audience_ask4(au)
    if (selected >= 0) && (selected < rnum) {
        return rtbl@(selected)
    }
    PLAYER_NONE
}

;; `si = game_ai->aud_*(au); if ((si == 1) || (si == 2)) si = game_audience_sweeten(au, si);`
func audience_ask_ai (au, f) {
    var si = f(au)
    if (si == 1) || (si == 2) {
        set si = game_audience_sweeten(au, si)
    }
    si
}

func audience_menu_treaty (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var selected = 0    ;; int16_t
    val condtbl = carray(6, true)   ;; bool[] (given to au->condtbl)
    pin war_tbl = carray(PLAYER_NUM)    ;; player_id_t[]
    pin all_tbl = carray(PLAYER_NUM)    ;; player_id_t[]
    var dtype   ;; uint8_t
    var si
    if eh.treaty@(pa) != TREATY_NONE {
        set condtbl@(0) = false
    }
    if eh.treaty@(pa) >= TREATY_ALLIANCE {
        set condtbl@(1) = false
    }
    if eh.treaty@(pa) < TREATY_WAR {
        set condtbl@(2) = false
    }
    if eh.treaty@(pa) >= TREATY_WAR {
        set condtbl@(3) = false
    }
    var war_num = 0     ;; uint8_t
    loop i in g.players {
        if (i != ph) && (i != pa) && (ea.treaty@(i) < TREATY_WAR) {
            set war_tbl@(war_num) = i
            set war_num = war_num + 1
        }
    }
    if war_num == 0 {
        set condtbl@(3) = false
    }
    var all_num = 0     ;; uint8_t
    loop i in g.players {
        if (i != ph) && (i != pa) && BOOLVEC_IS1(ea.contact, i) && ((ea.treaty@(i) == TREATY_ALLIANCE) || (game_num_aud_ask_break_nap && (ea.treaty@(i) == TREATY_NONAGGRESSION))) {
            set all_tbl@(all_num) = i
            set all_num = all_num + 1
        }
    }
    if all_num == 0 {
        set condtbl@(4) = false
    }
    game_audience_choice(au, game_str_au_youprte, game_str_au_opts_treaty, condtbl, 6)
    set selected = ui_audience_ask4(au)
    match selected {
        0 => {  ;; Non-Aggression Pact
            set si = audience_ask_ai(au, game_ai.aud_treaty_nap)
            if si == 3 {
                game_diplo_set_treaty(g, ph, pa, TREATY_NONAGGRESSION)
            }
            set dtype = 62
        }
        1 => {  ;; Alliance
            set si = audience_ask_ai(au, game_ai.aud_treaty_alliance)
            if si == 3 {
                game_diplo_set_treaty(g, ph, pa, TREATY_ALLIANCE)
            }
            set dtype = 63
        }
        2 => {  ;; Peace Treaty
            set si = audience_ask_ai(au, game_ai.aud_treaty_peace)
            if si == 3 {
                game_diplo_stop_war(g, ph, pa)
            }
            game_diplo_annoy(g, ph, pa, 2)
            set dtype = 65
        }
        3 => {  ;; Declaration of War on Another Race
            set dtype = 67
            set au.pstartwar = audience_menu_race(au, war_tbl, war_num, game_str_au_whowar)
            if au.pstartwar != PLAYER_NONE {
                set si = audience_ask_ai(au, game_ai.aud_treaty_declare_war)
                if si == 3 {
                    game_diplo_start_war(g, pa, au.pstartwar)
                }
            } else {
                set selected = -1
            }
        }
        4 => {  ;; Break Alliance With Another Race
            set dtype = 68
            set au.pwar = audience_menu_race(au, all_tbl, all_num, game_str_au_whobrk)
            if au.pwar != PLAYER_NONE {
                set si = audience_ask_ai(au, game_ai.aud_treaty_break_alliance)
                if si == 3 {
                    game_diplo_break_treaty(g, pa, au.pwar)
                }
            } else {
                set selected = -1
            }
        }
        else => {  ;; 5: Forget It
            set selected = -1
            set dtype = 0
            set si = 0
        }
    }
    if (selected != -1) && (si != 1) {
        game_audience_set_dtype(au, dtype, si)
    }
}

func audience_menu_trade (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    var selected = 0    ;; int16_t
    pin str = strbuild_init(au.strtbl_buf, AUDIENCE_STRTBL_BUFSIZE)
    set au.buf = game_str_au_youprta
    loop i in AUDIENCE_BC_MAX {
        strbuild_catf(str, "%s %i %s", game_str_au_bull, au.bctbl@(i), game_str_au_bcpery)
        set au.strtbl@(i) = cstr(au.strtbl_buf, strbuild_finish(str))
    }
    set au.strtbl@(au.num_bc) = game_str_au_opts_agree@(1)  ;; "Forget It"
    set au.strtbl@(au.num_bc + 1) = false
    set au.condtbl = nil
    set selected = ui_audience_ask4(au)
    game_diplo_annoy(g, ph, pa, 1)
    set eh.mood_trade@(pa) = i16(eh.mood_trade@(pa) - rnd_1_n(30, g))
    if (selected != -1) && (selected != au.num_bc) {
        set au.new_trade_bc = au.bctbl@(selected)
        var si = game_ai.aud_trade(au)
        if si < 3 {
            set si = 0
        } else {
            game_diplo_set_trade(g, ph, pa, au.new_trade_bc)
        }
        game_audience_set_dtype(au, 64, si)
    }
}

func audience_menu_threat (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    var selected = 0    ;; int16_t
    val condtbl = carray(5, true)   ;; bool[] (given to au->condtbl)
    var dtype = 0   ;; uint8_t
    if eh.treaty@(pa) != TREATY_NONAGGRESSION {
        set condtbl@(0) = false
    }
    if eh.treaty@(pa) != TREATY_ALLIANCE {
        set condtbl@(1) = false
    }
    if eh.trade_bc@(pa) == 0 {
        set condtbl@(2) = false
    }
    game_audience_choice(au, game_str_au_youract, game_str_au_opts_threaten, condtbl, 5)
    set au.condtbl = condtbl
    set selected = ui_audience_ask4(au)
    match selected {
        0 => {  ;; Break Non-Aggression Pact
            game_diplo_break_treaty(g, ph, pa)
            set dtype = 73
            set selected = 0
        }
        1 => {  ;; Break Alliance
            game_diplo_break_treaty(g, ph, pa)
            set dtype = 73
            set selected = 0
        }
        2 => {  ;; Break Trade Agreement
            game_diplo_break_trade(g, ph, pa)
            set dtype = 73
            set selected = 0
        }
        3 => {  ;; Threaten To Attack
            set selected = 0
            set dtype = u8(game_ai.aud_threaten(au))
        }
        else => nil
    }
    if (g.ai_id == GAME_AI_CLASSIC) || ((selected != -1) && (selected != 4)) {
        game_diplo_annoy(g, ph, pa, 10)     ;; WASBUG MOO1 does this before the if, annoying by merely entering the menu
    }
    if (selected != -1) && (selected != 4) {
        game_audience_set_dtype(au, dtype, 3)
    }
}

func audience_menu_tribute (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var selected = 0    ;; int16_t
    var bcnum   ;; uint8_t
    var reserve = eh.reserve_bc     ;; uint32_t
    pin bctbl = carray(4)   ;; uint16_t[]
    pin strtbl_build = strbuild_init(au.strtbl_buf, AUDIENCE_STRTBL_BUFSIZE)
    set au.buf = game_str_au_whattr
    set reserve = SETMIN(reserve, game_num_max_tribute_bc)
    set reserve = (reserve // 25) * 25
    if reserve < 100 {
        set bcnum = reserve // 25
        set bctbl@(0) = 25
        set bctbl@(1) = 50
        set bctbl@(2) = 75
        set bctbl@(3) = 100
    } else {
        set bcnum = 4
        set bctbl@(0) = u16(((reserve // 4) // 25) * 25)
        set bctbl@(1) = u16(((reserve // 2) // 25) * 25)
        set bctbl@(2) = u16((((3 * reserve) // 4) // 25) * 25)
        set bctbl@(3) = u16(reserve)
    }
    loop i in bcnum {
        strbuild_catf(strtbl_build, "%s %i %s", game_str_au_bull, bctbl@(i), game_str_bc)
        set au.strtbl@(i) = cstr(au.strtbl_buf, strbuild_finish(strtbl_build))
    }
    set au.strtbl@(bcnum) = game_str_au_techn
    set au.strtbl@(bcnum + 1) = false
    set au.condtbl = nil
    set selected = ui_audience_ask4(au)
    if selected == -1 {
        return nil
    }
    if selected < bcnum {
        set eh.reserve_bc = u32(eh.reserve_bc - bctbl@(selected))
        set ea.reserve_bc = u32(ea.reserve_bc + bctbl@(selected))
        game_ai.aud_tribute_bc(au, selected, bctbl@(selected))
        game_audience_set_dtype(au, 1, 3)
    } else {
        pin s = spy_esp_s()
        set s.spy = pa
        set s.target = ph
        ;; WASBUG
        ;; MOO1 does game_spy_esp_sub1(g, s, tav[i], 0) where tav is a global table also used by audience_menu_tech and i is bcnum.
        ;; If the tech menu is never visited or the table is not filled up to bcnum then the value is 0.
        ;; Values larger than 0 only filter out tech of lesser worth, and who would not want to use those as bribes?
        if game_spy_esp_sub1(g, s, 0, 0) > 0 {
            val num_techs = SETMIN(s.tnum, 4)
            game_audience_tech_choice(au, game_str_au_whattr, s.tbl_field, s.tbl_tech2, num_techs, true)
            set selected = ui_audience_ask4(au)
            if (selected != -1) && (selected < s.tnum) && (selected < 4) {
                game_tech_get_new(g, pa, s.tbl_field@(selected), s.tbl_tech2@(selected), TECHSOURCE_TRADE, ph, PLAYER_NONE, false)
                game_ai.aud_tribute_tech(au, selected, s.tbl_field@(selected), s.tbl_tech2@(selected))
                set eh.tribute_field@(pa) = s.tbl_field@(selected)
                set eh.tribute_tech@(pa) = s.tbl_tech2@(selected)
                game_audience_set_dtype(au, 1, 3)
            }
        } else {
            game_audience_set_dtype(au, 75, 3)
        }
    }
}

func audience_menu_tech (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val v = game_ai.aud_tech_scale(au)
    do {
        pin s = spy_esp_s()
        pin taf = carray(TECH_SPY_MAX)  ;; tech_field_t[] (diplo_p2_sub1_field)
        pin tat = carray(TECH_SPY_MAX)  ;; uint8_t[]
        pin tav = carray(TECH_SPY_MAX)  ;; int[]
        pin thf = carray2(TECH_SPY_MAX, TECH_SPY_MAX)   ;; tech_field_t[][]
        pin tht = carray2(TECH_SPY_MAX, TECH_SPY_MAX)   ;; uint8_t[][]
        pin thaf = carray(TECH_SPY_MAX * TECH_SPY_MAX)  ;; tech_field_t[]
        pin that = carray(TECH_SPY_MAX * TECH_SPY_MAX)  ;; uint8_t[]
        pin thnum = carray(TECH_SPY_MAX)    ;; int[]
        set s.spy = ph
        set s.target = pa
        if game_spy_esp_sub1(g, s, 0, 1) > 0 {
            val tanum = s.tnum
            loop i in tanum {
                set taf@(i) = s.tbl_field@(i)
                set tat@(i) = s.tbl_tech2@(i)
                set tav@(i) = (s.tbl_value@(i) * v) // 100
            }
            set s.spy = pa
            set s.target = ph
            var total_thnum = 0
            loop i in tanum {
                if game_spy_esp_sub1(g, s, tav@(i), 0) > 0 {
                    val n = s.tnum
                    set thnum@(total_thnum) = n
                    loop j in n {
                        set thf@(total_thnum)@(j) = s.tbl_field@(j)
                        set tht@(total_thnum)@(j) = s.tbl_tech2@(j)
                    }
                    set thaf@(total_thnum) = taf@(i)
                    set that@(total_thnum) = tat@(i)
                    set total_thnum = total_thnum + 1
                }
            }
            ;; 6568e
            if total_thnum > 0 {
                var selected = 0    ;; int16_t
                val num_techs = SETMIN(total_thnum, 5)
                game_diplo_annoy(g, ph, pa, 1)
                set eh.mood_tech@(pa) = i16(eh.mood_tech@(pa) - (rnd_1_n(50, g) + 20))
                game_audience_tech_choice(au, game_str_au_whatech, thaf, that, num_techs, false)
                set selected = ui_audience_ask4(au)
                ;; 65724
                if selected != -1 {
                    val gotf = thaf@(selected)
                    val gott = that@(selected)
                    val selected2 = selected
                    val num_techs2 = SETMIN(thnum@(selected2), 4)
                    game_audience_tech_choice(au, game_str_au_whatrad, thf@(selected2), tht@(selected2), num_techs2, true)
                    set selected = ui_audience_ask4(au)
                    if (selected != -1) && (selected < num_techs2) {
                        set g.evn.newtech@(ph).num = 0
                        set g.evn.newtech@(pa).num = 0
                        game_tech_get_new(g, ph, gotf, gott, TECHSOURCE_TRADE, pa, PLAYER_NONE, false)
                        game_tech_get_new(g, pa, thf@(selected2)@(selected), tht@(selected2)@(selected), TECHSOURCE_TRADE, ph, PLAYER_NONE, false)   ;; WASBUG last ph was pa
                        if g.evn.newtech@(ph).num != 0 {
                            if IS_HUMAN(g, pa) && (g.evn.newtech@(pa).num != 0) {
                                game_tech_finish_new(au.g, pa)
                                game_tech_finish_new(au.g, ph)
                                ui_audience_newtech(au, PLAYER_NONE)
                            } else {
                                game_tech_finish_new(au.g, ph)
                                ui_audience_newtech(au, ph)
                            }
                        } else {
                            if IS_HUMAN(g, pa) && (g.evn.newtech@(pa).num != 0) {
                                game_tech_finish_new(au.g, pa)
                                ui_audience_newtech(au, pa)
                            }
                        }
                    }
                }
            } else {
                game_audience_set_dtype(au, 75, 3)
            }
        } else {
            game_audience_set_dtype(au, 75, 3)
        }
    }
    game_diplo_annoy(g, ph, pa, 3)
    set eh.mood_tech@(pa) = SETMIN(eh.mood_tech@(pa), 50)
}

func audience_menu_main (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    var flag_done = false
    val condtbl = carray(6, true)   ;; bool[] (given to au->condtbl)
    loop {
        while !flag_done
        loop i in 6 {
            set condtbl@(i) = true
        }
        if eh.treaty@(pa) >= TREATY_WAR {
            set condtbl@(1) = false
            set condtbl@(2) = false
            set condtbl@(4) = false
        }
        do {
            pin s = spy_esp_s()
            set s.spy = pa
            set s.target = ph
            if (eh.reserve_bc < 25) && (game_spy_esp_sub1(g, s, 0, 0) == 0) {
                set condtbl@(3) = false
            }
        }
        do {
            val cur_trade = eh.trade_bc@(pa)
            var prod = SETMIN(eh.total_production_bc, g.eto@(pa).total_production_bc) // 4
            set prod = SETMIN(prod, 32000)
            val want_trade = ((prod // 25) * 25) - cur_trade
            if want_trade <= 0 {
                set condtbl@(1) = false
            } else {
                if want_trade < 125 {
                    set au.num_bc = u8(want_trade // 25)
                    set au.bctbl@(0) = u16(cur_trade + 25)
                    set au.bctbl@(1) = u16(cur_trade + 50)
                    set au.bctbl@(2) = u16(cur_trade + 75)
                    set au.bctbl@(3) = u16(cur_trade + 100)
                } else {
                    set au.num_bc = AUDIENCE_BC_MAX
                    set au.bctbl@(0) = u16((want_trade // 5) + cur_trade)
                    set au.bctbl@(1) = u16(((((want_trade * 2) // 5) // 25) * 25) + cur_trade)
                    set au.bctbl@(2) = u16(((((want_trade * 3) // 5) // 25) * 25) + cur_trade)
                    set au.bctbl@(3) = u16(((((want_trade * 4) // 5) // 25) * 25) + cur_trade)
                    set au.bctbl@(4) = u16(want_trade + cur_trade)
                }
            }
        }
        if game_ai.aud_later(au) {
            game_audience_set_dtype(au, 74, 3)
            break
        }
        game_audience_choice(au, game_str_au_howmay, game_str_au_opts_main, condtbl, 6)
        val selected = ui_audience_ask4(au)
        match selected {
            0 => audience_menu_treaty(au)   ;; Propose Treaty
            1 => audience_menu_trade(au)    ;; Form Trade Agreement
            2 => audience_menu_threat(au)   ;; Threaten/Break Treaty and Trade
            3 => audience_menu_tribute(au)  ;; Offer Tribute
            4 => audience_menu_tech(au)     ;; Exchange Technology
            else => { set flag_done = true }    ;; -1, 5: Good Bye
        }
    }
}

func game_audience_do (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    if (au.mode >= 0) && (au.mode <= 2) {
        ;; Greeting
        set g.evn.diplo_msg_subtype = -1
        game_audience_get_diplo_msg(au)
        ui_audience_show1(au)
    }
    match au.mode {
        2 => {  ;; AI initiated audience.
            if game_audience_check_alliances(au) {
                set au.dtype = au.dtype_next
                set g.evn.diplo_msg_subtype = -1
                game_audience_get_diplo_msg(au)
                match au.dtype {
                    28 => game_audience_ai_offers_bounty(au)
                    58 => game_audience_ai_pays_bounty(au)
                    29 => game_audience_ai_offers_tech_trade(au)
                    else => game_audience_ai_offers_treaty(au)
                }
            }
            ;; 607a9
            ;; After offering a deal, the AI becomes less likely to accept or
            ;; propose similar deals in the near future, independent of the
            ;; player's response. This even happens when the player didn't see
            ;; the actual offer because they're allied with one of the AI's
            ;; enemies, so we cannot do it in the game_audience_ai_offers_*
            ;; functions.
            game_diplo_annoy(g, ph, pa, 1)
            if (au.dtype == 24) || (au.dtype == 25) {
                set eh.mood_treaty@(pa) = i16(eh.mood_treaty@(pa) - (rnd_1_n(30, g) + 20))
            }
            if au.dtype == 26 {
                set eh.mood_trade@(pa) = i16(eh.mood_trade@(pa) - (rnd_1_n(30, g) + 20))
            }
            if au.dtype == 30 {
                set eh.mood_peace@(pa) = i16(eh.mood_peace@(pa) - (rnd_1_n(50, g) + 50))
            }
            if au.dtype == 29 {
                set eh.mood_tech@(pa) = i16(eh.mood_tech@(pa) - (rnd_1_n(30, g) + 20))
            }
        }
        6 => game_audience_set_dtype(au, au.dtype, 3)   ;; Single message from the AI, no player response.
        0 => audience_menu_main(au)     ;; Player initiated audience.
        else => nil
    }
}

;; ---------------------------------------------------------------------------

func game_audience (g, ph, pa) {
    pin au = audience_s()
    val eh = g.eto@(ph)
    set au.g = g
    game_diplo_limit_mood_treaty(g)
    game_audience_prepare(au, ph, pa)
    ui_audience_start(au)
    set au.mode = 6
    set au.dtype = eh.diplo_type@(pa)
    if (au.dtype == 66) || (au.dtype == 1) {
        ;; FIXME BUG? no ui_audience_end call after _start
        ui_audience_end(au)
        return nil
    }
    if au.dtype == 0 {
        game_audience_start_human(au)
    }
    set g.evn.diplo_msg_subtype = -1
    if ((au.dtype >= 24) && (au.dtype <= 30)) || (au.dtype == 58) || (au.dtype == 76) {
        set au.dtype_next = au.dtype
        set au.dtype = 22
        set au.mode = 2
        set au.pwar = eh.au_ally_attacker@(pa)
    }
    game_audience_do(au)
    ui_audience_end(au)
    if au.dtype == 32 {
        game_diplo_break_treaty(g, pa, ph)
    }
    if game_num_aud_update_tech {
        game_update_tech_util(g)
        game_update_within_range(g)
        game_update_visibility(g)
    }
}
