;; Port of c/src/game/game_tech.c and game_tech.h.
;;
;; The arithmetic of C on `uint32_t` (investments and costs) wraps at 32
;; bits, and so does it here: `u32(...)` where C computes in `unsigned`.

include "../boolvec.atm"
include "../comp.atm"
include "../ctypes.atm"
include "../lib.atm"
include "../rnd.atm"
include "game.atm"
include "game_ai.atm"
include "game_aux.atm"
include "game_num.atm"
include "game_shiptech.atm"
include "game_str.atm"
include "game_techtypes.atm"

;; ---------------------------------------------------------------------------

;; `RESEARCH_D0_PTR(ga, f, t)`: the position in `research.d0`.
func RESEARCH_D0_PTR (ga, f, t) {
    ((f * 50) + t - 1) * 6
}

pin tech_reduce_50percent_per_10pts = [
    100, 93, 87, 81, 76, 71, 66, 62, 58, 54,
    50, 47, 44, 41, 38, 35, 33, 31, 29, 27,
    25, 23, 22, 20, 19, 18, 16, 15, 14, 13,
    13, 12, 11, 10, 9, 9, 8, 8, 7, 7,
    6, 6, 5, 5, 5, 4, 4, 4, 4, 3,
    3
]

pin tech_reduce_25percent_per_10pts = [
    100, 97, 94, 92, 89, 87, 84, 82, 79, 77,
    75, 73, 71, 69, 67, 65, 63, 61, 60, 58,
    56, 55, 53, 52, 50, 49, 47, 46, 45, 43,
    42, 41, 40, 39, 38, 37, 36, 35, 34, 33,
    32, 31, 30, 29, 28, 27, 27, 26, 25, 24,
    24
]

;; ---------------------------------------------------------------------------

;; `tbl` from position `offs`, `len` bytes.
func find_byte_in_tbl (b, tbl, offs, len) {
    loop i in len {
        if tbl@(offs + i) == b {
            return b
        }
    }
    0
}

func get_tech_reduce_50 (percent) {     ;; uint8_t percent (1..100)
    tech_reduce_50percent_per_10pts@(SETMIN(percent, 50) - 1)
}

func get_base_cost_mod_armor (g, player_i, percent) {
    var tech_i = 0
    loop i in SHIP_ARMOR_NUM {
        if game_tech_player_has_tech(g, TECH_FIELD_CONSTRUCTION, tbl_shiptech_armor@(i).tech_i, player_i) != 0 {
            set tech_i = i
        }
    }
    if tech_i != 0 {
        set tech_i = tech_i - 1
    }
    val mult = get_tech_reduce_50(percent)
    u16(((tbl_shiptech_armor@(tech_i).cost@(SHIP_HULL_LARGE) + tbl_shiptech_hull@(SHIP_HULL_LARGE).cost) * mult) // 1500)
}

func get_base_cost_mod_weap (g, tech_i, percent) {
    val mult = u16(get_tech_reduce_50(percent) * 9)
    u16((tbl_shiptech_weap@(tech_i).cost * mult) // 1000)
}

func get_base_cost_mod_shield (g, tech_i, percent) {
    val mult = get_tech_reduce_50(percent)
    u16(((tbl_shiptech_shield@(tech_i).cost@(SHIP_HULL_LARGE) * mult) // 1000) + (tbl_shiptech_shield@(tech_i).power@(SHIP_HULL_LARGE) // 10))
}

func get_base_cost_mod_comp (g, tech_i, percent) {
    val mult = get_tech_reduce_50(percent)
    u16(((tbl_shiptech_comp@(tech_i).cost@(SHIP_HULL_LARGE) * mult) // 1000) + (tbl_shiptech_comp@(tech_i).power@(SHIP_HULL_LARGE) // 10))
}

func get_base_cost_mod_jammer (g, player_i, percent) {
    var tech_i = 0
    loop i in SHIP_JAMMER_NUM {
        if game_tech_player_has_tech(g, TECH_FIELD_COMPUTER, tbl_shiptech_jammer@(i).tech_i, player_i) != 0 {
            set tech_i = i
        }
    }
    val mult = get_tech_reduce_50(percent)
    u16(((tbl_shiptech_jammer@(tech_i).cost@(SHIP_HULL_LARGE) * mult) // 1000) + (tbl_shiptech_jammer@(tech_i).power@(SHIP_HULL_LARGE) // 10))
}

func find_best_tech_type (tbl, base, step, last) {
    var best = 0
    var i = base
    loop {
        while i <= last
        if BOOLVEC_IS1(tbl, i) {
            set best = i
        }
        set i = i + step
    }
    u8(best)
}

func game_tech_add_newtech (g, player, field, tech, source, a8, stolen_from, frame0) {
    var frame = frame0
    val nts = g.evn.newtech@(player)
    val num = nts.num
    if num < NEWTECH_MAX {
        val nt = nts.d@(num)
        set nt.field = field
        set nt.tech = tech
        set nt.source = source
        set nt.v06 = i8(a8)
        set nt.stolen_from = stolen_from
        set nt.other1 = PLAYER_NONE
        set nt.other2 = PLAYER_NONE
        if source != TECHSOURCE_SPY {
            set frame = false
        }
        if frame {
            val et = g.eto@(stolen_from)
            var i = 0
            loop {
                while (i < g.players) && (nt.other2 == PLAYER_NONE)
                if (i != player) && BOOLVEC_IS1(et.contact, i) {
                    if nt.other1 == PLAYER_NONE {
                        set nt.other1 = i
                    } else {
                        set nt.other2 = i
                    }
                }
                set i = i + 1
            }
            if nt.other2 == PLAYER_NONE {
                set nt.other1 = PLAYER_NONE
                set frame = false
            }
        }
        set nt.frame = frame
        set nts.num = u8(num + 1)
    }
}

;; `tbl` receives the techs (uint8_t[]); the number of them.
func game_tech_get_next_techs (g, player, field, tbl) {
    val rc = g.srd@(player).researchcompleted@(field)
    val len = g.eto@(player).tech.completed@(field)
    val rl = g.srd@(player).researchlist@(field)
    var tmax = 0
    loop i in len {
        set tmax = SETMAX(tmax, rc@(i))
    }
    var maxtier
    if len == 1 {
        set maxtier = 1
    } else {
        set maxtier = SETMIN(((tmax - 1) // 5) + 2, 10)
    }
    var num = 0
    loop tier in maxtier {
        loop l in 3 {
            val t = rl@(tier)@(l)
            if t != 0 {
                var have = false
                loop i in len {
                    if rc@(i) == t {
                        set have = true
                        break
                    }
                }
                if (!have) && (num < TECH_NEXT_MAX) {
                    set tbl@(num) = t
                    set num = num + 1
                }
            }
        }
    }
    if num == 0 {
        if tmax <= 50 {
            set tmax = 55
        } else {
            set tmax = SETMIN(tmax + 5, 100)
        }
        var t = 55
        loop {
            while t <= tmax
            var have = false
            var i = len - 1
            loop {
                while i >= 0
                if rc@(i) == t {
                    set have = true
                    break
                }
                set i = i - 1
            }
            if (!have) && (num < TECH_NEXT_MAX) {
                set tbl@(num) = t
                set num = num + 1
            }
            set t = u8(t + 5)
        }
    }
    u8(num)
}

func game_tech_ai_tech_next (g, player, field) {
    pin tbl = carray(TECH_NEXT_MAX)
    val num = game_tech_get_next_techs(g, player, field, tbl)
    if num != 0 {
        val tech = game_ai.tech_next(g, player, field, tbl, num)
        game_tech_start_next(g, player, field, tech)
    }
}

func game_tech_share (g, f, accepted, from_dead) {
    pin tbl_source = carray(TECH_MAX_LEVEL + 1)
    var maxtech = 0
    pin tbl_techcompl = BOOLVEC_DECLARE(TECH_MAX_LEVEL + 1)
    BOOLVEC_CLEAR(tbl_techcompl, TECH_MAX_LEVEL + 1)
    loop pi in g.players {
        if (BOOLVEC_IS0(g.refuse, pi) == accepted) && (from_dead || IS_ALIVE(g, pi)) {   ;; BUG MOO1 takes tech also from dead races
            val p = g.srd@(pi).researchcompleted@(f)
            loop k in g.eto@(pi).tech.completed@(f) {
                val tech_i = p@(k)
                BOOLVEC_SET1(tbl_techcompl, tech_i)
                set maxtech = SETMAX(maxtech, tech_i)
                set tbl_source@(tech_i) = pi
            }
        }
    }
    loop pi in g.players {
        if (BOOLVEC_IS1(g.refuse, pi) == accepted) || (!IS_ALIVE(g, pi)) {
            skip
        }
        if IS_AI(g, pi) {
            val p = g.srd@(pi).researchcompleted@(f)
            var n = 0
            loop tech_i in (0, maxtech) {
                if BOOLVEC_IS1(tbl_techcompl, tech_i) {
                    set p@(n) = tech_i
                    set n = n + 1
                }
            }
            set g.eto@(pi).tech.completed@(f) = u16(n)
        } else {
            var tech_i = 0
            loop {
                while (tech_i <= maxtech) && (g.evn.newtech@(pi).num < NEWTECH_MAX)
                if BOOLVEC_IS1(tbl_techcompl, tech_i) && (game_tech_player_has_tech(g, f, tech_i, pi) == 0) {
                    game_tech_get_new(g, pi, f, tech_i, TECHSOURCE_TRADE, tbl_source@(tech_i), PLAYER_NONE, false)
                }
                set tech_i = tech_i + 1
            }
        }
    }
}

;; ---------------------------------------------------------------------------

func game_tech_player_has_tech (g, field_i, tech_i, player_i) {
    val p = g.srd@(player_i).researchcompleted@(field_i)
    val len = g.eto@(player_i).tech.completed@(field_i)
    find_byte_in_tbl(u8(tech_i), p, 0, len)
}

func game_tech_player_best_tech (g, field_i, tech_i_base, tech_i_step, tech_i_max, player_i) {
    var tech_best = 0
    var tech_i = if tech_i_base >= 2 => tech_i_base => tech_i_step
    loop {
        while tech_i < tech_i_max
        if game_tech_player_has_tech(g, field_i, tech_i, player_i) != 0 {
            set tech_best = u8(tech_i)
        }
        set tech_i = tech_i + tech_i_step
    }
    tech_best
}

func game_get_base_cost (g, player_i) {
    val p = g.eto@(player_i).tech.percent
    val e = g.eto@(player_i)
    var cost = get_base_cost_mod_armor(g, player_i, p@(TECH_FIELD_CONSTRUCTION))
    set cost = u16(cost + get_base_cost_mod_weap(g, e.base_weapon, p@(TECH_FIELD_WEAPON)))
    set cost = u16(cost + get_base_cost_mod_shield(g, e.base_shield, p@(TECH_FIELD_FORCE_FIELD)))
    set cost = u16(cost + get_base_cost_mod_comp(g, e.base_comp, p@(TECH_FIELD_COMPUTER)))
    set cost = u16(cost + get_base_cost_mod_jammer(g, player_i, p@(TECH_FIELD_COMPUTER)))
    set cost = u16((cost * 3) // 5)
    if BOOLVEC_IS1(g.is_ai, player_i) {
        match g.difficulty {
            1 => { set cost = u16((cost * 9) // 10) }
            2 => { set cost = u16((cost * 8) // 10) }
            3 => { set cost = u16((cost * 7) // 10) }
            4 => { set cost = cost // 2 }
            else => {}
        }
    }
    if cost < 50 {
        set cost = 50
    }
    cost
}

func game_get_base_weapon (g, player_i, tech_i) {
    var r = WEAPON_LASER    ;; BUG?
    loop i in WEAPON_NUM {
        val w = tbl_shiptech_weap@(i)
        if (w.tech_i <= tech_i) && (w.damagemin == w.damagemax) && (w.numshots == 2) && (w.misstype == 0) && (!w.is_bio) && (w.nummiss == 1) && (game_tech_player_has_tech(g, TECH_FIELD_WEAPON, w.tech_i, player_i) != 0) {
            set r = i
        }
    }
    r
}

func game_get_base_weapon_2 (g, player_i, tech_i, r0) {
    var r = r0
    loop i in WEAPON_PLASMA_TORPEDO {
        val w = tbl_shiptech_weap@(i)
        if (w.nummiss > 1) && (game_tech_player_has_tech(g, TECH_FIELD_WEAPON, w.tech_i, player_i) != 0) {
            set r = i
        }
    }
    r
}

func game_get_best_shield (g, player_i, tech_i) {
    var r = 0
    loop i in SHIP_SHIELD_NUM {
        val w = tbl_shiptech_shield@(i)
        if (w.tech_i <= tech_i) && (game_tech_player_has_tech(g, TECH_FIELD_FORCE_FIELD, w.tech_i, player_i) != 0) {
            set r = i
        }
    }
    r
}

func game_get_best_comp (g, player_i, tech_i) {
    var r = 0
    loop i in SHIP_COMP_NUM {
        val w = tbl_shiptech_comp@(i)
        if (w.tech_i <= tech_i) && (game_tech_player_has_tech(g, TECH_FIELD_COMPUTER, w.tech_i, player_i) != 0) {
            set r = i
        }
    }
    r
}

func game_get_best_jammer (g, player_i, tech_i) {
    var r = 0
    loop i in SHIP_JAMMER_NUM {
        val w = tbl_shiptech_jammer@(i)
        if (w.tech_i <= tech_i) && (game_tech_player_has_tech(g, TECH_FIELD_COMPUTER, w.tech_i, player_i) != 0) {
            set r = i
        }
    }
    r
}

func game_update_tech_util (g) {
    pin tbl_techcompl = BOOLVEC_TBL_DECLARE(TECH_FIELD_NUM, 50 + 1)
    func IS1 (f, t) {
        BOOLVEC_TBL_IS1(tbl_techcompl, f, t)
    }
    loop pi in g.players {
        val e = g.eto@(pi)
        var b
        var tech_i
        BOOLVEC_TBL_CLEAR(tbl_techcompl, TECH_FIELD_NUM, 50 + 1)
        loop field_i in TECH_FIELD_NUM {
            val p = g.srd@(pi).researchcompleted@(field_i)
            loop k in e.tech.completed@(field_i) {
                set tech_i = p@(k)
                if tech_i <= 50 {
                    BOOLVEC_TBL_SET1(tbl_techcompl, field_i, tech_i)
                }
            }
        }
        set e.have_colony_for = PLANET_TYPE_MINIMAL
        loop i in 6 {
            if IS1(TECH_FIELD_PLANETOLOGY, (i * 3) + 3) {
                set e.have_colony_for = PLANET_TYPE_BARREN - i
            }
        }
        if e.race == RACE_SILICOID {
            set e.have_colony_for = PLANET_TYPE_RADIATED
        }
        set e.have_adv_soil_enrich = IS1(TECH_FIELD_PLANETOLOGY, 30)
        set e.have_atmos_terra = IS1(TECH_FIELD_PLANETOLOGY, 22)
        set e.have_soil_enrich = IS1(TECH_FIELD_PLANETOLOGY, 16)
        if e.race == RACE_SILICOID {
            set e.have_adv_soil_enrich = false
            set e.have_atmos_terra = false
            set e.have_soil_enrich = false
        }
        ifs {
            IS1(TECH_FIELD_PLANETOLOGY, 42) => { set e.inc_pop_cost = 5 }
            IS1(TECH_FIELD_PLANETOLOGY, 21) => { set e.inc_pop_cost = 10 }
            else => { set e.inc_pop_cost = 20 }
        }
        if e.race == RACE_SAKKRA {
            set e.inc_pop_cost = u8((e.inc_pop_cost * 2) // 3)
        }
        set tech_i = find_best_tech_type(tbl_techcompl@(TECH_FIELD_PLANETOLOGY), 2, 6, 50)
        set b = if tech_i > 0 => u8((((tech_i - 2) // 6) + 1) * 10) => 0
        ifs {
            b == 90 => { set b = 120 }
            b == 80 => { set b = 100 }
            b == 70 => { set b = 80 }
            else => {}
        }
        set e.have_terraform_n = b
        set b = if tech_i > 0 => u8(5 - ((tech_i - 2) // 12)) => 5
        if b < 2 {
            set b = 2
        }
        set e.terraform_cost_per_inc = b
        set e.have_combat_transporter = IS1(TECH_FIELD_PROPULSION, 45)
        set b = 2
        if IS1(TECH_FIELD_PLANETOLOGY, 5) { set b = 3 }
        if IS1(TECH_FIELD_PLANETOLOGY, 13) { set b = 5 }
        if IS1(TECH_FIELD_PLANETOLOGY, 24) { set b = 10 }
        if IS1(TECH_FIELD_PLANETOLOGY, 34) { set b = 20 }
        set e.have_eco_restoration_n = b
        ifs {
            IS1(TECH_FIELD_COMPUTER, 23) => { set b = 9 }
            IS1(TECH_FIELD_COMPUTER, 13) => { set b = 7 }
            IS1(TECH_FIELD_COMPUTER, 4) => { set b = 5 }
            else => { set b = 3 }
        }
        set e.scanner_range = b
        set e.have_stargates = IS1(TECH_FIELD_PROPULSION, 27)
        set e.have_hyperspace_comm = IS1(TECH_FIELD_COMPUTER, 34)
        set e.have_ia_scanner = IS1(TECH_FIELD_COMPUTER, 13) || IS1(TECH_FIELD_COMPUTER, 23)
        set e.have_adv_scanner = IS1(TECH_FIELD_COMPUTER, 23)
        set tech_i = find_best_tech_type(tbl_techcompl@(TECH_FIELD_COMPUTER), 8, 10, 50)
        set b = if tech_i > 0 => u8(((tech_i + 12) // 10) + 1) => 2
        if e.race == RACE_MEKLAR {
            set b = u8(b + 2)
        }
        set e.colonist_oper_factories = b
        ifs {
            IS1(TECH_FIELD_CONSTRUCTION, 38) => { set b = 2 }
            IS1(TECH_FIELD_CONSTRUCTION, 33) => { set b = 3 }
            IS1(TECH_FIELD_CONSTRUCTION, 28) => { set b = 4 }
            IS1(TECH_FIELD_CONSTRUCTION, 23) => { set b = 5 }
            IS1(TECH_FIELD_CONSTRUCTION, 18) => { set b = 6 }
            IS1(TECH_FIELD_CONSTRUCTION, 13) => { set b = 7 }
            IS1(TECH_FIELD_CONSTRUCTION, 8) => { set b = 8 }
            IS1(TECH_FIELD_CONSTRUCTION, 3) => { set b = 9 }
            else => { set b = 10 }
        }
        set e.factory_cost = b
        if e.race != RACE_MEKLAR {
            set b = u8((b * e.colonist_oper_factories) // 2)
        }
        set e.factory_adj_cost = b
        ifs {
            IS1(TECH_FIELD_CONSTRUCTION, 45) => { set b = 0 }
            IS1(TECH_FIELD_CONSTRUCTION, 35) => { set b = 2 }
            IS1(TECH_FIELD_CONSTRUCTION, 25) => { set b = 4 }
            IS1(TECH_FIELD_CONSTRUCTION, 15) => { set b = 6 }
            IS1(TECH_FIELD_CONSTRUCTION, 5) => { set b = 8 }
            else => { set b = 10 }
        }
        set e.ind_waste_scale = b
        ifs {
            IS1(TECH_FIELD_PROPULSION, 41) => { set b = 30 }
            IS1(TECH_FIELD_PROPULSION, 29) => { set b = 10 }
            IS1(TECH_FIELD_PROPULSION, 23) => { set b = 9 }
            IS1(TECH_FIELD_PROPULSION, 19) => { set b = 8 }
            IS1(TECH_FIELD_PROPULSION, 14) => { set b = 7 }
            IS1(TECH_FIELD_PROPULSION, 9) => { set b = 6 }
            IS1(TECH_FIELD_PROPULSION, 5) => { set b = 5 }
            IS1(TECH_FIELD_PROPULSION, 3) => { set b = 4 }
            else => { set b = 3 }
        }
        set e.fuel_range = b
        set tech_i = find_best_tech_type(tbl_techcompl@(TECH_FIELD_FORCE_FIELD), 2, 10, 50)
        if tech_i < 10 {
            set tech_i = 0
        }
        set b = if tech_i > 0 => u8(5 * ((tech_i - 2) // 10)) => 0
        set e.have_planet_shield = b
        set e.planet_shield_cost = game_num_pshield_cost@(b // 5)
        set b = 1
        var i = 6
        loop {
            while i < 50
            if IS1(TECH_FIELD_PROPULSION, i) {
                set b = u8(((i - 6) // 6) + 1)
            }
            set i = i + 6
        }
        set e.have_engine = b
        set e.have_sub_space_int = IS1(TECH_FIELD_PROPULSION, 43)
        ifs {
            IS1(TECH_FIELD_PLANETOLOGY, 36) => { set b = 2 }
            IS1(TECH_FIELD_PLANETOLOGY, 17) => { set b = 1 }
            else => { set b = 0 }
        }
        set e.antidote = b
        if g.gaux.flag_cheat_galaxy {
            set e.scanner_range = 30
        }
    }
}

func game_tech_get_group (gaux, field, tech) {
    gaux.research.d0@(RESEARCH_D0_PTR(gaux, field, tech))
}

func game_tech_get_tier (gaux, field, tech) {
    if game_tech_get_group(gaux, field, tech) == 0xff => 0 => gaux.research.d0@(RESEARCH_D0_PTR(gaux, field, tech) + 1)
}

func game_tech_get_gfx_i (gaux, field, tech) {
    gaux.research.d0@(RESEARCH_D0_PTR(gaux, field, tech) + 2)
}

func game_tech_get_name (gaux, field, tech, buf, bufsize) {
    ifs {
        tech == 0 => {
            lib_sprintf(buf, bufsize, "%s %s", game_str_tbl_te_field@(field), game_str_te_techno)
        }
        tech == -2 => {
            lib_strcpy(buf, game_str_tbl_st_weap@(WEAPON_NUCLEAR_MISSILE_2 - 1), bufsize)
        }
        tech == -1 => {
            lib_strcpy(buf, game_str_tbl_st_weap@(WEAPON_NUCLEAR_BOMB - 1), bufsize)
        }
        tech > 50 => {
            lib_sprintf(buf, bufsize, "%s %s %s %s", game_str_te_adv, game_str_tbl_te_field@(field), game_str_te_tech, game_str_tbl_roman@((tech - 50) // 5))
        }
        else => {
            val p = RESEARCH_D0_PTR(gaux, field, tech)
            if gaux.research.d0@(p) != 0xff {
                val offs = GET_LE_16(gaux.research.d0, p + 4)
                lib_strcpy(buf, cstr(gaux.research.names, offs), bufsize)
            } else {
                set buf@0 = 0
            }
        }
    }
    buf
}

func game_tech_get_descr (gaux, field, tech, buf, bufsize) {
    ifs {
        tech == 0 => {
            set buf@0 = 0
        }
        tech > 50 => {
            lib_sprintf(buf, bufsize, "%s %s %s.", game_str_te_genimp, game_str_tbl_te_field@(field), game_str_te_techno2)
        }
        tech == -2 => {
            lib_strcpy(buf, game_str_te_nmis, bufsize)
        }
        tech == -1 => {
            lib_strcpy(buf, game_str_te_nbomb, bufsize)
        }
        else => {
            lib_strcpy(buf, cstr(gaux.research.descr, ((field * 50) + tech - 1) * RESEARCH_DESCR_LEN), bufsize)
        }
    }
    buf
}

func game_tech_get_newtech_msg (g, pi, nt, buf, bufsize) {
    val race = g.eto@(pi).race
    match nt.source {
        TECHSOURCE_RESEARCH => {
            lib_sprintf(buf, bufsize, "%s %s %s %s", game_str_tbl_race@(race), game_str_nt_achieve, game_str_tbl_te_field@(nt.field), game_str_nt_break)
        }
        TECHSOURCE_SPY => {
            lib_sprintf(buf, bufsize, "%s %s %s", game_str_tbl_race@(race), game_str_nt_infil, cstr(g.planet@(nt.v06).name))
        }
        TECHSOURCE_FOUND => {
            ifs {
                nt.v06 == NEWTECH_V06_ORION => {
                    lib_strcpy(buf, game_str_nt_orion, bufsize)
                }
                nt.v06 >= 0 => {   ;; WASBUG > 0 vs. scout case with planet 0
                    lib_sprintf(buf, bufsize, "%s %s %s", game_str_nt_ruins, cstr(g.planet@(nt.v06).name), game_str_nt_discover)
                }
                else => {
                    lib_sprintf(buf, bufsize, "%s %s %s", game_str_nt_scouts, cstr(g.planet@(-(nt.v06 + 1)).name), game_str_nt_discover)
                }
            }
        }
        TECHSOURCE_CHOOSE => {
            lib_strcpy(buf, game_str_nt_choose, bufsize)
        }
        TECHSOURCE_TRADE => {
            lib_sprintf(buf, bufsize, "%s %s %s %s", game_str_tbl_race@(g.eto@(nt.v06).race), game_str_nt_reveal, game_str_tbl_te_field@(nt.field), game_str_nt_secrets)
        }
        else => {
            set buf@0 = 0
        }
    }
    buf
}

;; The investment of a field after this turn, as C computes it in
;; `uint32_t` (and `t1`, `t3` in `int`).
func game_tech_invest_next (invest0, slider, total_research) {
    var t1 = i32(u32(invest0 * 3) // 20)
    val t3 = i32(u32(slider * total_research) // 100)
    set t1 = SETMIN(t1, t3 * 2)
    return u32(invest0 + u32(t3 + t1)), t1, t3
}

func game_tech_current_research_percent1 (g, player, field) {
    val e = g.eto@(player)
    val cost = u32(game_tech_get_field_cost(g, player, field))
    val slider = e.tech.slider@(field)
    if (cost == 0) || (slider == 0) {
        return 0
    }
    val invest = game_tech_invest_next(e.tech.investment@(field), slider, e.total_research_bc)
    i32(u32(invest * 100) // cost)
}

func game_tech_current_research_percent2 (g, player, field) {
    val e = g.eto@(player)
    val cost = u32(game_tech_get_field_cost(g, player, field))
    val slider = e.tech.slider@(field)
    if (cost == 0) || (slider == 0) {
        return 0
    }
    val invest = game_tech_invest_next(e.tech.investment@(field), slider, e.total_research_bc)
    if invest <= cost {
        0
    } else {
        SETRANGE(i32(u32((invest - cost) * 50) // cost), 0, 99)
    }
}

func game_tech_current_research_has_max_bonus (g, player, field) {
    val e = g.eto@(player)
    val cost = u32(game_tech_get_field_cost(g, player, field))
    val slider = e.tech.slider@(field)
    if (cost == 0) || (slider == 0) {
        return false
    }
    val invest = e.tech.investment@(field)
    val t1 = i32(u32(invest * 3) // 20)
    val t3 = i32(u32(slider * e.total_research_bc) // 100)
    (t1 <= (t3 * 2)) && (t3 > 0)
}

func game_tech_set_to_max_bonus (g, player, field) {
    val had_bonus = game_tech_current_research_has_max_bonus(g, player, field)
    var has_bonus
    val e = g.eto@(player)
    val t = e.tech
    var prev
    var v = t.slider@(field)
    loop {
        set prev = v
        set v = i16(v + (if had_bonus => -1 => 1))
        set v = SETRANGE(v, 0, 100)
        set t.slider@(field) = v
        game_adjust_slider_group(t.slider, field, v, TECH_FIELD_NUM, t.slider_lock)
        set has_bonus = game_tech_current_research_has_max_bonus(g, player, field)
        set v = t.slider@(field)
        while (has_bonus == had_bonus) && (v != prev)
    }
}

func game_tech_get_new (g, player, field, tech, source, a8, stolen_from, flag_frame) {
    val e = g.eto@(player)
    val srd = g.srd@(player)
    val rc = srd.researchcompleted@(field)
    var tc = e.tech.completed@(field)
    var have_tech = false
    loop i in tc {
        if rc@(i) == tech {
            set have_tech = true
            break
        }
    }
    if have_tech || (tech == 0) {
        if e.tech.project@(field) == tech {
            if IS_HUMAN(g, player) {
                set e.tech.project@(field) = 0
                if source == 4 {
                    game_tech_add_newtech(g, player, field, tech, source, a8, stolen_from, flag_frame)
                }
            } else {
                game_tech_ai_tech_next(g, player, field)
            }
        }
    } else {
        set rc@(tc) = tech
        set tc = tc + 1
        set e.tech.completed@(field) = u16(tc)
        loop loops in tc {
            loop i in (tc - 1) {
                val t0 = rc@(i)
                val t1 = rc@(i + 1)
                if t0 > t1 {
                    set rc@(i + 1) = t0
                    set rc@(i) = t1
                }
            }
        }
        if IS_HUMAN(g, player) {
            game_tech_add_newtech(g, player, field, tech, source, a8, stolen_from, flag_frame)
        }
        if e.tech.project@(field) == tech {
            set e.tech.project@(field) = 0
            set e.tech.investment@(field) = 1
        }
        if (e.tech.project@(field) == 0) && IS_AI(g, player) {
            game_tech_ai_tech_next(g, player, field)
        }
    }
}

func game_tech_finish_new (g, pi) {
    val e = g.eto@(pi)
    pin can_choose = BOOLVEC_DECLARE(TECH_FIELD_NUM)
    BOOLVEC_CLEAR(can_choose, TECH_FIELD_NUM)
    loop i in g.evn.newtech@(pi).num {
        val nt = g.evn.newtech@(pi).d@(i)
        if e.tech.project@(nt.field) == nt.tech {
            BOOLVEC_SET1(can_choose, nt.field)
        }
    }
    loop field in TECH_FIELD_NUM {
        val xt = g.evn.newtech@(pi).next@(field)
        if (e.tech.project@(field) == 0) && (e.tech.investment@(field) > 0) {
            BOOLVEC_SET1(can_choose, field)
        }
        loop k in TECH_NEXT_MAX {
            set xt.tech@(k) = 0
        }
        if BOOLVEC_IS1(can_choose, field) {
            set xt.num = game_tech_get_next_techs(g, pi, field, xt.tech)
        } else {
            set xt.num = 0
        }
    }
}

func game_tech_can_choose (g, player, field) {
    g.evn.newtech@(player).next@(field).num != 0
}

func game_tech_get_next_rp (g, player, field, tech) {
    var cost = u32(tech * tech)
    set cost = u32(cost * game_num_tech_costmulr@(g.eto@(player).race)@(field))
    if IS_AI(g, player) {
        set cost = u32(cost * game_num_tech_costmula@(g.difficulty))
        set cost = cost // 100
    } else {
        set cost = u32(cost * game_num_tech_costmuld@(g.difficulty))
        set cost = cost // 1000
        set cost = u32(cost * 10)
    }
    cost
}

func game_tech_start_next (g, player, field, tech) {
    val td = g.eto@(player).tech
    if td.project@(field) != 0 {
        set td.investment@(field) = 0
    }
    set td.project@(field) = tech
    set td.cost@(field) = game_tech_get_next_rp(g, player, field, tech)
    set g.evn.newtech@(player).next@(field).num = 0
}

func game_tech_get_field_percent (g, player, field) {
    val rc = g.srd@(player).researchcompleted@(field)
    val len = g.eto@(player).tech.completed@(field)
    var tmax = 0
    loop i in len {
        set tmax = SETMAX(tmax, rc@(i))
    }
    var v = if len == 1 => 1 => (((tmax - 1) // 5) + 2)
    set v = tmax + len - v
    SETRANGE(v, 1, 99)
}

func game_tech_get_field_cost (g, player, field) {
    val e = g.eto@(player)
    var cost = e.tech.cost@(field)
    if IS_HUMAN(g, player) {
        if game_num_tech_costmuld2 != 100 {
            set cost = u32(cost * game_num_tech_costmuld2) // 100
        }
    } else {
        if game_num_tech_costmula2 != 100 {
            set cost = u32(cost * game_num_tech_costmula2) // 100
        }
    }
    if game_num_tech_costmul != 100 {
        set cost = u32(cost * game_num_tech_costmul) // 100
    }
    i32(cost)
}

func game_tech_research (g) {
    loop player in g.players {
        val e = g.eto@(player)
        val td = e.tech
        val total_research = e.total_research_bc
        loop field in TECH_FIELD_NUM {
            val slider = td.slider@(field)
            val invest = game_tech_invest_next(td.investment@(field), slider, total_research)
            set td.investment@(field) = invest
            set td.percent@(field) = u8(game_tech_get_field_percent(g, player, field))
            val cost = u32(game_tech_get_field_cost(g, player, field))
            if (cost != 0) && (slider != 0) && (total_research != 0) {
                if cost < invest {
                    val v = i32(u32((invest - cost) * 250) // cost)
                    if rnd_1_n(500, g) <= v {
                        game_tech_get_new(g, player, field, td.project@(field), TECHSOURCE_RESEARCH, game_planet_get_random(g, player), PLAYER_NONE, false)
                    }
                }
            } else {
                if (cost != 0) || (!game_num_first_tech_rp_fix) {  ;; WASBUG? 1 RP for first tech rounded down to 0
                    set td.investment@(field) = u32(invest * 9) // 10
                }
            }
        }
    }
    game_update_tech_util(g)
}

;; `n` attempts of 200 at a random tech, as game_tech_get_orion_loot and
;; game_tech_get_artifact_loot do it (the same code twice in C).
func game_tech_loot (g, player, percent, n, tmod, tadd, a8) {
    val td = g.eto@(player).tech
    loop in n {
        loop loops in 200 {
            val field = rnd_0_nm1(TECH_FIELD_NUM, g)
            val tech = u8(rnd_1_n(tmod, g) + tadd)
            val group = game_tech_get_group(g.gaux, field, tech)
            if (percent@(field) >= tech) && (group != TECH_GROUP_UNUSED) {
                val rc = g.srd@(player).researchcompleted@(field)
                var have_tech = false
                loop i in td.completed@(field) {
                    if rc@(i) == tech {
                        set have_tech = true
                        break
                    }
                }
                if !have_tech {
                    game_tech_get_new(g, player, field, tech, TECHSOURCE_FOUND, a8, PLAYER_NONE, false)
                    break
                }
            }
        }
    }
}

func game_tech_get_orion_loot (g, player) {
    val td = g.eto@(player).tech
    pin percent = carray(TECH_FIELD_NUM)
    game_tech_get_new(g, player, TECH_FIELD_WEAPON, TECH_WEAP_DEATH_RAY, TECHSOURCE_FOUND, -PLANETS_MAX, PLAYER_NONE, false)
    loop f in TECH_FIELD_NUM {
        set percent@(f) = u8(MIN(td.percent@(f) + 25, 50))
    }
    game_tech_loot(g, player, percent, 3, 31, 19, NEWTECH_V06_ORION)
}

func game_tech_get_artifact_loot (g, planet, player) {
    val td = g.eto@(player).tech
    pin percent = carray(TECH_FIELD_NUM)
    if IS_AI(g, player) {
        return nil
    }
    loop f in TECH_FIELD_NUM {
        set percent@(f) = u8(MIN(td.percent@(f) + 10, 50))
    }
    game_tech_loot(g, player, percent, 1, 30, 0, -(planet + 1))
}

func game_tech_final_war_share (g) {
    loop field_i in TECH_FIELD_NUM {
        game_tech_share(g, field_i, true, true)  ;; BUG MOO1 takes tech also from dead races
        if !BOOLVEC_ONLY1(g.refuse, PLAYER_NUM) {
            game_tech_share(g, field_i, false, false)
        }
    }
}
