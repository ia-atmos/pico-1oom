;; Port of c/src/game/game_ai_classic.c, in part (step 5, #9): the functions
;; of a new game, of techs, bombs, ground combat, votes, the battle,
;; diplomacy and audiences. The rest (the turn) is still to come; the
;; table `game_ai_classic` holds the functions ported so far.
;;
;; The "Classic" AI mimics MOO1 v1.3 behaviour.
;; Minor bug fixes are allowed.
;; The "Classic+" AI fixes small bugs and does small improvements.
;; Major improvements go to other game_ai_* implementations.

include "../rnd.atm"
include "../util_math.atm"
include "game.atm"
include "game_diplo.atm"
include "game_election.atm"
include "game_fleet.atm"
include "game_battle.atm"
include "game_num.atm"
include "game_spy.atm"
include "game_tech.atm"

;; ---------------------------------------------------------------------------

func game_ai_classic_new_game_init (g, player, home) {
    var n = 0
    val p = g.planet@(home)
    val e = g.eto@(player)
    loop i in g.galaxy_stars {
        val q = g.planet@(i)
        if (q.type > (PLANET_TYPE_MINIMAL - 1)) && (util_math_dist_fast(q.x, q.y, p.x, p.y) <= 30) {
            set n = n + 1
        }
    }
    set e.ai_p3_countdown = i8(rnd_1_n(6, g) + 14)
    set e.ai_p2_countdown = i8(rnd_1_n(10, g))
    if n > 1 {
        set p.slider@(PLANET_SLIDER_SHIP) = 10
        set p.slider@(PLANET_SLIDER_DEF) = 0
        set p.slider@(PLANET_SLIDER_IND) = 90
        set p.slider@(PLANET_SLIDER_ECO) = 0
        set p.slider@(PLANET_SLIDER_TECH) = 0
        set e.tech.slider@(TECH_FIELD_COMPUTER) = 20
        set e.tech.slider@(TECH_FIELD_CONSTRUCTION) = 20
        set e.tech.slider@(TECH_FIELD_FORCE_FIELD) = 0
        set e.tech.slider@(TECH_FIELD_PLANETOLOGY) = 40
        set e.tech.slider@(TECH_FIELD_PROPULSION) = 20
        set e.tech.slider@(TECH_FIELD_WEAPON) = 0
    } else {
        set e.ai_p3_countdown = i8(rnd_1_n(6, g) + 24)
        set p.slider@(PLANET_SLIDER_SHIP) = 0
        set p.slider@(PLANET_SLIDER_DEF) = 0
        set p.slider@(PLANET_SLIDER_IND) = 60
        set p.slider@(PLANET_SLIDER_ECO) = 10
        set p.slider@(PLANET_SLIDER_TECH) = 40
        set e.tech.slider@(TECH_FIELD_COMPUTER) = 0
        set e.tech.slider@(TECH_FIELD_CONSTRUCTION) = 0
        set e.tech.slider@(TECH_FIELD_FORCE_FIELD) = 0
        set e.tech.slider@(TECH_FIELD_PLANETOLOGY) = 0
        set e.tech.slider@(TECH_FIELD_PROPULSION) = 100
        set e.tech.slider@(TECH_FIELD_WEAPON) = 0
    }
    ;; XXX these shipi values are wrong, but fixed by first next turn
    set e.shipi_colony = 1
    set e.shipi_bomber = 4
}

func game_ai_classic_new_game_tech (g) {
    loop pli in g.players {
        if IS_HUMAN(g, pli) {
            skip
        }
        loop field in TECH_FIELD_NUM {
            val rl = g.srd@(pli).researchlist@(field)@0
            var tech
            loop {
                set tech = rl@(rnd_0_nm1(3, g))
                until tech != 0
            }
            if game_num_ai_first_tech_cost_fix {
                ;; game_tech_start_next comes with game_tech.c (step 4)
                throw "game_ai_classic_new_game_tech: game_tech_start_next is not ported yet"
            } else {
                val e = g.eto@(pli)
                set e.tech.project@(field) = tech
                set e.tech.cost@(field) = u32(tech * tech * 50)
            }
        }
    }
}

;; ---------------------------------------------------------------------------
;; The battle (`bt` is a `struct battle_s`).

;; `&bt->item[target_i]` of C, also for target_i == -1, which C reads before
;; the table (undefined behaviour): the bytes of bt->s[0] and bt->s[1] that
;; precede it (x86-64 layout, little endian). Only the fields that the AI
;; reads there are given.
func bt_item (bt, i) {
    if i >= 0 {
        return bt.item@(i)
    }
    val s0 = bt.s@(0)
    val s1 = bt.s@(1)
    val sx = (s1.tbl_ships@(1) >> 8) & 0xff
    [
        hp1    = s0.tbl_shiptype@(0) | (s0.tbl_shiptype@(1) << 8),
        hp2    = s0.tbl_shiptype@(2) | (s0.tbl_shiptype@(3) << 8),
        man    = s0.apparent_force & 0xff,
        absorb = (s0.apparent_force >> 24) & 0xff,
        repair = cint(s0.flag_have_scan),
        num    = s0.flag_auto & 0xffff,
        sbmask = s1.tbl_ships@(0),
        sx     = i8(sx),
        sy     = s1.tbl_ships@(2) & 0xff,
        unman  = (s1.tbl_ships@(3) >> 8) & 0xff,
    ]
}

func game_ai_classic_battle_ai_ai_get_weights (g, pi, tbl) {
    val e = g.eto@(pi)
    loop i in e.shipdesigns_num {
        val sd = g.srd@(pi).design@(i)
        set tbl@(i) = tbl@(i) + (sd.shield * 5)
        set tbl@(i) = tbl@(i) + (sd.comp * 5)
        set tbl@(i) = tbl@(i) + sd.wpnt@(0)
        set tbl@(i) = tbl@(i) + (sd.armor * 10)
        set tbl@(i) = tbl@(i) + (sd.special@(0) * 2)
        set tbl@(i) = tbl@(i) + (sd.special@(1) * 2)
        set tbl@(i) = tbl@(i) + (sd.special@(2) * 2)
        set tbl@(i) = tbl@(i) + (e.tech.percent@(TECH_FIELD_CONSTRUCTION) // 2)
        if (e.race == RACE_MRRSHAN) || (e.race == RACE_ALKARI) {
            set tbl@(i) = tbl@(i) + (if g.ai_id == GAME_AI_CLASSIC => 15 => 20)
        }
        set tbl@(i) = tbl@(i) * game_num_tbl_hull_w@(sd.hull)
    }
}

func game_ai_classic_battle_ai_ai_resolve_do (bt) {
    val g = bt.g
    pin tbl_weight_l = carray(NUM_SHIPDESIGNS)  ;; int[]
    pin tbl_weight_r = carray(NUM_SHIPDESIGNS)  ;; int[]
    var base_l = 0
    var base_r = 0
    var wl = 0
    var wr = 0
    set bt.biodamage = 0
    if bt.s@(SIDE_L).party < PLAYER_NUM {
        game_ai_classic_battle_ai_ai_get_weights(g, bt.s@(SIDE_L).party, tbl_weight_l)
    }
    if bt.s@(SIDE_R).party < PLAYER_NUM {
        game_ai_classic_battle_ai_ai_get_weights(g, bt.s@(SIDE_R).party, tbl_weight_r)
    }
    match bt.planet_side {
        SIDE_L => {
            val e = g.eto@(bt.s@(SIDE_L).party)
            set base_l = e.tech.percent@(TECH_FIELD_WEAPON) + e.tech.percent@(TECH_FIELD_FORCE_FIELD)
        }
        SIDE_R => {
            val e = g.eto@(bt.s@(SIDE_R).party)
            set base_r = e.tech.percent@(TECH_FIELD_WEAPON) + e.tech.percent@(TECH_FIELD_FORCE_FIELD)
        }
        else => nil
    }
    loop i in bt.s@(SIDE_L).num_types {
        set wl = wl + (bt.s@(SIDE_L).tbl_ships@(i) * tbl_weight_l@(bt.s@(SIDE_L).tbl_shiptype@(i)))
    }
    loop i in bt.s@(SIDE_R).num_types {
        set wr = wr + (bt.s@(SIDE_R).tbl_ships@(i) * tbl_weight_r@(bt.s@(SIDE_R).tbl_shiptype@(i)))
    }
    set wl = wl + (base_l * 75 * bt.bases)
    set wr = wr + (base_r * 75 * bt.bases)
    if bt.s@(SIDE_L).party >= PLAYER_NUM {
        set wl = if (bt.s@(SIDE_L).party - PLAYER_NUM) == MONSTER_GUARDIAN => 100000 => 30000
    }
    if bt.s@(SIDE_R).party >= PLAYER_NUM {
        set wr = if (bt.s@(SIDE_R).party - PLAYER_NUM) == MONSTER_GUARDIAN => 100000 => 30000
    }
    var wl2 = wl
    var wr2 = wr
    loop {
        while (wl2 > 0) && (wr2 > 0)
        var v = (rnd_1_n(10, g) * wl) // 100
        set v = SETMAX(v, 1)
        set wr2 = wr2 - v
        set v = (rnd_1_n(10, g) * wr) // 100
        set v = SETMAX(v, 1)
        set wl2 = wl2 - v
    }
    set wl2 = SETMAX(wl2, 0)
    set wr2 = SETMAX(wr2, 0)
    val r_won = wr2 > 0
    loop s in (SIDE_L, SIDE_R) {
        if bt.s@(s).party < PLAYER_NUM {
            val ws2 = if s == SIDE_L => wl2 => wr2
            val ws = if s == SIDE_L => wl => wr
            val ships = bt.s@(s).tbl_ships
            if ws == 0 {
                loop i in NUM_SHIPDESIGNS {
                    set ships@(i) = 0
                }
            } else {
                loop i in NUM_SHIPDESIGNS {
                    if game_num_doom_stack_fix {
                        set ships@(i) = u16((ships@(i) * ws2) // ws)
                    } else {
                        ;; WASBUG MOO1 uses 32bit math which results in negative overflows with large ws2,
                        ;; giving negative ship counts which get limited to 32000 later.
                        set ships@(i) = u16(i32(ships@(i) * ws2) // ws)
                    }
                }
            }
        }
    }
    if g.ai_id == GAME_AI_CLASSIC {
        ;; WASBUG MOO1 uses ui_main_loop_action for the switch variable below;
        ;; since it is UI_MAIN_LOOP_NEXT_TURN (== 8) at this point, bt->bases is unaffected.
        return r_won
    }
    match bt.planet_side {
        SIDE_L => { set bt.bases = if wl != 0 => u16((bt.bases * wl2) // wl) => 0 }
        SIDE_R => { set bt.bases = if wr != 0 => u16((bt.bases * wr2) // wr) => 0 }
        else => { set bt.bases = 0 }
    }
    ;; BUG? MOO1 passes pointers to pop1 and factories but does not touch them
    r_won
}

func game_ai_classic_battle_ai_ai_resolve (bt) {
    val r_won = game_ai_classic_battle_ai_ai_resolve_do(bt)
    game_battle_finish(bt)
    r_won
}

;; ---------------------------------------------------------------------------

func game_ai_battle_missile_dmg (bt, missile_i) {
    val m = bt.missile@(missile_i)
    val b = bt.item@(m.target)
    val bs = bt.item@(m.source)
    val w = tbl_shiptech_weap@(m.wpnt)
    var damagediv = 1
    var miss_chance = 50 - ((bs.complevel - b.misdefense) * 10)
    if b.cloak == 1 {
        set miss_chance = miss_chance + 50
    }
    set miss_chance = miss_chance - (w.extraacc * 10)
    set miss_chance = SETRANGE(miss_chance, 0, 95)
    if (m.target == 0) && (!w.is_bomb) && (w.misstype > 0) {   ;; planet
        set damagediv = 2
    }
    var damage = w.damagemax // damagediv
    if bt.g.ai_id == GAME_AI_CLASSIC {
        val absorbdiv = game_battle_get_absorbdiv(b, w, true)   ;; WASBUG checks target's Oracle
        ;; WASBUG should be damage -= b->absorb / absorbdiv; if Oracle worked for missiles
        set damage = damage - b.absorb
        set damage = damage // absorbdiv
    } else {
        set damage = damage - b.absorb  ;; missiles are not affected by Oracle
    }
    set damage = damage * w.damagemul
    set damage = SETMIN(damage, b.hp1)
    set damage = damage * m.damagemul2
    set damage = damage * m.nummissiles
    var damagepotential = if damage > 0 => (((100 - miss_chance) * damage) // 100) => 0
    SETMAX(damagepotential, 0)
}

func game_ai_battle_incoming_missiles_dmg (bt, itemi) {
    var v = 0
    if itemi == 0 {     ;; planet
        return 0
    }
    val hp = bt.item@(itemi).hp1
    loop i in bt.num_missile {
        val m = bt.missile@(i)
        if m.target == itemi {
            set v = v + (game_ai_battle_missile_dmg(bt, i) // hp)
        }
    }
    v
}

func game_ai_battle_dmgmax (bt, itemi) {
    val b = bt.item@(itemi)
    var v = 0
    val num_weap = if itemi == 0 => 1 => 4  ;; planet
    var flag_planet_opponent = false
    if (b.side + bt.item@(0).side) == 1 {
        set flag_planet_opponent = true
    }
    ;; (MOO1 also computes an unused v8, #if 0 in C)
    loop i in num_weap {
        val w = tbl_shiptech_weap@(b.wpn@(i).t)
        if b.wpn@(i).numshots != 0 {
            if w.is_bomb {
                if flag_planet_opponent {
                    var dmg = w.damagemax - bt.item@(0).absorb
                    if dmg > 0 {
                        set v = v + (dmg * b.wpn@(i).n * w.numfire)
                    }
                    if w.is_bio {
                        set dmg = w.damagemax - bt.antidote
                        if dmg > 0 {
                            set v = v + (dmg * b.wpn@(i).n * w.numfire * 50)
                        }
                    }
                }
            } else {
                set v = v + (w.damagemax * b.wpn@(i).n * w.numfire)
            }
        }
    }
    if b.blackhole == 1 {
        set v = v + 1000
    }
    v
}

func game_ai_battle_dmggive (bt, itemi1, itemi2, a2) {
    val b = bt.item@(itemi1)
    val bd = bt.item@(itemi2)
    var v = 0
    val num_weap = if itemi1 == 0 => 1 => 4     ;; planet
    var damagediv = 1
    var dmg
    if (bd.stasisby > 0) && ((a2 == 0) || (a2 == 2)) {
        return 0
    }
    var miss_chance_beam = 50 - ((b.complevel - bd.defense) * 10)
    var miss_chance_missile = 50 - ((b.complevel - bd.misdefense) * 10)
    if bd.cloak == 1 {
        set miss_chance_beam = miss_chance_beam + 50
        set miss_chance_missile = miss_chance_missile + 50
    }
    set miss_chance_beam = SETRANGE(miss_chance_beam, 0, 95)
    if bt.g.ai_id == GAME_AI_CLASSICPLUS {
        set miss_chance_missile = SETMIN(miss_chance_missile, 95)
    }
    val dist = util_math_dist_maxabs(b.sx, b.sy, bd.sx, bd.sy)
    loop i in num_weap {
        val w = tbl_shiptech_weap@(b.wpn@(i).t)
        ;; (classic: WASBUG checks target's oracle)
        val absorbdiv = if bt.g.ai_id == GAME_AI_CLASSIC => game_battle_get_absorbdiv(bd, w, true) => game_battle_get_absorbdiv(b, w, false)
        if itemi2 == 0 {    ;; planet
            if (!w.is_bomb) && ((w.misstype > 0) || (w.damagemin != w.damagemax)) {
                set damagediv = 2
            } else {
                set damagediv = 1
            }
        }
        var range = 0
        ifs {
            (w.damagemin != w.damagemax) && (!w.is_bomb) => { set range = b.extrarange }
            b.maxrange < 0 => { set range = b.maxrange }
            else => nil
        }
        if itemi1 == 0 {    ;; planet
            set range = range + 40
        }
        if true
          && ((!w.is_bomb) || (itemi2 == 0))
          && (b.wpn@(i).numshots != 0)
          && (((w.range + range) >= dist) || (a2 > 0))
          && ((b.wpn@(i).numfire > 0) || (a2 > 0)) {
            if w.damagemin == w.damagemax {
                ;; 584de
                var miss_chance = miss_chance_missile - (w.extraacc * 10)
                set miss_chance = SETRANGE(miss_chance, 0, 95)
                if bt.g.ai_id == GAME_AI_CLASSIC {
                    set miss_chance_missile = miss_chance   ;; WASBUG MOO1 substracts for every missile weapon
                }
                set dmg = ((100 - miss_chance) // 5) * (w.damagemax - (bd.absorb // absorbdiv))
                set dmg = dmg // damagediv
                set dmg = dmg * w.damagemul
                set dmg = dmg * w.nummiss
            } else {
                ;; 585ae
                var miss_chance = miss_chance_beam
                if bd.absorb > w.damagemin {
                    set miss_chance = miss_chance + (((100 - miss_chance) * (bd.absorb + 1 - w.damagemin)) // (w.damagemax + 1 - w.damagemin))
                    if bt.g.ai_id == GAME_AI_CLASSICPLUS {
                        set miss_chance = SETMIN(miss_chance, 95)
                    }
                }
                if bt.g.ai_id == GAME_AI_CLASSIC {
                    set miss_chance_beam = miss_chance  ;; WASBUG MOO1 adds for every beam weapon
                }
                ;; 5861e
                if (w.damagemax // damagediv) > (bd.absorb // absorbdiv) {
                    val dmgmax = (w.damagemax // damagediv) - (bd.absorb // absorbdiv)
                    var dmgmin
                    if bt.g.ai_id == GAME_AI_CLASSIC {
                        set dmgmin = if w.damagemin > bd.absorb => (w.damagemin - bd.absorb) => 1    ;; WASBUG {damage,absorb}div?
                    } else {
                        set dmgmin = (w.damagemin // damagediv) - (bd.absorb // absorbdiv)
                        set dmgmin = SETMAX(dmgmin, 1)
                    }
                    set dmg = (dmgmax + dmgmin) // 2
                    set dmg = ((100 - miss_chance) * dmg) // 5
                    set dmg = dmg * w.damagemul
                } else {
                    set dmg = 0
                }
            }
            ;; 58729
            if w.is_bio && (b.wpn@(i).numshots != 0) {
                set dmg = 500 * w.damagemax
            }
            ;; 58785
            if dmg <= 0 {
                set dmg = cint((w.damagemax // damagediv) > (bd.absorb // absorbdiv))
            }
            if a2 > 0 {
                set v = v + (b.wpn@(i).n * dmg * w.numfire)
            } else {
                ;; 5882d
                set v = v + (b.wpn@(i).n * dmg * b.wpn@(i).numfire)
            }
            ;; 58873
        }
    }
    if (b.warpdis == 1) && ((dist <= 3) || (a2 > 0)) && (itemi2 != 0) && (bd.unman < bd.man) {
        set v = v + 100
    }
    if (b.blackhole == 1) && ((dist <= 1) || (a2 > 0)) {
        set v = v + 1000
    }
    if (b.technull == 1) && ((dist <= 4) || (a2 > 0)) {
        set v = v + 500
    }
    if (b.pulsar == 1) && (bt.special_button == 1) && ((dist <= 1) || (a2 > 0)) {
        set dmg = (5 - bd.absorb) * bd.num  ;; FIXME BUG? should be b->num ?
        if dmg > 0 {
            set v = v + dmg
        }
    }
    if (b.pulsar == 2) && (bt.special_button == 1) && ((dist <= 1) || (a2 > 0)) {
        set dmg = (14 - bd.absorb) * bd.num     ;; FIXME BUG? should be b->num ?
        if dmg > 0 {
            set v = v + dmg
        }
    }
    if (b.stream == 1) && ((dist <= 2) || (a2 > 0)) {
        set dmg = ((bd.hp1 * ((b.num // 2) + 20)) // 100) * bd.num
        if dmg > 0 {
            set v = v + dmg
        }
    }
    if (b.stream == 2) && ((dist <= 2) || (a2 > 0)) {
        set dmg = ((bd.hp1 * (b.num + 40)) // 100) * bd.num
        if dmg > 0 {
            set v = v + dmg
        }
    }
    v
}

func game_ai_battle_rival (bt, itemi, a2) {
    val b = bt.item@(itemi)
    var rival = -1
    var maxw = 0
    loop i in (0, bt.items_num) {
        val b2 = bt.item@(i)
        if ((b.side + b2.side) == 1) && (b.num > 0) {
            var w
            val dmgmissile = game_ai_battle_incoming_missiles_dmg(bt, i)
            val dmgmax = game_ai_battle_dmgmax(bt, i)
            var dmggive = game_ai_battle_dmggive(bt, itemi, i, a2)
            val repair = (b2.repair * b2.hp2) // 100
            if itemi == 0 {     ;; planet
                var t = b.wpn@(0).t
                set b.wpn@(0).t = b.wpn@(1).t
                set b.wpn@(1).t = t
                val dmgother = game_ai_battle_dmggive(bt, itemi, i, a2)
                if dmgother > dmggive {
                    set dmggive = dmgother
                } else {
                    set t = b.wpn@(0).t
                    set b.wpn@(0).t = b.wpn@(1).t
                    set b.wpn@(1).t = t
                }
            }
            ;; 58fc7
            var dmgmany = ((b.num * dmggive) - repair) // (b2.hp1 * 20)
            if dmgmany > 0 {
                val vt = b2.num - dmgmissile    ;; FIMXE BUG? num - dmg?
                if vt < dmgmany {
                    set dmgmany = vt
                    set dmgmany = SETMAX(dmgmany, 0)
                }
                ;; 59099
                set w = dmgmany * dmgmax * 20
            } else {
                ;; 590c1
                if (dmgmissile > 0) && (dmggive > 0) {
                    set w = 3
                } else {
                    ;; 590e1
                    set w = ((dmggive - repair) * dmgmax) // b2.hp1
                }
                ;; 59124
                set w = SETMAX(w, 0)
                if dmggive > 0 {
                    set w = SETMAX(w, 3)
                }
                if (w == 1) && (i != 0) {
                    set w = 2
                }
            }
            ;; 5917c
            if (dmgmax <= 0) && (dmggive > 0) {
                set w = if i == 0 => 1 => 2
            }
            if (itemi == 0) && (w > 0) {
                val dist = util_math_dist_maxabs(b.sx, b.sy, b2.sx, b2.sy)
                set w = w + ((10 - dist) * 750)
            }
            ;; 59221
            if (i == 0) && (w == 1) {
                loop j in WEAPON_SLOT_NUM {
                    val wpnt = b.wpn@(j).t
                    if tbl_shiptech_weap@(wpnt).is_bio && (b.wpn@(j).numshots != 0) {
                        set dmggive = tbl_shiptech_weap@(wpnt).damagemax - bt.antidote
                        if dmggive > 0 {
                            set w = w + (dmggive * b.wpn@(j).n * 100)
                        }
                    }
                }
            }
            ;; 59306
            if w > maxw {
                set rival = i
                set maxw = w
                set bt.bases_using_mirv = tbl_shiptech_weap@(bt.item@(0).wpn@(0).t).nummiss > 1
            }
        }
    }
    ;; 59354
    if itemi == 0 {     ;; planet
        val t = b.wpn@(0).t
        val is_mirv = tbl_shiptech_weap@(t).nummiss > 1
        if bt.bases_using_mirv != is_mirv {
            set b.wpn@(0).t = b.wpn@(1).t
            set b.wpn@(1).t = t
        }
    }
    rival
}

func game_battle_missile_none_fired_by (bt, itemi) {
    loop i in bt.num_missile {
        if bt.missile@(i).source == itemi {
            return false
        }
    }
    true
}

func game_battle_stasis_target (bt) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    var target_i = -1
    var flag_have_unstasis = false
    do {
        var n = 0
        val itembase = if b.side == SIDE_R => 1 => (bt.s@(SIDE_L).items + 1)
        val itemnum = bt.s@(b.side ^ 1).items
        loop i in itemnum {
            if bt.item@(itembase + i).stasisby > 0 {
                set n = n + 1
            }
        }
        if (itemnum - 2) >= n {
            set flag_have_unstasis = true
        }
    }
    if flag_have_unstasis {
        var vmax = 0
        set b.stasis = 1
        loop i in (1, bt.items_num) {
            val bd = bt.item@(i)
            if (b.side != bd.side) && (bd.stasisby == 0) && (bd.cloak != 1) {
                val v = game_ai_battle_dmgmax(bt, i) * bd.num
                if v > vmax {
                    set vmax = v
                    set target_i = i
                }
            }
        }
    } else {
        set b.stasis = 2
    }
    target_i
}

func game_battle_ai_missile_evade (bt) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    var evade = 0
    if b.unman == b.man {
        return 0
    }
    var i = 0
    loop {
        while (i < bt.num_missile) && (evade <= 1)
        val m = bt.missile@(i)
        if m.target == itemi {
            var roomx
            var sx = m.x // 32
            if b.subspace == 1 {
                set roomx = 9 - sx
                set roomx = SETMAX(roomx, sx)
            } else {
                set sx = sx - b.sx
                if sx < 0 {
                    set roomx = 9 - b.sx
                } else {    ;; WASBUG this was if > 0 and the == 0 case was unhandled
                    set roomx = b.sx
                }
            }
            var movex = (b.man - b.unman) * m.fuel
            if (movex > roomx) || (b.subspace == 1) {
                set movex = roomx
            }
            var dist = util_math_dist_fast((b.sx * 32) + 16, (b.sy * 24) + 12, m.x, m.y)
            val dangerdist = (tbl_shiptech_weap@(m.wpnt).dtbl@(0) * m.fuel) + 13
            if dist > dangerdist {
                set evade = 1
            }
            set dist = dist + ((movex * 32) - 18)
            if (rnd_1_n(3, bt.g) < bt.g.difficulty) && (dist > dangerdist) {
                set evade = 2
            }
        }
        set i = i + 1
    }
    evade
}

;; Tries to approximate by how much enemy ship can increase distance in 2 turns.
func get_possible_distance_increase (bt, target_i) {
    val b = bt.item@(bt.cur_item)
    val bd = bt_item(bt, target_i)
    val si = if b.sx < bd.sx => (BATTLE_AREA_W - bd.sx - 1) => bd.sx
    val t = (bd.man - bd.unman) * 2
    set b.maxrange = i8(-MIN(si, t))
}

func game_battle_ai_best_range (bt, target_i) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    val bd = bt_item(bt, target_i)
    var bestrange = 1
    var damagediv = 1
    var weight1 = 0
    if target_i == 0 {  ;; planet
        return 1
    }
    loop i in (1, 9) {
        var weight = 0
        if (b.blackhole > 0) && (i <= 1) {
            set weight = weight + 2000
        }
        if (b.stasis == 1) && (i <= 1) {
            set weight = weight + 2000
        }
        if (b.pulsar == 1) && (i <= 1) {
            val v = (6 - bd.absorb) * bd.num
            if v > 0 {
                set weight = weight + v
            }
        }
        if (b.pulsar == 2) && (i <= 1) {
            val v = (16 - bd.absorb) * bd.num
            if v > 0 {
                set weight = weight + v
            }
        }
        if (b.stream == 1) && (i <= 2) {
            val v = (((bd.hp1 * (b.num + 20)) + 99) // 100) * bd.num
            if v > 0 {
                set weight = weight + v
            }
        }
        if (b.stream == 2) && (i <= 2) {
            val v = (((bd.hp1 * (b.num + 40)) + 99) // 100) * bd.num
            if v > 0 {
                set weight = weight + v
            }
        }
        loop j in WEAPON_SLOT_NUM {
            val w = tbl_shiptech_weap@(b.wpn@(j).t)
            var absorbdiv
            if bt.g.ai_id == GAME_AI_CLASSIC {
                set absorbdiv = game_battle_get_absorbdiv(bd, w, true)  ;; WASBUG checks target's oracle
            } else {
                set absorbdiv = if w.damagemin != w.damagemax => game_battle_get_absorbdiv(b, w, false) => 1
            }
            if target_i == 0 {  ;; planet
                if (!w.is_bomb) && ((w.misstype > 0) || (w.damagemin != w.damagemax)) {
                    set damagediv = 2
                } else {
                    set damagediv = 1   ;; WASBUG there was no else, so the 2 stuck
                }
            }
            var range = if itemi == 0 => 12 => 0
            ifs {
                (w.damagemax != w.damagemin) && (!w.is_bomb) => { set range = b.extrarange }
                !w.is_bomb => {
                    ;; if missile (or no weapon but it doesn't matter)
                    get_possible_distance_increase(bt, target_i)
                    set range = b.maxrange
                }
                else => nil
            }
            if ((w.range + range) >= i) && (b.wpn@(j).numshots != 0) && ((!w.damagefade) || (i == 1)) {
                var dmg = ((w.damagemax // damagediv) - (bd.absorb // absorbdiv)) * w.damagemul * b.wpn@(j).n * w.numfire
                if w.is_bio {
                    set dmg = w.damagemax * 100
                }
                set dmg = SETMAX(dmg, 0)
                set weight = weight + dmg
            }
        }
        if i == 1 {
            set weight1 = weight
        }
        if weight == 0 {
            break
        }
        if b.cloak == 1 {
            if weight1 > weight {
                break
            }
            set bestrange = i
        } else {
            if ((weight1 * 2) // (weight * 3)) <= 1 {
                set bestrange = i
            } else {
                break
            }
        }
    }
    bestrange
}

;; Evaluate position (sx, sy) in case ship has pulsar.
;; If position is next to friendly ship that can't absorb pulsar damage devaluate it.
;; If position is next to enemy ship that can't absorb pulsar damage add value to it.
func eval_pos_for_pulsar_use (bt, sx, sy) {
    val b = bt.item@(bt.cur_item)
    var weight = 0
    val ndiv = if b.pulsar == 1 => 2 => 1
    val rbase = if b.pulsar == 1 => 5 => 10
    val dmg = rbase + (b.num // ndiv)
    loop i in (0, bt.items_num) {
        val bd = bt.item@(i)
        if util_math_dist_maxabs(b.sx, b.sy, bd.sx, bd.sy) == 1 {
            if b.side == bd.side {
                if bd.absorb < dmg {
                    set weight = weight - 4
                }
            } else {
                if bd.absorb < dmg {
                    set weight = weight + 3
                }
            }
        }
    }
    weight
}

func game_battle_ai_target1_sub3 (bt, sx, sy, target_i, bestrange) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    val bd = bt.item@(target_i)
    var si = 0
    pin tblx = carray(20)
    pin tbly = carray(20)
    val dist = util_math_dist_maxabs(sx, sy, bd.sx, bd.sy)
    val len = util_math_line_plot(sx, sy, bd.sx, bd.sy, tblx, tbly)
    if dist == bestrange {
        set si = 10
    } else {
        set si = si - (dist * 4)
    }
    if (b.pulsar == 1) || (b.pulsar == 2) {
        set si = si + eval_pos_for_pulsar_use(bt, sx, sy)
    }
    if game_battle_area_check_line_ok(bt, tblx, tbly, len) < 1 {
        set si = si - 2
    }
    if bt.area@(sy)@(sx) == (itemi + 10) {
        set si = si + (if dist == bestrange => 1 => -1)
    }
    si
}

func game_battle_ai_target1_sub4 (bt) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    var dist = 0
    var mindist
    var n = 0
    var oppdist
    pin tblxy = carray(10)  ;; uint8_t[]
    if b.unman == b.man {
        return nil
    }
    if b.subspace == 1 {
        set oppdist = 0
        loop sy in BATTLE_AREA_H {
            loop sx in BATTLE_AREA_W {
                if bt.area@(sy)@(sx) == 1 {
                    loop i in (0, bt.items_num) {
                        val bd = bt.item@(i)
                        set mindist = 10    ;; FIXME BUG this results in always setting to last enemy dist
                        if (b.side + bd.side) == 1 {
                            set dist = util_math_dist_maxabs(sx, sy, bd.sx, bd.sy)
                            set mindist = SETMIN(mindist, dist)
                        }
                    }
                    if oppdist <= mindist {
                        if oppdist < dist {
                            set n = 0
                        }
                        set oppdist = dist
                        set tblxy@(n) = BATTLE_XY_SET(sx, sy)
                        set n = n + 1
                        set n = SETMIN(n, #tblxy - 1)   ;; WASBUG? not limited in MOO1
                    }
                }
            }
        }
        ;; 59d70
        game_battle_item_move(bt, itemi, BATTLE_XY_GET_X(tblxy@(0)), BATTLE_XY_GET_Y(tblxy@(0)))
    } else {
        ;; 59d85
        set oppdist = 10
        loop i in (0, bt.items_num) {
            val bd = bt.item@(i)
            if (b.side + bd.side) == 1 {
                set dist = util_math_dist_maxabs(b.sx, b.sy, bd.sx, bd.sy)
                set oppdist = SETMIN(oppdist, dist)
            }
        }
        loop {
            while b.actman > 0
            set n = 0
            loop sx in (b.sx - 1, b.sx + 1) {
                if (sx >= 0) && (sx < BATTLE_AREA_W) {
                    loop sy in (b.sy - 1, b.sy) {   ;; (C: sy < (b->sy + 1))
                        if (sy >= 0) && (sy < BATTLE_AREA_H) {
                            if bt.area@(sy)@(sx) == 1 {
                                set mindist = 10
                                loop i in (0, bt.items_num) {
                                    val bd = bt.item@(i)
                                    if (b.side + bd.side) == 1 {
                                        set dist = util_math_dist_maxabs(sx, sy, bd.sx, bd.sy)
                                        set mindist = SETMIN(mindist, dist)
                                    }
                                }
                                if mindist > oppdist {
                                    set oppdist = mindist
                                    set n = 1
                                    set tblxy@(0) = BATTLE_XY_SET(sx, sy)
                                }
                            }
                        }
                    }
                }
            }
            if n > 0 {
                game_battle_item_move(bt, itemi, BATTLE_XY_GET_X(tblxy@(0)), BATTLE_XY_GET_Y(tblxy@(0)))
            } else {
                set b.actman = 0
            }
        }
    }
}

func game_battle_ai_target1_sub5 (bt) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    var dist = 0
    var mindist = 10
    var missdist = 0
    var xy = BATTLE_XY_INVALID
    if b.unman == b.man {
        return nil
    }
    if b.subspace == 1 {
        loop sy in BATTLE_AREA_H {
            loop sx in BATTLE_AREA_W {
                if bt.area@(sy)@(sx) == 1 {
                    loop i in bt.num_missile {
                        val m = bt.missile@(i)
                        if (m.target == itemi) && (m.fuel < 8) {
                            set mindist = 10    ;; FIXME BUG this results in always setting to last missile dist
                            set dist = util_math_dist_maxabs(sx, sy, m.x // 32, m.y // 24)
                            set mindist = SETMIN(mindist, dist)
                        }
                    }
                    if missdist < mindist {
                        set xy = BATTLE_XY_SET(sx, sy)
                        set missdist = dist     ;; FIXME BUG? should be mindist ?
                    }
                }
            }
        }
        if xy == BATTLE_XY_INVALID {
            log_warning("BUG: subspace destination not found\n")
            set xy = BATTLE_XY_SET(b.sx, b.sy)
        }
        game_battle_item_move(bt, itemi, BATTLE_XY_GET_X(xy), BATTLE_XY_GET_Y(xy))
    } else {
        ;; 5a0d8
        loop {
            while b.actman > 0
            set missdist = 10
            loop i in bt.num_missile {
                val m = bt.missile@(i)
                if (m.target == itemi) && (m.fuel < 8) {
                    set dist = util_math_dist_maxabs(b.sx, b.sy, m.x // 32, m.y // 24)
                    set missdist = SETMIN(missdist, dist)
                }
            }
            set xy = BATTLE_XY_INVALID
            loop sx in (b.sx - 1, b.sx + 1) {
                if (sx >= 0) && (sx < BATTLE_AREA_W) {
                    loop sy in (b.sy - 1, b.sy) {   ;; (C: sy < (b->sy + 1))
                        if (sy >= 0) && (sy < BATTLE_AREA_H) {
                            if (bt.area@(sy)@(sx) == 1) && ((b.sx != sx) || (b.sy != sy)) {
                                set mindist = 10
                                loop i in bt.num_missile {
                                    val m = bt.missile@(i)
                                    if (m.target == itemi) && (m.fuel < 8) {
                                        set dist = util_math_dist_maxabs(sx, sy, m.x // 32, m.y // 24)
                                        set mindist = SETMIN(mindist, dist)
                                    }
                                }
                                if mindist > missdist {
                                    set missdist = mindist
                                    set xy = BATTLE_XY_SET(sx, sy)
                                }
                            }
                        }
                    }
                }
            }
            if xy != BATTLE_XY_INVALID {
                game_battle_item_move(bt, itemi, BATTLE_XY_GET_X(xy), BATTLE_XY_GET_Y(xy))
            } else {
                set b.actman = 0
            }
        }
    }
}

func game_battle_ai_target1 (bt, target_i) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    val bestrange = game_battle_ai_best_range(bt, target_i)
    if (b.actman > 0) || (b.subspace == 1) {
        ifs {
            (target_i != -1) && (game_battle_ai_missile_evade(bt) == 0) => {
                var vmax = -999
                var n = 1
                pin tblxy = carray(20)  ;; uint8_t[]
                loop sy in BATTLE_AREA_H {
                    loop sx in BATTLE_AREA_W {
                        if (bt.area@(sy)@(sx) == 1) || ((b.sx == sx) && (b.sy == sy)) {
                            ;; 5a3dc
                            val v = game_battle_ai_target1_sub3(bt, sx, sy, target_i, bestrange)
                            ifs {
                                v > vmax => {
                                    set n = 1
                                    set tblxy@(0) = BATTLE_XY_SET(sx, sy)
                                    set vmax = v
                                }
                                (v == vmax) && (n < #tblxy) => {
                                    set tblxy@(n) = BATTLE_XY_SET(sx, sy)
                                    set n = n + 1
                                }
                                else => nil
                            }
                        }
                    }
                }
                ;; 5a449
                val i = if n < 2 => 0 => rnd_0_nm1(n, bt.g)
                if itemi != 0 {     ;; planet
                    game_battle_item_move(bt, itemi, BATTLE_XY_GET_X(tblxy@(i)), BATTLE_XY_GET_Y(tblxy@(i)))
                }
            }
            target_i == -1 => {
                ;; 5a494
                game_battle_ai_target1_sub4(bt)
            }
            else => {
                ;; 5a4a0
                game_battle_ai_target1_sub5(bt)
            }
        }
    }
    bestrange
}

func game_ai_classic_battle_ai_turn (bt) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    ;; 5a581
    var target_i = 0    ;; FIXME WASBUG used uninitialized later ; proper value ?
    var v4
    game_battle_area_setup(bt)  ;; FIXME already done by caller
    if true
      && (b.side == SIDE_R)
      && (game_ai_battle_rival(bt, itemi, 1) == -1)
      && game_battle_missile_none_fired_by(bt, itemi) {
        set b.retreat = u8(b.retreat + 1)
    }
    ;; 5a5cb
    if (b.man - b.unman) == 0 {
        set b.retreat = 0
    }
    ;; 5a604
    if b.stasis > 0 {
        set target_i = game_battle_stasis_target(bt)
        if target_i != -1 {
            game_battle_ai_target1(bt, target_i)
            game_battle_area_setup(bt)
            if !bt.flag_cur_item_destroyed {
                val bd = bt.item@(target_i)
                if util_math_dist_maxabs(b.sx, b.sy, bd.sx, bd.sy) <= 1 {
                    get_possible_distance_increase(bt, target_i)
                    game_battle_attack(bt, itemi, target_i, false)
                }
            }
        }
    }
    ;; 5a69e
    game_battle_area_setup(bt)
    if (game_ai_battle_incoming_missiles_dmg(bt, itemi) > 0) && (target_i != -1) {     ;; BUG used uninitialized if b->stasis == 0
        set target_i = game_ai_battle_rival(bt, itemi, 0)
        if target_i > -1 {
            if (b.pulsar == 1) || (b.pulsar == 2) {
                if eval_pos_for_pulsar_use(bt, b.sx, b.sy) < 0 {
                    set bt.special_button = 0
                }
            }
            ;; 5a72a
            get_possible_distance_increase(bt, target_i)
            game_battle_attack(bt, itemi, target_i, false)
        }
    }
    ;; 5a740
    if bt.special_button == -1 {
        set bt.special_button = 1
    }
    game_battle_area_setup(bt)
    if b.retreat > 0 {
        set target_i = -1
    } else {
        set target_i = game_ai_battle_rival(bt, itemi, 2)
    }
    if !bt.flag_cur_item_destroyed {
        set v4 = game_battle_ai_target1(bt, target_i)
    }
    if !bt.flag_cur_item_destroyed {
        if (b.pulsar == 1) || (b.pulsar == 2) {
            if eval_pos_for_pulsar_use(bt, b.sx, b.sy) < 0 {
                set bt.special_button = 0
            }
        }
        set target_i = game_ai_battle_rival(bt, itemi, 0)
        if (target_i == -1) && (itemi == 0) && (b.num > 0) {    ;; planet
            val ii = if b.side == SIDE_R => 1 => (bt.s@(SIDE_L).items + 1)
            if bt.item@(ii).side != b.side {
                game_battle_attack(bt, itemi, ii, false)
            }
        }
        ;; 5a866
        var loops = 0
        loop {
            while target_i != -1
            set target_i = game_ai_battle_rival(bt, itemi, 0)
            set loops = loops + 1
            if (b.cloak == 1) && (target_i != -1) {     ;; WASBUG no test for -1
                val bd = bt.item@(target_i)
                if util_math_dist_maxabs(b.sx, b.sy, bd.sx, bd.sy) != v4 {  ;; WASBUG bd at index -1
                    set target_i = -1
                }
            }
            if b.retreat > 0 {
                set target_i = -1
            }
            ;; 5a8e1
            if target_i > -1 {
                get_possible_distance_increase(bt, target_i)
                game_battle_attack(bt, itemi, target_i, false)
            }
            if loops > 10 {     ;; MOO1 does not need this but it does have the loop counter
                ;; (C: LOG_DEBUG "BUG: break from loop")
                break
            }
        }
        ;; 5a91b
        set b.selected = 0
        set bt.turn_done = true
    }
    ;; 5a934
}

;; ---------------------------------------------------------------------------

func game_ai_classic_battle_ai_retreat (bt) {
    pin missile = carray(BATTLE_ITEM_MAX)   ;; int[]
    pin repair = carray(BATTLE_ITEM_MAX)    ;; uint32_t[]
    pin dmg = carray(2)     ;; int64_t[]
    pin hp = carray(2)      ;; uint32_t[]
    loop i in BATTLE_ITEM_MAX {
        val b = bt.item@(i)
        set missile@(i) = 0
        set repair@(i) = (b.hp1 * b.repair) // 5
    }
    loop i in bt.num_missile {
        val m = bt.missile@(i)
        if m.target != MISSILE_TARGET_NONE {
            val s = bt.item@(m.target).side
            set missile@(m.source) = missile@(m.source) + 2
            set dmg@(s) = dmg@(s) + (game_ai_battle_missile_dmg(bt, i) // (missile@(m.source) + 1))
            set dmg@(s) = dmg@(s) - repair@(m.target)
            set repair@(m.target) = 0
        }
    }
    loop i in (1, bt.items_num) {
        val s = if i <= bt.s@(SIDE_L).items => SIDE_R => SIDE_L
        val j = game_ai_battle_rival(bt, i, 1)
        if j >= 0 {
            val b = bt.item@(i)
            set hp@(s ^ 1) = u32(hp@(s ^ 1) + (b.hp1 * b.num))
            set dmg@(s) = dmg@(s) + (game_ai_battle_dmggive(bt, i, j, 1) * b.num)
            set dmg@(s) = dmg@(s) - repair@(j)
            set repair@(j) = 0
        } else {
            set hp@(s ^ 1) = u32(hp@(s ^ 1) + 1)
        }
    }
    if bt.item@(0).num > 0 {    ;; planet
        val b = bt.item@(0)
        val s = if b.side == SIDE_L => SIDE_R => SIDE_L
        set hp@(s ^ 1) = u32(hp@(s ^ 1) + ((b.hp1 * b.num * 7) // 10))
        val j = game_ai_battle_rival(bt, 0, 1)
        if j > 0 {
            set dmg@(s) = dmg@(s) + ((game_ai_battle_dmggive(bt, 0, j, 1) * b.num * 7) // 10)
            set dmg@(s) = dmg@(s) - ((repair@(j) * 7) // 10)
            set repair@(j) = 0
        }
    }
    if hp@(SIDE_L) == 0 {
        return false
    }
    if hp@(SIDE_R) == 0 {
        return false
    }
    if dmg@(SIDE_L) == 0 {
        return true
    }
    var v = ((5 - bt.g.difficulty) * 5) + 5
    match bt.item@(0).side {
        SIDE_L => { set v = v + 10 }
        SIDE_R => { set v = v + 20 }
        else => nil
    }
    set v = v + rnd_1_n(15, bt.g)
    var wr
    var wl
    if bt.g.ai_id == GAME_AI_CLASSICPLUS {
        set wr = (dmg@(SIDE_R) * 100) // hp@(SIDE_R)
        set wl = (dmg@(SIDE_L) * 100 * v) // hp@(SIDE_L)
    } else {    ;; WASBUG MOO1 uses 32b vars which can overflow on extreme cases
        ;; (an int32_t divided by the uint32_t hp: an unsigned division)
        set wr = i32(u32(i32(dmg@(SIDE_R)) * 100) // hp@(SIDE_R))
        set wl = i32(u32(i32(i32(dmg@(SIDE_L)) * 100) * v) // hp@(SIDE_L))
    }
    wr > wl
}

;; ---------------------------------------------------------------------------

func game_ai_classic_tech_next (g, player, field, tbl, num) {
    var tech    ;; uint8_t
    if rnd_1_n(6, g) < g.difficulty {
        set tech = tbl@(num - 1)
    } else {
        set tech = tbl@(rnd_0_nm1(num, g))
    }
    tech
}

;; ---------------------------------------------------------------------------

func game_ai_classic_bomb (g, player, planet, pop_inbound0) {
    var pop_inbound = pop_inbound0
    val p = g.planet@(planet)
    if g.eto@(player).race == RACE_BULRATHI {
        if g.ai_id == GAME_AI_CLASSICPLUS {
            ;; OSG states 2.15:1 average kill:death ratio for +20 (+Bulrathi -Defense) advantage
            set pop_inbound = (pop_inbound * 215) // 100
        } else {
            set pop_inbound = pop_inbound + (pop_inbound // 5)
        }
    }
    var flag_do_bomb = p.pop > pop_inbound
    if IS_HUMAN(g, p.owner) && (g.evn.ceasefire@(p.owner)@(player) > 0) {
        set flag_do_bomb = false
    }
    flag_do_bomb
}

;; ---------------------------------------------------------------------------

func game_ai_classic_ground (g, def, att, planet, pop_killed0, owner_changed) {
    var pop_killed = pop_killed0
    if IS_HUMAN(g, def) {
        return nil
    }
    if IS_AI(g, att) {
        ;; e996
        set pop_killed = 1  ;; FIXME BUG? AI-AI ground diplo always sees 1 pop killed
        ;; e9c4
        game_diplo_act(g, -((rnd_1_n(4, g) + 4) * pop_killed), att, def, 0xa, planet, 0)
    } else {
        if owner_changed && IS_HUMAN(g, att) {
            if g.eto@(att).treaty@(def) < TREATY_WAR {
                game_diplo_act(g, -50 - rnd_1_n(50, g), att, def, 0xd, planet, 0)
                game_diplo_start_war_swap(g, def, att)
            } else {
                ;; e93f
                game_diplo_act(g, -50 - rnd_1_n(50, g), att, def, 0xa, planet, 0)
            }
        } else {
            ;; e969
            game_diplo_act(g, -((rnd_1_n(5, g) + 5) * pop_killed), att, def, 0xa, planet, 0)
        }
    }
}

;; ---------------------------------------------------------------------------

func game_ai_classic_add_reserve (g, p) {
    val e = g.eto@(p.owner)
    val v = e.reserve_bc // 5   ;; uint32_t
    set e.reserve_bc = u32(e.reserve_bc - v)
    set p.reserve = u32(p.reserve + v)
}

func game_ai_classic_crank_tech (g, planet) {
    val p = g.planet@(planet)
    if (p.owner == PLAYER_NONE) || IS_HUMAN(g, p.owner) {
        return nil
    }
    var v = p.slider@(PLANET_SLIDER_SHIP)
    set v = v + p.slider@(PLANET_SLIDER_IND)
    set v = v + p.slider@(PLANET_SLIDER_DEF)
    set p.slider@(PLANET_SLIDER_TECH) = i16(p.slider@(PLANET_SLIDER_TECH) + v)
    set p.slider@(PLANET_SLIDER_SHIP) = 0
    set p.slider@(PLANET_SLIDER_IND) = 0
    set p.slider@(PLANET_SLIDER_DEF) = 0
    game_ai_classic_add_reserve(g, p)
}

func game_ai_classic_crank_ship (g, planet) {
    val p = g.planet@(planet)
    if (p.owner == PLAYER_NONE) || IS_HUMAN(g, p.owner) {
        return nil
    }
    var v = p.slider@(PLANET_SLIDER_TECH)
    set v = v + p.slider@(PLANET_SLIDER_IND)
    set v = v + p.slider@(PLANET_SLIDER_DEF)
    set p.slider@(PLANET_SLIDER_SHIP) = i16(p.slider@(PLANET_SLIDER_SHIP) + v)
    set p.slider@(PLANET_SLIDER_TECH) = 0
    set p.slider@(PLANET_SLIDER_IND) = 0
    set p.slider@(PLANET_SLIDER_DEF) = 0
    game_ai_classic_add_reserve(g, p)
}

;; ---------------------------------------------------------------------------

func game_ai_classic_vote_w (g, player, cand) {
    var v = 0
    if g.planet@(g.evn.planet_orion_i).owner == cand {
        set v = v + 20
    }
    if g.eto@(cand).race == RACE_HUMAN {
        set v = v + 20
    }
    if g.evn.voted@(player) == cand {
        set v = v + 40
    }
    v
}

func game_ai_classic_vote_like (g, player, cand) {
    var v = g.eto@(player).relation1@(cand) // 4
    set v = v + game_ai_classic_vote_w(g, player, cand)
    rnd_1_n(100, g) < v
}

func game_ai_classic_vote_hate (g, player, c1, c2) {
    var v = (-g.eto@(player).relation1@(c1)) // 4
    set v = v + game_ai_classic_vote_w(g, player, c2)
    rnd_1_n(100, g) < v
}

func game_ai_classic_vote (el, player) {
    val g = el.g
    val e = g.eto@(player)
    val c1 = el.candidate@(0)
    val c2 = el.candidate@(1)
    if player == c1 {
        return 1
    }
    if player == c2 {
        return 2
    }
    if e.treaty@(c1) == TREATY_ALLIANCE {
        return 1
    }
    if e.treaty@(c2) == TREATY_ALLIANCE {
        return 2
    }
    if e.treaty@(c1) == TREATY_WAR {
        return 2
    }
    if e.treaty@(c2) == TREATY_WAR {
        return 1
    }
    if e.relation1@(c1) >= 0 {
        if game_ai_classic_vote_like(g, player, c1) {
            return 1
        }
    } else {
        if game_ai_classic_vote_hate(g, player, c1, c2) {
            return 2
        }
    }
    if e.relation1@(c2) >= 0 {
        if game_ai_classic_vote_like(g, player, c2) {
            return 2
        }
    } else {
        var v = (-g.eto@(player).relation1@(c2)) // 5     ;; FIXME BUG? the other case uses / 4
        set v = v + game_ai_classic_vote_w(g, player, c1)
        if rnd_1_n(100, g) < v {
            return 1
        }
    }
    0
}

;; ---------------------------------------------------------------------------
;; The diplomacy.

func game_ai_classic_diplo_wage_war_fleet_w (g, p1, p2) {
    pin fleetw = carray(2)  ;; int[2]
    loop i in 2 {
        val player = if i == 0 => p1 => p2
        val e = g.eto@(player)
        val srd = g.srd@(player)
        set fleetw@(i) = 0
        loop j in e.shipdesigns_num {
            val v = u32(srd.shipcount@(j) * game_num_tbl_hull_w@(srd.design@(j).hull))
            set fleetw@(i) = ADDSATT(fleetw@(i), v, 3250000)
        }
        set fleetw@(i) = SETMAX(fleetw@(i), 1)
    }
    var ratio = ((fleetw@(0) - fleetw@(1)) * 100) // fleetw@(1)
    set ratio = SETRANGE(ratio, -300, 300)
    ifs {
        ratio == 0 => 0
        ratio < 0 => -rnd_1_n(-ratio, g)
        else => rnd_1_n(ratio, g)
    }
}

func game_ai_classic_diplo_wage_war_do (g, p1, p2) {
    val e1 = g.eto@(p1)
    val e2 = g.eto@(p2)
    if (e1.treaty@(p2) == TREATY_ALLIANCE) || (e1.treaty@(p2) == TREATY_NONAGGRESSION) {
        if g.difficulty < DIFFICULTY_AVERAGE {
            return nil
        }
        if false
          || ((e1.treaty@(p2) == TREATY_ALLIANCE) && ((rnd_0_nm1(4, g) == 0) || ((rnd_0_nm1(2, g) == 0) && (e2.trait2 == TRAIT2_EXPANSIONIST))))
          || ((e1.treaty@(p2) == TREATY_NONAGGRESSION) && ((rnd_0_nm1(2, g) == 0) || (e2.trait2 == TRAIT2_EXPANSIONIST))) {
            game_diplo_act(g, -10000, p1, p2, 32, 0, 0)
            game_diplo_break_treaty(g, p2, p1)
            if e1.relation1@(p2) > 30 {
                set e1.relation1@(p2) = 30
                set e2.relation1@(p1) = 30
            }
        }
    } else {
        if g.evn.ceasefire@(p1)@(p2) <= 0 {
            game_diplo_act(g, -10000, p1, p2, if e1.relation1@(p2) < 0 => 13 => 60, 0, 0)
            game_diplo_start_war(g, p2, p1)
        }
    }
}

func game_ai_classic_diplo_wage_war_prod_w (g, p1, p2) {
    val prod0 = i32(g.eto@(p1).total_production_bc)
    val prod1 = SETRANGE(i32(g.eto@(p2).total_production_bc), 1, 3250000)  ;; FIXME BUG? only p2 prod limited
    var ratio = ((prod0 - prod1) * 100) // prod1
    set ratio = SETRANGE(ratio, -300, 300)
    ifs {
        ratio == 0 => 0
        ratio < 0 => -rnd_1_n(-ratio, g)
        else => rnd_1_n(ratio, g)
    }
}

func game_ai_classic_diplo_wage_war (g, p1, p2) {
    if g.end != GAME_END_NONE {
        loop q1 in g.players {
            val e1 = g.eto@(q1)
            loop q2 in g.players {
                if (q1 != q2) && (BOOLVEC_IS1(g.refuse, q1) == BOOLVEC_IS1(g.refuse, q2)) {
                    set e1.treaty@(q2) = TREATY_ALLIANCE
                }
            }
        }
    } else {
        val e1 = g.eto@(p1)
        val e2 = g.eto@(p2)
        if (e1.treaty@(p2) >= TREATY_WAR) || BOOLVEC_IS0(e1.contact, p2) || (!IS_ALIVE(g, p1)) {
            return nil
        }
        if true
          && (e2.trait1 == TRAIT1_ERRATIC)
          && (rnd_1_n(300, g) <= g.difficulty)
          && (IS_AI(g, p1) || (g.evn.ceasefire@(p1)@(p2) < 1)) {
            set e1.diplo_type@(p2) = 61
            set e1.diplo_val@(p2) = 2000
            game_diplo_start_war(g, p2, p1)
        } else {
            if true
              && (rnd_0_nm1(20, g) == 0)
              && ((e2.trait2 == TRAIT2_MILITARIST) || (e2.trait2 == TRAIT2_EXPANSIONIST))
              && (e2.trait1 != TRAIT1_HONORABLE)
              && (IS_AI(g, p1) || (g.evn.ceasefire@(p1)@(p2) < 1)) {
                var v = game_ai_classic_diplo_wage_war_fleet_w(g, p1, p2)
                set v = e1.relation1@(p2) - v + game_diplo_tbl_reldiff@(e2.trait1) + e1.trust@(p2)
                if v < -150 {
                    game_ai_classic_diplo_wage_war_do(g, p1, p2)
                }
            }
            ;; 1679f
            if true
              && (rnd_0_nm1(20, g) == 0)
              && (IS_AI(g, p1) || (g.evn.ceasefire@(p1)@(p2) < 1)) {
                var v = game_ai_classic_diplo_wage_war_prod_w(g, p1, p2)
                set v = e1.relation1@(p2) - v + game_diplo_tbl_reldiff@(e2.trait1) + e1.trust@(p2)
                if v < -150 {
                    game_ai_classic_diplo_wage_war_do(g, p1, p2)
                }
            }
        }
        ;; 16829
        loop p3 in g.players {
            if !IS_HUMAN(g, p3) {
                loop p4 in g.players {
                    val e4 = g.eto@(p4)
                    if !IS_AI(g, p4) {
                        if true
                          && (e4.treaty@(p3) == TREATY_WAR)
                          && (e2.treaty@(p3) == TREATY_ALLIANCE)
                          && (g.evn.ceasefire@(p4)@(p2) <= 0)
                          && (rnd_0_nm1(10, g) == 0)
                          && (e2.treaty@(p1) == TREATY_ALLIANCE) {
                            game_ai_classic_diplo_wage_war_do(g, p1, p2)
                        }
                    }
                }
            }
        }
        if IS_HUMAN(g, p1) && (g.difficulty >= DIFFICULTY_AVERAGE) {
            var num = 0
            loop p3 in g.players {
                if e1.treaty@(p3) >= TREATY_WAR {
                    set num = num + 1
                }
            }
            if num < g.difficulty {
                ;; MOO1 does unused buggy count of planets ; overwrites local variable at tbl[-1] (which is also unused)
                var v = e1.relation1@(p2)
                if v < -30 {
                    set v = (-v) // 10
                    if rnd_1_n(10, g) <= v {
                        game_ai_classic_diplo_wage_war_do(g, p1, p2)
                    }
                }
            }
        }
    }
}

func game_ai_classic_turn_diplo_p1_sub1 (g) {
    loop p1 in g.players {
        val e1 = g.eto@(p1)
        if !IS_HUMAN(g, p1) {
            var p2 = p1 + 1
            loop {
                while p2 < g.players
                val e2 = g.eto@(p2)
                if !IS_HUMAN(g, p2) {
                    ;; FIXME BUG? p2 + 1 ; BUG p3 < ; BUG ++p3
                    ;; (C loops on p2, the variable of the outer loop, with p3 fixed)
                    val p3 = p1 + 1
                    loop {
                        while p2 < g.players
                        if !IS_HUMAN(g, p3) {
                            if (e2.treaty@(p3) == TREATY_WAR) && (e1.treaty@(p2) == TREATY_ALLIANCE) && (e1.treaty@(p3) == TREATY_ALLIANCE) {
                                game_diplo_break_treaty(g, p1, p2)
                                game_diplo_break_treaty(g, p1, p3)
                            }
                        }
                        set p2 = p2 + 1
                    }
                }
                set p2 = p2 + 1
            }
        }
    }
}

;; Gives (num, field, tech): the `fieldptr` and `techptr` of C.
func game_ai_classic_turn_diplo_p1_get_ai_trade_tech (g, p1, p2) {
    pin s = spy_esp_s()
    var field = 0
    var tech = 0
    set s.target = p1
    set s.spy = p2
    val r = rnd_1_n(3, g)
    val num = game_spy_esp_sub2(g, s, r)
    ;; WASBUG
    ;; MOO1 does field = s.tbl_field[0] and tech = s.tbl_tech2[0] but neither is set by game_spy_esp_sub2.
    ;; MOO1 uses global variables for the tables; the values are from some previous spy call (possibly ground combat tech steal).
    if num > 0 {
        var i = (g.year ^ r) % num  ;; "random" value without advancing the rng
        loop f in TECH_FIELD_NUM {
            val n = s.tbl_num@(f)
            if i < n {
                set field = f
                set tech = s.tbl_techi@(f)@(i)
                break
            }
            set i = i - n
        }
    }
    (num, field, tech)
}

func game_ai_classic_turn_diplo_p1 (g) {
    loop p1 in g.players {
        val e1 = g.eto@(p1)
        if !IS_HUMAN(g, p1) {
            loop p2 in g.players {
                val e2 = g.eto@(p2)
                if (p1 != p2) && !IS_HUMAN(g, p2) {
                    if (rnd_0_nm1(15 - (g.difficulty * 2), g) == 0) && BOOLVEC_IS1(e1.contact, p2) {
                        var v = e1.trust@(p2) + e1.relation1@(p2) + game_diplo_tbl_reldiff@(e2.trait1) + rnd_1_n(100, g)
                        if e1.treaty@(p2) == TREATY_NONAGGRESSION {
                            set v = v + 10
                        }
                        if e1.treaty@(p2) == TREATY_ALLIANCE {
                            set v = v + 20
                        }
                        if e1.trade_bc@(p2) != 0 {
                            set v = v + 10
                        }
                        ifs {
                            ((v + e1.mood_treaty@(p2)) > 150) && (e1.treaty@(p2) != TREATY_ALLIANCE) => {
                                game_diplo_set_treaty(g, p1, p2, TREATY_ALLIANCE)
                            }
                            ((v + e1.mood_treaty@(p2)) > 150) && (e1.treaty@(p2) != TREATY_NONAGGRESSION) => {    ;; BUG ignores Alliance, results in NAP/Alliance oscillation
                                game_diplo_set_treaty(g, p1, p2, TREATY_NONAGGRESSION)
                            }
                            else => {
                                ifs {
                                    (e1.mood_tech@(p2) + 80) < v => {
                                        val num0, field0, tech0 = game_ai_classic_turn_diplo_p1_get_ai_trade_tech(g, p1, p2)
                                        val num1, field1, tech1 = game_ai_classic_turn_diplo_p1_get_ai_trade_tech(g, p2, p1)
                                        if (num0 > 0) && (num1 > 0) {
                                            game_tech_get_new(g, p2, field0, tech0, TECHSOURCE_TRADE, 0, PLAYER_NONE, false)
                                            game_tech_get_new(g, p1, field1, tech1, TECHSOURCE_TRADE, 0, PLAYER_NONE, false)
                                        }
                                    }
                                    v > 70 => {
                                        var v1 = i32(e1.total_production_bc // 4)
                                        val v2 = i32(e2.total_production_bc // 4)
                                        set v1 = SETMIN(v1, v2)
                                        set v1 = SETMIN(v1, 32000)
                                        game_diplo_set_trade(g, p1, p2, v1)
                                    }
                                    else => nil
                                }
                            }
                        }
                        if rnd_0_nm1(20, g) == 0 {
                            game_diplo_act(g, rnd_1_n(5, g), p1, p2, 1, 0, 0)
                        }
                        ;; WASBUG
                        ;; MOO1 uses the last audience message variant index (diplo_msg_subtype, -1..13) in place of v.
                        ;; This is weird, nondeterministic (in MOO1) and unworkable for multiplayer.
                        ;; Whether v is what was intended is unknown, but it makes a whole lot more sense.
                        if g.ai_id == GAME_AI_CLASSIC {
                            set v = g.evn.diplo_msg_subtype
                        }
                        if (e1.treaty@(p2) == TREATY_WAR) && ((v + e1.mood_peace@(p2)) > 100) {
                            game_diplo_stop_war(g, p1, p2)
                        }
                        game_diplo_annoy(g, p1, p2, 3)
                        game_ai_classic_turn_diplo_p1_sub1(g)
                        game_ai_classic_diplo_wage_war(g, p1, p2)
                    }
                }
            }
        }
    }
    loop p1 in g.players {
        val e1 = g.eto@(p1)
        if !IS_HUMAN(g, p1) {
            loop p2 in g.players {
                if (p1 != p2) && !IS_HUMAN(g, p2) {
                    if e1.treaty@(p2) == TREATY_ALLIANCE {
                        loop p3 in g.players {
                            val e3 = g.eto@(p3)
                            if (p1 != p3) && (p2 != p3) && IS_AI(g, p3) && (e3.treaty@(p1) == TREATY_WAR) && (e3.treaty@(p2) != TREATY_WAR) {
                                game_diplo_start_war(g, p2, p3)
                            }
                        }
                    }
                }
            }
        }
    }
}

;; ---------------------------------------------------------------------------

func game_ai_classic_turn_diplo_p2_offer (g, p1, p2) {
    val e1 = g.eto@(p1)
    val e2 = g.eto@(p2)
    if rnd_0_nm1(4, g) != 0 {
        set e1.offer_bc@(p2) = u16((((e2.total_production_bc // (rnd_1_n(3, g) + 1)) + g.year) // 25) * 25)
    } else {
        pin s = spy_esp_s()
        set s.spy = p1
        set s.target = p2
        if game_spy_esp_sub1(g, s, 0, 2) > 0 {
            set e1.offer_field@(p2) = s.tbl_field@(0)
            set e1.offer_tech@(p2) = s.tbl_tech2@(0)
        }
    }
}

func game_ai_classic_turn_diplo_p2_sub1 (g, p1, p2) {
    val e1 = g.eto@(p1)
    val e2 = g.eto@(p2)
    if BOOLVEC_IS0(e1.contact, p2) || (e1.treaty@(p2) >= TREATY_WAR) {  ;; WASBUG? MOO1 also tests for "|| (e1->diplo_val == 0)" ; note the missing [p2]
        set e1.diplo_type@(p2) = 0
        return nil
    }
    if game_fleet_any_dest_player(g, p2, p1) {
        set e1.diplo_type@(p2) = 0
        return nil
    }
    if (e1.diplo_type@(p2) != 0) && (rnd_0_nm1(2, g) == 0) {
        return nil
    }
    var v4 = 0
    var v = e1.trust@(p2) + e1.relation1@(p2) + (if e1.race == RACE_HUMAN => 50 => 0) + game_diplo_tbl_reldiff@(e2.trait1)
    if (e1.treaty@(p2) == TREATY_NONE) && (e1.relation1@(p2) > 15) {
        val v8 = v + rnd_1_n(100, g) + e1.mood_treaty@(p2)
        if v8 > 50 {
            set v4 = 1
            set e1.diplo_type@(p2) = 24
        }
    }
    ;; 41684
    if ((e1.treaty@(p2) == TREATY_NONAGGRESSION) || (v4 == 1)) && (e1.relation1@(p2) > 50) {
        val v8 = v + rnd_1_n(100, g) + e1.mood_treaty@(p2)
        if v8 > 100 {
            set v4 = 2
            set e1.diplo_type@(p2) = 25
        }
    }
    ;; 416e8
    if v4 == 0 {
        val v8 = v + rnd_1_n(150, g) + e1.mood_trade@(p2)
        if v8 > 50 {
            var prod = i32(MIN(e1.total_production_bc, e2.total_production_bc) // 4)
            set prod = SETMIN(prod, 32000)
            var want_trade = prod // 25
            if want_trade != 0 {
                set want_trade = rnd_1_n(want_trade, g) * 25
            }
            if e1.trade_bc@(p2) < want_trade {
                set v4 = 3
                set e1.diplo_type@(p2) = 26
                set e1.au_want_trade@(p2) = u16(want_trade)
            }
        }
    }
    ;; 417f2
    if v4 == 0 {
        var pa = PLAYER_NONE
        loop p3 in g.players {
            if (p3 != p1) && (p3 != p2) && (e2.treaty@(p3) >= TREATY_WAR) && BOOLVEC_IS1(e1.contact, p3) {
                set pa = p3
            }
        }
        if (pa != PLAYER_NONE) && (rnd_0_nm1(10, g) == 0) && (e1.attack_bounty@(p2) == PLAYER_NONE) {
            pin s = spy_esp_s()
            set s.spy = p1
            set s.target = p2
            val num = game_spy_esp_sub1(g, s, 0, 2)
            ;; game_spy_esp_get_random(g, s, &field, &tech); unused
            var bc = 0
            if num == 0 {
                set bc = (((rnd_1_n(3, g) + 1) * g.year) // 50) * 50
                set s.tbl_tech2@(0) = 0
            }
            if (bc != 0) || (num != 0) {
                set v4 = 4
                set e1.diplo_type@(p2) = 28
                set e1.attack_bounty@(p2) = pa
                set e1.attack_gift_field@(p2) = s.tbl_field@(0)
                set e1.attack_gift_tech@(p2) = s.tbl_tech2@(0)
                set e1.attack_gift_bc@(p2) = i16(bc)
                set e1.bounty_collect@(p2) = PLAYER_NONE
            }
        }
    }
    ;; 418d2
    if v4 == 0 {
        var v8 = v + rnd_1_n(100, g) + e1.mood_trade@(p2)
        if v8 > 25 {
            pin s = spy_esp_s()
            var v1c = e1.mood_tech@(p2)
            if v1c > 0 {
                set v1c = v1c // 5
            }
            set v1c = SETMIN(v1c, 30)
            if e1.treaty@(p2) == TREATY_ALLIANCE {
                set v1c = v1c + 25
            }
            set v = e1.trust@(p2) + (e1.relation1@(p2) // 2) + (if e2.race == RACE_HUMAN => 50 => 0) + game_diplo_tbl_reldiff@(e2.trait1) + v1c - 125
            set v8 = v + rnd_1_n(100, g) + v1c - 125
            var v14 = if v8 < 0 => (math.abs(v8) + 100) => (20000 // (v8 + 200))
            set v14 = SETMIN(v14, 50)
            set s.spy = p2
            set s.target = p1
            var num = game_spy_esp_sub1(g, s, 0, 0)
            if num > 0 {
                val zfield = s.tbl_field@(0)
                val ztech = s.tbl_tech2@(0)
                val zvalue = (s.tbl_value@(0) * 100) // v14
                set s.spy = p1
                set s.target = p2
                set num = game_spy_esp_sub1(g, s, zvalue, 1)
                var found = false
                loop i in num {
                    if s.tbl_value@(i) <= zvalue {
                        set found = true
                        break
                    }
                }
                if found {
                    var n = 0
                    set v4 = 5
                    set e1.diplo_type@(p2) = 29
                    set e1.au_want_field@(p2) = zfield
                    set e1.au_want_tech@(p2) = ztech
                    loop i in num {
                        if s.tbl_value@(i) <= zvalue {
                            set e1.au_tech_trade_field@(p2)@(n) = s.tbl_field@(i)
                            set e1.au_tech_trade_tech@(p2)@(n) = s.tbl_tech2@(i)
                            set n = n + 1
                        }
                    }
                    set e1.au_tech_trade_num@(p2) = n
                    set e1.mood_tech@(p2) = 0
                    set e2.mood_tech@(p1) = 0
                }
            }
        }
    }
    ;; 41aa2
    if v4 == 0 {
        if (e1.relation1@(p2) < 0) && (e1.total_production_bc > e2.total_production_bc) && (e1.treaty@(p2) == TREATY_NONE) {
            set v4 = 1
            set e1.diplo_type@(p2) = 24
        }
    }
    ;; 41ae2
    ;; 41c23
    if true
      && (e2.total_production_bc != 0)
      && ((v4 == 1) || (v4 == 2))
      && (e2.trait1 > TRAIT1_RUTHLESS)
      && (rnd_1_n(100, g) <= (u32(e1.total_production_bc * 30) // e2.total_production_bc))
      && (rnd_0_nm1(8, g) == 0) {
        game_ai_classic_turn_diplo_p2_offer(g, p1, p2)
    }
}

func game_ai_classic_turn_diplo_p2_sub2 (g, p1, p2) {
    val e1 = g.eto@(p1)
    if (e1.treaty@(p2) == TREATY_ALLIANCE) && (rnd_0_nm1(10, g) == 0) {
        var pa = PLAYER_NONE
        loop p3 in g.players {
            val e3 = g.eto@(p3)
            if true
              && (p3 != p1) && (p3 != p2) && (e3.treaty@(p2) == TREATY_WAR)
              && BOOLVEC_IS1(e1.contact, p3)
              && (e1.treaty@(p3) != TREATY_WAR) {
                set pa = p3
            }
        }
        set e1.au_ally_attacker@(p2) = pa
        set e1.diplo_type@(p2) = if pa == PLAYER_NONE => 0 => 76
    } else {
        set e1.diplo_type@(p2) = 0
    }
}

func game_ai_classic_turn_diplo_p2_sub3 (g, p1, p2) {
    val e1 = g.eto@(p1)
    val e2 = g.eto@(p2)
    if BOOLVEC_IS0(e1.contact, p2) {    ;; WASBUG? MOO1 also tests for "|| (e1->diplo_val == 0)" ; note the missing [p2]
        set e1.diplo_type@(p2) = 0
        return nil
    }
    val v = e1.trust@(p2) + e1.relation1@(p2) + (if e1.race == RACE_HUMAN => 50 => 0) + game_diplo_tbl_reldiff@(e2.trait1)
    if e1.treaty@(p2) < TREATY_WAR {
        ifs {
            e1.relation1@(p2) <= -95 => {
                game_diplo_start_war(g, p2, p1)
                set e1.diplo_type@(p2) = 13
            }
            ((v - rnd_1_n(100, g)) + e1.mood_treaty@(p2)) <= -100 => {
                if e1.hatred@(p2) > 0 {
                    set e1.hatred@(p2) = i16(e1.hatred@(p2) + 1)
                    if (e1.hatred@(p2) > 2) || (e1.treaty@(p2) == TREATY_NONE) {
                        if rnd_1_n(100, g) < (-((game_diplo_tbl_reldiff@(e2.trait1) // 2) + e1.diplo_val@(p2))) {
                            game_diplo_start_war(g, p2, p1)
                            set e1.diplo_type@(p2) = 13
                            set e1.hatred@(p2) = 1
                        }
                    } else {
                        set e1.diplo_type@(p2) = u8(e1.diplo_type@(p2) + 46)
                        game_diplo_break_treaty(g, p2, p1)
                    }
                } else {
                    set e1.hatred@(p2) = 1
                    if (e1.treaty@(p2) == TREATY_NONAGGRESSION) || (e1.treaty@(p2) == TREATY_ALLIANCE) || (e1.trade_bc@(p2) != 0) {
                        set e1.diplo_type@(p2) = u8(e1.diplo_type@(p2) + 38)
                    }
                }
            }
            else => nil
        }
    } else {
        if (((v + rnd_1_n(100, g)) + e1.mood_peace@(p2)) >= 50) && (rnd_0_nm1(8, g) == 0) {
            set e1.diplo_type@(p2) = 30
            if rnd_1_n(100, g) <= (u32(e2.total_production_bc * 30) // e1.total_production_bc) {
                game_ai_classic_turn_diplo_p2_offer(g, p1, p2)
            }
        }
    }
}

func game_ai_classic_turn_diplo_p2 (g) {
    game_diplo_limit_mood_treaty(g)
    loop p1 in g.players {
        val e1 = g.eto@(p1)
        ifs {
            IS_AI(g, p1) => nil
            !IS_ALIVE(g, p1) => {
                loop i in PLAYER_NUM {
                    set e1.diplo_type@(i) = 0
                }
            }
            else => {
                loop p2 in g.players {
                    val e2 = g.eto@(p2)
                    ifs {
                        IS_HUMAN(g, p2) => nil
                        !IS_ALIVE(g, p2) => {
                            set e1.diplo_type@(p2) = 0
                        }
                        else => {
                            ifs {
                                (e1.treaty@(p2) == TREATY_FINAL_WAR) || (e1.diplo_type@(p2) == 59) => {
                                    if e1.diplo_type@(p2) != 59 {
                                        set e1.diplo_type@(p2) = 0
                                    }
                                }
                                e1.have_met@(p2) == 1 => {
                                    set e1.have_met@(p2) = 2
                                    set e1.diplo_type@(p2) = u8(e2.trait1 + 14)
                                }
                                e1.bounty_collect@(p2) != PLAYER_NONE => {
                                    set e1.diplo_type@(p2) = 58
                                }
                                (e1.diplo_type@(p2) == 13) || (e1.diplo_type@(p2) == 32) || (e1.diplo_type@(p2) == 61) || (e1.diplo_type@(p2) == 60) => {
                                    ;; v8 = 0; unused
                                }
                                else => {
                                    ;; 16441
                                    val v = i16(game_diplo_get_mood(g, p1, p2))
                                    val v2 = i16(v + e1.trust@(p2) + game_diplo_tbl_reldiff@(e2.trait1))
                                    val dv2 = i16(e1.diplo_val@(p2) * 2)
                                    ifs {
                                        (v2 <= -100) || (v <= -100) => {
                                            set e1.diplo_type@(p2) = 0
                                        }
                                        e1.diplo_val@(p2) < 0 => {
                                            if (e1.hatred@(p2) > 0) || (rnd_1_n(100, g) < math.abs(dv2)) {
                                                game_ai_classic_turn_diplo_p2_sub3(g, p1, p2)
                                            } else {
                                                set e1.diplo_type@(p2) = 0
                                            }
                                        }
                                        (e1.treaty@(p2) == TREATY_WAR) && ((rnd_1_n(100, g) + 30) < e1.mood_peace@(p2)) => {
                                            game_ai_classic_turn_diplo_p2_sub3(g, p1, p2)
                                        }
                                        (rnd_1_n(100, g) < (dv2 + (if e1.hatred@(p2) == 0 => 3 => 0))) && (rnd_0_nm1(4, g) == 0) => {
                                            if e1.hatred@(p2) > 0 {
                                                set e1.hatred@(p2) = 0
                                            } else {
                                                game_ai_classic_turn_diplo_p2_sub1(g, p1, p2)
                                            }
                                        }
                                        else => {
                                            ;; 1656f
                                            game_ai_classic_turn_diplo_p2_sub2(g, p1, p2)
                                        }
                                    }
                                }
                            }
                            ;; 16576
                            if e1.diplo_type@(p2) == 0 {
                                game_ai_classic_diplo_wage_war(g, p1, p2)
                            }
                            if (e1.diplo_type@(p2) == 2) && (rnd_0_nm1(10, g) != 0) {
                                set e1.diplo_type@(p2) = 0
                            }
                        }
                    }
                }
            }
        }
    }
}

;; ---------------------------------------------------------------------------
;; The audiences (`au` is a `struct audience_s`).

func game_ai_classic_aud_check_mood (au, a0, a2) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var v = match a2 {
        1 => eh.mood_trade@(pa)
        2 => eh.mood_peace@(pa)
        3 => eh.mood_tech@(pa)
        else => eh.mood_treaty@(pa)
    }
    set v = v + eh.trust@(pa) + eh.relation1@(pa) + (if eh.race == RACE_HUMAN => 50 => 0) + game_diplo_tbl_reldiff@(ea.trait1)
    set v = v + rnd_1_n(100, g)
    set v = v - a0
    if eh.treaty@(pa) == TREATY_ALLIANCE {
        set v = v + 40
    }
    game_diplo_annoy(g, ph, pa, 1)
    match a2 {
        1 => { set eh.mood_trade@(pa) = i16(eh.mood_trade@(pa) - (rnd_1_n(30, g) + 20)) }
        2 => { set eh.mood_peace@(pa) = i16(eh.mood_peace@(pa) - (rnd_1_n(50, g) + 50)) }
        3 => { set eh.mood_tech@(pa) = i16(eh.mood_tech@(pa) - (rnd_1_n(50, g) + 20)) }
        else => { set eh.mood_treaty@(pa) = i16(eh.mood_treaty@(pa) - (rnd_1_n(30, g) + 20)) }
    }
    ifs {
        v < -75 => 0
        v < -50 => 1
        v < 0 => 2
        else => 3
    }
}

func game_ai_classic_aud_start_human (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var v = eh.trust@(pa) + game_diplo_get_mood(g, ph, pa) + game_diplo_tbl_reldiff@(ea.trait1)
    if v < -100 {
        set au.dtype = if eh.treaty@(pa) >= TREATY_WAR => 20 => 21
        set au.mode = 1
    } else {
        set v = v + eh.relation1@(pa)
        set au.dtype = if v > -50 => 22 => 23
        set au.mode = 0
    }
}

func game_ai_classic_aud_treaty_nap (au) {
    val eh = au.g.eto@(au.ph)
    if eh.relation1@(au.pa) > 10 => game_ai_classic_aud_check_mood(au, 50, 0) => 0
}

func game_ai_classic_aud_treaty_alliance (au) {
    val eh = au.g.eto@(au.ph)
    if eh.relation1@(au.pa) > 50 => game_ai_classic_aud_check_mood(au, 125, 0) => 0
}

func game_ai_classic_aud_treaty_peace (au) {
    val mi = if au.g.ai_id == GAME_AI_CLASSICPLUS => 2 => 0   ;; peace : treaty ; WASBUG? mood_peace makes sense
    game_ai_classic_aud_check_mood(au, 60, mi)
}

func game_ai_classic_aud_treaty_declare_war (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    if (eh.treaty@(pa) == TREATY_ALLIANCE) && (eh.treaty@(au.pstartwar) == TREATY_WAR) {
        if rnd_0_nm1(8, g) == 0 => 2 => 3
    } else {
        var v = ea.relation1@(au.pstartwar) + 150
        if g.ai_id != GAME_AI_CLASSIC {
            ;; WASBUG?
            ;; MOO1 contains the treaty * 30 code but the result is unused.
            ;; OSG states that either NAP or alliance changes that 150 to 250 but there is no such code.
            set v = v + (ea.treaty@(au.pstartwar) * 30)
        }
        game_ai_classic_aud_check_mood(au, v, 0)
    }
}

func game_ai_classic_aud_treaty_break_alliance (au) {
    val g = au.g
    val eh = g.eto@(au.ph)
    val ea = g.eto@(au.pa)
    if eh.relation1@(au.pa) > 24 => game_ai_classic_aud_check_mood(au, ea.relation1@(au.pwar) + 175, 0) => 0
}

func game_ai_classic_aud_trade (au) {
    game_ai_classic_aud_check_mood(au, 50, 1)
}

;; Gives (ok, bc, field, tech): the `bcptr`, `fieldptr` and `techptr` of C.
func game_ai_classic_aud_sweeten (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    var field = 0
    var tech    ;; uint8_t
    var bc = (((rnd_1_n(8, g) + rnd_1_n(8, g)) * g.year) // 25) * 25
    if bc > eh.reserve_bc {
        set bc = 0
    }
    do {
        pin s = spy_esp_s()
        set s.spy = pa
        set s.target = ph
        if game_spy_esp_sub1(g, s, g.year, 1) > 0 {
            set field = s.tbl_field@(0)
            set tech = s.tbl_tech2@(0)
        } else {
            set tech = 0
        }
    }
    if (bc == 0) && (tech == 0) {
        return (false, bc, field, tech)
    }
    (true, bc, field, tech)
}

func game_ai_classic_aud_threaten (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var dtype   ;; uint8_t
    var v = rnd_1_n(200, g) + (eh.mood_treaty@(pa) // 2)
    set v = v + (game_diplo_tbl_reldiff@(ea.trait1) * 2)
    if ea.total_production_bc > 0 {
        set v = v + (u32(eh.total_production_bc * 100) // ea.total_production_bc)
    } else {
        set v = v + 100
    }
    set eh.relation1@(pa) = i16(SUBSATT(eh.relation1@(pa), rnd_1_n(15, g), -100))
    set ea.relation1@(ph) = eh.relation1@(pa)
    set eh.mood_treaty@(pa) = -120
    if v < 170 {
        if (rnd_1_n(15, g) - game_diplo_tbl_reldiff@(ea.trait1)) > rnd_1_n(100, g) {
            game_diplo_start_war(g, ph, pa)
            set dtype = 13
        } else {
            set dtype = 69
        }
    } else {
        if g.ai_id == GAME_AI_CLASSICPLUS {
            set ea.spymode_next@(ph) = SPYMODE_HIDE
            set ea.spymode@(ph) = SPYMODE_HIDE
        } else {    ;; WASBUG MOO1 hides your spies
            set eh.spymode_next@(pa) = SPYMODE_HIDE
            set eh.spymode@(pa) = SPYMODE_HIDE
        }
        set g.evn.ceasefire@(ph)@(pa) = i16(rnd_1_n(15, g) + 5)
        set dtype = 70
        if v >= 275 {
            pin s = spy_esp_s()
            set s.spy = ph
            set s.target = pa
            if game_spy_esp_sub1(g, s, 0, 1) > 0 {
                set au.tribute_field = s.tbl_field@(0)
                set au.tribute_tech = s.tbl_tech2@(0)
                game_tech_get_new(g, ph, au.tribute_field, au.tribute_tech, TECHSOURCE_TRADE, pa, PLAYER_NONE, false)   ;; WASBUG? pa was 0
            }
        } else {
            if v >= 200 {
                val bc = (((rnd_1_n(8, g) + 2) * g.year) // 25) * 25
                if bc != 0 {
                    set eh.reserve_bc = u32(eh.reserve_bc + bc)
                    set au.tribute_bc = i16(bc)
                    set dtype = 71
                }
            }
        }
    }
    dtype
}

func game_ai_classic_aud_tribute_bc (au, selected, bc) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var v
    if ea.total_production_bc != 0 {
        ;; WASBUG MOO1 uses the value
        ;;    (reserve * 12) / (0x786e + 0xdd4 * pa + 0x326b0000)
        ;; == (reserve * 12) / ea->relation1
        ;; == 0
        ;; This makes money tributes quite useless.
        ;; The formula below is according to OSG.
        if g.ai_id == GAME_AI_CLASSICPLUS {
            set v = u32(bc * 12) // ea.total_production_bc
        } else {
            set v = 0
        }
    } else {
        set v = selected + 1
    }
    if eh.race == RACE_HUMAN {
        set v = v * 2
    }
    set eh.relation1@(pa) = i16(ADDSATT(eh.relation1@(pa), v, 100))
    set ea.relation1@(ph) = eh.relation1@(pa)
    if eh.treaty@(pa) >= TREATY_WAR {
        set ea.relation1@(ph) = SETMIN(ea.relation1@(ph), -25)
    }
    if eh.treaty@(pa) != TREATY_ALLIANCE {
        set ea.relation1@(ph) = SETMIN(ea.relation1@(ph), 65)
    }
    ;; BUG? eh->relation1[pa] = ea->relation1[ph]; is missing
    if g.ai_id == GAME_AI_CLASSICPLUS {
        set eh.relation1@(pa) = ea.relation1@(ph)
    }
}

func game_ai_classic_aud_tribute_tech (au, selected, field, tech) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var v
    if eh.relation1@(pa) < 0 {
        set v = 20
    } else {
        set v = (100 - eh.relation1@(pa)) // 10
    }
    set v = ((rnd_1_n(8, g) + rnd_1_n(8, g) + (tech // 4)) * v) // 10
    if eh.race == RACE_HUMAN {
        set v = v * 2
    }
    set eh.relation1@(pa) = i16(ADDSATT(eh.relation1@(pa), v, 100))
    set ea.relation1@(ph) = eh.relation1@(pa)
    set eh.mood_peace@(pa) = i16(ADDSATT(eh.mood_peace@(pa), v, 200))
    set eh.trust@(pa) = i16(ADDSATT(eh.trust@(pa), rnd_1_n(8, g) + 2, 30))
    if eh.treaty@(pa) >= TREATY_WAR {
        set ea.relation1@(ph) = SETMIN(ea.relation1@(ph), -25)
    }
    if eh.treaty@(pa) != TREATY_ALLIANCE {
        set ea.relation1@(ph) = SETMIN(ea.relation1@(ph), 70)
    }
    ;; BUG? eh->relation1[pa] = ea->relation1[ph]; is missing
    if g.ai_id == GAME_AI_CLASSICPLUS {
        set eh.relation1@(pa) = ea.relation1@(ph)
    }
}

func game_ai_classic_aud_tech_scale (au) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    val ea = g.eto@(pa)
    var di = eh.mood_tech@(pa)
    if di > 0 {
        set di = di // 5
    }
    set di = SETMIN(di, 30)
    if eh.treaty@(pa) == TREATY_ALLIANCE {
        set di = di + 25
    }
    var v = eh.trust@(pa) + (eh.relation1@(pa) // 2) + (if eh.race == RACE_HUMAN => 50 => 0)
    set v = v + (game_diplo_tbl_reldiff@(ea.trait1) * 2) + di + rnd_1_n(100, g) - 125
    if v < 0 {
        set v = math.abs(v) + 100
    } else {
        set v = 20000 // (v + 200)
    }
    set v = v // 4
    SETMAX(v, 75)
}

func game_ai_classic_aud_get_dtype (au, dtype0, a2) {
    val g = au.g
    val ph = au.ph
    val pa = au.pa
    val eh = g.eto@(ph)
    var dtype = dtype0  ;; uint8_t
    if (dtype == 31) || ((dtype >= 33) && (dtype <= 41)) || ((dtype >= 62) && (dtype <= 68)) {
        ifs {
            (a2 >= 0) && (a2 <= 2) => {
                if (eh.blunder@(pa) != 0) && (rnd_0_nm1(2, g) == 0) {
                    set dtype = u8(eh.blunder@(pa) + 30)
                    set eh.blunder@(pa) = 0
                } else {
                    if (eh.broken_treaty@(pa) != TREATY_NONE) && (rnd_0_nm1(4, g) == 0) {
                        set dtype = 33
                        set eh.broken_treaty@(pa) = TREATY_NONE
                    } else {
                        set dtype = 31
                    }
                }
            }
            a2 == 3 => {
                if (rnd_0_nm1(4, g) == 0) && (eh.tribute_tech@(pa) != 0) {
                    set au.tribute_field = eh.tribute_field@(pa)
                    set au.tribute_tech = eh.tribute_tech@(pa)
                    set eh.tribute_tech@(pa) = 0
                    set dtype = 66
                }
            }
            else => nil
        }
    }
    dtype
}

func game_ai_classic_aud_later (au) {
    game_diplo_get_mood(au.g, au.ph, au.pa) < -100
}

