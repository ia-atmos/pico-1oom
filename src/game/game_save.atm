func game_save_encode_srd (buf, pos, srd, sdnum, version) {
    var q = pos
    loop i in sdnum {
        set q = game_save_encode_sd(buf, q, srd.design@(i))
    }
    loop f in TECH_FIELD_NUM {
        set q = SG_1OOM_EN_TBL_TBL_U8(buf, q, srd.researchlist@(f), TECH_TIER_NUM, 3)
    }
    set q = SG_1OOM_EN_TBL_TBL_U8(buf, q, srd.researchcompleted, TECH_FIELD_NUM, TECH_PER_FIELD)
    set q = SG_1OOM_EN_DUMMY(buf, q, NUM_SHIPDESIGNS)
    set q = SG_1OOM_EN_TBL_U16(buf, q, srd.year, NUM_SHIPDESIGNS)
    set q = SG_1OOM_EN_DUMMY(buf, q, NUM_SHIPDESIGNS * 4)
    q
}

func game_save_decode_srd (buf, pos, srd, sdnum, version) {
    var q = pos
    loop i in sdnum {
        set q = game_save_decode_sd(buf, q, srd.design@(i))
    }
    loop f in TECH_FIELD_NUM {
        set q = SG_1OOM_DE_TBL_TBL_U8(buf, q, srd.researchlist@(f), TECH_TIER_NUM, 3)
    }
    set q = SG_1OOM_DE_TBL_TBL_U8(buf, q, srd.researchcompleted, TECH_FIELD_NUM, TECH_PER_FIELD)
    set q = SG_1OOM_DE_DUMMY(buf, q, NUM_SHIPDESIGNS)
    set q = SG_1OOM_DE_TBL_U16(buf, q, srd.year, NUM_SHIPDESIGNS)
    set q = SG_1OOM_DE_DUMMY(buf, q, NUM_SHIPDESIGNS * 4)
    q
}

