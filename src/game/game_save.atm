;; Port of c/src/game/game_save.c and game_save.h.
;;
;; NOTE!
;;  If the save format changes, increase GAME_SAVE_VERSION and implement a
;;  converter in 1oom_saveconv. The format is not to be changed without a
;;  very good reason.
;;
;; The buffer of the save is a vector of bytes, and a file is read and
;; written whole (cfile.atm).

include "../cfile.atm"
include "../ctypes.atm"
include "../log.atm"
include "game.atm"
include "game_endecode.atm"
include "game_nebula.atm"

val NUM_SAVES = 6
val NUM_ALL_SAVES = NUM_SAVES + 1 + 1 + 1   ;; continue game, undo, init
val SAVE_NAME_LEN = 20

;; ---------------------------------------------------------------------------

val GAME_SAVE_HDR_SIZE = 64
val GAME_SAVE_MAGIC = "1oomSAVE"
val GAME_SAVE_END = 0x646e450a      ;; dnE\n
val GAME_SAVE_OFFS_VERSION = 8
val GAME_SAVE_OFFS_NAME = 16

val GAME_SAVE_VERSION = 0

;; ---------------------------------------------------------------------------

pin game_save_tbl_have_save = carray(NUM_ALL_SAVES, false)
pin game_save_tbl_name = carray2(NUM_ALL_SAVES, SAVE_NAME_LEN)

;; ---------------------------------------------------------------------------

;; A decoded value converted to the C type of its field, and the position.
func sg_de (conv, v, pos) {
    return conv(v), pos
}

;; HACK: Nebula types are not stored in the save file format, but can be
;; inferred from the bounding boxes.
func game_save_nebula_match (x, y, x0, y0, x1, y1, nebula_data) {
    loop i in 4 {
        if x0@(i) != (x + nebula_data@0@(i)) {
            return false
        }
        if y0@(i) != (y + nebula_data@1@(i)) {
            return false
        }
        if x1@(i) != (x + nebula_data@2@(i)) {
            return false
        }
        if y1@(i) != (y + nebula_data@3@(i)) {
            return false
        }
    }
    true
}

func game_save_infer_nebula_type (g, index) {
    val x  = g.nebula_x@(index)
    val y  = g.nebula_y@(index)
    val x0 = g.nebula_x0@(index)
    val y0 = g.nebula_y0@(index)
    val x1 = g.nebula_x1@(index)
    val y1 = g.nebula_y1@(index)
    loop t in NEBULA_TYPE_NUM {
        if game_save_nebula_match(x, y, x0, y0, x1, y1, tbl_nebula_data@(t)) {
            return t
        }
    }
    -1
}

func game_save_encode_planet (buf, pos, p, pnum, version) {
    var q = pos
    set q = SG_1OOM_EN_TBL_U8(buf, q, p.name, PLANET_NAME_LEN)
    set q = SG_1OOM_EN_U16(buf, q, p.x)
    set q = SG_1OOM_EN_U16(buf, q, p.y)
    set q = SG_1OOM_EN_U8(buf, q, p.star_type)
    set q = SG_1OOM_EN_U8(buf, q, p.look)
    set q = SG_1OOM_EN_U8(buf, q, p.frame)
    set q = SG_1OOM_EN_U8(buf, q, p.rocks)
    set q = SG_1OOM_EN_U16(buf, q, p.max_pop1)
    set q = SG_1OOM_EN_U16(buf, q, p.max_pop2)
    set q = SG_1OOM_EN_U16(buf, q, p.max_pop3)
    set q = SG_1OOM_EN_U8(buf, q, p.type)
    set q = SG_1OOM_EN_U8(buf, q, p.battlebg)
    set q = SG_1OOM_EN_U8(buf, q, p.infogfx)
    set q = SG_1OOM_EN_U8(buf, q, p.growth)
    set q = SG_1OOM_EN_U8(buf, q, p.special)
    set q = SG_1OOM_EN_U16(buf, q, p.bc_to_ecoproj)
    set q = SG_1OOM_EN_U16(buf, q, p.bc_to_ship)
    set q = SG_1OOM_EN_U16(buf, q, p.bc_to_factory)
    set q = SG_1OOM_EN_U32(buf, q, p.reserve)
    set q = SG_1OOM_EN_U16(buf, q, p.waste)
    set q = SG_1OOM_EN_U8(buf, q, p.owner)
    set q = SG_1OOM_EN_U8(buf, q, p.prev_owner)
    set q = SG_1OOM_EN_U8(buf, q, p.claim)
    set q = SG_1OOM_EN_U16(buf, q, p.pop)
    set q = SG_1OOM_EN_U16(buf, q, p.pop_prev)
    set q = SG_1OOM_EN_U16(buf, q, p.factories)
    set q = SG_1OOM_EN_TBL_U16(buf, q, p.slider, PLANET_SLIDER_NUM)
    set q = SG_1OOM_EN_TBL_U8(buf, q, p.slider_lock, PLANET_SLIDER_NUM)
    set q = SG_1OOM_EN_U8(buf, q, p.buildship)
    set q = SG_1OOM_EN_U8(buf, q, p.reloc)
    set q = SG_1OOM_EN_U16(buf, q, p.missile_bases)
    set q = SG_1OOM_EN_U16(buf, q, p.bc_to_base)
    set q = SG_1OOM_EN_U16(buf, q, p.bc_upgrade_base)
    set q = SG_1OOM_EN_U8(buf, q, p.have_stargate)
    set q = SG_1OOM_EN_U8(buf, q, p.shield)
    set q = SG_1OOM_EN_U16(buf, q, p.bc_to_shield)
    set q = SG_1OOM_EN_U16(buf, q, p.trans_num)
    set q = SG_1OOM_EN_U8(buf, q, p.trans_dest)
    set q = SG_1OOM_EN_U8(buf, q, p.pop_tenths)
    set q = SG_1OOM_EN_BV(buf, q, p.explored, PLAYER_NUM)
    set q = SG_1OOM_EN_BV(buf, q, p.unrefuel, PLAYER_NUM)
    set q = SG_1OOM_EN_DUMMY(buf, q, 4)
    set q = SG_1OOM_EN_U8(buf, q, p.pop_oper_fact)
    set q = SG_1OOM_EN_U16(buf, q, p.bc_to_refit)
    set q = SG_1OOM_EN_U16(buf, q, p.rebels)
    set q = SG_1OOM_EN_U8(buf, q, p.unrest)
    set q = SG_1OOM_EN_U8(buf, q, p.unrest_reported)
    set q = SG_1OOM_EN_BV(buf, q, p.finished, FINISHED_NUM)
    set q = SG_1OOM_EN_DUMMY(buf, q, 5)
    q
}

func game_save_decode_planet (buf, pos, p, pnum, version) {
    var q = pos
    set q = SG_1OOM_DE_TBL_U8(buf, q, p.name, PLANET_NAME_LEN)
    set p.x, q = SG_1OOM_DE_U16(buf, q)
    set p.y, q = SG_1OOM_DE_U16(buf, q)
    set p.star_type, q = SG_1OOM_DE_U8(buf, q)
    set p.look, q = SG_1OOM_DE_U8(buf, q)
    set p.frame, q = SG_1OOM_DE_U8(buf, q)
    set p.rocks, q = SG_1OOM_DE_U8(buf, q)
    set p.max_pop1, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.max_pop2, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.max_pop3, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.type, q = SG_1OOM_DE_U8(buf, q)
    set p.battlebg, q = SG_1OOM_DE_U8(buf, q)
    set p.infogfx, q = SG_1OOM_DE_U8(buf, q)
    set p.growth, q = SG_1OOM_DE_U8(buf, q)
    set p.special, q = SG_1OOM_DE_U8(buf, q)
    set p.bc_to_ecoproj, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.bc_to_ship, q = SG_1OOM_DE_U16(buf, q)
    set p.bc_to_factory, q = sg_de(u8, SG_1OOM_DE_U16(buf, q))
    set p.reserve, q = SG_1OOM_DE_U32(buf, q)
    set p.waste, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.owner, q = SG_1OOM_DE_U8(buf, q)
    set p.prev_owner, q = SG_1OOM_DE_U8(buf, q)
    set p.claim, q = SG_1OOM_DE_U8(buf, q)
    set p.pop, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.pop_prev, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.factories, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set q = SG_1OOM_DE_TBL_U16(buf, q, p.slider, PLANET_SLIDER_NUM, i16)
    set q = SG_1OOM_DE_TBL_U8(buf, q, p.slider_lock, PLANET_SLIDER_NUM)
    set p.buildship, q = SG_1OOM_DE_U8(buf, q)
    set p.reloc, q = SG_1OOM_DE_U8(buf, q)
    set p.missile_bases, q = SG_1OOM_DE_U16(buf, q)
    set p.bc_to_base, q = SG_1OOM_DE_U16(buf, q)
    set p.bc_upgrade_base, q = SG_1OOM_DE_U16(buf, q)
    set p.have_stargate, q = sg_de(cbool, SG_1OOM_DE_U8(buf, q))
    set p.shield, q = SG_1OOM_DE_U8(buf, q)
    set p.bc_to_shield, q = SG_1OOM_DE_U16(buf, q)
    set p.trans_num, q = SG_1OOM_DE_U16(buf, q)
    set p.trans_dest, q = SG_1OOM_DE_U8(buf, q)
    set p.pop_tenths, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    set q = SG_1OOM_DE_BV(buf, q, p.explored, PLAYER_NUM)
    set q = SG_1OOM_DE_BV(buf, q, p.unrefuel, PLAYER_NUM)
    set q = SG_1OOM_DE_DUMMY(buf, q, 4)
    set p.pop_oper_fact, q = SG_1OOM_DE_U8(buf, q)
    set p.bc_to_refit, q = SG_1OOM_DE_U16(buf, q)
    set p.rebels, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set p.unrest, q = SG_1OOM_DE_U8(buf, q)
    set p.unrest_reported, q = sg_de(cbool, SG_1OOM_DE_U8(buf, q))
    set q = SG_1OOM_DE_BV(buf, q, p.finished, FINISHED_NUM)
    set q = SG_1OOM_DE_DUMMY(buf, q, 5)
    q
}

func game_save_encode_enroute (buf, pos, r) {
    var q = pos
    set q = SG_1OOM_EN_U8(buf, q, r.owner)
    set q = SG_1OOM_EN_U16(buf, q, r.x)
    set q = SG_1OOM_EN_U16(buf, q, r.y)
    set q = SG_1OOM_EN_U8(buf, q, r.dest)
    do {
        var v = r.speed
        if r.retreat {
            set v = u8(v | 0x80)
        }
        set q = SG_1OOM_EN_U8(buf, q, v)
    }
    set q = SG_1OOM_EN_TBL_U16(buf, q, r.ships, NUM_SHIPDESIGNS)
    q
}

func game_save_decode_enroute (buf, pos, r) {
    var q = pos
    set r.owner, q = SG_1OOM_DE_U8(buf, q)
    set r.x, q = SG_1OOM_DE_U16(buf, q)
    set r.y, q = SG_1OOM_DE_U16(buf, q)
    set r.dest, q = SG_1OOM_DE_U8(buf, q)
    do {
        var v
        set v, q = SG_1OOM_DE_U8(buf, q)
        set r.speed = v & 0x7f
        set r.retreat = ((v & 0x80) != 0)
    }
    set q = SG_1OOM_DE_TBL_U16(buf, q, r.ships, NUM_SHIPDESIGNS)
    q
}

func game_save_encode_transport (buf, pos, r) {
    var q = pos
    set q = SG_1OOM_EN_U8(buf, q, r.owner)
    set q = SG_1OOM_EN_U16(buf, q, r.x)
    set q = SG_1OOM_EN_U16(buf, q, r.y)
    set q = SG_1OOM_EN_U8(buf, q, r.dest)
    set q = SG_1OOM_EN_U8(buf, q, r.speed)
    set q = SG_1OOM_EN_U16(buf, q, r.pop)
    q
}

func game_save_decode_transport (buf, pos, r) {
    var q = pos
    set r.owner, q = SG_1OOM_DE_U8(buf, q)
    set r.x, q = SG_1OOM_DE_U16(buf, q)
    set r.y, q = SG_1OOM_DE_U16(buf, q)
    set r.dest, q = SG_1OOM_DE_U8(buf, q)
    set r.speed, q = SG_1OOM_DE_U8(buf, q)
    set r.pop, q = SG_1OOM_DE_U16(buf, q)
    q
}

func game_save_encode_orbits (buf, pos, o, planets) {
    var q = pos
    loop i in planets {
        var any_ships = false
        loop j in NUM_SHIPDESIGNS {
            if o@(i).ships@(j) != 0 {
                set any_ships = true
                break
            }
        }
        if any_ships {
            set q = SG_1OOM_EN_U8(buf, q, i)
            set q = SG_1OOM_EN_TBL_U16(buf, q, o@(i).ships, NUM_SHIPDESIGNS)
        }
    }
    set q = SG_1OOM_EN_U8(buf, q, PLANET_NONE)
    q
}

func game_save_decode_orbits (buf, pos, o, planets) {
    var q = pos
    loop loops in (0, planets) {
        var i
        set i, q = SG_1OOM_DE_U8(buf, q)
        if i == PLANET_NONE {
            return q
        } else {
            if i >= planets {
                log_error("Save: decode orbit planet %i >= %i max\n", i, planets)
                return -1
            }
        }
        set q = SG_1OOM_DE_TBL_U16(buf, q, o@(i).ships, NUM_SHIPDESIGNS)
    }
    log_error("Save: decode orbit terminator missing\n")
    -1
}

func game_save_encode_eto (buf, pos, e, pnum, planets, version) {
    var q = pos
    set q = SG_1OOM_EN_U8(buf, q, e.race)
    set q = SG_1OOM_EN_U8(buf, q, e.banner)
    set q = SG_1OOM_EN_U8(buf, q, e.trait1)
    set q = SG_1OOM_EN_U8(buf, q, e.trait2)
    set q = SG_1OOM_EN_U8(buf, q, e.ai_p3_countdown)
    set q = SG_1OOM_EN_U8(buf, q, e.ai_p2_countdown)
    set q = SG_1OOM_EN_BV(buf, q, e.contact, PLAYER_NUM)
    set q = SG_1OOM_EN_BV(buf, q, e.contact_broken, PLAYER_NUM)
    set q = SG_1OOM_EN_DUMMY(buf, q, 4)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.relation1, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.relation2, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.diplo_type, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.diplo_val, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.diplo_p1, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.diplo_p2, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.trust, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.broken_treaty, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.blunder, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.tribute_field, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.tribute_tech, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.mood_treaty, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.mood_trade, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.mood_tech, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.mood_peace, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.treaty, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.trade_bc, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.trade_percent, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.spymode_next, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.offer_field, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.offer_tech, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.offer_bc, pnum)
    do {
        ;; HACK Fit 5 tables into 2 while not breaking old versions.
        pin tbl = carray(PLAYER_NUM)
        ;; Old attack_bounty. The attack_gift_* are irrelevant if
        ;; attack_bounty is PLAYER_NONE.
        loop i in pnum {
            var v
            ifs {
                e.attack_gift_bc@(i) != 0 => {
                    set v = u16(e.attack_gift_bc@(i))  ;; multiple of 50, always even
                }
                e.attack_gift_tech@(i) != 0 => {
                    set v = u16((e.attack_gift_tech@(i) << 8) | (e.attack_gift_field@(i) << 1) | 1)
                }
                else => {
                    set v = 0
                }
            }
            set tbl@(i) = v
        }
        set q = SG_1OOM_EN_TBL_U16(buf, q, tbl, pnum)
        ;; Old bounty_collect.
        ;; attack_bounty[0] is never 0, and thus tbl[0] is never PLAYER_NONE
        ;; (but typically (PLAYER_NONE << 8) | PLAYER_NONE).
        ;; bounty_collect[0] is always PLAYER_NONE.
        ;; Old code reading this to bounty_collect will get != PLAYER_NONE and
        ;; reset attack_bounty on next turn.
        loop i in pnum {
            set tbl@(i) = u16((e.attack_bounty@(i) << 8) | e.bounty_collect@(i))
        }
        set q = SG_1OOM_EN_TBL_U16(buf, q, tbl, pnum)
    }
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.hatred, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.have_met, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.trade_established_bc, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.spying, pnum)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.spyfund, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.spymode, pnum)
    set q = SG_1OOM_EN_U16(buf, q, e.security)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.spies, pnum)
    set q = SG_1OOM_EN_U32(buf, q, e.reserve_bc)
    set q = SG_1OOM_EN_U16(buf, q, e.tax)
    set q = SG_1OOM_EN_U8(buf, q, e.base_shield)
    set q = SG_1OOM_EN_U8(buf, q, e.base_comp)
    set q = SG_1OOM_EN_U8(buf, q, e.base_weapon)
    set q = SG_1OOM_EN_U8(buf, q, e.colonist_oper_factories)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.tech.percent, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.tech.slider, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.tech.slider_lock, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_TBL_U32(buf, q, e.tech.investment, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_TBL_U8(buf, q, e.tech.project, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_TBL_U32(buf, q, e.tech.cost, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.tech.completed, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_U8(buf, q, e.shipdesigns_num)
    set q = game_save_encode_orbits(buf, q, e.orbit, planets)
    set q = SG_1OOM_EN_TBL_TBL_U8(buf, q, e.spyreportfield, pnum, TECH_FIELD_NUM)
    set q = SG_1OOM_EN_TBL_U16(buf, q, e.spyreportyear, pnum)
    set q = SG_1OOM_EN_U8(buf, q, e.shipi_colony)
    set q = SG_1OOM_EN_U8(buf, q, e.shipi_bomber)
    q
}

func game_save_decode_eto (buf, pos, e, pnum, planets, version) {
    var q = pos
    set e.race, q = SG_1OOM_DE_U8(buf, q)
    set e.banner, q = SG_1OOM_DE_U8(buf, q)
    set e.trait1, q = SG_1OOM_DE_U8(buf, q)
    set e.trait2, q = SG_1OOM_DE_U8(buf, q)
    set e.ai_p3_countdown, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    set e.ai_p2_countdown, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    set q = SG_1OOM_DE_BV(buf, q, e.contact, PLAYER_NUM)
    set q = SG_1OOM_DE_BV(buf, q, e.contact_broken, PLAYER_NUM)
    set q = SG_1OOM_DE_DUMMY(buf, q, 4)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.relation1, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.relation2, pnum, i16)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.diplo_type, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.diplo_val, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.diplo_p1, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.diplo_p2, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.trust, pnum, i16)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.broken_treaty, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.blunder, pnum, i16)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.tribute_field, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.tribute_tech, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.mood_treaty, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.mood_trade, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.mood_tech, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.mood_peace, pnum, i16)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.treaty, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.trade_bc, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.trade_percent, pnum, i16)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.spymode_next, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.offer_field, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.offer_tech, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.offer_bc, pnum)
    do {
        pin ab = carray(PLAYER_NUM)
        pin bc = carray(PLAYER_NUM)
        set q = SG_1OOM_DE_TBL_U16(buf, q, ab, pnum)
        set q = SG_1OOM_DE_TBL_U16(buf, q, bc, pnum)
        if bc@0 != PLAYER_NONE {
            ;; New save, demangle the data.
            loop i in pnum {
                var v
                set v = bc@(i)
                set e.attack_bounty@(i) = (v >> 8) & 0xf
                set e.bounty_collect@(i) = v & 0xf
                set v = ab@(i)
                if (v & 1) != 0 {
                    set e.attack_gift_tech@(i) = (v >> 8) & 0xff
                    set e.attack_gift_field@(i) = (v >> 1) & 0xf
                } else {
                    set e.attack_gift_bc@(i) = i16(v)
                }
            }
        } else {
            ;; Old save, simply copy the tables.
            loop i in pnum {
                set e.attack_bounty@(i) = ab@(i)
                set e.bounty_collect@(i) = bc@(i)
            }
        }
    }
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.hatred, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.have_met, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.trade_established_bc, pnum)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.spying, pnum, i16)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.spyfund, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.spymode, pnum)
    set e.security, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.spies, pnum)
    set e.reserve_bc, q = SG_1OOM_DE_U32(buf, q)
    set e.tax, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set e.base_shield, q = SG_1OOM_DE_U8(buf, q)
    set e.base_comp, q = SG_1OOM_DE_U8(buf, q)
    set e.base_weapon, q = SG_1OOM_DE_U8(buf, q)
    set e.colonist_oper_factories, q = SG_1OOM_DE_U8(buf, q)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.tech.percent, TECH_FIELD_NUM)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.tech.slider, TECH_FIELD_NUM, i16)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.tech.slider_lock, TECH_FIELD_NUM)
    set q = SG_1OOM_DE_TBL_U32(buf, q, e.tech.investment, TECH_FIELD_NUM)
    set q = SG_1OOM_DE_TBL_U8(buf, q, e.tech.project, TECH_FIELD_NUM)
    set q = SG_1OOM_DE_TBL_U32(buf, q, e.tech.cost, TECH_FIELD_NUM)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.tech.completed, TECH_FIELD_NUM)
    set e.shipdesigns_num, q = SG_1OOM_DE_U8(buf, q)
    if e.shipdesigns_num > NUM_SHIPDESIGNS {
        log_error("Save: decode invalid number of ship designs %i\n", e.shipdesigns_num)
        return -1
    }
    set q = game_save_decode_orbits(buf, q, e.orbit, planets)
    if q < 0 {
        return -1
    }
    set q = SG_1OOM_DE_TBL_TBL_U8(buf, q, e.spyreportfield, pnum, TECH_FIELD_NUM)
    set q = SG_1OOM_DE_TBL_U16(buf, q, e.spyreportyear, pnum)
    set e.shipi_colony, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    set e.shipi_bomber, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    q
}

func game_save_encode_sd (buf, pos, sd) {
    var q = pos
    set q = SG_1OOM_EN_TBL_U8(buf, q, sd.name, SHIP_NAME_LEN)
    set q = SG_1OOM_EN_U16(buf, q, sd.cost)
    set q = SG_1OOM_EN_U16(buf, q, sd.space)
    set q = SG_1OOM_EN_U8(buf, q, sd.hull)
    set q = SG_1OOM_EN_U8(buf, q, sd.look)
    set q = SG_1OOM_EN_TBL_U8(buf, q, sd.wpnt, WEAPON_SLOT_NUM)
    set q = SG_1OOM_EN_TBL_U8(buf, q, sd.wpnn, WEAPON_SLOT_NUM)
    set q = SG_1OOM_EN_U8(buf, q, sd.engine)
    set q = SG_1OOM_EN_U32(buf, q, sd.engines)
    set q = SG_1OOM_EN_TBL_U8(buf, q, sd.special, SPECIAL_SLOT_NUM)
    set q = SG_1OOM_EN_U8(buf, q, sd.shield)
    set q = SG_1OOM_EN_U8(buf, q, sd.jammer)
    set q = SG_1OOM_EN_U8(buf, q, sd.comp)
    set q = SG_1OOM_EN_U8(buf, q, sd.armor)
    set q = SG_1OOM_EN_U8(buf, q, sd.man)
    set q = SG_1OOM_EN_U16(buf, q, sd.hp)
    q
}

func game_save_decode_sd (buf, pos, sd) {
    var q = pos
    set q = SG_1OOM_DE_TBL_U8(buf, q, sd.name, SHIP_NAME_LEN)
    set sd.cost, q = SG_1OOM_DE_U16(buf, q)
    set sd.space, q = SG_1OOM_DE_U16(buf, q)
    set sd.hull, q = SG_1OOM_DE_U8(buf, q)
    set sd.look, q = SG_1OOM_DE_U8(buf, q)
    set q = SG_1OOM_DE_TBL_U8(buf, q, sd.wpnt, WEAPON_SLOT_NUM)
    set q = SG_1OOM_DE_TBL_U8(buf, q, sd.wpnn, WEAPON_SLOT_NUM)
    set sd.engine, q = SG_1OOM_DE_U8(buf, q)
    set sd.engines, q = SG_1OOM_DE_U32(buf, q)
    set q = SG_1OOM_DE_TBL_U8(buf, q, sd.special, SPECIAL_SLOT_NUM)
    set sd.shield, q = SG_1OOM_DE_U8(buf, q)
    set sd.jammer, q = SG_1OOM_DE_U8(buf, q)
