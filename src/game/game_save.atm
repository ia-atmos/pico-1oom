    set q = SG_1OOM_DE_DUMMY(buf, q, 16)
    set ev.have_plague, q = SG_1OOM_DE_U8(buf, q)
    set ev.plague_player, q = SG_1OOM_DE_U8(buf, q)
    set ev.plague_planet_i, q = SG_1OOM_DE_U8(buf, q)
    set ev.plague_val, q = sg_de(i32, SG_1OOM_DE_U32(buf, q))
    set ev.have_nova, q = SG_1OOM_DE_U8(buf, q)
    set ev.nova_player, q = SG_1OOM_DE_U8(buf, q)
    set ev.nova_planet_i, q = SG_1OOM_DE_U8(buf, q)
    set ev.nova_years, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    set ev.nova_val, q = sg_de(i32, SG_1OOM_DE_U32(buf, q))
    set ev.have_accident, q = SG_1OOM_DE_U8(buf, q)
    set ev.accident_planet_i, q = SG_1OOM_DE_U8(buf, q)
    set ev.have_comet, q = SG_1OOM_DE_U8(buf, q)
    set ev.comet_player, q = SG_1OOM_DE_U8(buf, q)
    set ev.comet_planet_i, q = SG_1OOM_DE_U8(buf, q)
    set ev.comet_years, q = SG_1OOM_DE_U8(buf, q)
    set ev.comet_hp, q = SG_1OOM_DE_U16(buf, q)
    set ev.comet_dmg, q = SG_1OOM_DE_U16(buf, q)
    set ev.have_pirates, q = SG_1OOM_DE_U8(buf, q)
    set ev.pirates_planet_i, q = SG_1OOM_DE_U8(buf, q)
    set ev.pirates_hp, q = SG_1OOM_DE_U16(buf, q)
    set q = game_save_decode_monster(buf, q, ev.crystal)
    set q = game_save_decode_monster(buf, q, ev.amoeba)
    set ev.planet_orion_i, q = SG_1OOM_DE_U8(buf, q)
    set ev.have_guardian, q = sg_de(cbool, SG_1OOM_DE_U8(buf, q))
    set q = SG_1OOM_DE_TBL_U8(buf, q, ev.home, pnum)
    set ev.report_stars, q = SG_1OOM_DE_U8(buf, q)
    set q = SG_1OOM_DE_TBL_TBL_U32(buf, q, ev.new_ships, pnum, NUM_SHIPDESIGNS)
    set q = SG_1OOM_DE_TBL_TBL_U16(buf, q, ev.spies_caught, pnum, pnum)
    set q = SG_1OOM_DE_TBL_TBL_U16(buf, q, ev.ceasefire, pnum, pnum, i16)
    loop i in pnum {
        set q = SG_1OOM_DE_BV(buf, q, ev.help_shown@(i), HELP_SHOWN_NUM)
        set q = SG_1OOM_DE_DUMMY(buf, q, 14)
    }
    set q = SG_1OOM_DE_TBL_U16(buf, q, ev.build_finished_num, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, ev.voted, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, ev.best_ecorestore, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, ev.best_wastereduce, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, ev.best_roboctrl, pnum)
    set q = SG_1OOM_DE_TBL_U8(buf, q, ev.best_terraform, pnum)
    q
}

func game_save_encode (buf, g, version) {
    var q = 0
    set q = SG_1OOM_EN_U8(buf, q, g.players)
    set q = SG_1OOM_EN_BV(buf, q, g.is_ai, PLAYER_NUM)
    set q = SG_1OOM_EN_BV(buf, q, g.refuse, PLAYER_NUM)
    set q = SG_1OOM_EN_U8(buf, q, g.ai_id)
    set q = SG_1OOM_EN_DUMMY(buf, q, 3)
    set q = SG_1OOM_EN_U8(buf, q, g.active_player)
    set q = SG_1OOM_EN_U8(buf, q, g.difficulty)
    set q = SG_1OOM_EN_U8(buf, q, g.galaxy_size)
    set q = SG_1OOM_EN_U8(buf, q, g.galaxy_w)
    set q = SG_1OOM_EN_U8(buf, q, g.galaxy_h)
    set q = SG_1OOM_EN_U8(buf, q, g.galaxy_stars)
    set q = SG_1OOM_EN_U16(buf, q, g.galaxy_maxx)
    set q = SG_1OOM_EN_U16(buf, q, g.galaxy_maxy)
    set q = SG_1OOM_EN_U32(buf, q, g.galaxy_seed)
    set q = SG_1OOM_EN_U32(buf, q, g.seed)
    set q = SG_1OOM_EN_U16(buf, q, g.year)
    set q = SG_1OOM_EN_U16(buf, q, g.enroute_num)
    set q = SG_1OOM_EN_U16(buf, q, g.transport_num)
    set q = SG_1OOM_EN_U8(buf, q, g.end)
    set q = SG_1OOM_EN_U8(buf, q, g.winner)
    set q = SG_1OOM_EN_U8(buf, q, g.election_held)
    set q = SG_1OOM_EN_U8(buf, q, g.nebula_num)
    set q = SG_1OOM_EN_TBL_U16(buf, q, g.nebula_x, g.nebula_num)
    set q = SG_1OOM_EN_TBL_U16(buf, q, g.nebula_y, g.nebula_num)
    set q = SG_1OOM_EN_TBL_TBL_U16(buf, q, g.nebula_x0, g.nebula_num, 4)
    set q = SG_1OOM_EN_TBL_TBL_U16(buf, q, g.nebula_x1, g.nebula_num, 4)
    set q = SG_1OOM_EN_TBL_TBL_U16(buf, q, g.nebula_y0, g.nebula_num, 4)
    set q = SG_1OOM_EN_TBL_TBL_U16(buf, q, g.nebula_y1, g.nebula_num, 4)
    set q = SG_1OOM_EN_TBL_TBL_U8(buf, q, g.emperor_names, g.players, EMPEROR_NAME_LEN)
    set q = SG_1OOM_EN_TBL_U8(buf, q, g.planet_focus_i, g.players)
    loop i in g.galaxy_stars {
        set q = game_save_encode_planet(buf, q, g.planet@(i), g.players, version)
    }
    loop j in g.players {
        loop i in g.galaxy_stars {
            val s = g.seen@(j)@(i)
            set q = SG_1OOM_EN_U8(buf, q, s.owner)
            set q = SG_1OOM_EN_U16(buf, q, s.pop)
            set q = SG_1OOM_EN_U16(buf, q, s.bases)
            set q = SG_1OOM_EN_U16(buf, q, s.factories)
        }
    }
    loop i in g.enroute_num {
        set q = game_save_encode_enroute(buf, q, g.enroute@(i))
    }
    loop i in g.transport_num {
        set q = game_save_encode_transport(buf, q, g.transport@(i))
    }
    loop i in g.players {
        set q = game_save_encode_eto(buf, q, g.eto@(i), g.players, g.galaxy_stars, version)
    }
    loop i in g.players {
        set q = game_save_encode_srd(buf, q, g.srd@(i), g.eto@(i).shipdesigns_num, version)
    }
    loop i in g.players {
        set q = game_save_encode_sd(buf, q, g.current_design@(i))
    }
    set q = game_save_encode_evn(buf, q, g.evn, g.players, version)
    set q = SG_1OOM_EN_U32(buf, q, GAME_SAVE_END)
    q
}

func game_save_decode (buf, buflen, g, version) {
    var q = 0
    if buflen < 512 {
        log_error("Save: decode expected len > %i, got %i\n", 512, buflen)
        return -1
    }
    do {
        val ga = g.gaux
        loop k,v in game_s() {
            set g@(k) = v
        }
        set g.gaux = ga
    }
    set g.players, q = SG_1OOM_DE_U8(buf, q)
    if (g.players < 2) || (g.players > 6) {
        log_error("Save: decode invalid number of players %i\n", g.players)
        return -1
    }
    set q = SG_1OOM_DE_BV(buf, q, g.is_ai, PLAYER_NUM)
    set q = SG_1OOM_DE_BV(buf, q, g.refuse, PLAYER_NUM)
    set g.ai_id, q = SG_1OOM_DE_U8(buf, q)
    set q = SG_1OOM_DE_DUMMY(buf, q, 3)
    set g.active_player, q = SG_1OOM_DE_U8(buf, q)
    set g.difficulty, q = SG_1OOM_DE_U8(buf, q)
    if (g.difficulty < 0) || (g.difficulty >= DIFFICULTY_NUM) {
        log_error("Save: decode invalid difficulty value %i\n", g.difficulty)
        return -1
    }
    set g.galaxy_size, q = SG_1OOM_DE_U8(buf, q)
    set g.galaxy_w, q = SG_1OOM_DE_U8(buf, q)
    set g.galaxy_h, q = SG_1OOM_DE_U8(buf, q)
    set g.galaxy_stars, q = SG_1OOM_DE_U8(buf, q)
    if g.galaxy_stars > PLANETS_MAX {
        log_error("Save: decode invalid number of stars %i\n", g.galaxy_stars)
        return -1
    }
    set g.galaxy_maxx, q = SG_1OOM_DE_U16(buf, q)
    set g.galaxy_maxy, q = SG_1OOM_DE_U16(buf, q)
    set g.galaxy_seed, q = SG_1OOM_DE_U32(buf, q)
    set g.seed, q = SG_1OOM_DE_U32(buf, q)
    set g.year, q = SG_1OOM_DE_U16(buf, q)
    set g.enroute_num, q = SG_1OOM_DE_U16(buf, q)
    if g.enroute_num > FLEET_ENROUTE_MAX {
        log_error("Save: decode invalid number of fleets %i\n", g.enroute_num)
        return -1
    }
    set g.transport_num, q = SG_1OOM_DE_U16(buf, q)
    if g.transport_num > TRANSPORT_MAX {
        log_error("Save: decode invalid number of transports %i\n", g.transport_num)
        return -1
    }
    set g.end, q = SG_1OOM_DE_U8(buf, q)
    set g.winner, q = SG_1OOM_DE_U8(buf, q)
    set g.election_held, q = sg_de(cbool, SG_1OOM_DE_U8(buf, q))
    set g.nebula_num, q = SG_1OOM_DE_U8(buf, q)
    if g.nebula_num > NEBULA_MAX {
        log_error("Save: decode invalid number of nebula %i\n", g.nebula_num)
        return -1
    }
    set q = SG_1OOM_DE_TBL_U16(buf, q, g.nebula_x, g.nebula_num)
    set q = SG_1OOM_DE_TBL_U16(buf, q, g.nebula_y, g.nebula_num)
    set q = SG_1OOM_DE_TBL_TBL_U16(buf, q, g.nebula_x0, g.nebula_num, 4)
    set q = SG_1OOM_DE_TBL_TBL_U16(buf, q, g.nebula_x1, g.nebula_num, 4)
    set q = SG_1OOM_DE_TBL_TBL_U16(buf, q, g.nebula_y0, g.nebula_num, 4)
    set q = SG_1OOM_DE_TBL_TBL_U16(buf, q, g.nebula_y1, g.nebula_num, 4)
    loop i in g.nebula_num {
        ;; nebula_type is uint8_t: -1 becomes 255 there, and the test below
        ;; is never true in C. Kept as C has it.
        set g.nebula_type@(i) = u8(game_save_infer_nebula_type(g, i))
        if g.nebula_type@(i) < 0 {
            log_error("Save: unknown nebula type for nebula %i\n", i)
            return -1
        }
    }

    set q = SG_1OOM_DE_TBL_TBL_U8(buf, q, g.emperor_names, g.players, EMPEROR_NAME_LEN)
    set q = SG_1OOM_DE_TBL_U8(buf, q, g.planet_focus_i, g.players)
    loop i in g.galaxy_stars {
        set q = game_save_decode_planet(buf, q, g.planet@(i), g.players, version)
    }
    loop j in g.players {
        loop i in g.galaxy_stars {
            val s = g.seen@(j)@(i)
            set s.owner, q = SG_1OOM_DE_U8(buf, q)
            set s.pop, q = SG_1OOM_DE_U16(buf, q)
            set s.bases, q = SG_1OOM_DE_U16(buf, q)
            set s.factories, q = SG_1OOM_DE_U16(buf, q)
        }
    }
    loop i in g.enroute_num {
        set q = game_save_decode_enroute(buf, q, g.enroute@(i))
    }
    loop i in g.transport_num {
        set q = game_save_decode_transport(buf, q, g.transport@(i))
    }
    loop i in g.players {
        set q = game_save_decode_eto(buf, q, g.eto@(i), g.players, g.galaxy_stars, version)
        if q < 0 {
            return -1
        }
    }
    loop i in g.players {
        set q = game_save_decode_srd(buf, q, g.srd@(i), g.eto@(i).shipdesigns_num, version)
    }
    loop i in g.players {
        set q = game_save_decode_sd(buf, q, g.current_design@(i))
    }
    set q = game_save_decode_evn(buf, q, g.evn, g.players, version)
    do {
        var v
        if (q + 4) > buflen {
            ;; C reads past the data here, into the rest of its buffer
            ;; (zeros), and only then compares the position.
            set v = 0
            set q = q + 4
        } else {
            set v, q = SG_1OOM_DE_U32(buf, q)
        }
        if q > buflen {
            log_error("Save: decode read len %i > got %i\n", q, buflen)
            return -1
        }
        if v != GAME_SAVE_END {
            log_error("Save: invalid end mark 0x%08x != 0x%08x at %i!\n", v, GAME_SAVE_END, q)
            return -1
        }
    }
    if q < buflen {
        log_warning("Save: decode read len %i < got %i (left %i)\n", q, buflen, buflen - q)
    }
    ;; generate g->refuse if needed
    if (g.end == GAME_END_FINAL_WAR) && BOOLVEC_IS_CLEAR(g.refuse, PLAYER_NUM) {
        loop i in g.players {
            if IS_HUMAN(g, i) && IS_ALIVE(g, i) {
                BOOLVEC_SET1(g.refuse, i)
            }
        }
    }
    set g.guardian_killer = PLAYER_NONE
    0
}

;; ---------------------------------------------------------------------------

;; `strncpy`: the bytes of the string, and zeros after it, up to `n`.
func sg_strncpy (buf, pos, s, n) {
    loop i in n {
        set buf@(pos + i) = if i < #s => string.byte(s, i) => 0
    }
}

func game_save_make_header (buf, savename, version) {
    loop i in GAME_SAVE_HDR_SIZE {
        set buf@(i) = 0
    }
    loop i in 8 {
        set buf@(i) = string.byte(GAME_SAVE_MAGIC, i)
    }
    SET_LE_32(buf, GAME_SAVE_OFFS_VERSION, version)
    sg_strncpy(buf, GAME_SAVE_OFFS_NAME, savename, SAVE_NAME_LEN)
}

func game_save_do_save_do (filename, savename, g, savei, version) {
    pin savebuf = []
    val len = game_save_encode(savebuf, g, version)
    if len <= 0 {
        return -1
    }
    pin hdr = []
    game_save_make_header(hdr, savename, version)
    if (savei >= 0) && (savei < (NUM_SAVES + 1)) {
        set game_save_tbl_have_save@(savei) = false
        set game_save_tbl_name@(savei)@0 = 0
    }
    if !cfile_write(filename, hdr, savebuf) {
        log_error("Save: failed to save '%s'\n", filename)
        os.remove(filename)
        return -1
    }
    if (savei >= 0) && (savei < (NUM_SAVES + 1)) {
        set game_save_tbl_have_save@(savei) = true
        loop i in SAVE_NAME_LEN {
            set game_save_tbl_name@(savei)@(i) = hdr@(GAME_SAVE_OFFS_NAME + i)
        }
    }
    log_message("Save: save '%s' '%s'\n", filename, savename)
    0
}

;; The bytes of the file after its header, and its version; or nil.
;; In C, it returns the open file, to read the rest: here, the rest is read.
func game_save_open_check_header (filename, i, update_table, savename) {
    var upd = update_table
    if (i < 0) || (i >= NUM_ALL_SAVES) {
        set upd = false
    }
    if upd {
        set game_save_tbl_have_save@(i) = false
        set game_save_tbl_name@(i)@0 = 0
    }
    if savename {
        set savename@0 = 0
    }
    val bs = cfile_read(filename)
    if (bs == nil) || (#bs < GAME_SAVE_HDR_SIZE) {
        return nil
    }
    loop k in 8 {
        if bs@(k) != string.byte(GAME_SAVE_MAGIC, k) {
            return nil
        }
    }
    val version = GET_LE_32(bs, GAME_SAVE_OFFS_VERSION)
    if version > GAME_SAVE_VERSION {
        return nil
    }
    if upd {
        set game_save_tbl_have_save@(i) = true
        loop k in SAVE_NAME_LEN {
            set game_save_tbl_name@(i)@(k) = bs@(GAME_SAVE_OFFS_NAME + k)
        }
        set game_save_tbl_name@(i)@(SAVE_NAME_LEN - 1) = 0
    }
    if savename {
        loop k in SAVE_NAME_LEN {
            set savename@(k) = bs@(GAME_SAVE_OFFS_NAME + k)
        }
        set savename@(SAVE_NAME_LEN - 1) = 0
    }
    pin rest = []
    loop k in (GAME_SAVE_HDR_SIZE, #bs - 1) {
        set rest@+ = bs@(k)
    }
    return rest, version
}

func game_save_do_load_do (filename, g, savei, savename) {
    var res = -1
    val savebuf, version = game_save_open_check_header(filename, savei, true, savename)
    ifs {
        (savebuf == nil) || (#savebuf == 0) => {
            log_error("Save: failed to load '%s'\n", filename)
        }
        game_save_decode(savebuf, #savebuf, g, version) != 0 => {
            log_error("Save: invalid data on load '%s'\n", filename)
        }
        else => {
            log_message("Save: load '%s'\n", filename)
            set res = 0
        }
    }
    res
}
