}

func game_save_decode_monster (buf, pos, m) {
    var q = pos
    set m.exists, q = SG_1OOM_DE_U8(buf, q)
    set m.x, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set m.y, q = sg_de(i16, SG_1OOM_DE_U16(buf, q))
    set m.killer, q = SG_1OOM_DE_U8(buf, q)
    set m.dest, q = SG_1OOM_DE_U8(buf, q)
    set m.counter, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    set m.nuked, q = sg_de(i8, SG_1OOM_DE_U8(buf, q))
    q
}

func game_save_encode_evn (buf, pos, ev, pnum, version) {
    var q = pos
    set q = SG_1OOM_EN_U16(buf, q, ev.year)
    set q = SG_1OOM_EN_BV(buf, q, ev.done, GAME_EVENT_TBL_NUM)
    set q = SG_1OOM_EN_U8(buf, q, ev.diplo_msg_subtype)
    set q = SG_1OOM_EN_DUMMY(buf, q, 16)
    set q = SG_1OOM_EN_U8(buf, q, ev.have_plague)
    set q = SG_1OOM_EN_U8(buf, q, ev.plague_player)
    set q = SG_1OOM_EN_U8(buf, q, ev.plague_planet_i)
    set q = SG_1OOM_EN_U32(buf, q, ev.plague_val)
    set q = SG_1OOM_EN_U8(buf, q, ev.have_nova)
    set q = SG_1OOM_EN_U8(buf, q, ev.nova_player)
    set q = SG_1OOM_EN_U8(buf, q, ev.nova_planet_i)
    set q = SG_1OOM_EN_U8(buf, q, ev.nova_years)
    set q = SG_1OOM_EN_U32(buf, q, ev.nova_val)
    set q = SG_1OOM_EN_U8(buf, q, ev.have_accident)
    set q = SG_1OOM_EN_U8(buf, q, ev.accident_planet_i)
    set q = SG_1OOM_EN_U8(buf, q, ev.have_comet)
    set q = SG_1OOM_EN_U8(buf, q, ev.comet_player)
    set q = SG_1OOM_EN_U8(buf, q, ev.comet_planet_i)
    set q = SG_1OOM_EN_U8(buf, q, ev.comet_years)
    set q = SG_1OOM_EN_U16(buf, q, ev.comet_hp)
    set q = SG_1OOM_EN_U16(buf, q, ev.comet_dmg)
    set q = SG_1OOM_EN_U8(buf, q, ev.have_pirates)
    set q = SG_1OOM_EN_U8(buf, q, ev.pirates_planet_i)
    set q = SG_1OOM_EN_U16(buf, q, ev.pirates_hp)
    set q = game_save_encode_monster(buf, q, ev.crystal)
    set q = game_save_encode_monster(buf, q, ev.amoeba)
    set q = SG_1OOM_EN_U8(buf, q, ev.planet_orion_i)
    set q = SG_1OOM_EN_U8(buf, q, ev.have_guardian)
    set q = SG_1OOM_EN_TBL_U8(buf, q, ev.home, pnum)
    set q = SG_1OOM_EN_U8(buf, q, ev.report_stars)
    set q = SG_1OOM_EN_TBL_TBL_U32(buf, q, ev.new_ships, pnum, NUM_SHIPDESIGNS)
    set q = SG_1OOM_EN_TBL_TBL_U16(buf, q, ev.spies_caught, pnum, pnum)
    set q = SG_1OOM_EN_TBL_TBL_U16(buf, q, ev.ceasefire, pnum, pnum)
    loop i in pnum {
        set q = SG_1OOM_EN_BV(buf, q, ev.help_shown@(i), HELP_SHOWN_NUM)
        set q = SG_1OOM_EN_DUMMY(buf, q, 14)
    }
    set q = SG_1OOM_EN_TBL_U16(buf, q, ev.build_finished_num, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, ev.voted, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, ev.best_ecorestore, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, ev.best_wastereduce, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, ev.best_roboctrl, pnum)
    set q = SG_1OOM_EN_TBL_U8(buf, q, ev.best_terraform, pnum)
    q
}

