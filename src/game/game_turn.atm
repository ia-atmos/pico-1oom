;; Of c/src/game/game.c (an option of the configuration), here until game.c
;; is ported.
pin game_opt_message_filter = carray(FINISHED_NUM, false)   ;; bool[]

;; ---------------------------------------------------------------------------

var copyprot_status = 0     ;; int

func game_turn_limit_ships (g) {
    loop ei in g.enroute_num {
        val r = g.enroute@(ei)
        loop si in NUM_SHIPDESIGNS {
            set r.ships@(si) = SETMIN(r.ships@(si), game_num_limit_ships)
        }
        set r.retreat = false
    }
    loop i in g.galaxy_stars {
        loop j in g.players {
            val r = g.eto@(j).orbit@(i)
            loop si in NUM_SHIPDESIGNS {
                set r.ships@(si) = SETMIN(r.ships@(si), game_num_limit_ships)
            }
        }
    }
    game_remove_empty_fleets(g)
}

func game_turn_countdown_ceasefire (g) {
    loop j in g.players {
        loop i in g.players {
            if g.evn.ceasefire@(j)@(i) > 0 {
                set g.evn.ceasefire@(j)@(i) = g.evn.ceasefire@(j)@(i) - 1
            }
        }
    }
}

;; The change of one mood of `game_turn_update_mood_blunder`.
func turn_mood (g, v0) {
    var v = v0  ;; int16_t
    if v < 0 {
        set v = i16(v + rnd_1_n(5, g))
    }
    if v < 50 {
        set v = i16(v + rnd_1_n(5, g))
    }
    v
}

func game_turn_update_mood_blunder (g) {
    loop i in g.players {
        val e = g.eto@(i)
        loop j in (PLAYER_1, g.players - 1) {
            if i != j {
                var v = e.diplo_type@(j)    ;; int16_t
                if (v >= 4) && (v <= 11) {
                    set e.blunder@(j) = v
                } else {
                    if (v >= 42) && (v <= 49) {
                        set e.blunder@(j) = v - 30
                    } else {
                        if (v >= 50) && (v <= 57) {
                            set e.blunder@(j) = v - 46
                        }
                    }
                }
                if e.treaty@(j) != TREATY_FINAL_WAR {
                    set e.mood_treaty@(j) = turn_mood(g, e.mood_treaty@(j))
                    set e.mood_trade@(j) = turn_mood(g, e.mood_trade@(j))
                    set e.mood_tech@(j) = turn_mood(g, e.mood_tech@(j))
                    set v = turn_mood(g, e.mood_peace@(j))
                    set v = SETRANGE(v, -200, 200)
                    set e.mood_peace@(j) = v
                }
            }
        }
    }
    loop i in g.players {
        val e = g.eto@(i)
        loop j in g.players {
            set e.diplo_val@(j) = 0
            set e.diplo_type@(j) = 0
            if e.bounty_collect@(j) != PLAYER_NONE {
                set e.attack_bounty@(j) = PLAYER_NONE
                set e.bounty_collect@(j) = PLAYER_NONE
            }
            set e.au_tech_trade_num@(j) = 0
            set e.offer_tech@(j) = 0
            set e.au_want_tech@(j) = 0
            set e.offer_bc@(j) = 0
        }
    }
}

func game_turn_init_z_finished (g) {
    loop _,t in g.evn.spies_caught {
        loop k in #t {
            set t@(k) = 0
        }
    }
    loop _,t in g.evn.new_ships {
        loop k in #t {
            set t@(k) = 0
        }
    }
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        BOOLVEC_CLEAR(p.finished, FINISHED_NUM)
        BOOLVEC_CLEAR(p.unrefuel, PLAYER_NUM)
    }
    loop i in g.players {
        val e = g.eto@(i)
        BOOLVEC_CLEAR(e.contact_broken, PLAYER_NUM)
    }
    loop k in #g.evn.build_finished_num {
        set g.evn.build_finished_num@(k) = 0
    }
}

func game_turn_send_transport (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        if (p.owner != PLAYER_NONE) && (p.trans_num > 0) {
            game_send_transport(g, p)
        }
    }
}

func game_turn_build_eco_sub1 (fact0, colonist_oper_fact, pop1, waste, max_pop2) {
    if game_num_waste_calc_fix {
        ;; WASBUG
        ;; MOO1 adds waste twice using two separate pieces of code.
        ;; The first time (see above) is as described in OSG.
        ;; The second time (see below, from game_turn_build_eco_sub1) has several issues:
        ;; - p->pop * e->colonist_oper_factories * e->colonist_oper_factories / 10 makes no sense
        ;; - since p->waste is not limited at this point, the value added can be negative, leading to Silicoid planets with 0 waste
        ;; - the cost of eco restoration is already calculated; as the slider is typically set to Clean (ecorestore <= ecoprod) the point is mostly moot
        ;; Speculation: Someone added the above working code and forgot to remove this broken code.
        return 0
    }
    var fact = fact0
    var v = pop1 * colonist_oper_fact
    set fact = SETMIN(fact, v)
    set v = (fact * colonist_oper_fact) // 10
    ((100 - ((waste * 100) // max_pop2)) * v) // 100
}

func game_add_planet_to_eco_finished (g, pli, owner) {
    BOOLVEC_SET1(g.planet@(pli).finished, FINISHED_SOILATMOS)
}

func game_turn_build_eco (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        set p.pop_prev = if owner != PLAYER_NONE => p.pop => 0
        if (owner != PLAYER_NONE) && (p.type != PLANET_TYPE_NOT_HABITABLE) && (p.pop != 0) {
            val e = g.eto@(owner)
            var ecorestore
            var ecoprod
            do {
                var fact = p.factories
                val v = p.pop * game_planet_get_pop_oper_fact(g, p)
                set fact = SETMIN(fact, v)
                val waste = (fact * e.ind_waste_scale) // 10
                set p.waste = i16(p.waste + (((100 - ((p.waste * 100) // p.max_pop2)) * waste) // 100))
            }
            if p.unrest == PLANET_UNREST_REBELLION {
                set p.waste = 0
            }
            set ecorestore = if e.race != RACE_SILICOID => (p.waste // e.have_eco_restoration_n) => 0
            set p.waste = i16(p.waste + game_turn_build_eco_sub1(p.factories, game_planet_get_pop_oper_fact(g, p), p.pop, p.waste, p.max_pop2))
            set ecoprod = (p.slider@(PLANET_SLIDER_ECO) * p.prod_after_maint) // 100
            if e.race != RACE_SILICOID {
                if ecorestore > ecoprod {
                    set p.waste = i16(p.waste - (e.have_eco_restoration_n * ecoprod))
                    set ecoprod = 0
                } else {
                    set ecoprod = ecoprod - ecorestore
                    set p.waste = 0
                }
            }
            set p.waste = SETMAX(p.waste, 0)
            if (p.max_pop2 - p.waste) < 10 {
                set p.waste = i16(p.max_pop2 - 10)
            }
            set p.waste = SETMAX(p.waste, 0)
            if (ecoprod > 0) && e.have_atmos_terra && (p.growth == PLANET_GROWTH_HOSTILE) {
                set p.bc_to_ecoproj = i16(p.bc_to_ecoproj + ecoprod)
                if p.bc_to_ecoproj >= game_num_atmos_cost {
                    game_turn_atmos_tform(p)
                    set ecoprod = p.bc_to_ecoproj - game_num_atmos_cost
                    set p.bc_to_ecoproj = 0
                    ;; WASBUG MOO1 did p->bc_to_ecoproj -= game_num_atmos_cost
                    ;; instead which allowed double-spending of credits if
                    ;; p->bc_to_ecoproj > game_num_atmos_cost.
                    game_add_planet_to_eco_finished(g, i, owner)
                } else {
                    set ecoprod = 0
                }
            }
            if (ecoprod > 0) && e.have_soil_enrich && (p.growth == PLANET_GROWTH_NORMAL) {
                set p.bc_to_ecoproj = i16(p.bc_to_ecoproj + ecoprod)
                if p.bc_to_ecoproj > game_num_soil_cost {
                    game_turn_soil_enrich(p, e.have_terraform_n, false)
                    set ecoprod = p.bc_to_ecoproj - game_num_soil_cost
                    ;; p->bc_to_ecoproj carries over as partial progress
                    ;; towards advanced soil enrichment.
                    set p.bc_to_ecoproj = SETMIN(p.bc_to_ecoproj, game_num_soil_cost)
                    ;; WASBUG MOO1 did not do the SETMIN, allowing
                    ;; double-spending again.
                    game_add_planet_to_eco_finished(g, i, owner)
                } else {
                    set ecoprod = 0
                }
            }
            if (ecoprod > 0) && e.have_adv_soil_enrich && (p.growth < PLANET_GROWTH_GAIA) && (p.growth > PLANET_GROWTH_HOSTILE) {
                set p.bc_to_ecoproj = i16(p.bc_to_ecoproj + ecoprod)
                if p.bc_to_ecoproj > game_num_adv_soil_cost {
                    game_turn_soil_enrich(p, e.have_terraform_n, true)
                    set ecoprod = p.bc_to_ecoproj - game_num_adv_soil_cost
                    set p.bc_to_ecoproj = 0
                    ;; WASBUG MOO1 did not reset p->bc_to_ecoproj to 0, but
                    ;; the planet may become hostile due to a random event and
                    ;; then this variable becomes relevant again.
                    game_add_planet_to_eco_finished(g, i, owner)
                } else {
                    set ecoprod = 0
                }
            }
            if (ecoprod > 0) && ((p.max_pop3 - p.max_pop2) < e.have_terraform_n) && (p.max_pop3 < game_num_max_pop) {
                val v = ecoprod // e.terraform_cost_per_inc
                val tmax = e.have_terraform_n + p.max_pop2
                if tmax < (p.max_pop3 + v) {
                    set ecoprod = ecoprod - ((tmax - p.max_pop3) * e.terraform_cost_per_inc)
                    set p.max_pop3 = i16(tmax)
                } else {
                    set p.max_pop3 = i16(p.max_pop3 + v)
                    set ecoprod = 0
                }
            }
            set p.max_pop3 = SETMIN(p.max_pop3, game_num_max_pop)
            set ecoprod = SETMAX(ecoprod, 0)
            do {
                val v = game_get_pop_growth_max(g, p, p.max_pop3) + game_get_pop_growth_for_eco(g, p, ecoprod) + p.pop_tenths
                set p.pop = i16(p.pop + (v // 10))
                set p.pop_tenths = i8(v % 10)
            }
            set p.pop = SETRANGE(p.pop, 0, p.max_pop3)
        }
    }
}

func game_turn_update_trade (g) {
    loop i in g.players {
        val e = g.eto@(i)
        loop j in (i, g.players - 1) {
            val e2 = g.eto@(j)
            val bc = e.trade_bc@(j)     ;; uint16_t
            if bc != 0 {
                if BOOLVEC_IS0(e.contact, j) {
                    set e.trade_bc@(j) = 0
                    set e.trade_percent@(j) = 0
                    set e.trade_established_bc@(j) = 0
                } else {
                    var estbc = e.trade_established_bc@(j)  ;; uint16_t
                    if estbc < bc {     ;; FIXME BUG? never true ; both are set to bc
                        set estbc = u16(estbc + (bc // 10))
                        set estbc = SETMIN(estbc, bc)
                        set e.trade_established_bc@(j) = estbc
                        set e2.trade_established_bc@(i) = estbc
                    }
                    var v = i16((rnd_1_n(200, g) + e.relation1@(j) + 25) // 60)    ;; int16_t
                    set v = SETMAX(v, 0)
                    set e.trade_percent@(j) = i16(ADDSATT(e.trade_percent@(j), v, 100))
                    set e2.trade_percent@(i) = i16(ADDSATT(e2.trade_percent@(i), v, 100))
                }
            }
        }
    }
}

func game_add_planet_to_shield_finished (g, pli, owner) {
    BOOLVEC_SET1(g.planet@(pli).finished, FINISHED_SHIELD)
}

func game_turn_build_def (g) {
    pin cost_new = carray(PLAYER_NUM)   ;; int16_t[]
    pin cost_diff = carray(PLAYER_NUM)  ;; int16_t[]
    loop i in g.players {
        val e = g.eto@(i)
        val cost_old = i16(game_get_base_cost(g, i))
        set e.base_weapon = u8(game_get_base_weapon(g, i, e.tech.percent@(TECH_FIELD_WEAPON)))
        set e.base_shield = u8(game_get_best_shield(g, i, e.tech.percent@(TECH_FIELD_FORCE_FIELD)))
        set e.base_comp = u8(game_get_best_comp(g, i, e.tech.percent@(TECH_FIELD_COMPUTER)))
        set cost_new@(i) = i16(game_get_base_cost(g, i))
        set cost_diff@(i) = i16(cost_new@(i) - cost_old)
        set cost_diff@(i) = SETMAX(cost_diff@(i), 0)
    }
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val e = g.eto@(owner)
            var prod = game_adjust_prod_by_special((p.slider@(PLANET_SLIDER_DEF) * p.prod_after_maint) // 100, p.special)
            set prod = prod + p.bc_to_base
            var toup = (cost_diff@(owner) * p.missile_bases) + p.bc_upgrade_base
            if toup >= prod {
                set toup = toup - prod
                set p.bc_upgrade_base = u16(toup)
                set p.bc_to_base = 0
            } else {
                set prod = prod - toup
                set p.bc_upgrade_base = 0
                var tosh = e.planet_shield_cost - p.bc_to_shield
                set tosh = SETMAX(tosh, 0)
                if (p.battlebg == 0) || game_xy_is_in_nebula(g, p.x, p.y) {   ;; FIXME later check is redundant
                    set tosh = 0
                    set p.bc_to_shield = 0
                }
                if prod <= tosh {   ;; FIXME just "<" ?
                    set p.bc_to_shield = u16(p.bc_to_shield + prod)
                    set prod = 0
                } else {
                    set prod = prod - tosh
                    set p.bc_to_shield = e.planet_shield_cost
                    loop {
                        while prod >= cost_new@(owner)
                        set prod = prod - cost_new@(owner)
                        set p.missile_bases = u16(p.missile_bases + 1)
                    }
                }
                set p.bc_to_base = u16(prod)
            }
            do {
                val curcost = SETMIN(e.planet_shield_cost, p.bc_to_shield)
                var newshield = 0   ;; uint8_t
                var j = 1
                loop {
                    while (j < PSHIELD_NUM) && (curcost >= game_num_pshield_cost@(j))
                    set newshield = newshield + 5
                    set j = j + 1
                }
                if newshield != p.shield {
                    set p.shield = newshield
                    if newshield == g.eto@(owner).have_planet_shield {
                        game_add_planet_to_shield_finished(g, i, owner)
                    }
                }
            }
        }
    }
}

func game_add_planet_to_stargate_finished (g, pli, owner) {
    BOOLVEC_SET1(g.planet@(pli).finished, FINISHED_STARGATE)
}

func game_turn_build_ship (g) {
    game_update_maint_costs(g)
    loop i in g.players {
        val e = g.eto@(i)
        val srd = g.srd@(i)
        pin gd = game_design_s()
        set gd.sd_num = e.shipdesigns_num
        set gd.player_i = i
        loop f in TECH_FIELD_NUM {
            set gd.percent@(f) = e.tech.percent@(f)
        }
        loop j in gd.sd_num {
            val sd = srd.design@(j)
            cstruct_copy(gd.sd, sd)
            set sd.cost = u16(game_design_calc_cost(gd))
        }
    }
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val e = g.eto@(owner)
            val srd = g.srd@(owner)
            var prod = game_adjust_prod_by_special((p.slider@(PLANET_SLIDER_SHIP) * p.prod_after_maint) // 100, p.special)
            set prod = prod + p.bc_to_ship
            ;; BUG: A 1 BC bonus for having the slider > 0.
            ;; This bonus is not taken into account by UI
            if p.slider@(PLANET_SLIDER_SHIP) > 0 {
                set prod = prod + 1
            }
            val si = p.buildship    ;; uint8_t
            if si == BUILDSHIP_STARGATE {
                if prod >= game_num_stargate_cost {
                    set p.have_stargate = true
                    set p.buildship = 0
                    set p.bc_to_ship = u16(prod - game_num_stargate_cost)
                    game_add_planet_to_stargate_finished(g, i, owner)
                } else {
                    set p.bc_to_ship = u16(prod)
                }
            } else {
                val sd = srd.design@(si)
                val cost = sd.cost
                var shipnum = 0
                loop {
                    while prod >= cost
                    set shipnum = shipnum + 1
                    set prod = prod - cost
                }
                if (shipnum + srd.shipcount@(si)) > game_num_limit_ships_all {
                    set shipnum = i32(game_num_limit_ships_all - srd.shipcount@(si))
                }
                set shipnum = SETMAX(shipnum, 0)
                set srd.shipcount@(si) = u32(srd.shipcount@(si) + shipnum)
                val dest = p.reloc  ;; uint8_t
                if dest == i {
                    set e.orbit@(i).ships@(si) = u16(e.orbit@(i).ships@(si) + shipnum)
                    if shipnum > 0 {
                        BOOLVEC_SET1(p.finished, FINISHED_SHIP)
                    }
                } else {
                    if shipnum > 0 {
                        game_send_fleet_reloc(g, owner, i, dest, si, u16(shipnum))
                    }
                }
                set g.evn.new_ships@(owner)@(si) = u32(g.evn.new_ships@(owner)@(si) + shipnum)
                set p.bc_to_ship = u16(prod)
            }
        }
    }
    game_update_visibility(g)
}

func game_turn_reserve (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val v = p.prod_after_maint // 2     ;; uint32_t
            var r = p.reserve   ;; uint32_t
            if v < r {
                set r = r - v
            } else {
                set r = 0
            }
            set p.reserve = r
        }
    }
    loop i in g.players {
        val e = g.eto@(i)
        set e.reserve_bc = u32(e.reserve_bc + (u32(e.total_production_bc * e.tax) // 2000))
    }
}

func game_add_planet_to_build_finished (g, pli, owner, type_) {
    if game_opt_message_filter@(type_) {
        return nil
    }
    val p = g.planet@(pli)
    BOOLVEC_SET1(p.finished, type_)
    set g.evn.build_finished_num@(owner) = u16(g.evn.build_finished_num@(owner) + 1)
}

func game_turn_finished_switch_slider (g, p, from, to) {
    if game_num_slider_respects_locks && ((p.slider_lock@(from) != 0) || (p.slider_lock@(to) != 0)) {
        return false
    }
    if from == to {
        return false
    }
    var v = p.slider@(from)
    if from == PLANET_SLIDER_ECO {
        set v = v - game_planet_get_waste_percent(nil, g, p, false)
        set v = SETMAX(v, 0)
    }
    set p.slider@(from) = i16(p.slider@(from) - v)
    set p.slider@(to) = i16(p.slider@(to) + v)
    true
}

func game_turn_finished_disable_slider (g, p, from, build_ind) {
    if game_num_slider_respects_locks && (p.slider_lock@(from) != 0) {
        return nil
    }
    val first = if build_ind => PLANET_SLIDER_IND => PLANET_SLIDER_TECH
    game_turn_finished_switch_slider(g, p, from, first)
    || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_TECH)
    || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_SHIP)
    || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_DEF)
    || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_IND)
    || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_ECO)
}

func game_turn_build_ind (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val e = g.eto@(owner)
            var fact = u16(p.factories)     ;; uint16_t
            val factold = fact
            var num     ;; uint16_t
            val cost = u8(game_planet_get_fact_adj_cost(g, p))  ;; uint8_t
            var prod = game_adjust_prod_by_special((p.slider@(PLANET_SLIDER_IND) * p.prod_after_maint) // 100, p.special)
            set prod = prod + p.bc_to_factory
            val bonus = if e.race == RACE_MEKLAR => 2 => 0  ;; uint8_t
            var v = e.colonist_oper_factories - p.pop_oper_fact - bonus
            if v > 0 {
                set v = v * (e.factory_cost // 2)
                if game_num_factory_cost_fix {
                    if e.race != RACE_MEKLAR {
                        set v = (e.factory_cost * p.factories) // 2
                    } else {
                        set v = 0
                    }
                }
            } else {
                set v = 0
            }
            if ((prod // cost) + fact) > (p.pop * p.pop_oper_fact) {
                if game_num_factory_cost_fix && (fact < (p.pop * p.pop_oper_fact)) {
                    set num = u16((p.pop * p.pop_oper_fact) - fact)
                    set fact = u16(p.pop * p.pop_oper_fact)
                    set prod = prod - (num * cost)
                }
                set p.bc_to_refit = u16(p.bc_to_refit + prod)
                if p.bc_to_refit >= v {
                    if game_num_factory_cost_fix && (e.race != RACE_MEKLAR) {
                        set p.pop_oper_fact = u8(p.pop_oper_fact + 1)
                        set p.pop_oper_fact = SETMIN(p.pop_oper_fact, e.colonist_oper_factories)
                    } else {
                        set p.pop_oper_fact = e.colonist_oper_factories
                    }
                    set prod = p.bc_to_refit - v
                    set p.bc_to_refit = 0
                } else {
                    set prod = 0
                }
            }
            set num = u16(prod // cost)
            set p.bc_to_factory = u8(prod % cost)
            set v = p.max_pop3 * game_planet_get_pop_oper_fact(g, p)
            if v < (fact + num) {
                set v = (fact + num) - v
                set v = SETMAX(v, 0)
                set v = SETMIN(v, num)
                set num = u16(num - v)
            } else {
                set v = 0
            }
            if game_num_factory_cost_fix && (p.pop_oper_fact < e.colonist_oper_factories) {
                set p.bc_to_refit = u16(p.bc_to_refit + ((v * cost) // 2))
            } else {
                set e.reserve_bc = u32(e.reserve_bc + ((v * cost) // 2))
            }
            set fact = u16(fact + num)
            set fact = SETMIN(fact, game_num_max_factories)
            set p.factories = i16(fact)
            if (fact != factold) && (fact >= (p.max_pop3 * e.colonist_oper_factories)) {
                if IS_HUMAN(g, owner) && (p.slider@(PLANET_SLIDER_IND) > 0) {
                    game_turn_finished_disable_slider(g, p, PLANET_SLIDER_IND, false)
                }
                game_add_planet_to_build_finished(g, i, owner, FINISHED_FACT)
            }
        }
    }
}
