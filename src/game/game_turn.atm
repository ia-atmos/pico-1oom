;; is ported.
pin game_opt_message_filter = carray(FINISHED_NUM, false)   ;; bool[]

;; ---------------------------------------------------------------------------

var copyprot_status = 0     ;; int

func game_turn_limit_ships (g) {
    loop ei in g.enroute_num {
        val r = g.enroute@(ei)
        loop si in NUM_SHIPDESIGNS {
            set r.ships@(si) = SETMIN(r.ships@(si), game_num_limit_ships)
        }
        set r.retreat = false
    }
    loop i in g.galaxy_stars {
        loop j in g.players {
            val r = g.eto@(j).orbit@(i)
            loop si in NUM_SHIPDESIGNS {
                set r.ships@(si) = SETMIN(r.ships@(si), game_num_limit_ships)
            }
        }
    }
    game_remove_empty_fleets(g)
}

func game_turn_countdown_ceasefire (g) {
    loop j in g.players {
        loop i in g.players {
            if g.evn.ceasefire@(j)@(i) > 0 {
                set g.evn.ceasefire@(j)@(i) = g.evn.ceasefire@(j)@(i) - 1
            }
        }
    }
}

;; The change of one mood of `game_turn_update_mood_blunder`.
func turn_mood (g, v0) {
    var v = v0  ;; int16_t
    if v < 0 {
        set v = i16(v + rnd_1_n(5, g))
    }
    if v < 50 {
        set v = i16(v + rnd_1_n(5, g))
    }
    v
}

func game_turn_update_mood_blunder (g) {
    loop i in g.players {
        val e = g.eto@(i)
        loop j in (PLAYER_1, g.players - 1) {
            if i != j {
                var v = e.diplo_type@(j)    ;; int16_t
                if (v >= 4) && (v <= 11) {
                    set e.blunder@(j) = v
                } else {
                    if (v >= 42) && (v <= 49) {
                        set e.blunder@(j) = v - 30
                    } else {
                        if (v >= 50) && (v <= 57) {
                            set e.blunder@(j) = v - 46
                        }
                    }
                }
                if e.treaty@(j) != TREATY_FINAL_WAR {
                    set e.mood_treaty@(j) = turn_mood(g, e.mood_treaty@(j))
                    set e.mood_trade@(j) = turn_mood(g, e.mood_trade@(j))
                    set e.mood_tech@(j) = turn_mood(g, e.mood_tech@(j))
                    set v = turn_mood(g, e.mood_peace@(j))
                    set v = SETRANGE(v, -200, 200)
                    set e.mood_peace@(j) = v
                }
            }
        }
    }
    loop i in g.players {
        val e = g.eto@(i)
        loop j in g.players {
            set e.diplo_val@(j) = 0
            set e.diplo_type@(j) = 0
            if e.bounty_collect@(j) != PLAYER_NONE {
                set e.attack_bounty@(j) = PLAYER_NONE
                set e.bounty_collect@(j) = PLAYER_NONE
            }
            set e.au_tech_trade_num@(j) = 0
            set e.offer_tech@(j) = 0
            set e.au_want_tech@(j) = 0
            set e.offer_bc@(j) = 0
        }
    }
}

func game_turn_init_z_finished (g) {
    loop _,t in g.evn.spies_caught {
        loop k in #t {
            set t@(k) = 0
        }
    }
    loop _,t in g.evn.new_ships {
        loop k in #t {
            set t@(k) = 0
        }
    }
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        BOOLVEC_CLEAR(p.finished, FINISHED_NUM)
        BOOLVEC_CLEAR(p.unrefuel, PLAYER_NUM)
    }
    loop i in g.players {
        val e = g.eto@(i)
        BOOLVEC_CLEAR(e.contact_broken, PLAYER_NUM)
    }
    loop k in #g.evn.build_finished_num {
        set g.evn.build_finished_num@(k) = 0
    }
}

func game_turn_send_transport (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        if (p.owner != PLAYER_NONE) && (p.trans_num > 0) {
            game_send_transport(g, p)
        }
    }
}

func game_turn_build_eco_sub1 (fact0, colonist_oper_fact, pop1, waste, max_pop2) {
    if game_num_waste_calc_fix {
        ;; WASBUG
        ;; MOO1 adds waste twice using two separate pieces of code.
        ;; The first time (see above) is as described in OSG.
        ;; The second time (see below, from game_turn_build_eco_sub1) has several issues:
        ;; - p->pop * e->colonist_oper_factories * e->colonist_oper_factories / 10 makes no sense
        ;; - since p->waste is not limited at this point, the value added can be negative, leading to Silicoid planets with 0 waste
        ;; - the cost of eco restoration is already calculated; as the slider is typically set to Clean (ecorestore <= ecoprod) the point is mostly moot
        ;; Speculation: Someone added the above working code and forgot to remove this broken code.
        return 0
    }
    var fact = fact0
    var v = pop1 * colonist_oper_fact
    set fact = SETMIN(fact, v)
    set v = (fact * colonist_oper_fact) // 10
    ((100 - ((waste * 100) // max_pop2)) * v) // 100
}

func game_add_planet_to_eco_finished (g, pli, owner) {
    BOOLVEC_SET1(g.planet@(pli).finished, FINISHED_SOILATMOS)
}

func game_turn_build_eco (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        set p.pop_prev = if owner != PLAYER_NONE => p.pop => 0
        if (owner != PLAYER_NONE) && (p.type != PLANET_TYPE_NOT_HABITABLE) && (p.pop != 0) {
            val e = g.eto@(owner)
            var ecorestore
            var ecoprod
            do {
                var fact = p.factories
                val v = p.pop * game_planet_get_pop_oper_fact(g, p)
                set fact = SETMIN(fact, v)
                val waste = (fact * e.ind_waste_scale) // 10
                set p.waste = i16(p.waste + (((100 - ((p.waste * 100) // p.max_pop2)) * waste) // 100))
            }
            if p.unrest == PLANET_UNREST_REBELLION {
                set p.waste = 0
            }
            set ecorestore = if e.race != RACE_SILICOID => (p.waste // e.have_eco_restoration_n) => 0
            set p.waste = i16(p.waste + game_turn_build_eco_sub1(p.factories, game_planet_get_pop_oper_fact(g, p), p.pop, p.waste, p.max_pop2))
            set ecoprod = (p.slider@(PLANET_SLIDER_ECO) * p.prod_after_maint) // 100
            if e.race != RACE_SILICOID {
                if ecorestore > ecoprod {
                    set p.waste = i16(p.waste - (e.have_eco_restoration_n * ecoprod))
                    set ecoprod = 0
                } else {
                    set ecoprod = ecoprod - ecorestore
                    set p.waste = 0
                }
            }
            set p.waste = SETMAX(p.waste, 0)
            if (p.max_pop2 - p.waste) < 10 {
                set p.waste = i16(p.max_pop2 - 10)
            }
            set p.waste = SETMAX(p.waste, 0)
            if (ecoprod > 0) && e.have_atmos_terra && (p.growth == PLANET_GROWTH_HOSTILE) {
                set p.bc_to_ecoproj = i16(p.bc_to_ecoproj + ecoprod)
                if p.bc_to_ecoproj >= game_num_atmos_cost {
                    game_turn_atmos_tform(p)
                    set ecoprod = p.bc_to_ecoproj - game_num_atmos_cost
                    set p.bc_to_ecoproj = 0
                    ;; WASBUG MOO1 did p->bc_to_ecoproj -= game_num_atmos_cost
                    ;; instead which allowed double-spending of credits if
                    ;; p->bc_to_ecoproj > game_num_atmos_cost.
                    game_add_planet_to_eco_finished(g, i, owner)
                } else {
                    set ecoprod = 0
                }
            }
            if (ecoprod > 0) && e.have_soil_enrich && (p.growth == PLANET_GROWTH_NORMAL) {
                set p.bc_to_ecoproj = i16(p.bc_to_ecoproj + ecoprod)
                if p.bc_to_ecoproj > game_num_soil_cost {
                    game_turn_soil_enrich(p, e.have_terraform_n, false)
                    set ecoprod = p.bc_to_ecoproj - game_num_soil_cost
                    ;; p->bc_to_ecoproj carries over as partial progress
                    ;; towards advanced soil enrichment.
                    set p.bc_to_ecoproj = SETMIN(p.bc_to_ecoproj, game_num_soil_cost)
                    ;; WASBUG MOO1 did not do the SETMIN, allowing
                    ;; double-spending again.
                    game_add_planet_to_eco_finished(g, i, owner)
                } else {
                    set ecoprod = 0
                }
            }
            if (ecoprod > 0) && e.have_adv_soil_enrich && (p.growth < PLANET_GROWTH_GAIA) && (p.growth > PLANET_GROWTH_HOSTILE) {
                set p.bc_to_ecoproj = i16(p.bc_to_ecoproj + ecoprod)
                if p.bc_to_ecoproj > game_num_adv_soil_cost {
                    game_turn_soil_enrich(p, e.have_terraform_n, true)
                    set ecoprod = p.bc_to_ecoproj - game_num_adv_soil_cost
                    set p.bc_to_ecoproj = 0
                    ;; WASBUG MOO1 did not reset p->bc_to_ecoproj to 0, but
                    ;; the planet may become hostile due to a random event and
                    ;; then this variable becomes relevant again.
                    game_add_planet_to_eco_finished(g, i, owner)
                } else {
                    set ecoprod = 0
                }
            }
            if (ecoprod > 0) && ((p.max_pop3 - p.max_pop2) < e.have_terraform_n) && (p.max_pop3 < game_num_max_pop) {
                val v = ecoprod // e.terraform_cost_per_inc
                val tmax = e.have_terraform_n + p.max_pop2
                if tmax < (p.max_pop3 + v) {
                    set ecoprod = ecoprod - ((tmax - p.max_pop3) * e.terraform_cost_per_inc)
                    set p.max_pop3 = i16(tmax)
                } else {
                    set p.max_pop3 = i16(p.max_pop3 + v)
                    set ecoprod = 0
                }
            }
            set p.max_pop3 = SETMIN(p.max_pop3, game_num_max_pop)
            set ecoprod = SETMAX(ecoprod, 0)
            do {
                val v = game_get_pop_growth_max(g, p, p.max_pop3) + game_get_pop_growth_for_eco(g, p, ecoprod) + p.pop_tenths
                set p.pop = i16(p.pop + (v // 10))
                set p.pop_tenths = i8(v % 10)
            }
            set p.pop = SETRANGE(p.pop, 0, p.max_pop3)
        }
    }
}

func game_turn_update_trade (g) {
    loop i in g.players {
        val e = g.eto@(i)
        loop j in (i, g.players - 1) {
            val e2 = g.eto@(j)
            val bc = e.trade_bc@(j)     ;; uint16_t
            if bc != 0 {
                if BOOLVEC_IS0(e.contact, j) {
                    set e.trade_bc@(j) = 0
                    set e.trade_percent@(j) = 0
                    set e.trade_established_bc@(j) = 0
                } else {
                    var estbc = e.trade_established_bc@(j)  ;; uint16_t
                    if estbc < bc {     ;; FIXME BUG? never true ; both are set to bc
                        set estbc = u16(estbc + (bc // 10))
                        set estbc = SETMIN(estbc, bc)
                        set e.trade_established_bc@(j) = estbc
                        set e2.trade_established_bc@(i) = estbc
                    }
                    var v = i16((rnd_1_n(200, g) + e.relation1@(j) + 25) // 60)    ;; int16_t
                    set v = SETMAX(v, 0)
                    set e.trade_percent@(j) = i16(ADDSATT(e.trade_percent@(j), v, 100))
                    set e2.trade_percent@(i) = i16(ADDSATT(e2.trade_percent@(i), v, 100))
                }
            }
        }
    }
}

func game_turn_diplo_adjust (g) {
    loop i in g.players {
        val e = g.eto@(i)
        loop j in (i + 1, g.players - 1) {
            if rnd_0_nm1(2, g) == 0 {
                if e.treaty@(j) == TREATY_NONAGGRESSION {
                    game_diplo_act(g, rnd_1_n(3, g), i, j, 0, 0, 0)
                }
                if e.treaty@(j) == TREATY_ALLIANCE {
                    game_diplo_act(g, rnd_1_n(6, g), i, j, 0, 0, 0)
                }
                if e.trade_bc@(j) != 0 {
                    game_diplo_act(g, rnd_1_n(3, g), i, j, 2, 0, 0)
                }
            }
        }
    }
    loop i in g.players {
        if IS_HUMAN(g, i) {
            skip
        }
        val s_ai = game_stat_fleet(g, i)
        loop j in g.players {
            if IS_AI(g, j) {
                skip
            }
            val s_h = game_stat_fleet(g, j)
            if (s_ai < s_h) && (s_ai > 0) && (rnd_1_n(100, g) >= ((s_h * 50) // s_ai)) && (rnd_0_nm1(20, g) == 0) {
                game_diplo_act(g, -10, j, i, 8, 0, 0)
            }
        }
    }
    if (g.year & 1) == 0 {
        pin tbl_num_pp = carray(PLAYER_NUM)     ;; uint8_t[]
        val gscale = (g.galaxy_size + 1) * 3
        val gdiv = g.galaxy_size + 6 - g.difficulty
        loop i in g.players {
            set tbl_num_pp@(i) = 0
        }
        loop j in g.galaxy_stars {
            val p = g.planet@(j)
            if p.prod_after_maint >= 100 {
                set tbl_num_pp@(p.owner) = u8(tbl_num_pp@(p.owner) + 1)
            }
        }
        loop i in g.players {
            val e = g.eto@(i)
            if (gscale < tbl_num_pp@(i)) && (rnd_0_nm1(4, g) == 0) {
                var v = rnd_1_n(4, g) * ((-(tbl_num_pp@(i) - gscale)) // gdiv)
                set v = (v // 3) * 4
                if IS_HUMAN(g, i) {
                    set v = v // 2
                }
                loop j in g.players {
                    if IS_HUMAN(g, j) {
                        skip
                    }
                    if BOOLVEC_IS1(e.contact, j) && (e.treaty@(j) == TREATY_ALLIANCE) {
                        game_diplo_act(g, v, i, j, 12, 0, 0)
                    }
                }
            }
        }
    }
    loop i in g.players {
        val e = g.eto@(i)
        if IS_HUMAN(g, i) {
            skip
        }
        loop j in g.players {
            if (i != j) && (e.diplo_val@(j) == 0) {
                var r1 = e.relation1@(j)    ;; int16_t
                val r2 = e.relation2@(j)    ;; int16_t
                val v = if math.abs(r1) > rnd_1_n(105, g) => rnd_0_nm1(2, g) => 0   ;; uint8_t
                if r1 < r2 {
                    set r1 = i16(r1 + v)
                    if r1 > r2 {
                        set r1 = r2
                    }
                } else {
                    set r1 = i16(r1 - v)
                    if r1 < r2 {
                        set r1 = r2
                    }
                }
                set r1 = SETRANGE(r1, -100, 100)
                set e.relation1@(j) = r1
            }
        }
    }
    loop i in g.players {
        val e = g.eto@(i)
        loop j in g.players {
            if i == j {
                set e.relation1@(j) = 0
            } else {
                set g.eto@(j).relation1@(i) = e.relation1@(j)
            }
        }
    }
}

func game_add_planet_to_shield_finished (g, pli, owner) {
    BOOLVEC_SET1(g.planet@(pli).finished, FINISHED_SHIELD)
}

func game_turn_build_def (g) {
    pin cost_new = carray(PLAYER_NUM)   ;; int16_t[]
    pin cost_diff = carray(PLAYER_NUM)  ;; int16_t[]
    loop i in g.players {
        val e = g.eto@(i)
        val cost_old = i16(game_get_base_cost(g, i))
        set e.base_weapon = u8(game_get_base_weapon(g, i, e.tech.percent@(TECH_FIELD_WEAPON)))
        set e.base_shield = u8(game_get_best_shield(g, i, e.tech.percent@(TECH_FIELD_FORCE_FIELD)))
        set e.base_comp = u8(game_get_best_comp(g, i, e.tech.percent@(TECH_FIELD_COMPUTER)))
        set cost_new@(i) = i16(game_get_base_cost(g, i))
        set cost_diff@(i) = i16(cost_new@(i) - cost_old)
        set cost_diff@(i) = SETMAX(cost_diff@(i), 0)
    }
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val e = g.eto@(owner)
            var prod = game_adjust_prod_by_special((p.slider@(PLANET_SLIDER_DEF) * p.prod_after_maint) // 100, p.special)
            set prod = prod + p.bc_to_base
            var toup = (cost_diff@(owner) * p.missile_bases) + p.bc_upgrade_base
            if toup >= prod {
                set toup = toup - prod
                set p.bc_upgrade_base = u16(toup)
                set p.bc_to_base = 0
            } else {
                set prod = prod - toup
                set p.bc_upgrade_base = 0
                var tosh = e.planet_shield_cost - p.bc_to_shield
                set tosh = SETMAX(tosh, 0)
                if (p.battlebg == 0) || game_xy_is_in_nebula(g, p.x, p.y) {   ;; FIXME later check is redundant
                    set tosh = 0
                    set p.bc_to_shield = 0
                }
                if prod <= tosh {   ;; FIXME just "<" ?
                    set p.bc_to_shield = u16(p.bc_to_shield + prod)
                    set prod = 0
                } else {
                    set prod = prod - tosh
                    set p.bc_to_shield = e.planet_shield_cost
                    loop {
                        while prod >= cost_new@(owner)
                        set prod = prod - cost_new@(owner)
                        set p.missile_bases = u16(p.missile_bases + 1)
                    }
                }
                set p.bc_to_base = u16(prod)
            }
            do {
                val curcost = SETMIN(e.planet_shield_cost, p.bc_to_shield)
                var newshield = 0   ;; uint8_t
                var j = 1
                loop {
                    while (j < PSHIELD_NUM) && (curcost >= game_num_pshield_cost@(j))
                    set newshield = newshield + 5
                    set j = j + 1
                }
                if newshield != p.shield {
                    set p.shield = newshield
                    if newshield == g.eto@(owner).have_planet_shield {
                        game_add_planet_to_shield_finished(g, i, owner)
                    }
                }
            }
        }
    }
}

func game_add_planet_to_stargate_finished (g, pli, owner) {
    BOOLVEC_SET1(g.planet@(pli).finished, FINISHED_STARGATE)
}

func game_turn_build_ship (g) {
    game_update_maint_costs(g)
    loop i in g.players {
        val e = g.eto@(i)
        val srd = g.srd@(i)
        pin gd = game_design_s()
        set gd.sd_num = e.shipdesigns_num
        set gd.player_i = i
        loop f in TECH_FIELD_NUM {
            set gd.percent@(f) = e.tech.percent@(f)
        }
        loop j in gd.sd_num {
            val sd = srd.design@(j)
            cstruct_copy(gd.sd, sd)
            set sd.cost = u16(game_design_calc_cost(gd))
        }
    }
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val e = g.eto@(owner)
            val srd = g.srd@(owner)
            var prod = game_adjust_prod_by_special((p.slider@(PLANET_SLIDER_SHIP) * p.prod_after_maint) // 100, p.special)
            set prod = prod + p.bc_to_ship
            ;; BUG: A 1 BC bonus for having the slider > 0.
            ;; This bonus is not taken into account by UI
            if p.slider@(PLANET_SLIDER_SHIP) > 0 {
                set prod = prod + 1
            }
            val si = p.buildship    ;; uint8_t
            if si == BUILDSHIP_STARGATE {
                if prod >= game_num_stargate_cost {
                    set p.have_stargate = true
                    set p.buildship = 0
                    set p.bc_to_ship = u16(prod - game_num_stargate_cost)
                    game_add_planet_to_stargate_finished(g, i, owner)
                } else {
                    set p.bc_to_ship = u16(prod)
                }
            } else {
                val sd = srd.design@(si)
                val cost = sd.cost
                var shipnum = 0
                loop {
                    while prod >= cost
                    set shipnum = shipnum + 1
                    set prod = prod - cost
                }
                if (shipnum + srd.shipcount@(si)) > game_num_limit_ships_all {
                    set shipnum = i32(game_num_limit_ships_all - srd.shipcount@(si))
                }
                set shipnum = SETMAX(shipnum, 0)
                set srd.shipcount@(si) = u32(srd.shipcount@(si) + shipnum)
                val dest = p.reloc  ;; uint8_t
                if dest == i {
                    set e.orbit@(i).ships@(si) = u16(e.orbit@(i).ships@(si) + shipnum)
                    if shipnum > 0 {
                        BOOLVEC_SET1(p.finished, FINISHED_SHIP)
                    }
                } else {
                    if shipnum > 0 {
                        game_send_fleet_reloc(g, owner, i, dest, si, u16(shipnum))
                    }
                }
                set g.evn.new_ships@(owner)@(si) = u32(g.evn.new_ships@(owner)@(si) + shipnum)
                set p.bc_to_ship = u16(prod)
            }
        }
    }
    game_update_visibility(g)
}

func game_turn_reserve (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val v = p.prod_after_maint // 2     ;; uint32_t
            var r = p.reserve   ;; uint32_t
            if v < r {
                set r = r - v
            } else {
                set r = 0
            }
            set p.reserve = r
        }
    }
    loop i in g.players {
        val e = g.eto@(i)
        set e.reserve_bc = u32(e.reserve_bc + (u32(e.total_production_bc * e.tax) // 2000))
    }
}

func game_add_planet_to_build_finished (g, pli, owner, type_) {
    if game_opt_message_filter@(type_) {
        return nil
    }
    val p = g.planet@(pli)
    BOOLVEC_SET1(p.finished, type_)
    set g.evn.build_finished_num@(owner) = u16(g.evn.build_finished_num@(owner) + 1)
}

func game_turn_finished_switch_slider (g, p, from, to) {
    if game_num_slider_respects_locks && ((p.slider_lock@(from) != 0) || (p.slider_lock@(to) != 0)) {
        return false
    }
    if from == to {
        return false
    }
    var v = p.slider@(from)
    if from == PLANET_SLIDER_ECO {
        set v = v - game_planet_get_waste_percent(nil, g, p, false)
        set v = SETMAX(v, 0)
    }
    set p.slider@(from) = i16(p.slider@(from) - v)
    set p.slider@(to) = i16(p.slider@(to) + v)
    true
}

func game_turn_finished_disable_slider (g, p, from, build_ind) {
    if game_num_slider_respects_locks && (p.slider_lock@(from) != 0) {
        return nil
    }
    val first = if build_ind => PLANET_SLIDER_IND => PLANET_SLIDER_TECH
    game_turn_finished_switch_slider(g, p, from, first) || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_TECH) || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_SHIP) || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_DEF) || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_IND) || game_turn_finished_switch_slider(g, p, from, PLANET_SLIDER_ECO)
}

func game_turn_build_ind (g) {
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        val owner = p.owner
        if owner != PLAYER_NONE {
            val e = g.eto@(owner)
            var fact = u16(p.factories)     ;; uint16_t
            val factold = fact
            var num     ;; uint16_t
            val cost = u8(game_planet_get_fact_adj_cost(g, p))  ;; uint8_t
            var prod = game_adjust_prod_by_special((p.slider@(PLANET_SLIDER_IND) * p.prod_after_maint) // 100, p.special)
            set prod = prod + p.bc_to_factory
            val bonus = if e.race == RACE_MEKLAR => 2 => 0  ;; uint8_t
            var v = e.colonist_oper_factories - p.pop_oper_fact - bonus
            if v > 0 {
                set v = v * (e.factory_cost // 2)
                if game_num_factory_cost_fix {
                    if e.race != RACE_MEKLAR {
                        set v = (e.factory_cost * p.factories) // 2
                    } else {
                        set v = 0
                    }
                }
            } else {
                set v = 0
            }
            if ((prod // cost) + fact) > (p.pop * p.pop_oper_fact) {
                if game_num_factory_cost_fix && (fact < (p.pop * p.pop_oper_fact)) {
                    set num = u16((p.pop * p.pop_oper_fact) - fact)
                    set fact = u16(p.pop * p.pop_oper_fact)
                    set prod = prod - (num * cost)
                }
                set p.bc_to_refit = u16(p.bc_to_refit + prod)
                if p.bc_to_refit >= v {
                    if game_num_factory_cost_fix && (e.race != RACE_MEKLAR) {
                        set p.pop_oper_fact = u8(p.pop_oper_fact + 1)
                        set p.pop_oper_fact = SETMIN(p.pop_oper_fact, e.colonist_oper_factories)
                    } else {
                        set p.pop_oper_fact = e.colonist_oper_factories
                    }
                    set prod = p.bc_to_refit - v
                    set p.bc_to_refit = 0
                } else {
                    set prod = 0
                }
            }
            set num = u16(prod // cost)
            set p.bc_to_factory = u8(prod % cost)
            set v = p.max_pop3 * game_planet_get_pop_oper_fact(g, p)
            if v < (fact + num) {
                set v = (fact + num) - v
                set v = SETMAX(v, 0)
                set v = SETMIN(v, num)
                set num = u16(num - v)
            } else {
                set v = 0
            }
            if game_num_factory_cost_fix && (p.pop_oper_fact < e.colonist_oper_factories) {
                set p.bc_to_refit = u16(p.bc_to_refit + ((v * cost) // 2))
            } else {
                set e.reserve_bc = u32(e.reserve_bc + ((v * cost) // 2))
            }
            set fact = u16(fact + num)
            set fact = SETMIN(fact, game_num_max_factories)
            set p.factories = i16(fact)
            if (fact != factold) && (fact >= (p.max_pop3 * e.colonist_oper_factories)) {
                if IS_HUMAN(g, owner) && (p.slider@(PLANET_SLIDER_IND) > 0) {
                    game_turn_finished_disable_slider(g, p, PLANET_SLIDER_IND, false)
                }
                game_add_planet_to_build_finished(g, i, owner, FINISHED_FACT)
            }
        }
    }
}

;; `memcpy(dst, src, n * sizeof(item))` of the first `n` items of a table.
func turn_copy_items (dst, src, n) {
    loop i in n {
        cstruct_copy(dst@(i), src@(i))
    }
}

;; The move of the fleets, transports and monsters of one frame: one table.
func turn_move_frame_items (g, tbl, num, frame, odd_frame, flag_more0, is_fleet) {
    var flag_more = flag_more0
    loop i in num {
        val r = tbl@(i)
        if (r.speed * 2) > frame {
            var x = r.x
            var y = r.y
            var in_nebula
            var moves
            if is_fleet {
                set in_nebula = if odd_frame || (frame == 0) => false => game_xy_is_in_nebula(g, x, y)
                set moves = odd_frame || (frame == 0) || (!in_nebula)
            } else {
                set in_nebula = if !odd_frame => false => game_xy_is_in_nebula(g, x, y)
                set moves = (!odd_frame) || (!in_nebula)
            }
            if moves {
                val p = g.planet@(r.dest)
                val x1 = p.x
                val y1 = p.y
                if r.speed == FLEET_SPEED_STARGATE {
                    set x = x1
                    set y = y1
                } else {
                    set flag_more = true
                    set x, y = util_math_go_line_dist(x, y, x1, y1, if odd_frame => 6 => 5)
                }
                set r.x = x
                set r.y = y
            } else {
                if in_nebula {
                    set flag_more = true    ;; WASBUG MOO1 stopped nebula movement early if no transports (fleets) or faster ships enroute
                }
            }
        }
    }
    flag_more
}

func game_turn_move_ships (g) {
    val local_multiplayer = g.gaux.local_players > 1
    var move_back = false
    val ctx = ui_gmap_basic_init(g, local_multiplayer)
    if local_multiplayer {
        turn_copy_items(g.gaux.move_temp.enroute, g.enroute, g.enroute_num)
        turn_copy_items(g.gaux.move_temp.transport, g.transport, g.transport_num)
        cstruct_copy(g.gaux.move_temp.crystal, g.evn.crystal)
        cstruct_copy(g.gaux.move_temp.amoeba, g.evn.amoeba)
    }
    set g.active_player = 0
    loop {
        while g.active_player < g.players
        if BOOLVEC_IS1(g.is_ai, g.active_player) {
            set g.active_player = g.active_player + 1
            skip
        }
        if move_back {
            turn_copy_items(g.enroute, g.gaux.move_temp.enroute, g.enroute_num)
            turn_copy_items(g.transport, g.gaux.move_temp.transport, g.transport_num)
            cstruct_copy(g.evn.crystal, g.gaux.move_temp.crystal)
            cstruct_copy(g.evn.amoeba, g.gaux.move_temp.amoeba)
        }
        game_update_visibility(g)
        var flag_more = true
        ui_gmap_basic_start_player(ctx, g.active_player)
        var frame = 0
        loop {
            while (frame < 20) && flag_more
            game_update_visibility(g)
            val odd_frame = (frame & 1) != 0
            ui_gmap_basic_start_frame(ctx, g.active_player)
            set flag_more = false
            set flag_more = turn_move_frame_items(g, g.enroute, g.enroute_num, frame, odd_frame, flag_more, true)
            set flag_more = turn_move_frame_items(g, g.transport, g.transport_num, frame, odd_frame, flag_more, false)
            loop i in 2 {
                val m = if i == 0 => g.evn.crystal => g.evn.amoeba
                if (m.exists != 0) && (m.counter <= 0) {
                    val p = g.planet@(m.dest)
                    val x1 = p.x
                    val y1 = p.y
                    var x = m.x
                    var y = m.y
                    if ((x != x1) || (y != y1)) && (frame < 2) {
                        set x, y = util_math_go_line_dist(x, y, x1, y1, if odd_frame => 6 => 5)
                        set m.x = x
                        set m.y = y
                    }
                }
            }
            ui_gmap_basic_draw_frame(ctx, g.active_player)
            ui_gmap_basic_finish_frame(ctx, g.active_player)
            set frame = frame + 1
        }
        set move_back = local_multiplayer
        set g.active_player = g.active_player + 1
    }
    ui_gmap_basic_shutdown(ctx)
    var i = 0
    loop {
        while i < g.enroute_num
        val r = g.enroute@(i)
        val p = g.planet@(r.dest)
        if (r.x == p.x) && (r.y == p.y) {
            val o = g.eto@(r.owner).orbit@(r.dest)
            loop j in NUM_SHIPDESIGNS {
                var s = u32(o.ships@(j) + r.ships@(j))  ;; uint32_t
                set s = SETMIN(s, game_num_limit_ships)
                set o.ships@(j) = u16(s)
            }
            util_table_remove_item_any_order(i, g.enroute, g.enroute_num)
            set g.enroute_num = g.enroute_num - 1
            set i = i - 1
        }
        set i = i + 1
    }
    game_update_visibility(g)
}

func game_turn_explore (g) {
    loop pli in g.galaxy_stars {
        val p = g.planet@(pli)
        set p.artifact_looter = PLAYER_NONE
        loop i in g.players {
            if BOOLVEC_IS0(p.explored, i) || (p.owner == PLAYER_NONE) {
                val e = g.eto@(i)
                var flag_visible = false
                loop j in e.shipdesigns_num {
                    if e.orbit@(pli).ships@(j) > 0 {
                        set flag_visible = true
                        break
                    }
                }
                var by_scanner = false
                if (!flag_visible) && e.have_adv_scanner {
                    loop pli2 in g.galaxy_stars {
                        val p2 = g.planet@(pli2)
                        if (p2.owner == i) && (util_math_dist_fast(p.x, p.y, p2.x, p2.y) <= game_num_adv_scan_range) {
                            set flag_visible = true
                            break
                        }
                    }
                    set by_scanner = true
                }
                ;; c4ca
                if flag_visible {
                    var best_colonyship = 0
                    ;; FIXME artifacts disappearing due to scanning a planet is weird
                    val first = BOOLVEC_IS_CLEAR(p.explored, PLAYER_NUM)
                    if (p.special == PLANET_SPECIAL_ARTIFACTS) && (!by_scanner) && first {
                        ;; FIXME? AIs (last player ID) win on simultaneous explore
                        set p.artifact_looter = i
                    }
                    var flag_colony_ship = false
                    var flag_do_colonize = false
                    var best_colonize = 200
                    loop j in e.shipdesigns_num {
                        val sd = g.srd@(i).design@(j)
                        var can_colonize = 200
                        loop k in SPECIAL_SLOT_NUM {
                            val s = sd.special@(k)
                            if (s >= SHIP_SPECIAL_STANDARD_COLONY_BASE) && (s <= SHIP_SPECIAL_RADIATED_COLONY_BASE) {
                                set can_colonize = PLANET_TYPE_MINIMAL - (s - SHIP_SPECIAL_STANDARD_COLONY_BASE)
                            }
                        }
                        if (can_colonize < 200) && (e.orbit@(pli).ships@(j) > 0) {
                            set flag_colony_ship = true
                            if can_colonize < best_colonize {
                                set best_colonize = can_colonize
                                set best_colonyship = j
                            }
                            if e.race == RACE_SILICOID {
                                set best_colonize = PLANET_TYPE_RADIATED
                            }
                        }
                    }
                    if (best_colonize == 200) || (p.owner != PLAYER_NONE) || (p.type == PLANET_TYPE_NOT_HABITABLE) || (p.type < best_colonize) {
                        set best_colonize = 0
                    }
                    val was_explored = BOOLVEC_IS1(p.explored, i)
                    BOOLVEC_SET1(p.explored, i)
                    if IS_HUMAN(g, i) {
                        if (best_colonize != 0) || (!was_explored) {
                            game_update_visibility(g)   ;; from explore_draw_cb
                            if (p.type < best_colonize) || (best_colonize == 0) {
                                set flag_colony_ship = false
                            } else {
                                set flag_colony_ship = true
                            }
                            if ui_explore(g, i, pli, by_scanner, flag_colony_ship) && flag_colony_ship {
                                set flag_do_colonize = true
                            }
                        }
                    } else {
                        if best_colonize != 0 {
                            set flag_do_colonize = true
                        }
                    }
                    if flag_do_colonize {
                        set p.owner = i
                        set p.pop = 2
                        if game_num_colonized_factories_fix && (p.prev_owner != PLAYER_NONE) && (p.prev_owner != i) {
                            if p.factories != 0 {
                                set p.pop_oper_fact = 1
                            } else {
                                set p.pop_oper_fact = 2
                            }
                            set p.bc_to_refit = 0
                        }
                        set e.orbit@(pli).ships@(best_colonyship) = u16(e.orbit@(pli).ships@(best_colonyship) - 1)
                        if (pli == g.evn.planet_orion_i) && game_num_news_orion {
                            set g.evn.have_orion_conquer = i + 1
                        }
                    }
                }
            }
        }
    }
}

func game_turn_transport_shoot (g, planet_i, rowner, num_transports, speed, attacker, bases, basewpnt) {
    val p = g.planet@(planet_i)
    val ea = g.eto@(attacker)
    val ed = g.eto@(rowner)
    var totaldmg = 0
    var bestcomp = 0    ;; uint8_t
    var bestarmor = 0   ;; uint8_t
    val rc = g.srd@(rowner).researchcompleted@(TECH_FIELD_CONSTRUCTION)

    ;; Transports use the best armor that the owner has researched.
    loop i in ed.tech.completed@(TECH_FIELD_CONSTRUCTION) {
        val group = game_tech_get_group(g.gaux, TECH_FIELD_CONSTRUCTION, rc@(i))
        val tier = u8(game_tech_get_tier(g.gaux, TECH_FIELD_CONSTRUCTION, rc@(i)))
        if group == TECH_GROUP_ARMOR {
            set bestarmor = tier
        }
    }
    val transport_hp = (bestarmor + 1) * 15
    val total_hp = transport_hp * num_transports

    pin tbl = carray(WEAPON_NUM)    ;; uint32_t[]
    set tbl@(basewpnt) = u32(bases * 24)
    loop i in ea.shipdesigns_num {
        val sd = g.srd@(attacker).design@(i)
        val comp = sd.comp  ;; uint8_t
        if comp > speed {   ;; FIXME BUG ?
            set bestcomp = comp
        }
        loop j in WEAPON_SLOT_NUM {
            val wpnt = sd.wpnt@(j)
            var v = u32(ea.orbit@(planet_i).ships@(i) * sd.wpnn@(j))     ;; uint32_t
            if v != 0 {
                val w = tbl_shiptech_weap@(wpnt)
                var ns = w.numshots
                if ns == -1 {
                    set ns = 4
                }
                set v = u32(v * ns)
                if w.nummiss != 0 {
                    set v = u32(v * w.nummiss)
                }
                set v = SETMIN(v, game_num_max_trans_dmg)
                if w.is_bomb || w.is_bio {
                    set v = 0
                }
                if w.misstype != 0 {
                    set v = v // 2
                }
                set tbl@(wpnt) = u32(tbl@(wpnt) + (u32(v * 2) // speed))
            }
        }
    }
    if bases > 0 {
        set bestcomp = u8(game_get_best_comp(g, rowner, ed.tech.percent@(TECH_FIELD_COMPUTER)))   ;; FIXME should be ea ?
    }
    var complevel = ((bestcomp - speed) * 2) + 12
    set complevel = SETRANGE(complevel, 1, 20)
    val wnum = if game_num_orbital_weap_any => WEAPON_NUM => WEAPON_CRYSTAL_RAY
    loop i in wnum {    ;; WASBUG? excludes death ray and amoeba stream too
        var vcur = tbl@(i)  ;; uint32_t
        if vcur != 0 {
            val w = tbl_shiptech_weap@(i)
            var dmgmin = w.damagemin
            val dmgmax = w.damagemax
            if dmgmin == dmgmax {
                loop in vcur {
                    if rnd_1_n(20, g) <= complevel {
                        set totaldmg = totaldmg + dmgmax
                    }
                }
            } else {
                ;; 7c47d
                val dmgrange = dmgmax - dmgmin + 1
                set dmgmin = dmgmin - 1
                set vcur = u32(complevel * vcur) // 20
                loop in vcur {
                    val dmg = rnd_1_n(dmgrange, g) + dmgmin
                    if dmg > 0 {
                        set totaldmg = totaldmg + dmg
                    }
                }
            }
            if totaldmg >= total_hp {
                break
            }
        }
    }
    var killed = totaldmg // transport_hp
    set killed = SETMIN(killed, 1000)
    loop i in (MONSTER_CRYSTAL, MONSTER_AMOEBA) {
        val m = if i == MONSTER_CRYSTAL => g.evn.crystal => g.evn.amoeba
        if (m.exists != 0) && (m.killer == PLAYER_NONE) && (m.x == p.x) && (m.y == p.y) {
            set killed = 1000
        }
    }
    killed
}

func game_turn_transport (g) {
    loop pli in g.galaxy_stars {
        val p = g.planet@(pli)
        loop i in g.players {
            set p.inbound@(i) = 0
            set p.total_inbound@(i) = 0
        }
    }
    var i = 0
    loop {
        while i < g.transport_num
        val r = g.transport@(i)
        val dest = r.dest   ;; uint8_t
        val p = g.planet@(dest)
        if (r.x == p.x) && (r.y == p.y) {
            val owner = r.owner
            val pop2 = r.pop
            var pop3 = r.pop
            loop j in g.players {
                if j == owner {
                    skip
                }
                val t = g.eto@(owner).treaty@(j)
                if (j == p.owner) || (t == TREATY_NONE) || (t >= TREATY_WAR) {
                    val e = g.eto@(j)
                    if j == p.owner {
                        set pop3 = pop3 - game_turn_transport_shoot(g, dest, owner, u16(pop3), r.speed, j, p.missile_bases, e.base_weapon)
                    } else {
                        ;; e102
                        var any_ships = false
                        loop k in e.shipdesigns_num {
                            if e.orbit@(dest).ships@(k) > 0 {
                                set any_ships = true
                                break
                            }
                        }
                        if any_ships {
                            set pop3 = pop3 - game_turn_transport_shoot(g, dest, owner, u16(pop3), r.speed, j, 0, WEAPON_NONE)
                        }
                    }
                }
            }
            if g.evn.have_guardian && (dest == g.evn.planet_orion_i) {
                set pop3 = 0
            }
            loop j in (MONSTER_CRYSTAL, MONSTER_AMOEBA) {
                val m = if j == MONSTER_CRYSTAL => g.evn.crystal => g.evn.amoeba
                if (m.exists != 0) && (m.x == p.x) && (m.y == p.y) {   ;; (m->killer == PLAYER_NONE) && ; FIXME dead monster kills transports ?
                    set pop3 = 0
                }
            }
            set pop3 = SETMAX(pop3, 0)
            if g.eto@(owner).have_combat_transporter {
                val n = pop2 - pop3
                ;; g->eto[p->owner] with no owner reads past the table in C
                if p.owner == PLAYER_NONE {
                    throw "game_turn_transport: transporters onto a planet with no owner (eto[PLAYER_NONE] in C)"
                }
                if game_num_combat_trans_fix {    ;; do as OSG says: 50% chance, 25% if interdictor
                    val c = if g.eto@(p.owner).have_sub_space_int => 4 => 2
                    loop in n {
                        if rnd_0_nm1(c, g) == 0 {
                            set pop3 = pop3 + 1
                        }
                    }
                } else {
                    if g.eto@(p.owner).have_sub_space_int {   ;; WASBUG transporters only work when planet owner has interdictor
                        loop in n {
                            if rnd_0_nm1(4, g) == 0 {
                                set pop3 = pop3 + 1
                            } else {
                                if rnd_0_nm1(2, g) == 0 {
                                    set pop3 = pop3 + 1
                                }
                            }
                        }
                    }
                }
            }
            ;; e2a4
            if pop3 <= 0 {
                if IS_HUMAN(g, owner) || IS_HUMAN(g, p.owner) {
                    val buf = ui_get_strbuf()
                    val s = if (g.gaux.local_players == 1) && IS_HUMAN(g, owner) => game_str_sb_your => game_str_tbl_race@(g.eto@(owner).race)
                    lib_sprintf(buf, UI_STRBUF_SIZE, "%s %s %s %s", s, game_str_sm_traad1, cstr(g.planet@(dest).name), game_str_sm_traad2)
                    ui_turn_msg(g, if IS_HUMAN(g, owner) => owner => p.owner, buf)
                }
            } else {
                if p.owner == PLAYER_NONE {
                    ;; e36d
                    if IS_HUMAN(g, owner) {
                        val buf = ui_get_strbuf()
                        lib_sprintf(buf, UI_STRBUF_SIZE, "%s %s %s", game_str_sm_trbdb1, cstr(g.planet@(dest).name), game_str_sm_trbdb2)
                        ui_turn_msg(g, owner, buf)
                    }
                } else {
                    ;; e3fe
                    if (p.owner == PLAYER_NONE) || (p.pop == 0) {
                        if IS_HUMAN(g, owner) {
                            ui_landing(g, owner, dest)
                        }
                        set p.pop = i16(pop3)
                        set p.bc_to_refit = 0
                        set p.pop_oper_fact = 1
                        if dest == g.evn.planet_orion_i {
                            set g.evn.have_orion_conquer = owner + 1
                        }
                        set p.owner = owner
                    } else {
                        if p.owner == owner {
                            if p.unrest == PLANET_UNREST_REBELLION {
                                set p.inbound@(owner) = u16(ADDSATT(p.inbound@(owner), pop3, game_num_max_inbound))
                                set p.total_inbound@(owner) = u16(p.total_inbound@(owner) + pop3)
                            } else {
                                set p.pop = i16(ADDSATT(p.pop, pop3, p.max_pop3))
                            }
                        } else {
                            ;; e5a6
                            if g.eto@(owner).treaty@(p.owner) != TREATY_ALLIANCE {
                                set p.inbound@(owner) = u16(ADDSATT(p.inbound@(owner), pop3, game_num_max_inbound))
                                set p.total_inbound@(owner) = u16(p.total_inbound@(owner) + pop2)
                            }
                        }
                    }
                }
            }
            ;; e639
            util_table_remove_item_any_order(i, g.transport, g.transport_num)
            set g.transport_num = g.transport_num - 1
            set i = i - 1
        }
        set i = i + 1
    }
}

func game_turn_coup (g) {
    pin tbl_planets = carray(PLAYER_NUM)        ;; uint8_t[]
    pin tbl_rebelplanets = carray(PLAYER_NUM)   ;; uint8_t[]
    BOOLVEC_CLEAR(g.evn.coup, PLAYER_NUM)
    loop pli in g.galaxy_stars {
        val p = g.planet@(pli)
        if p.owner != PLAYER_NONE {
            set tbl_planets@(p.owner) = u8(tbl_planets@(p.owner) + 1)
            if p.unrest == PLANET_UNREST_REBELLION {
                set tbl_rebelplanets@(p.owner) = u8(tbl_rebelplanets@(p.owner) + 1)
            }
        }
    }
    loop i in g.players {
        if (tbl_rebelplanets@(i) >= ((tbl_planets@(i) + 1) // 2)) && IS_ALIVE(g, i) {
            val e = g.eto@(i)
            set e.trait2 = rnd_0_nm1(TRAIT2_NUM, g)
            set e.trait1 = rnd_0_nm1(TRAIT1_NUM, g)
            ;; WASBUG MOO1 reads an unitialized variable at BP-2 and check for it to be 0 or 1.
            ;; It is the return address to the caller which is neither of the values, leading to the code below.
            loop j in g.players {
                val rel = e.relation2@(j)   ;; int16_t
                set e.relation1@(j) = rel
                if i != j {
                    set g.eto@(j).relation1@(i) = rel
                    if IS_HUMAN(g, j) {
                        game_diplo_break_treaty(g, i, j)
                        game_diplo_break_trade(g, i, j)
                    }
                }
            }
            BOOLVEC_SET1(g.evn.coup, i)
            loop pli in g.galaxy_stars {
                val p = g.planet@(pli)
                if p.owner == i {
                    set p.unrest = PLANET_UNREST_NORMAL
                    set p.rebels = 0
                }
            }
        }
    }
}

func game_turn_update_have_met (g) {
    game_update_empire_contact(g)
    loop i in g.players {
        val e = g.eto@(i)
        if !IS_HUMAN(g, i) {
            skip
        }
        loop j in g.players {
            if (i != j) && (e.have_met@(j) == 0) && BOOLVEC_IS1(e.contact, j) {
                set e.have_met@(j) = 1
                set e.treaty@(j) = TREATY_NONE
                set g.eto@(j).treaty@(i) = TREATY_NONE
            }
        }
    }
}

func game_turn_contact_broken (g, pi, bv) {
    val e = g.eto@(pi)
    if !IS_ALIVE(g, pi) {
        return nil
    }
    loop i in g.players {
        if (i != pi) && IS_ALIVE(g, i) && BOOLVEC_IS0(e.contact, i) && BOOLVEC_IS1(bv, i) {
            val e2 = g.eto@(i)
            set e.mood_trade@(i) = 0
            set e.trade_bc@(i) = 0
            set e.trade_percent@(i) = 0
            set e.spymode@(i) = SPYMODE_HIDE
            BOOLVEC_SET1(e.contact_broken, i)
            set e2.mood_trade@(pi) = 0
            set e2.trade_bc@(pi) = 0
            set e2.trade_percent@(pi) = 0
            set e2.spymode@(pi) = SPYMODE_HIDE
            BOOLVEC_SET1(e2.contact_broken, pi)
        }
    }
}

func game_turn_update_seen (g) {
    game_update_visibility(g)
    loop i in g.galaxy_stars {
        val p = g.planet@(i)
        loop pi in g.players {
            var can_see = BOOLVEC_IS1(p.within_srange, pi) || (p.owner == pi)
            if !can_see {   ;; WASBUG handled only on game load (game_update_seen_by_orbit)
                val os = g.eto@(pi).orbit@(i).ships
                loop j in NUM_SHIPDESIGNS {
                    if os@(j) != 0 {
                        set can_see = true
                        break
                    }
                }
            }
            val s = g.seen@(pi)@(i)
            if can_see {
                set s.owner = p.owner
                set s.pop = u16(p.pop)
                set s.bases = p.missile_bases
                set s.factories = u16(p.factories)
            } else {
                if (p.owner != PLAYER_NONE) && BOOLVEC_IS1(g.eto@(pi).contact, p.owner) {
                    set s.owner = p.owner
                }
            }
        }
    }
}

func game_turn_finished_slider (g) {
    loop pli in g.galaxy_stars {
        val p = g.planet@(pli)
        val pi = p.owner
        if (pi == PLAYER_NONE) || IS_AI(g, pi) {
            BOOLVEC_CLEAR(p.finished, FINISHED_NUM)
            skip
        }
        val e = g.eto@(pi)
        var cond_build_ind = p.factories < (p.pop * e.colonist_oper_factories)
        if game_num_cond_switch_to_ind_fix {
            set cond_build_ind = p.factories < (p.max_pop3 * e.colonist_oper_factories)
        }
        if game_num_factory_cost_fix {
            set cond_build_ind = cond_build_ind || (p.pop_oper_fact < e.colonist_oper_factories)
        }
        if BOOLVEC_IS1(p.finished, FINISHED_SOILATMOS) && !(game_num_slider_eco_done_fix && game_planet_can_terraform(g, p, p.owner, true)) {
            game_turn_finished_disable_slider(g, p, PLANET_SLIDER_ECO, cond_build_ind)
            game_add_planet_to_build_finished(g, pli, pi, FINISHED_SOILATMOS)
        }
        if (p.pop >= p.max_pop3) && (p.unrest == PLANET_UNREST_NORMAL) {
            var v = (p.prod_after_maint * p.slider@(PLANET_SLIDER_ECO)) // 100
            var flag_pending_ecoproj = false
            if v > 0 {
                if (e.have_atmos_terra && (p.growth == PLANET_GROWTH_HOSTILE)) || (e.have_soil_enrich && (p.growth == PLANET_GROWTH_NORMAL)) || (e.have_adv_soil_enrich && ((p.growth == PLANET_GROWTH_NORMAL) || (p.growth == PLANET_GROWTH_FERTILE))) || ((p.max_pop3 - p.max_pop2) < e.have_terraform_n) {
                    set flag_pending_ecoproj = true
                }
            }
            if !flag_pending_ecoproj {
                pin r_waste = [waste = 0]   ;; int waste = 0
                val w = game_planet_get_waste_percent(r_waste, g, p, false)
                set v = SUBSAT0(v, r_waste.waste)
                if ((game_get_pop_growth_for_eco(g, p, v) // 10) > 0) || ((p.slider@(PLANET_SLIDER_ECO) != 0) && (e.race == RACE_SILICOID)) {
                    if (p.pop > p.pop_prev) || (p.slider@(PLANET_SLIDER_ECO) > (w + game_num_eco_slider_slack)) {
                        game_turn_finished_disable_slider(g, p, PLANET_SLIDER_ECO, cond_build_ind)
                        if p.pop > p.pop_prev {
                            game_add_planet_to_build_finished(g, pli, pi, FINISHED_POPMAX)
                        }
                    }
                }
                if (p.slider@(PLANET_SLIDER_ECO) > 0) && ((e.race == RACE_SILICOID) || ((e.ind_waste_scale == 0) && (p.waste == 0))) {
                    game_turn_finished_disable_slider(g, p, PLANET_SLIDER_ECO, cond_build_ind)
                }
            }
        }
        if BOOLVEC_IS1(p.finished, FINISHED_SHIELD) {
            game_turn_finished_disable_slider(g, p, PLANET_SLIDER_DEF, false)
            game_add_planet_to_build_finished(g, pli, pi, FINISHED_SHIELD)
        }
        if BOOLVEC_IS1(p.finished, FINISHED_STARGATE) {
            ;; WASBUG MOO1 has DEF, not SHIP
            ;; p->slider[PLANET_SLIDER_TECH] += p->slider[PLANET_SLIDER_SHIP];
            ;; p->slider[PLANET_SLIDER_SHIP] = 0;
            game_turn_finished_disable_slider(g, p, PLANET_SLIDER_SHIP, false)
            game_add_planet_to_build_finished(g, pli, pi, FINISHED_STARGATE)
        }
    }
}

func game_turn_claim (g) {
    loop pli in g.galaxy_stars {
        val p = g.planet@(pli)
        set p.claim = p.owner
        if p.owner == PLAYER_NONE {
            loop pi in g.players {
                val e = g.eto@(pi)
                loop i in e.shipdesigns_num {
                    if e.orbit@(pli).ships@(i) != 0 {
                        set p.claim = pi
                        break
                    }
                }
            }
        }
    }
}

func game_turn_update_final_war (g) {
    if g.end != GAME_END_FINAL_WAR {
        return nil
    }
    game_tech_final_war_share(g)
    loop i in g.players {
        if IS_HUMAN(g, i) {
            game_tech_finish_new(g, i)
            ui_newtech(g, i)
        }
    }
    loop pi1 in g.players {
        val e1 = g.eto@(pi1)
        loop pi2 in (pi1 + 1, g.players - 1) {
            val e2 = g.eto@(pi2)
            if BOOLVEC_IS1(g.refuse, pi1) == BOOLVEC_IS1(g.refuse, pi2) {
                set e1.treaty@(pi2) = TREATY_ALLIANCE
                set e2.treaty@(pi1) = TREATY_ALLIANCE
                set e1.relation1@(pi2) = 100
                set e2.relation1@(pi1) = 100
            } else {
                set e1.treaty@(pi2) = TREATY_FINAL_WAR
                set e2.treaty@(pi1) = TREATY_FINAL_WAR
                set e1.relation1@(pi2) = -100
                set e2.relation1@(pi1) = -100
            }
        }
    }
}

func game_turn_check_end (g, ge) {
    var pih = PLAYER_NONE
    loop i in g.players {
        if IS_HUMAN(g, i) && IS_ALIVE(g, i) {
            set pih = i
            break
        }
    }
    if g.end == GAME_END_LOST_EXILE {
        set ge.type = GAME_END_LOST_EXILE
        if pih == g.winner {
            loop i in (pih + 1, g.players - 1) {
                if IS_HUMAN(g, i) && IS_ALIVE(g, i) {
                    set pih = i
                    break
                }
            }
        }
        set ge.name = g.emperor_names@(pih)
        return true
    }
    if g.end == GAME_END_WON_GOOD {
        set ge.type = GAME_END_WON_GOOD
        set ge.name = g.emperor_names@(g.winner)
        set ge.race = g.eto@(g.winner).race
        return true
    }
    do {
        var pi1 = PLAYER_NONE
        var pi2 = PLAYER_NONE
        var human_alive = false
        pin num_planets = carray(PLAYER_NUM)    ;; uint8_t[]
        pin good_planets = carray(PLAYER_NUM)   ;; uint8_t[]
        loop pli in g.galaxy_stars {
            val p = g.planet@(pli)
            if p.owner != PLAYER_NONE {
                set num_planets@(p.owner) = u8(num_planets@(p.owner) + 1)
                if p.unrest != PLANET_UNREST_REBELLION {
                    set good_planets@(p.owner) = u8(good_planets@(p.owner) + 1)
                }
            }
        }
        loop i in g.players {
            if num_planets@(i) > 0 {
                if pi1 == PLAYER_NONE {
                    set pi1 = i
                } else {
                    if pi2 == PLAYER_NONE {
                        set pi2 = i
                    }
                }
                if IS_HUMAN(g, i) && (good_planets@(i) > 0) && IS_ALIVE(g, i) {
                    set human_alive = true
                }
            }
        }
        if pi2 == PLAYER_NONE {
            set ge.type = GAME_END_WON_TYRANT
            set ge.name = g.emperor_names@(pi1)
            set ge.race = g.eto@(pi1).race
            return true
        }
        if !human_alive {
            pin ns = news_s()
            var killer = g.gaux.human_killer
            if killer >= g.players {
                set killer = if pi1 != PLAYER_NONE => pi1 => 1
            }
            set ns.type = GAME_NEWS_GENOCIDE
            set ns.race = g.eto@(pih).race
            set ns.subtype = 3
            set ns.num1 = pih
            ui_news_start()
            ui_news(g, ns)
            set ge.type = GAME_END_LOST_FUNERAL
            set ge.race = g.eto@(killer).banner
            set ge.banner_dead = pih
            return true
        }
    }
    false
}

func game_turn_audiences (g) {
    loop ph in PLAYER_NUM {
        val e = g.eto@(ph)
        if !IS_HUMAN(g, ph) {
            skip
        }
        set g.evn.newtech@(ph).num = 0
        loop pa in PLAYER_NUM {
            if IS_AI(g, pa) && (e.diplo_type@(pa) != 0) {
                game_audience(g, ph, pa)
                set e.diplo_type@(pa) = 0
            }
        }
        game_tech_finish_new(g, ph)
        ui_newtech(g, ph)
    }
}

;; ---------------------------------------------------------------------------

;; Gives the `struct game_end_s` of C.
func game_turn_process (g) {
    val game_end = game_end_s()     ;; (returned: not pinned)
    pin old_contact = BOOLVEC_TBL_DECLARE(PLAYER_NUM, PLAYER_NUM)
    pin old_focus = carray(PLAYER_NUM)  ;; uint8_t[]
    var num_alive = 0
    var num_colony = 0
    set game_end.type = GAME_END_NONE
    game_turn_limit_ships(g)
    loop i in g.players {
        BOOLVEC_TBL_COPY1(old_contact, g.eto@(i).contact, i, PLAYER_NUM)
        set old_focus@(i) = g.planet_focus_i@(i)
    }
    if (g.year > 40) && (rnd_0_nm1(30, g) == 0) && (copyprot_status == 0) {
        set copyprot_status = 1
    }
    ui_turn_pre(g)
    game_turn_countdown_ceasefire(g)
    game_turn_update_mood_blunder(g)
    game_update_have_reserve_fuel(g)
    game_ai.turn_p1(g)
    game_ai.turn_p2(g)
    game_update_have_reserve_fuel(g)
    game_ai.turn_p3(g)
    game_turn_init_z_finished(g)
    game_turn_send_transport(g)
    game_update_production(g)
    game_turn_build_eco(g)
    game_update_total_research(g)
    game_update_have_reserve_fuel(g)
    game_turn_update_trade(g)
    game_spy_build(g)
    if !game_num_hidden_child_labor_fix {
        game_update_production(g)
    }
    game_turn_diplo_adjust(g)
    game_turn_build_def(g)
    game_turn_build_ship(g)
    game_turn_reserve(g)
    game_turn_build_ind(g)
    game_turn_move_ships(g)
    game_turn_limit_ships(g)
    game_remove_empty_fleets(g)
    game_spy_report(g)
    game_battle_handle_all(g)
    ;; game_turn_unrest_hmm1(g);
    loop i in g.players {
        set g.evn.newtech@(i).num = 0
    }
    do {
        pin st = spy_turn_s()
        game_spy_turn(g, st)
        game_spy_esp_human(g, st)
        game_spy_sab_human(g)
    }
    ;; ui_newtech(); FIXME redundant;
    loop i in g.players {
        set g.evn.newtech@(i).num = 0
    }
    ;; 935f
    game_tech_research(g)
    loop i in g.players {
        if IS_HUMAN(g, i) {
            game_tech_finish_new(g, i)
            ui_newtech(g, i)
        }
    }
    ;; FIXME useless? game_battle should have taken care of this
    if g.evn.have_guardian {
        val o = g.evn.planet_orion_i
        loop i in g.players {
            ;; (C: memset(s, 0, sizeof(*s)) with s the ships of the orbit: only the first)
            set g.eto@(i).orbit@(o).ships@(0) = 0
        }
    }
    game_turn_explore(g)
    game_turn_bomb(g)
    game_turn_transport(g)
    do {
        val grdata = game_turn_ground_resolve_all(g)
        game_turn_ground_show_all(g, grdata)
    }
    game_turn_coup(g)
    if game_turn_check_end(g, game_end) {
        return game_end
    }
    game_event_new(g)
    if game_event_run(g, game_end) {
        return game_end
    }
    if game_turn_check_end(g, game_end) {
        return game_end
    }
    loop pli in g.galaxy_stars {
        val looter = g.planet@(pli).artifact_looter
        if looter != PLAYER_NONE {
            game_tech_get_artifact_loot(g, pli, looter)
        }
    }
    loop i in g.players {
        if IS_HUMAN(g, i) {
            game_tech_finish_new(g, i)
            ui_newtech(g, i)
        }
        set g.evn.newtech@(i).num = 0
    }
    game_turn_update_have_met(g)
    game_ai.turn_diplo_p1(g)
    loop i in g.galaxy_stars {
        if g.planet@(i).owner != PLAYER_NONE {
            set num_colony = num_colony + 1
        }
    }
    loop i in g.players {
        if IS_ALIVE(g, i) {
            set num_alive = num_alive + 1
        }
    }
    if true
      && (!g.gaux.flag_cheat_elections)
      && (game_num_council_years != 0)
      && (((g.year % game_num_council_years) == 0) || (!g.election_held))
      && (num_alive > 2)
      && (((g.galaxy_stars * 2) // 3) <= num_colony)
      && (g.end == GAME_END_NONE) {
        game_election(g)
        set g.election_held = true
    }
    if game_turn_check_end(g, game_end) {
        return game_end
    }
    if g.gaux.local_players > 1 {
        game_turn_update_final_war(g)   ;; MOO1 does this much later
    }
    game_ai.turn_diplo_p2(g)
    game_turn_audiences(g)
    if game_turn_check_end(g, game_end) {
        return game_end
    }
    loop i in g.players {
        game_turn_contact_broken(g, i, old_contact@(i))
    }
    game_fleet_unrefuel(g)
    game_update_production(g)
    if copyprot_status == 1 {
        ui_copyprotection_check(g)
    }
    loop i in g.players {
        game_update_eco_on_waste(g, i, false)
    }
    game_turn_update_seen(g)
    game_diplo_mood_relax(g)
    loop i in g.players {
        set g.planet_focus_i@(i) = old_focus@(i)    ;; FIXME should not be needed anymore
    }
    set g.year = u16(g.year + 1)
    if copyprot_status == 1 {
        ui_copyprotection_lose(g, game_end)
        return game_end
    }
    ;; (#if 0 in C: game_turn_show_newships, handled in game_turn_start_messages)
    ;; MOO1 autosaves here every 5 turns
    game_update_tech_util(g)
    loop i in g.players {
        val e = g.eto@(i)
        loop f in TECH_FIELD_NUM {
            set e.tech.percent@(f) = game_tech_get_field_percent(g, i, f)
        }
    }
    game_turn_finished_slider(g)
    game_turn_claim(g)
    game_update_within_range(g)
    if game_num_extended_reloc_range {
        game_update_reloc_dest(g)
    }
    game_update_visibility(g)
    if g.gaux.local_players == 1 {
        game_turn_update_final_war(g)   ;; MOO1 does this here, after update_tech_util etc
    }
    game_remove_empty_fleets(g)
    game_planet_update_home(g)
    game_end
}
