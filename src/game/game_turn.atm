;; Port of c/src/game/game_turn.c, one phase at a time (#9). The phases that
;; call into what is not ported yet are still to come; game_turn_process too.

include "../boolvec.atm"
include "../comp.atm"
include "../ctypes.atm"
include "../rnd.atm"
include "../util.atm"
include "game.atm"
include "game_design.atm"
include "game_fleet.atm"
include "game_misc.atm"
include "game_num.atm"
include "game_planet.atm"
include "game_planet_c.atm"
