include "game_aux.atm"
include "game_end.atm"
include "game_misc.atm"
include "game_new.atm"
include "game_num.atm"
include "game_nump.atm"
include "game_save.atm"
include "game_tech.atm"
include "game_turn.atm"

var game_opt_skip_intro_always = false
var game_opt_skip_intro = false
var game_opt_new_game = false
var game_opt_continue = false
var game_opt_load_game = 0
var game_opt_load_fname = nil
var game_opt_undo_enabled = true
var game_opt_year_save_enabled = false
var game_opt_init_save_enabled = true
var game_opt_next_turn = false
var game_opt_save_quit = false

pin game_opt_end = game_end_s()     ;; { GAME_END_NONE, 0, 0, 0, 0 }
pin game_opt_new = game_new_options_s()
pin game_opt_custom = game_new_options_s()

var game_opt_new_value = 200
var game_opt_custom_race_value = 0xaaaaa0
var game_opt_custom_banner_value = 666660
var game_opt_custom_isai_value = 111110

pin game_opt_message_filter = [ false, false, false, false, false, false ]  ;; [FINISHED_NUM]

pin game = game_s()
pin game_aux = game_aux_s()

;; ---------------------------------------------------------------------------

func game_start (g) {
    if g.seed == 0 {
        set g.seed = rnd_get_new_seed()
        log_message("Game: seed was 0, got new seed 0x%0x\n", g.seed)
    }
    if g.ai_id >= GAME_AI_NUM {
        log_warning("Game: AI ID was %i >= %i, setting to %i (%s)\n", g.ai_id, GAME_AI_NUM, GAME_AI_CLASSIC, game_ais@(GAME_AI_CLASSIC).name)
        set g.ai_id = GAME_AI_CLASSIC
    }
    set game_ai = game_ais@(g.ai_id)
    game_update_production(g)
    game_update_tech_util(g)
    if game_num_update_on_load {
        loop i in g.players {
            game_update_eco_on_waste(g, i, false)
            game_update_seen_by_orbit(g, i)
        }
    }
    game_update_within_range(g)
    game_update_visibility(g)
    game_update_have_reserve_fuel(g)
}

func game_stop (g) {
    set g.gaux.flag_cheat_galaxy = false
    set g.gaux.flag_cheat_elections = false
    set g.gaux.flag_cheat_events = false
    set g.gaux.flag_cheat_spy_hint = false
    set g.gaux.flag_cheat_stars = false
    set g.gaux.flag_cheat_tech_hint = false
    set g.gaux.flag_cheat_news = false
}

func game_set_opts_from_value (go, v0) {
    var v = v0
    var v2 = v % 10
    set v = v // 10
    set go.difficulty = v2
    set v2 = v % 10
    set v = v // 10
    set go.galaxy_size = v2
    set go.players = v
}

func game_get_opts_value (g) {
    g.difficulty + (g.galaxy_size * 10) + (g.players * 100)
}

func game_set_custom_opts_from_cfg (go) {
    var races = u32(game_opt_custom_race_value)
    var banners = u32(game_opt_custom_banner_value)
    var is_ai = u32(game_opt_custom_isai_value)
    loop i in PLAYER_NUM {
        set go.pdata@(i).race = races % 0x10
        set races = races // 0x10
        set go.pdata@(i).banner = banners % 10
        set banners = banners // 10
        set go.pdata@(i).is_ai = (is_ai % 10) != 0
        set is_ai = is_ai // 10
    }
}

func game_save_custom_opts_to_cfg (go) {
    set game_opt_custom_race_value = 0
    set game_opt_custom_banner_value = 0
    set game_opt_custom_isai_value = 0
    loop k in PLAYER_NUM {
        val i = PLAYER_NUM - 1 - k
        set game_opt_custom_race_value = (game_opt_custom_race_value * 0x10) + go.pdata@(i).race
        set game_opt_custom_banner_value = (game_opt_custom_banner_value * 10) + go.pdata@(i).banner
        set game_opt_custom_isai_value = (game_opt_custom_isai_value * 10) + cint(go.pdata@(i).is_ai)
    }
}

func game_apply_rules () {
    if game_opt_fix_bugs {
        game_num_fix_bugs()
    }
    if game_opt_fix_starting_ships {
        game_num_fix_starting_ships()
    }
    game_num_fix_bugs_1_3a()
}

;; ---------------------------------------------------------------------------
;; The options (`argv` is a vector of strings: the option and its arguments).

func game_opt_do_new_seed (argv, var_) {
    val buf = string.sub(argv@(1), 0, SETMIN(#argv@(1), 511) - 1)
    ;; the parts between ':', nil where empty at a ':'
    pin parts = [ nil, nil, nil, nil, nil ]
    do {
        var start = 0
        var k = 0
        loop {
            while k < 5
            var e = start
            loop {
                while (e < #buf) && (string.byte(buf, e) != 58)
                set e = e + 1
            }
            val atcolon = (start < #buf) && (string.byte(buf, start) == 58)
            set parts@(k) = if atcolon => nil => string.sub(buf, start, e - 1)
            set k = k + 1
            if e >= #buf {
                break
            }
            set start = e + 1
        }
    }
    val stropt = parts@(0)
    val strrace = parts@(1)
    val strbanner = parts@(2)
    val strseed = parts@(3)
    val strhuman = parts@(4)
    var vo
    var vr
    var vb
    var vs
    var va
    do {
        var v = 0
        if stropt != nil {
            val ok, x = util_parse_number(stropt)
            if !ok {
                log_error("invalid value '%s'\n", stropt)
                return -1
            }
            set v = x
        } else {
            set v = game_opt_new_value
        }
        set vo = v
        var v2 = v % 10
        set v = v // 10
        if v2 > DIFFICULTY_NUM {
            log_error("invalid difficulty num %i\n", v2)
            return -1
        }
        set game_opt_new.difficulty = v2
        set v2 = v % 10
        set v = v // 10
        if v2 > GALAXY_SIZE_HUGE {
            log_error("invalid galaxy size num %i\n", v2)
            return -1
        }
        set game_opt_new.galaxy_size = v2
        set v2 = v % 10
        if (v2 < 2) || (v2 > PLAYER_NUM) {
            log_error("invalid players num %i\n", v2)
            return -1
        }
        set game_opt_new.players = v2
    }
    do {
        var v = 0
        if strrace != nil {
            val ok, x = util_parse_number(strrace)
            if !ok {
                log_error("invalid value '%s'\n", strrace)
                return -1
            }
            set v = x
        }
        set vr = v
        loop i in PLAYER_NUM {
            var v2 = v & 0xf
            set v = v >> 4
            if v2 > RACE_NUM {
                log_error("invalid race num %i\n", v2)
                return -1
            }
            set v2 = if v2 != 0 => (v2 - 1) => RACE_RANDOM
            set game_opt_new.pdata@(i).race = v2
        }
    }
    do {
        var v = 0
        if strbanner != nil {
            val ok, x = util_parse_number(strbanner)
            if !ok {
                log_error("invalid value '%s'\n", strbanner)
                return -1
            }
            set v = x
        }
        set vb = v
        loop i in PLAYER_NUM {
            var v2 = v % 10
            set v = v // 10
            if v2 > BANNER_NUM {
                log_error("invalid banner num %i\n", v2)
                return -1
            }
            set v2 = if v2 != 0 => (v2 - 1) => BANNER_RANDOM
            set game_opt_new.pdata@(i).banner = v2
        }
    }
    do {
        var v = 0
        if strseed != nil {
            val ok, x = util_parse_number(strseed)
            if !ok {
                log_error("invalid value '%s'\n", strseed)
                return -1
            }
            set v = x
        }
        set vs = v
        set game_opt_new.galaxy_seed = v
    }
    do {
        var v = 1
        if strhuman != nil {
            val ok, x = util_parse_number(strhuman)
            if !ok {
                log_error("invalid value '%s'\n", strhuman)
                return -1
            }
            set v = x
        }
        set va = v
        loop i in PLAYER_NUM {
            val v2 = v % 10
            set v = v // 10
            set game_opt_new.pdata@(i).is_ai = v2 == 0
        }
    }
    set game_opt_skip_intro = true
    set game_opt_load_game = 0
    set game_opt_load_fname = nil
    set game_opt_continue = false
    set game_opt_new_game = true
    log_message("Game: -new %d:0x%x:%d:0x%x:%d\n", vo, vr, vb, vs, va)    ;; (%u of C: Atmos has no %u)
    0
}

func game_opt_do_load (argv, var_) {
    val ok, v = util_parse_number(argv@(1))
    if ok && (((v >= 1) && (v <= NUM_ALL_SAVES)) || ((v >= 2300) && (v <= 9999))) {
        set game_opt_load_game = v
        set game_opt_load_fname = nil
        log_message("Game: load game %i\n", game_opt_load_game)
    } else {
        set game_opt_load_game = 0
        set game_opt_load_fname = argv@(1)
        log_message("Game: load game '%s'\n", game_opt_load_fname)
    }
    set game_opt_skip_intro = true
    set game_opt_continue = false
    set game_opt_new_game = false
    0
}

func game_opt_do_continue (argv, var_) {
    set game_opt_load_game = 0
    set game_opt_load_fname = nil
    set game_opt_skip_intro = true
    set game_opt_continue = true
    set game_opt_new_game = false
    log_message("Game: continue game\n")
    0
}

func game_opt_set_new_name (argv, var_) {
    val ok, v = util_parse_number(argv@(1))
    ifs {
        !ok => {
            log_error("invalid value '%s'\n", argv@(1))
            return -1
        }
        (v < 1) || (v > PLAYER_NUM) => {
            log_error("invalid player num %i\n", v)
            return -1
        }
    }
    ;; strncpy, then buf[EMPEROR_NAME_LEN - 1] = '\0'
    val buf = string.sub(argv@(2), 0, SETMIN(#argv@(2), EMPEROR_NAME_LEN - 1) - 1)
    set game_opt_new.pdata@(v - 1).playername = buf
    log_message("Game: player %i name '%s'\n", v, buf)
    0
}

func game_opt_set_new_home (argv, var_) {
    val ok, v = util_parse_number(argv@(1))
    ifs {
        !ok => {
            log_error("invalid value '%s'\n", argv@(1))
            return -1
        }
        (v < 1) || (v > PLAYER_NUM) => {
            log_error("invalid player num %i\n", v)
            return -1
        }
    }
    val buf = string.sub(argv@(2), 0, SETMIN(#argv@(2), PLANET_NAME_LEN - 1) - 1)
    set game_opt_new.pdata@(v - 1).homename = buf
    log_message("Game: player %i home '%s'\n", v, buf)
    0
}

func game_opt_set_new_ai (argv, var_) {
    val ok, v = util_parse_number(argv@(1))
    ifs {
        !ok => {
            log_error("invalid value '%s'\n", argv@(1))
            return -1
        }
        v > GAME_AI_NUM => {
            log_error("invalid AI num %i\n", v)
            return -1
        }
    }
    set game_opt_new.ai_id = v
    log_message("Game: AI type %i '%s'\n", v, game_ais@(v).name)
    0
}

;; -dumpstr and -dumpnum: game_str_dump and game_num_dump (of game_strp.c
;; and game_nump.c) are not ported yet (#14, with the PBX files).
func dump_strings (argv, var_) {
    log_error("option '%s' is not ported yet\n", argv@(0))
    return -1
}

func dump_numbers (argv, var_) {
    log_error("option '%s' is not ported yet\n", argv@(0))
    return -1
}

