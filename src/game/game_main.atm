;; ---------------------------------------------------------------------------

func game_cfg_check_difficulty_value (v) {
    if v >= DIFFICULTY_NUM {
        log_error("invalid difficulty num %i\n", v)
        return false
    }
    true
}

func game_cfg_check_galaxy_size_value (v) {
    if v > GALAXY_SIZE_HUGE {
        log_error("invalid galaxy size num %i\n", v)
        return false
    }
    true
}

func game_cfg_check_players_value (v) {
    if (v < 2) || (v > PLAYER_NUM) {
        log_error("invalid players num %i\n", v)
        return false
    }
    true
}

func game_cfg_check_custom_game_ai_id (v) {
    if (v >= GAME_AI_NUM) || (v < 0) {
        log_error("invalid ai id %i\n", v)
        return false
    }
    true
}

;; `%` and `/` of C on an int: truncated towards zero.
func game_cfg_cmod (a, b) {
    i32(a - (b * game_cfg_cdiv(a, b)))
}

func game_cfg_cdiv (a, b) {
    if a < 0 => -((-a) // b) => a // b
}

func game_cfg_check_new_game_opts (val_) {
    var v = val_
    var v2 = game_cfg_cmod(v, 10)
    set v = game_cfg_cdiv(v, 10)
    if v2 >= DIFFICULTY_NUM {
        log_error("invalid difficulty num %i\n", v2)
        return false
    }
    set v2 = game_cfg_cmod(v, 10)
    set v = game_cfg_cdiv(v, 10)
    if v2 > GALAXY_SIZE_HUGE {
        log_error("invalid galaxy size num %i\n", v2)
        return false
    }
    set v2 = game_cfg_cmod(v, 10)
    if (v2 < 2) || (v2 > PLAYER_NUM) {
        log_error("invalid players num %i\n", v2)
        return false
    }
    true
}

func game_cfg_check_race_value (val_) {
    var v = val_
    loop i in PLAYER_NUM {
        val v2 = game_cfg_cmod(v, 0x10)
        set v = game_cfg_cdiv(v, 0x10)
        if v2 > RACE_RANDOM {
            log_error("invalid race num %i\n", v2)
            return false
        }
    }
    true
}

func game_cfg_check_banner_value (val_) {
    var v = val_
    loop i in PLAYER_NUM {
        val v2 = game_cfg_cmod(v, 10)
        set v = game_cfg_cdiv(v, 10)
        if v2 > BANNER_RANDOM {
            log_error("invalid banner num %i\n", v2)
            return false
        }
    }
    true
}

func game_cfg_check_isai_value (val_) {
    var v = val_
    loop i in PLAYER_NUM {
        val v2 = game_cfg_cmod(v, 10)
        set v = game_cfg_cdiv(v, 10)
        if v2 > 1 {
            log_error("invalid isai num %i\n", v2)
            return false
        }
    }
    true
}

;; An int item on a field of a struct (`&t.k` in C): the fields of
;; game_opt_custom are unsigned (uint32_t or enums of gcc, #12), which the
;; config writes and reads as int.
func game_cfg_item_field (n, t, k, check) {
    CFG_ITEM_INT(n, func () { i32(t@(k)) }, func (v) { set t@(k) = u32(v) }, check)
}

func game_cfg_item_bool_field (n, t, k) {
    CFG_ITEM_BOOL(n, func () { t@(k) }, func (v) { set t@(k) = v })
}

