    CFG_ITEM_BOOL("rules_deterministic_rng", func () { game_num_deterministic }, func (v) { set game_num_deterministic = v }),
    CFG_ITEM_BOOL("rules_hidden_child_labor_fix", func () { game_num_hidden_child_labor_fix }, func (v) { set game_num_hidden_child_labor_fix = v }),
    CFG_ITEM_BOOL("rules_leaving_trans_fix", func () { game_num_leaving_trans_fix }, func (v) { set game_num_leaving_trans_fix = v }),
    CFG_ITEM_BOOL("rules_monster_rest_attack", func () { game_num_monster_rest_att }, func (v) { set game_num_monster_rest_att = v }),
    CFG_ITEM_BOOL("rules_factory_cost_fix", func () { game_num_factory_cost_fix }, func (v) { set game_num_factory_cost_fix = v }),
    CFG_ITEM_BOOL("rules_colonized_factories_fix", func () { game_num_colonized_factories_fix }, func (v) { set game_num_colonized_factories_fix = v }),
    CFG_ITEM_BOOL("rules_newtech_adjust_fix", func () { game_num_newtech_adjust_fix }, func (v) { set game_num_newtech_adjust_fix = v }),
    CFG_ITEM_BOOL("rules_slider_eco_done_fix", func () { game_num_slider_eco_done_fix }, func (v) { set game_num_slider_eco_done_fix = v }),
    CFG_ITEM_BOOL("rules_cond_switch_to_ind_fix", func () { game_num_cond_switch_to_ind_fix }, func (v) { set game_num_cond_switch_to_ind_fix = v }),
    CFG_ITEM_BOOL("rules_waste_adjust_fix", func () { game_num_waste_adjust_fix }, func (v) { set game_num_waste_adjust_fix = v }),
    CFG_ITEM_BOOL("rules_orbital_bio_fix", func () { game_num_orbital_bio_fix }, func (v) { set game_num_orbital_bio_fix = v }),
    CFG_ITEM_BOOL("rules_orbital_weap_4", func () { game_num_orbital_weap_4 }, func (v) { set game_num_orbital_weap_4 = v }),
    CFG_ITEM_BOOL("rules_orbital_comp_fix", func () { game_num_orbital_comp_fix }, func (v) { set game_num_orbital_comp_fix = v }),
    CFG_ITEM_BOOL("rules_retreat_redir_fix", func () { game_num_retreat_redir_fix }, func (v) { set game_num_retreat_redir_fix = v }),
    CFG_ITEM_BOOL("rules_ship_stargate_redir_fix", func () { game_num_stargate_redir_fix }, func (v) { set game_num_stargate_redir_fix = v }),
    CFG_ITEM_BOOL("rules_ship_trans_redir_fix", func () { game_num_trans_redir_fix }, func (v) { set game_num_trans_redir_fix = v }),
