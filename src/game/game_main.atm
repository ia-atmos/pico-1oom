]

;; ---------------------------------------------------------------------------

func main_handle_option (argv) {
    if game_opt_end.type == GAME_END_NONE {
        val c = if #argv > 0 => string.byte(argv, 0) => 0
        ifs {
            (#argv == 1) && (c >= 48) && (c <= 51) => {    ;; '0'..'3'
                match c {
                    48 => { set game_opt_end.type = GAME_END_WON_GOOD }
                    49 => { set game_opt_end.type = GAME_END_LOST_FUNERAL }
                    50 => { set game_opt_end.type = GAME_END_LOST_EXILE }
                    51 => { set game_opt_end.type = GAME_END_WON_TYRANT }
                }
                set game_opt_load_game = 0
                set game_opt_load_fname = nil
                set game_opt_new_game = false
                set game_opt_skip_intro = true
                set game_opt_continue = false
                return 0
            }
            argv == "YOMAMA" => {
                log_message("Game: skip intro for YOMAMA\n")
                set game_opt_skip_intro = true
                return 0
            }
            argv == "s" => {
                log_message("Game: direct continue\n")
                set game_opt_load_game = 0
                set game_opt_load_fname = nil
                set game_opt_new_game = false
                set game_opt_skip_intro = true
                set game_opt_continue = true
                return 0
            }
        }
    } else {
        val t = game_opt_end.type
        ifs {
            game_opt_end.varnum == 0 => {
                if t == GAME_END_LOST_EXILE {
                    set game_opt_end.name = argv
                } else {
                    set game_opt_end.race = opt_atoi(argv)
                }
            }
            game_opt_end.varnum == 1 => {
                ifs {
                    (t == GAME_END_WON_GOOD) || (t == GAME_END_WON_TYRANT) => {
                        set game_opt_end.name = argv
                        log_message("Game: ending %s %i '%s'\n", if t == GAME_END_WON_GOOD => "good" => "tyrant", game_opt_end.race, game_opt_end.name)
                    }
                    t == GAME_END_LOST_FUNERAL => {
                        set game_opt_end.banner_dead = opt_atoi(argv)
                        log_message("Game: ending funeral %i %i\n", game_opt_end.race, game_opt_end.banner_dead)
                    }
                    t == GAME_END_LOST_EXILE => {
                        log_message("Game: ending exile '%s'\n", game_opt_end.name)
                    }
                }
            }
            else => {
                return -1
            }
        }
        set game_opt_end.varnum = game_opt_end.varnum + 1
        return 0
    }
    return -1
}

;; ---------------------------------------------------------------------------

;; Gives 0 at the end (C: `return 0` from `main_do`).
func main_do () {
    var game_end = game_end_s()
    cstruct_copy(game_end, game_opt_end)
    if ui_late_init() != 0 {
        return 1
    }
    game_aux_init(game_aux, game)
    game_save_check_saves()
    var skip_to_ending = (game_opt_end.type != GAME_END_NONE) && (game_opt_end.varnum == 2)
    if (!skip_to_ending) && (!(game_opt_skip_intro || game_opt_skip_intro_always)) {
        ui_play_intro()
    }
    loop {
        if !skip_to_ending {
            pin game_new_opts = game_new_options_s()
            pin game_challenge_opts = game_new_options_s()
            var main_menu_action = nil
            var load_game_i = 0
            var go = nil    ;; the label of C to go to: "new", "start", "load", "continue"
            ifs {
                game_opt_new_game => {
                    set game_opt_new_game = false
                    cstruct_copy(game_new_opts, game_opt_new)
                    set go = "new"
                }
                game_opt_load_fname != nil => {
                    if game_save_do_load_fname(game_opt_load_fname, nil, game) != 0 {
                        log_fatal_and_die("Game: could not load save '%s'\n", game_opt_load_fname)
                    }
                    set game_opt_load_fname = nil
                    set go = "start"
                }
                game_opt_load_game != 0 => {
                    set load_game_i = game_opt_load_game
                    if load_game_i < 2300 {
                        set load_game_i = load_game_i - 1
                    }
                    set game_opt_load_game = 0
                    if (load_game_i >= 2300) || game_save_tbl_have_save@(load_game_i) {
                        set go = "load"
                    } else {
                        log_warning("Game: direct load game %i failed due to missing savegame\n", load_game_i + 1)
                        ;; try again, now with game_opt_load_game set to 0
                        skip
                    }
                }
                game_opt_continue => {
                    set game_opt_continue = false
                    if game_save_tbl_have_save@(GAME_SAVE_I_CONTINUE) {
                        set go = "continue"
                    } else {
                        log_warning("Game: direct continue failed due to missing savegame\n")
                        ;; try again, now with game_opt_continue set to false
                        skip
                    }
                }
                else => {
                    game_set_opts_from_value(game_new_opts, game_opt_new_value)
                    game_set_custom_opts_from_cfg(game_opt_custom)
                    set main_menu_action, load_game_i = ui_main_menu(game_new_opts, game_opt_custom, game_challenge_opts, load_game_i)
                }
            }
            if go == nil {
                set go = match main_menu_action {
                    MAIN_MENU_ACT_NEW_GAME => "new"
                    MAIN_MENU_ACT_CUSTOM_GAME => "custom"
                    MAIN_MENU_ACT_CHALLENGE_GAME => "challenge"
                    MAIN_MENU_ACT_TUTOR => "tutor"
                    MAIN_MENU_ACT_LOAD_GAME => "load"
                    MAIN_MENU_ACT_LOAD_GAME_MOO13 => "moo13"
                    MAIN_MENU_ACT_CONTINUE_GAME => "continue"
                    MAIN_MENU_ACT_QUIT_GAME => "quit"
                }
            }
            ;; the main loop of a game, again from "load" when a game is loaded in game
            var restart = true
            loop {
                while restart
                set restart = false
                match go {
                    "new" => {
                        game_new(game, game_aux, game_new_opts)
                        set game_opt_new_value = game_get_opts_value(game)
                        if game_opt_init_save_enabled {
                            game_save_do_save_i(GAME_SAVE_I_INIT, "Init", game)
                        }
                    }
                    "custom" => {
                        game_new(game, game_aux, game_opt_custom)
                        game_save_custom_opts_to_cfg(game_opt_custom)
                        if game_opt_init_save_enabled {
                            game_save_do_save_i(GAME_SAVE_I_INIT, "Init", game)
                        }
                    }
                    "challenge" => {
                        game_new(game, game_aux, game_challenge_opts)
                        if game_opt_init_save_enabled {
                            game_save_do_save_i(GAME_SAVE_I_INIT, "Init", game)
                        }
                    }
                    "tutor" => {
                        game_new_tutor(game, game_aux)
                    }
                    "load" => {
                        if false
                          || ((load_game_i < NUM_ALL_SAVES) && (game_save_do_load_i(load_game_i, game) != 0))
                          || ((load_game_i >= 2300) && (game_save_do_load_year(load_game_i, nil, game) != 0)) {
                            log_fatal_and_die("Game: could not load save %i\n", load_game_i)
                        }
                    }
                    "moo13" => {
                        throw "game_main: the saves of MOO 1.3 are not ported yet (#14)"
                    }
                    "continue" => {
                        if game_save_do_load_i(GAME_SAVE_I_CONTINUE, game) != 0 {
                            log_fatal_and_die("Game: could not start or continue from save 7\n")
                        }
                    }
                    "quit" => {
                        log_message("Game: quit (main)\n")
                        return 0
                    }
                    "start" => nil
                }
                ;; main_menu_start_game:
                game_aux_start(game_aux, game)
                game_start(game)
                ui_game_start(game)
                set game_end.type = GAME_END_NONE
                loop {
                    while (game_end.type == GAME_END_NONE) || (game_end.type == GAME_END_FINAL_WAR)
                    loop {
                        while ((game_end.type == GAME_END_NONE) || (game_end.type == GAME_END_FINAL_WAR)) && (game.active_player < game.players)
                        val pi = game.active_player
                        if IS_HUMAN(game, pi) && IS_ALIVE(game, pi) {
                            if game_opt_next_turn {
                                set game_opt_next_turn = false
                                break
                            }
                            var act
                            if game_opt_save_quit {
                                set act = UI_TURN_ACT_QUIT_GAME
                            } else {
                                set act, load_game_i = ui_game_turn(game, load_game_i, pi)
                            }
                            match act {
                                UI_TURN_ACT_LOAD_GAME => {
                                    set main_menu_action = MAIN_MENU_ACT_LOAD_GAME
                                    ui_game_end(game)
                                    set go = "load"
                                    set restart = true
                                    break
                                }
                                UI_TURN_ACT_QUIT_GAME => {
                                    if game_save_do_save_i(GAME_SAVE_I_CONTINUE, "Continue", game) != 0 {
                                        log_error("Game: could create continue save\n")
                                    }
                                    set game_end.type = GAME_END_QUIT
                                }
                                UI_TURN_ACT_NEXT_TURN => {
                                    if game_opt_undo_enabled && (game_save_do_save_i(GAME_SAVE_I_UNDO, "Undo", game) != 0) {
                                        log_error("Game: could create undo save\n")
                                    }
                                    if game_opt_year_save_enabled && (game_save_do_save_year(nil, game) != 0) {
                                        log_error("Game: could create year save\n")
                                    }
                                }
                            }
                        }
                        set game.active_player = game.active_player + 1
                    }
                    if restart {
                        break
                    }
                    if game_end.type != GAME_END_QUIT {
                        set game_end = game_turn_process(game)
                    }
                    set game.active_player = PLAYER_0
                }
            }
            ui_game_end(game)
        }
        ;; do_ending:
        set skip_to_ending = false
        match game_end.type {
            GAME_END_QUIT => {
                log_message("Game: quit (ingame)\n")
                if game_opt_save_quit {
                    set game_opt_save_quit = false
                    return 0
                }
            }
            GAME_END_WON_GOOD => ui_play_ending_good(game_end.race, cstr(game_end.name))
            GAME_END_WON_TYRANT => ui_play_ending_tyrant(game_end.race, cstr(game_end.name))
            GAME_END_LOST_FUNERAL => ui_play_ending_funeral(game_end.race, game_end.banner_dead)
            GAME_END_LOST_EXILE => ui_play_ending_exile(cstr(game_end.name))
            else => nil
        }
        set game_end.type = GAME_END_NONE
        game_stop(game)
    }
}

func main_do_shutdown () {
    ;; TODO save game if in progress
    game_aux_shutdown(game_aux)
}
