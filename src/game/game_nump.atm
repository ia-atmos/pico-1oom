;; END game_num_id_tbl

;; ---------------------------------------------------------------------------

func game_num_find_match (numid, i, num) {
    loop _, s in game_num_id_tbl {
        if s.numid == numid {
            if (num > 0) && ((i + num) <= s.size) {
                return s
            } else {
                log_error("NUM: numid '%s' index %i+%i=%i > size %i\n", numid, i, num, i + num, s.size)
                return nil
            }
        }
    }
    log_error("NUM: unknown numid '%s'\n", numid)
    nil
}

;; ---------------------------------------------------------------------------

var game_opt_fix_bugs = false
var game_opt_fix_starting_ships = false

func game_num_fix_bugs () {
    set game_num_ng_tech@(RACE_SILICOID)@(TECH_FIELD_PLANETOLOGY)@(24) = 1
    set game_num_ng_tech@(RACE_SILICOID)@(TECH_FIELD_PLANETOLOGY)@(30) = 1
    set game_num_accident_chk_factories = true
    set game_num_weapon_list_max = 64
    set game_num_aud_bounty_give = true
    set game_num_aud_update_tech = true
    set game_num_update_on_load = false
    set game_num_combat_trans_fix = true
    set game_num_eco_slider_slack = 0
    set game_num_reset_tform_to_max = false
}

func game_num_fix_bugs_1_3a () {
    set game_num_ai_4_colony_curse_fix = true
    set game_num_max_factories = 2700
    set game_num_bt_oracle_fix = true
    set game_num_orbital_weap_any = true
    set game_num_orbital_torpedo = true
    set game_num_ship_scanner_fix = true
    set tbl_monster@(MONSTER_GUARDIAN)@(3).special@(1) = 16
    set tbl_monster@(MONSTER_GUARDIAN)@(4).special@(1) = 26
    set tbl_monster@(MONSTER_GUARDIAN)@(4).repair = 30
}

func game_num_fix_starting_ships () {
    set tbl_startship@(0).engines = 2
    set tbl_startship@(1).engines = 27
    set tbl_startship@(2).engines = 110
    set tbl_startship@(3).engines = 85
    set tbl_startship@(4).engines = 100
    set tbl_startship@(0).cost = 8
    set tbl_startship@(1).cost = 14
    set tbl_startship@(2).cost = 74
    set tbl_startship@(3).cost = 65
    set tbl_startship@(4).cost = 570
}

;; `patchnums`: a vector of int32. The checks of C compare `v` (an int) with
;; `vmax` (a uint32_t) as unsigned, so a negative value fails also where
;; `vmin` is negative (st_weap_numshots -1).
func game_num_patch (numid, patchnums, first, num) {
    val s = game_num_find_match(numid, first, num)
    if s != nil {
        val is_signed = NUMTYPE_IS_S(s.numtype)
        loop i in num {
            val v = patchnums@(i)
            if (is_signed && ((v < s.vmin) || (u32(v) > s.vmax)))
                || (!is_signed && ((u32(v) < u32(s.vmin)) || (u32(v) > s.vmax)))
            {
                log_error("NUM: numid '%s' %ssigned value %i (%d) outside range %i..%d\n", numid, if is_signed => "" => "un", v, u32(v), s.vmin, s.vmax)
                return false
            }
            val k = first + i
            match s.numtype {
                NUMTYPE_S => s.put(k, i32(v))
                NUMTYPE_U => s.put(k, u32(v))
                NUMTYPE_S8 => s.put(k, i8(v))
                NUMTYPE_U8 => s.put(k, u8(v))
                NUMTYPE_S16 => s.put(k, i16(v))
                NUMTYPE_U16 => s.put(k, u16(v))
                NUMTYPE_S32 => s.put(k, i32(v))
                NUMTYPE_U32 => s.put(k, u32(v))
                NUMTYPE_BOOL => s.put(k, v != 0)
                else => s.put(k, i32(v))
            }
        }
        return true
    } else {
        return false
    }
}

func game_num_dump () {
    var prevmin = 1
    var prevmax = 0
    log_message("# dump of all patchable game numbers\n")
    loop _, s in game_num_id_tbl {
        if (s.vmin != prevmin) || (s.vmax != prevmax) {
            set prevmin = s.vmin
            set prevmax = s.vmax
            log_message("# %i..%d\n", prevmin, prevmax)
        }
        log_message("4,%s,0", s.numid)
        loop i in s.size {
            val x = s.get(i)
            val v = if s.numtype == NUMTYPE_BOOL => cint(x) => x
            log_message(",%d", v)
        }
        log_message("\n")
    }
}
