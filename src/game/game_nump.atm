;; END game_num_id_tbl

;; ---------------------------------------------------------------------------

func game_num_find_match (numid, i, num) {
    loop _, s in game_num_id_tbl {
        if s.numid == numid {
            if (num > 0) && ((i + num) <= s.size) {
                return s
            } else {
                log_error("NUM: numid '%s' index %i+%i=%i > size %i\n", numid, i, num, i + num, s.size)
                return nil
            }
        }
    }
    log_error("NUM: unknown numid '%s'\n", numid)
    nil
}

