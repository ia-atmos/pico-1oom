;; Port of c/src/game/game_nump.c: the numbers of the game that a PBX file
;; may replace (`4,numid,i,v...`), their dump (-dumpnum), and the fixes of
;; the rules. In C an item points to the variable, with the step between
;; the elements; here it has `get(i)` and `put(i, v)`. The table is
;; generated from the C by tools/game_nump.py. `find_match` of C is
;; `game_num_find_match` here (Atmos has no `static`).

include "game_num.atm"
include "game_parsed.atm"
include "game_shipdesign.atm"
include "game_types.atm"
include "game_techtypes.atm"
include "game_shiptech.atm"
include "../log.atm"

val NUMTYPE_S = 0
val NUMTYPE_U = 1
val NUMTYPE_S8 = 2
val NUMTYPE_U8 = 3
val NUMTYPE_S16 = 4
val NUMTYPE_U16 = 5
val NUMTYPE_S32 = 6
val NUMTYPE_U32 = 7
val NUMTYPE_BOOL = 8

func NUMTYPE_IS_S (t) {
    (t & 1) == 0
}

func numtbl_s (numid, numtype, size, vmin, vmax, get, put) {
    [ numid = numid, numtype = numtype, size = size, vmin = vmin, vmax = vmax,
      get = get, put = put ]
}

;; BEGIN game_num_id_tbl (generated by tools/game_nump.py)
