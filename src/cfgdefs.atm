;; The part of c/src/cfg.h that the modules use to define their items:
;; the types and the constructors of the items (the macros CFG_ITEM_*).
;; An item: `name`, `tbl` and `key` (the variable, which C points to, is
;; the field `key` of the table `tbl`), `check`, `type`.

val CFG_TYPE_INT = 0
val CFG_TYPE_STR = 1
val CFG_TYPE_BOOL = 2
val CFG_TYPE_COMMENT = 3

func CFG_ITEM_STR (n, tbl, key, check) {
    [ name = n, tbl = tbl, key = key, check = check, type = CFG_TYPE_STR ]
}

func CFG_ITEM_INT (n, tbl, key, check) {
    [ name = n, tbl = tbl, key = key, check = check, type = CFG_TYPE_INT ]
}

func CFG_ITEM_BOOL (n, tbl, key) {
    [ name = n, tbl = tbl, key = key, check = nil, type = CFG_TYPE_BOOL ]
}

func CFG_ITEM_COMMENT (s) {
    [ name = s, tbl = nil, key = nil, check = nil, type = CFG_TYPE_COMMENT ]
}
