;; Port of c/src/lib.c: the functions on strings that the port needs so far.
;;
;; A `char[]` of the state is a vector of bytes (see game.atm); a `const char *`
;; of the program (game_str) is an Atmos string. `cstr` reads a vector as C
;; reads a string, up to its first zero.

include "log.atm"

;; The string of C at `offs` (0 by default) of a vector of bytes; a string is
;; itself.
func cstr (src, offs) {
    if type(src) == "string" {
        return src
    }
    val o = offs || 0
    val cs = []
    var i = o
    loop {
        val b = src@(i)
        while (b != nil) && (b != 0)
        set cs@+ = string.char(b)
        set i = i + 1
    }
    string.join(cs, "")
}

;; `strcpy` into a vector of bytes, with the check of 1oom: the string and
;; its zero; the bytes after it keep their values, as in C.
func lib_strcpy (dst, src, dst_bufsize) {
    val s = cstr(src)
    if #s >= dst_bufsize {
        log_fatal_and_die("lib_strcpy: destination buffer too small, need %d, have %d\n", #s + 1, dst_bufsize)
    }
    loop i in #s {
        set dst@(i) = string.byte(s, i)
    }
    set dst@(#s) = 0
    dst
}

;; `strcasecmp` of libc, on strings: below, equal (0), or above zero.
func strcasecmp (a, b) {
    val x = string.lower(cstr(a))
    val y = string.lower(cstr(b))
    var i = 0
    loop {
        val ca = if i < #x => string.byte(x, i) => 0
        val cb = if i < #y => string.byte(y, i) => 0
        if (ca != cb) || (ca == 0) {
            return ca - cb
        }
        set i = i + 1
    }
}

;; `vsnprintf` into a vector of bytes, with the check of 1oom.
func lib_sprintf (buf, bufsize, fmt, ...) {
    val s = string.format(fmt, ...)
    if #s >= bufsize {
        log_fatal_and_die("lib_sprintf: buffer too small, need %d, have %d", #s, bufsize)
    }
    loop i in #s {
        set buf@(i) = string.byte(s, i)
    }
    set buf@(#s) = 0
    #s
}


;; `strcat` into a vector of bytes, with the check of 1oom.
func lib_strcat (dst, src, dst_bufsize) {
    val s = cstr(src)
    val d = cstr(dst)
    val combined_len = #s + #d
    if combined_len >= dst_bufsize {
        log_fatal_and_die("lib_strcat: destination buffer too small, need %d, have %d\n", combined_len + 1, dst_bufsize)
    }
    loop i in #s {
        set dst@(#d + i) = string.byte(s, i)
    }
    set dst@(combined_len) = 0
    dst
}

;; `strbuild_*`: build up strings piece by piece, checking the buffer size.
;; The `struct strbuild_s` is a table: the buffer (a vector of bytes), the
;; positions of the start and the end of the current string, and what
;; remains of the buffer.

func strbuild_fatal_too_small (str) {
    log_fatal_and_die("string buffer too small for: \"%s...\"\n", cstr(str.buf, str.str_start))
}

func strbuild_init (buf, bufsize) {
    if bufsize > 0 {
        set buf@(0) = 0
    }
    [ buf = buf, str_start = 0, str_end = 0, remaining = bufsize ]
}

;; Return the string being built (its position) and start a new one after
;; it, storing multiple strings in the same buffer.
func strbuild_finish (str) {
    val old_str = str.str_start
    if str.remaining > 0 {
        set str.str_end = str.str_end + 1
        set str.buf@(str.str_end) = 0
        set str.remaining = str.remaining - 1
    }
    set str.str_start = str.str_end
    ;; If str->remaining was 0, we will log_fatal_and_die when anything
    ;; more is written to this string.
    old_str
}

func strbuild_append_char (str, c) {
    if str.remaining > 0 {
        set str.buf@(str.str_end) = c
        set str.str_end = str.str_end + 1
        set str.buf@(str.str_end) = 0
        set str.remaining = str.remaining - 1
    } else {
        strbuild_fatal_too_small(str)
    }
}

;; Print text at the end of the current string.
func strbuild_catf (str, fmt, ...) {
    val s = string.format(fmt, ...)
    val bytes_added = #s
    if bytes_added >= str.remaining {
        ;; Truncated
        strbuild_fatal_too_small(str)
    }
    loop i in bytes_added {
        set str.buf@(str.str_end + i) = string.byte(s, i)
    }
    set str.buf@(str.str_end + bytes_added) = 0
    set str.str_end = str.str_end + bytes_added
    set str.remaining = str.remaining - bytes_added
}
