;; ---------------------------------------------------------------------------

;; The `goto out` of C: the index of the first entry of `tbl` (of `n`) that
;; is above `slope`, or `nil` if none.
func calc_angle_find (tbl, n, slope) {
    loop i in n {
        if slope < tbl@(i) {
            return i
        }
    }
    nil
}

;; dx and dy are `unsigned int` in C: here they are never negative.
func calc_angle_do (dx, dy) {
    if dx == 0 {
        return 90
    }
    val slope = (dy << 8) // dx
    if slope < 0x100 {
        if slope >= 0x67 {
            val i = calc_angle_find(tbl_math_tan_22, 0x17, slope)
            if i == nil => 44 - 1 => (22 + i) - 1
        } else {
            val i = calc_angle_find(tbl_math_tan_0, 0x16, slope)
            if i == nil => 22 - 1 => i - 1
        }
    } else {
        if slope >= 0x258 {
            val i = calc_angle_find(tbl_math_tan_67, 0x17, slope)
            if i == nil => 90 => (i - 1) + 67
        } else {
            val i = calc_angle_find(tbl_math_tan_45, 0x16, slope)
            if i == nil => 66 => (i - 1) + 45
        }
    }
}

func util_math_route_step_len (adx, ady) {
    val v = adx + ady
    if v != 0 => (v + 1) => 3
}

;; ---------------------------------------------------------------------------

func util_math_calc_angle (dx, dy) {
    if dx >= 0 {
        if dy >= 0 {
            calc_angle_do(dx, dy)
        } else {
            360 - calc_angle_do(dx, -dy)
        }
    } else {
        if dy >= 0 {
            180 - calc_angle_do(-dx, dy)
        } else {
            180 + calc_angle_do(-dx, -dy)
        }
    }
}

func util_math_angle_dist_cos (angle0, dist) {
    var angle = angle0
    var res = 0
    var negate = false
    ifs {
        angle < 91 => {}
        angle < 181 => {
            set angle = 180 - angle
            set negate = true
        }
        angle < 271 => {
            set angle = angle - 180
            set negate = true
        }
        else => {
            set angle = 360 - angle
        }
    }
    if angle == 0 {
        set res = dist
    } else {
        set res = (dist * tbl_math_cos@(angle - 1)) // 0x10000
    }
    if negate {
        set res = -res
    }
    res
}

func util_math_angle_dist_sin (angle0, dist) {
    var angle = angle0
    var res = 0
    var negate = false
    ifs {
        angle < 91 => {}
        angle < 181 => {
            set angle = 180 - angle
        }
        angle < 271 => {
            set angle = angle - 180
            set negate = true
        }
        else => {
            set angle = 360 - angle
            set negate = true
        }
    }
    if angle == 90 {
        set res = dist
    } else {
        set res = (dist * tbl_math_sin@(angle)) // 0x10000
    }
    if negate {
        set res = -res
    }
    res
}

;; C moves the point through two pointers: here, it returns the new point.
func util_math_go_line_dist (x0, y0, x1, y1, dist) {
    if dist <= 0 {
        return x0, y0
    }
    var x = x0
    var y = y0
    if (x == x1) && (y == y1) {
        return x0, y0
    }
    var dx = x1 - x
    var dy = y1 - y
    if (math.abs(dx) > 0xff) || (math.abs(dy) > 0xff) {
        set dx = dx // 2
        set dy = dy // 2
    }
    val angle = util_math_calc_angle(dx, dy)
    set x = x + util_math_angle_dist_cos(angle, dist)
    if dx >= 0 {
        if x > x1 {
            set x = x1
        }
    } else {
        if x < x1 {
            set x = x1
        }
    }
    set y = y + util_math_angle_dist_sin(angle, dist)
    if dy >= 0 {
        if y > y1 {
            set y = y1
        }
    } else {
        if y < y1 {
            set y = y1
        }
    }
    return x, y
}

func util_math_dist_steps (x0, y0, x1, y1) {
    var x = x0
    var y = y0
    var num = 0
    loop {
        while (x != x1) || (y != y1)
        set x, y = util_math_go_line_dist(x, y, x1, y1, 5)
        if (x != x1) || (y != y1) {
            set x, y = util_math_go_line_dist(x, y, x1, y1, 6)
        }
        set num = num + 1
    }
    num
}

func util_math_dist_fast (x0, y0, x1, y1) {
    val dx = math.abs(x1 - x0)
    val dy = math.abs(y1 - y0)
    if dx > dy => (dx + (dy // 2)) => (dy + (dx // 2))
}

func util_math_dist_maxabs (x0, y0, x1, y1) {
    val dx = math.abs(x1 - x0)
    val dy = math.abs(y1 - y0)
    if dx > dy => dx => dy
}

;; `tblx` and `tbly` are vectors that receive the points.
func util_math_line_plot (x0i, y0i, x1, y1, tblx, tbly) {
    var x0 = x0i
    var y0 = y0i
    var len = 0
    var zerr = 0x8000
    var dx = x1 - x0
    var dirx = 1
    if dx < 0 {
        set dx = -dx
        set dirx = -1
    }
    var dy = y1 - y0
    var diry = 1
    if dy < 0 {
        set dy = -dy
        set diry = -1
    }
    ifs {
        dx < dy => {
            val slope = (dx << 16) // dy
            loop {
                while len < dy
                set y0 = y0 + diry
                set zerr = zerr + slope
                if zerr >= 0x10000 {
                    set x0 = x0 + dirx
                }
                set zerr = zerr & 0xffff
                set tblx@(len) = x0
                set tbly@(len) = y0
                set len = len + 1
            }
        }
        dy < dx => {
            val slope = (dy << 16) // dx
            loop {
                while len < dx
                set x0 = x0 + dirx
                set zerr = zerr + slope
                if zerr >= 0x10000 {
                    set y0 = y0 + diry
                }
                set zerr = zerr & 0xffff
                set tblx@(len) = x0
                set tbly@(len) = y0
                set len = len + 1
            }
        }
        else => {
            loop {
                while len < dy
                set x0 = x0 + dirx
                set y0 = y0 + diry
                set tblx@(len) = x0
                set tbly@(len) = y0
                set len = len + 1
            }
        }
    }
    len
}

func util_math_get_route_len (x0, y0, tblx, tbly, len) {
    var l = util_math_route_step_len(math.abs(x0 - tblx@0), math.abs(y0 - tbly@0))
    loop i in (1, len - 1) {
        set l = l + util_math_route_step_len(math.abs(tblx@(i - 1) - tblx@(i)), math.abs(tbly@(i - 1) - tbly@(i)))
    }
    l
}
