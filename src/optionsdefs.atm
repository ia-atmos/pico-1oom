;; The part of c/src/options.c (and options.h) that the other modules use:
;; the global options, the handlers of options (`options_*_var`) and the
;; constructor of an option (struct cmdline_options_s: `str`, `num_param`,
;; `handle`, `var`, `str_param`, `str_help`). In C `var` points to the
;; variable; here it is `[tbl=..., key=...]`, the field of a table, or `nil`.

include "log.atm"

;; ---------------------------------------------------------------------------
;; The options of options.c, as the fields of one table `opt` (opt_X of C
;; is opt.X); FEATURE_MODEBUG and HAVE_SAMPLERATE are off in the build.

pin opt = [
    ;; local options of options.c
    logfilename_in = nil,
    configfilename_in = nil,    ;; used only for the -c option
    configfilename = nil,
    config_ro = false,
    datapath = nil,
    default = false,
    ;; global options
    audio_enabled = true,
    music_enabled = true,
    sfx_enabled = true,
    sfx_init_parallel = true,
    music_volume = 64,
    sfx_volume = 100,
    audiorate = 48000,
    audioslice_ms = 50,
    cfg_reset = false,
]

;; `atoi` of C: blanks, a sign, the digits, up to the first other char.
func opt_atoi (s) {
    var i = 0
    loop {
        while (i < #s) && ((string.byte(s, i) == 32) || ((string.byte(s, i) >= 9) && (string.byte(s, i) <= 13)))
        set i = i + 1
    }
    var neg = false
    if (i < #s) && ((string.byte(s, i) == 43) || (string.byte(s, i) == 45)) {
        set neg = string.byte(s, i) == 45
        set i = i + 1
    }
    var v = 0
    loop {
        while (i < #s) && (string.byte(s, i) >= 48) && (string.byte(s, i) <= 57)
        set v = (v * 10) + (string.byte(s, i) - 48)
        set i = i + 1
    }
    i32(if neg => -v => v)
}

func options_enable_int_var (argv, var_) {
    set var_.tbl@(var_.key) = 1
    0
}

func options_disable_int_var (argv, var_) {
    set var_.tbl@(var_.key) = 0
    0
}

func options_set_int_var (argv, var_) {
    set var_.tbl@(var_.key) = opt_atoi(argv@(1))
    0
}

func options_set_str_var (argv, var_) {
    set var_.tbl@(var_.key) = argv@(1)
    0
}

func options_unset_str_var (argv, var_) {
    set var_.tbl@(var_.key) = nil
    0
}

func options_empty_str_var (argv, var_) {
    set var_.tbl@(var_.key) = ""
    0
}

func options_enable_bool_var (argv, var_) {
    set var_.tbl@(var_.key) = true
    0
}

func options_disable_bool_var (argv, var_) {
    set var_.tbl@(var_.key) = false
    0
}

func options_notimpl (argv, var_) {
    log_error("option '%s' is not implemented (yet)", argv@(0))
    return -1
}

func options_nop (argv, var_) {
    0
}

func OPT (str, num_param, handle, var_, str_param, str_help) {
    [ str = str, num_param = num_param, handle = handle, var = var_,
      str_param = str_param, str_help = str_help ]
}

