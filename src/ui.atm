;; Port of c/src/ui.h: what the logic calls of the interface. In C each
;; interface (classic, cmdline, nop) defines these functions; here each one is
;; a `var` that an interface sets to its own function (`set ui_turn_msg =
;; func (g, pi, str) { ... }`). Until it is set, a call throws. Only the
;; functions that the ported logic calls so far are here.

include "ctypes.atm"

val UI_STRBUF_SIZE = 1024

;; Not set by an interface: what C would do with no interface (a link error).
func ui_not_set (name) {
    throw "ui: " ++ name ++ " is not set by an interface"
}

;; The buffer of `ui_get_strbuf`, as every interface of 1oom has it.
pin ui_strbuf = carray(UI_STRBUF_SIZE)  ;; char[]
var ui_get_strbuf = func () { ui_strbuf }

var ui_explore = func (g, pi, planet_i, by_scanner, flag_colony_ship) { ui_not_set("ui_explore") }
var ui_landing = func (g, pi, planet_i) { ui_not_set("ui_landing") }
var ui_turn_msg = func (g, pi, str) { ui_not_set("ui_turn_msg") }
var ui_turn_pre = func (g) { ui_not_set("ui_turn_pre") }

;; The copy protection (`ge` is a `struct game_end_s`).
var ui_copyprotection_check = func (g) { ui_not_set("ui_copyprotection_check") }
var ui_copyprotection_lose = func (g, ge) { ui_not_set("ui_copyprotection_lose") }

;; The map while the ships move (`ctx` is what `ui_gmap_basic_init` gives).
var ui_gmap_basic_init = func (g, show_player_switch) { ui_not_set("ui_gmap_basic_init") }
var ui_gmap_basic_start_player = func (ctx, pi) { ui_not_set("ui_gmap_basic_start_player") }
var ui_gmap_basic_start_frame = func (ctx, pi) { ui_not_set("ui_gmap_basic_start_frame") }
var ui_gmap_basic_draw_frame = func (ctx, pi) { ui_not_set("ui_gmap_basic_draw_frame") }
var ui_gmap_basic_finish_frame = func (ctx, pi) { ui_not_set("ui_gmap_basic_finish_frame") }
var ui_gmap_basic_shutdown = func (ctx) { ui_not_set("ui_gmap_basic_shutdown") }

var ui_newtech = func (g, pi) { ui_not_set("ui_newtech") }
var ui_newships = func (g, pi) { ui_not_set("ui_newships") }

;; The spies. `ui_spy_sabotage_ask` gives the action and the planet (the
;; `uint8_t *planetptr` of C).
val UI_SABOTAGE_FACT = 0
val UI_SABOTAGE_BASES = 1
val UI_SABOTAGE_REVOLT = 2
val UI_SABOTAGE_NONE = 3
var ui_spy_steal = func (g, spy, target, flags_field) { ui_not_set("ui_spy_steal") }
var ui_spy_stolen = func (g, pi, spy, field, tech) { ui_not_set("ui_spy_stolen") }
var ui_spy_sabotage_ask = func (g, spy, target) { ui_not_set("ui_spy_sabotage_ask") }
var ui_spy_sabotage_done = func (g, pi, spy, target, act, other1, other2, planet, snum) { ui_not_set("ui_spy_sabotage_done") }

;; The bombing of planets.
var ui_bomb_ask = func (g, pi, planet_i, pop_inbound) { ui_not_set("ui_bomb_ask") }
var ui_bomb_show = func (g, pi, attacker_i, owner_i, planet_i, popdmg, factdmg, play_music, hide_other) { ui_not_set("ui_bomb_show") }

;; The ground combat (`gr` is a `struct ground_s`).
var ui_ground = func (g, gr) { ui_not_set("ui_ground") }

;; The election (`el` is a `struct election_s`).
var ui_election_start = func (el) { ui_not_set("ui_election_start") }
var ui_election_show = func (el) { ui_not_set("ui_election_show") }
var ui_election_delay = func (el, delay) { ui_not_set("ui_election_delay") }
var ui_election_vote = func (el, player_i) { ui_not_set("ui_election_vote") }
var ui_election_accept = func (el, player_i) { ui_not_set("ui_election_accept") }
var ui_election_end = func (el) { ui_not_set("ui_election_end") }

;; The news (`ns` is a `struct news_s`).
var ui_news_start = func () { ui_not_set("ui_news_start") }
var ui_news = func (g, ns) { ui_not_set("ui_news") }
var ui_news_end = func () { ui_not_set("ui_news_end") }

;; The audiences (`au` is a `struct audience_s`). The `ask` functions give
;; the index of the option chosen, or -1.
var ui_audience_start = func (au) { ui_not_set("ui_audience_start") }
var ui_audience_show1 = func (au) { ui_not_set("ui_audience_show1") }
var ui_audience_show2 = func (au) { ui_not_set("ui_audience_show2") }
var ui_audience_show3 = func (au) { ui_not_set("ui_audience_show3") }
var ui_audience_ask2a = func (au) { ui_not_set("ui_audience_ask2a") }
var ui_audience_ask2b = func (au) { ui_not_set("ui_audience_ask2b") }
var ui_audience_ask3 = func (au) { ui_not_set("ui_audience_ask3") }
var ui_audience_ask4 = func (au) { ui_not_set("ui_audience_ask4") }
var ui_audience_newtech = func (au, pi) { ui_not_set("ui_audience_newtech") }
var ui_audience_end = func (au) { ui_not_set("ui_audience_end") }

;; The pictures of ships, planets and rocks (an interface gives what it
;; draws them with; the logic only keeps it).
var ui_gfx_get_ship = func (look) { ui_not_set("ui_gfx_get_ship") }
var ui_gfx_get_planet = func (look) { ui_not_set("ui_gfx_get_planet") }
var ui_gfx_get_rock = func (look) { ui_not_set("ui_gfx_get_rock") }

