;; Port of c/src/cfg.c (and cfg.h): the configuration file, written as a
;; table of Atmos (see below).
;;
;; In C an item points to its variable (`void *var`); here an item has
;; `get` and `put`, the functions that read and write the variable. An array
;; of items ends with `CFG_ITEM_END` in C; here it is a vector, and the end
;; is its length. `cfg_items_tbl` lists the modules: its tables are
;; defined by options.atm, game_main.atm, hwnop.atm and uicmdline.atm, which
;; the program includes before this file.

include "lib.atm"
include "log.atm"
include "util.atm"
include "os/unix/os.atm"
include "os/unix/osdefs.atm"
include "cfgdefs.atm"

;; The modules: `cond` is the flag that enables the module (`bool const *`
;; in C), as a function; `nil` if always.
pin cfg_items_tbl = [
    [ str = "opt", items = opt_cfg_items, cond = nil ],
    [ str = "opta", items = opt_cfg_items_audio, cond = \{ ui_use_audio } ],
    [ str = "game", items = game_cfg_items, cond = nil ],
    [ str = "hw", items = hw_cfg_items, cond = nil ],
    [ str = "hwx", items = hw_cfg_items_extra, cond = nil ],
    [ str = "ui", items = ui_cfg_items, cond = nil ],
]

;; ---------------------------------------------------------------------------
;; The file is a table of Atmos (by decision of the author, 2026-11-26: the
;; file is external, and the logic is not changed), read with `X.load`, in
;; place of the lines `module.item = value` of C:
;;
;;   ;; 1oom configuration file
;;   [
;;       opt = [
;;           data_path = "/home/user/moo-data",
;;       ],
;;       game = [
;;           undo = true,
;;           ...
;;       ],
;;   ]
;;
;; The modules and the items are applied in the order of the file, as C
;; applies the lines; an error stops there, as in C. Differences: a text
;; that is not a valid table applies nothing (C applies the lines before
;; the bad one), a string item set to `nil` is the same as one absent
;; (C sets it to NULL), and the messages name the item, not the line.

func cfg_find_module (name) {
    loop _, m in cfg_items_tbl {
        if (m.str == name) && ((m.cond == nil) || m.cond()) {
            return m
        }
    }
    nil
}

func cfg_find_item (items, name) {
    loop _, i in items {
        if (i.type != CFG_TYPE_COMMENT) && (i.name == name) {
            return i
        }
    }
    nil
}

;; One item of the file: 0, or -1 if invalid.
func cfg_apply_item (mname, it, iname, v) {
    match it.type {
        CFG_TYPE_INT => {
            if (type(v) != "number") || (v != math.floor(v)) {
                log_error("Cfg: invalid value of '%s.%s'\n", mname, iname)
                return -1
            }
            val n = i32(v)
            if (it.check != nil) && !it.check(n) {
                log_warning("Cfg: item '%s.%s' failed check\n", mname, iname)
                return -1
            }
            set it.tbl@(it.key) = n
        }
        CFG_TYPE_STR => {
            if type(v) != "string" {
                log_error("Cfg: invalid value of '%s.%s'\n", mname, iname)
                return -1
            }
            if (it.check != nil) && !it.check(v) {
                log_warning("Cfg: item '%s.%s' failed check\n", mname, iname)
                return -1
            }
            set it.tbl@(it.key) = v
        }
        CFG_TYPE_BOOL => {
            if type(v) != "boolean" {
                log_error("Cfg: invalid value of '%s.%s'\n", mname, iname)
                return -1
            }
            set it.tbl@(it.key) = v
        }
        else => nil
    }
    0
}

;; ---------------------------------------------------------------------------

func cfg_cfgname () {
    val path = os_get_path_user()
    var name = os_get_fname_cfg(idstr_main, idstr_ui, idstr_hw)
    if name == nil {
        set name = string.format("1oom_config_%s_%s_%s.atm", idstr_main, idstr_ui, idstr_hw)
    }
    util_concat(path, FSDEV_DIR_SEP_STR, name)
}

func cfg_load (filename) {
    log_message("Cfg: loading configuration from '%s'\n", filename)
    pin fd = io.open(filename, "r")
    if !fd {
        log_error("Cfg: failed to open file '%s'\n", filename)
        return -1
    }
    val text = io.read(fd, :all)
    io.close(fd)
    val ok, tbl = catch true {
        X.load(text)
    }
    if !ok {
        log_error("Cfg: invalid file '%s': %s\n", filename, tostring(tbl))
        return -1
    }
    if type(tbl) != "table" {
        log_error("Cfg: invalid file '%s': not a table\n", filename)
        return -1
    }
    loop mname, mv in tbl {
        var m = cfg_find_module(mname)
        if m == nil {
            log_error("Cfg: unknown module '%s'\n", tostring(mname))
            return -1
        }
        if type(mv) != "table" {
            log_error("Cfg: invalid module '%s'\n", mname)
            return -1
        }
        loop iname, v in mv {
            var it = cfg_find_item(m.items, iname)
            if (it == nil) && (m.items == opt_cfg_items) {
                ;; HACK handle audio option opt -> opta move (as C)
                set it = cfg_find_item(opt_cfg_items_audio, iname)
            }
            if it == nil {
                log_warning("Cfg: ignoring unknown item '%s.%s'\n", mname, tostring(iname))
            } else {
                if cfg_apply_item(mname, it, iname, v) < 0 {
                    return -1
                }
            }
        }
    }
    0
}

func cfg_clear (filename) {
    if os_make_path_for(filename) != 0 {
        log_error("Cfg: failed to create path for '%s'\n", filename)
        return -1
    }
    pin fd = io.open(filename, "w")
    if !fd {
        log_error("Cfg: failed to create file '%s'\n", filename)
        return -1
    }
    io.close(fd)
    0
}

func cfg_str_out (s) {
    val cs = ["\""]
    loop k in #s {
        val c = string.byte(s, k)
        set cs@+ = ifs {
            c == 92 => "\\\\"
            c == 34 => "\\\""
            c == 10 => "\\n"
            c == 9 => "\\t"
            (c < 32) || (c == 127) => string.format("\\x%02x", c)
            else => string.char(c)
        }
    }
    set cs@+ = "\""
    string.join(cs, "")
}

func cfg_save (filename) {
    if opt.cfg_reset {
        return cfg_clear(filename)
    }
    log_message("Cfg: saving configuration to '%s'\n", filename)
    if os_make_path_for(filename) != 0 {
        log_error("Cfg: failed to create path for '%s'\n", filename)
        return -1
    }
    pin fd = io.open(filename, "w+")
    if !fd {
        log_error("Cfg: failed to create file '%s'\n", filename)
        return -1
    }
    io.write(fd, ";; 1oom configuration file\n[\n")
    loop _, module in cfg_items_tbl {
        if ((module.cond == nil) || module.cond()) && (#module.items > 0) {
            io.write(fd, string.format("    %s = [\n", module.str))
            loop _, item in module.items {
                match item.type {
                    CFG_TYPE_INT => {
                        io.write(fd, string.format("        %s = %i,\n", item.name, item.tbl@(item.key)))
                    }
                    CFG_TYPE_STR => {
                        val v = item.tbl@(item.key)
                        io.write(fd, string.format("        %s = %s,\n", item.name, if v != nil => cfg_str_out(v) => "nil"))
                    }
                    CFG_TYPE_BOOL => {
                        io.write(fd, string.format("        %s = %s,\n", item.name, if item.tbl@(item.key) => "true" => "false"))
                    }
                    CFG_TYPE_COMMENT => {
                        io.write(fd, string.format("        ;; %s\n", item.name))
                    }
                }
            }
            io.write(fd, "    ],\n")
        }
    }
    io.write(fd, "]\n")
    io.close(fd)
    0
}
