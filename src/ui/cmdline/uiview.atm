;; Port of c/src/ui/cmdline/uiview.c.

include "../../boolvec.atm"
include "../../util_math.atm"
include "../../game/game.atm"
include "../../game/game_misc.atm"
include "uidefs.atm"
include "uifleet.atm"
include "uiinput.atm"
include "uiplanet.atm"

val UI_VIEW_FILTER_PLANET = 1 << 0
val UI_VIEW_FILTER_FLEET = 1 << 1
val UI_VIEW_FILTER_TRANS = 1 << 2
val UI_VIEW_FILTER_MY = 1 << 3
val UI_VIEW_FILTER_OPP = 1 << 4
val UI_VIEW_FILTER_UNEX = 1 << 5
val UI_VIEW_FILTER_EX = 1 << 6
val UI_VIEW_FILTER_UNCOLON = 1 << 7
val UI_VIEW_FILTER_COLON = 1 << 8
val UI_VIEW_FILTER_ALL = (1 << 9) - 1

pin ui_view_filter = [
    [ c = "p", m1 = UI_VIEW_FILTER_PLANET, m0 = 0 ],
    [ c = "f", m1 = UI_VIEW_FILTER_FLEET, m0 = 0 ],
    [ c = "t", m1 = UI_VIEW_FILTER_TRANS, m0 = 0 ],
    [ c = "y", m1 = UI_VIEW_FILTER_MY | UI_VIEW_FILTER_COLON | UI_VIEW_FILTER_EX, m0 = UI_VIEW_FILTER_OPP | UI_VIEW_FILTER_UNCOLON | UI_VIEW_FILTER_UNEX ],
    [ c = "o", m1 = UI_VIEW_FILTER_OPP | UI_VIEW_FILTER_COLON | UI_VIEW_FILTER_EX, m0 = UI_VIEW_FILTER_MY | UI_VIEW_FILTER_UNCOLON | UI_VIEW_FILTER_UNEX ],
    [ c = "u", m1 = UI_VIEW_FILTER_UNEX | UI_VIEW_FILTER_PLANET, m0 = UI_VIEW_FILTER_EX ],
    [ c = "x", m1 = UI_VIEW_FILTER_EX | UI_VIEW_FILTER_PLANET, m0 = UI_VIEW_FILTER_UNEX ],
    [ c = "n", m1 = UI_VIEW_FILTER_UNCOLON | UI_VIEW_FILTER_PLANET, m0 = UI_VIEW_FILTER_COLON ],
    [ c = "c", m1 = UI_VIEW_FILTER_COLON | UI_VIEW_FILTER_PLANET, m0 = UI_VIEW_FILTER_UNCOLON ],
]

func ui_cmd_view_add (range, dist, i, type, num) {
    set ui_data.view.item@(num) = u32((dist << 24) | (type << 22) | i)
    num + 1
}

func ui_cmd_view_display (g, api, item, filter) {
    val dist = item >> 24
    val type = (item >> 22) & 3
    val i = item & 0xfff
    io.write(string.format("Dist %2i: ", dist))
    match type {
        0 => ui_fleet_print_transport_enroute(g, api, i)
        1 => ui_fleet_print_fleet_enroute(g, api, i, PLANET_NONE)
        2 => ui_planet_look(g, api, i, false)
        3 => ui_fleet_print_fleets_orbit(g, api, i, (filter & UI_VIEW_FILTER_MY) != 0, (filter & UI_VIEW_FILTER_OPP) != 0)
        else => nil
    }
}

func ui_cmd_view_do (g, api, filter, rangemax, distmax) {
    val planet_i = g.planet_focus_i@(api)
    val p0 = g.planet@(planet_i)
    var num = 0
    val cx = p0.x
    val cy = p0.y
    if (filter & UI_VIEW_FILTER_PLANET) != 0 {
        loop i in g.galaxy_stars {
            val p = g.planet@(i)
            var ok = true
            if BOOLVEC_IS0(p.explored, api) {
                if (filter & UI_VIEW_FILTER_UNEX) == 0 {
                    set ok = false
                }
            } else {
                if (filter & UI_VIEW_FILTER_EX) == 0 {
                    set ok = false
                }
            }
            if ok {
                var owner = p.owner
                if BOOLVEC_IS0(p.within_srange, api) && ((owner == PLAYER_NONE) || BOOLVEC_IS0(g.eto@(api).contact, owner)) {
                    set owner = g.seen@(api)@(i).owner
                }
                if owner == PLAYER_NONE {
                    if (filter & UI_VIEW_FILTER_UNCOLON) == 0 {
                        set ok = false
                    }
                } else {
                    if (filter & UI_VIEW_FILTER_COLON) == 0 {
                        set ok = false
                    } else {
                        if p.owner == api {
                            if (filter & UI_VIEW_FILTER_MY) == 0 {
                                set ok = false
                            }
                        } else {
                            if (filter & UI_VIEW_FILTER_OPP) == 0 {
                                set ok = false
                            }
                        }
                    }
                }
            }
            if ok {
                val dist = g.gaux.star_dist@(planet_i)@(i)
                if (distmax >= 0) && (dist > distmax) {
                    set ok = false
                }
                if ok {
                    val range = game_get_min_dist(g, api, i)
                    if (rangemax < 0) || (range <= rangemax) {
                        set num = ui_cmd_view_add(range, dist, i, 2, num)   ;; planet
                    }
                }
            }
        }
    }
    if (filter & UI_VIEW_FILTER_FLEET) != 0 {
        loop i in g.enroute_num {
            val r = g.enroute@(i)
            if BOOLVEC_IS1(r.visible, api) {
                val mine = r.owner == api
                if (mine && ((filter & UI_VIEW_FILTER_MY) != 0)) || ((!mine) && ((filter & UI_VIEW_FILTER_OPP) != 0)) {
                    val dist = util_math_dist_steps(cx, cy, r.x, r.y)
                    if (distmax < 0) || (dist <= distmax) {
                        set num = ui_cmd_view_add(0, dist, i, 1, num)   ;; fleet
                    }
                }
            }
        }
    }
    if (filter & (UI_VIEW_FILTER_FLEET | UI_VIEW_FILTER_PLANET)) == UI_VIEW_FILTER_FLEET {
        loop i in g.galaxy_stars {
            val dist = g.gaux.star_dist@(planet_i)@(i)
            if (distmax < 0) || (dist <= distmax) {
                var got_fleet = false
                loop j in g.players {
                    val r = g.eto@(j).orbit@(i)
                    if BOOLVEC_IS1(r.visible, api) {
                        if j == api {
                            if (filter & UI_VIEW_FILTER_MY) != 0 {
                                set got_fleet = true
                                break
                            }
                        } else {
                            if (filter & UI_VIEW_FILTER_OPP) != 0 {
                                set got_fleet = true
                                break
                            }
                        }
                    }
                }
                if got_fleet {
                    val range = game_get_min_dist(g, api, planet_i)
                    if (rangemax < 0) || (range <= rangemax) {
                        set num = ui_cmd_view_add(range, dist, i, 3, num)   ;; orbit
                    }
                }
            }
        }
    }
    if (filter & UI_VIEW_FILTER_TRANS) != 0 {
        loop i in g.transport_num {
            val r = g.transport@(i)
            if BOOLVEC_IS1(r.visible, api) {
                val mine = r.owner == api
                if (mine && ((filter & UI_VIEW_FILTER_MY) != 0)) || ((!mine) && ((filter & UI_VIEW_FILTER_OPP) != 0)) {
                    val dist = util_math_dist_steps(cx, cy, r.x, r.y)
                    if (distmax < 0) || (dist <= distmax) {
                        set num = ui_cmd_view_add(0, dist, i, 0, num)   ;; transport
                    }
                }
            }
        }
    }
    ;; (C: qsort with `return v0 < v1`, never negative; the merge sort of
    ;; glibc 2.39 gives a stable descending order, and the items differ)
    pin items = []
    loop k in num {
        set items@(k) = ui_data.view.item@(k)
    }
    loop a in num {
        loop b in num - 1 - a {
            if items@(b) < items@(b + 1) {
                val t = items@(b)
                set items@(b) = items@(b + 1)
                set items@(b + 1) = t
            }
        }
    }
    loop k in num {
        set ui_data.view.item@(k) = items@(k)
        ui_cmd_view_display(g, api, items@(k), filter)
    }
}

;; ---------------------------------------------------------------------------

func ui_cmd_view (g, api, param, num_param, var_) {
    var filter = UI_VIEW_FILTER_ALL
    var range = -1
    var dist = -1
    loop i in num_param {
        ifs {
            param@(i).type == INPUT_TOKEN_NUMBER => { set range = param@(i).data }
            param@(i).type == INPUT_TOKEN_RELNUMBER => { set dist = param@(i).data }
            else => {
                set filter = 0
                val str = param@(i).str
                loop k in #str {
                    val c = c_tolower(string.byte(str, k))
                    var f = nil
                    loop j in #ui_view_filter {
                        if string.byte(ui_view_filter@(j).c, 0) == c {
                            set f = ui_view_filter@(j)
                            break
                        }
                    }
                    if f == nil {
                        io.write(string.format("Invalid filter '%c'\n", c))
                        return -1
                    }
                    set filter = filter | f.m1
                    if f.m0 != 0 {
                        set filter = filter & (~f.m0)
                    }
                }
                if (filter & (UI_VIEW_FILTER_PLANET | UI_VIEW_FILTER_FLEET | UI_VIEW_FILTER_TRANS)) == 0 {
                    set filter = filter | UI_VIEW_FILTER_PLANET | UI_VIEW_FILTER_FLEET | UI_VIEW_FILTER_TRANS
                }
                if (filter & (UI_VIEW_FILTER_MY | UI_VIEW_FILTER_OPP)) == 0 {
                    set filter = filter | UI_VIEW_FILTER_MY | UI_VIEW_FILTER_OPP
                }
                if (filter & (UI_VIEW_FILTER_EX | UI_VIEW_FILTER_UNEX)) == 0 {
                    set filter = filter | UI_VIEW_FILTER_EX | UI_VIEW_FILTER_UNEX
                }
                if (filter & (UI_VIEW_FILTER_COLON | UI_VIEW_FILTER_UNCOLON)) == 0 {
                    set filter = filter | UI_VIEW_FILTER_COLON | UI_VIEW_FILTER_UNCOLON
                }
            }
        }
    }
    ui_cmd_view_do(g, api, filter, range, dist)
    0
}
