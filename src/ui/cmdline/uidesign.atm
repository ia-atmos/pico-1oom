pin cmds_design = [
    input_cmd_s("?", nil, "Help", 0, 0, 0, ui_cmd_help, nil),
    input_cmd_s("q", nil, "Cancel", 0, 0, 0, cmd_design_exit, 1),     ;; cancel
    input_cmd_s("b", nil, "Build", 0, 0, 0, cmd_design_exit, 2),      ;; ok
    input_cmd_s("l", nil, "Look", 0, 0, 0, cmd_design_look, 0),
    input_cmd_s("clear", nil, "Clear", 0, 0, 0, cmd_design_clear, 0),
    input_cmd_s("c", nil, "Computer", 0, 0, 0, cmd_sel_comp, 0),
    input_cmd_s("s", nil, "Shield", 0, 0, 0, cmd_sel_shield, 0),
    input_cmd_s("j", nil, "Ecm", 0, 0, 0, cmd_sel_jammer, 0),
    input_cmd_s("a", nil, "Armor", 0, 0, 0, cmd_sel_armor, 0),
    input_cmd_s("e", nil, "Engine", 0, 0, 0, cmd_sel_engine, 0),
    input_cmd_s("m", nil, "Maneuver", 0, 0, 0, cmd_sel_man, 0),
    input_cmd_s("w1", nil, "Weapon 1 type", 0, 0, 0, cmd_sel_wpnt1, 0),
    input_cmd_s("w2", nil, "Weapon 2 type", 0, 0, 0, cmd_sel_wpnt2, 0),
    input_cmd_s("w3", nil, "Weapon 3 type", 0, 0, 0, cmd_sel_wpnt3, 0),
    input_cmd_s("w4", nil, "Weapon 4 type", 0, 0, 0, cmd_sel_wpnt4, 0),
    input_cmd_s("a1", "NUM", "Weapon 1 amount", 1, 1, 0, cmd_set_wpnn1, 0),
    input_cmd_s("a2", "NUM", "Weapon 2 amount", 1, 1, 0, cmd_set_wpnn2, 0),
    input_cmd_s("a3", "NUM", "Weapon 3 amount", 1, 1, 0, cmd_set_wpnn3, 0),
    input_cmd_s("a4", "NUM", "Weapon 4 amount\nNUM can be +N or -N for relative adjustment", 1, 1, 0, cmd_set_wpnn4, 0),
    input_cmd_s("s1", nil, "Special 1", 0, 0, 0, cmd_sel_spec1, 0),
    input_cmd_s("s2", nil, "Special 2", 0, 0, 0, cmd_sel_spec2, 0),
    input_cmd_s("s3", nil, "Special 3", 0, 0, 0, cmd_sel_spec3, 0),
    input_cmd_s("h", nil, "Ship size", 0, 0, 0, cmd_sel_hull, 0),
    input_cmd_s("n", "[NAME]", "Name", 0, 1, 0, cmd_set_name, 0),
    input_cmd_s(nil, nil, nil, 0, 0, 0, nil, 0),
]
pin cmdsptr_design = [ cmds_design, nil ]
set cmds_design@(0).var_ = cmdsptr_design

func ui_design (g, gd, pi) {
    pin d = design_data_s()
    val sd = gd.sd
    set d.g = g
    set d.gd = gd
    set d.api = pi
    game_design_init_maxtech_haveflags(d)
    lib_strcpy(sd.name, gd.names@(sd.hull), SHIP_NAME_LEN)
    cmd_design_look(g, pi, nil, 0, d)
    loop {
        val input = ui_input_line("Ship design > ")
        if (ui_input_tokenize(input, cmdsptr_design) == 0) && (ui_data.input.num > 0) {
            if ui_data.input.tok@(0).type == INPUT_TOKEN_COMMAND {
                val cmd = ui_data.input.tok@(0).data
                val var_ = if (cmd.var_ != 0) && (cmd.var_ != nil) => cmd.var_ => d
                val v = cmd.handle(g, pi, ui_input_params(), ui_data.input.num - 1, var_)
                if cmd.handle == cmd_design_exit {
                    return v == 2   ;; ok
                } else {
                    if cmd.handle != ui_cmd_help {
                        game_design_update_engines(sd)
                        game_design_update_haveflags(d)
                        cmd_design_look(g, pi, nil, 0, d)
                    }
                }
            }
        }
    }
}

;; ---------------------------------------------------------------------------

func ui_cmd_design (g, api, param, num_param, var_) {
    pin gd = game_design_s()
    var sd_num = g.eto@(api).shipdesigns_num
    game_design_prepare(g, gd, api, g.current_design@(api))
    var ok = ui_design(g, gd, api)
    if ok && (sd_num == NUM_SHIPDESIGNS) {
        ui_cmd_fleet_specs(g, api, nil, 0, nil)
        ui_cmd_fleet_scrap(g, api, nil, 0, 0)
        set sd_num = g.eto@(api).shipdesigns_num
        set ok = sd_num < NUM_SHIPDESIGNS
        if ok {
            game_design_look_fix(g, api, gd.sd)
        }
    }
    if ok {
        game_design_add(g, api, gd.sd, true)
    }
    cstruct_copy(g.current_design@(api), gd.sd)
    0
}
