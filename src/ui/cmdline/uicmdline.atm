set ui_turn_msg = func (g, pi, str) {
    io.write(string.format("%s | %i | Message: %s\n", cstr(g.emperor_names@(pi)), g.year + YEAR_BASE, cstr(str)))
}

set ui_copyprotection_check = func (g) {
    set copyprot_status = -99
}

set ui_copyprotection_lose = func (g, ge) {
}

set ui_newships = func (g, pi) {
    var first = true
    io.write(string.format("%s | %i | New ships:", cstr(g.emperor_names@(pi)), g.year + YEAR_BASE))
    loop i in NUM_SHIPDESIGNS {
        val n = g.evn.new_ships@(pi)@(i)
        if n != 0 {
            val sd = g.srd@(pi).design@(i)
            if !first {
                io.write(",")
            } else {
                set first = false
            }
            io.write(string.format(" %i * %s", n, cstr(sd.name)))
        }
    }
    io.write("\n")
}

