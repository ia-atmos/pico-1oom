set ui_battle_draw_repulse = func (bt, attacker_i, target_i, sx, sy) { nil }

set ui_battle_draw_retreat = func (bt) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    val tx = (b.sx * 4) + 3
    val ty = b.sy * 3
    ui_battle_draw_arena(bt, itemi, 1)
    ui_battle_draw_bottom(bt)
    loop dy in 3 {
        loop dx in 4 {
            set ui_data.battle.screen@(ty + dy)@(tx + dx) = 82  ;; 'R'
        }
    }
    ui_battle_draw_finish(bt)
}

set ui_battle_draw_bottom = func (bt) { nil }

set ui_battle_draw_finish = func (bt) {
    io.write("  +-A---B---C---D---E---F---G---H---I---J---+\n")
    loop l in 8 * 3 {
        io.write(cstr(ui_data.battle.screen@(l)))
    }
    io.write("  +-A---B---C---D---E---F---G---H---I---J---+\n")
}

set ui_battle_area_setup = func (bt) { nil }
set ui_battle_turn_pre = func (bt) { nil }
set ui_battle_turn_post = func (bt) { nil }

set ui_battle_turn = func (bt) {
    val itemi = bt.cur_item
    val b = bt.item@(itemi)
    ui_battle_draw_arena(bt, 0, 0)
    ui_battle_draw_finish(bt)
    if false
      || (b.stasisby > 0)
      || ((itemi == 0) && (b.num <= 0))
      || bt.turn_done
      || ((b.missile != 0) && (b.maxrange == 0) && bt.has_attacked) {
        return UI_BATTLE_ACT_DONE
    }
    val prompt = string.format("%s: %d %s > ", cstr(bt.g.emperor_names@(bt.s@(b.side).party)), b.num, cstr(b.name))
    if #prompt >= (EMPEROR_NAME_LEN + SHIP_NAME_LEN + 20) {
        log_fatal_and_die("lib_sprintf: buffer too small, need %d, have %d", #prompt, EMPEROR_NAME_LEN + SHIP_NAME_LEN + 20)
    }
    loop {
        val input = ui_input_line(prompt)
        if (ui_input_tokenize(input, cmdsptr_battle) == 0) && (ui_data.input.num > 0) {
            if ui_data.input.tok@(0).type == INPUT_TOKEN_COMMAND {
                val cmd = ui_data.input.tok@(0).data
                val v = cmd.handle(bt.g, 0, ui_input_params(), ui_data.input.num - 1, cmd.var_)
                if v >= 0 {
                    if cmd.handle == ui_cmd_dummy_ret {
                        return v
                    } else {
                        if cmd.handle == cmd_battle_look {
                            ui_battle_draw_arena(bt, 0, 0)
                            ui_battle_draw_reach(bt, itemi)
                            ui_battle_draw_finish(bt)
                        }
                    }
                }
            } else {
                var x = -1
                var y = -1
                val p = ui_data.input.tok@(0).str
                func at (k) {
                    if k < #p => string.byte(p, k) => 0
                }
                val c0 = at(0)
                ifs {
                    (c0 >= 49) && (c0 <= 56) => {     ;; '1'..'8'
                        set y = c0 - 49
                        val c1 = at(1)
                        if (c1 >= 97) && (c1 <= 106) {    ;; 'a'..'j'
                            set x = c1 - 97
                            if at(2) != 0 {
                                set x = -1
                            }
                        }
                    }
                    (c0 >= 97) && (c0 <= 106) => {
                        set x = c0 - 97
                        val c1 = at(1)
                        if (c1 >= 49) && (c1 <= 56) {
                            set y = c1 - 49
                            if at(2) != 0 {
                                set y = -1
                            }
                        }
                    }
                    else => nil
                }
                if (x >= 0) && (y >= 0) {
                    return BATTLE_XY_SET(x, y)  ;; UI_BATTLE_ACT_CLICK
                }
            }
        }
    }
}

set ui_battle_ai_pre = func (bt) { nil }
set ui_battle_ai_post = func (bt) { false }

set ui_gfx_get_ship = func (look0) {
    var look = look0
    if look >= (SHIP_LOOK_PER_BANNER * BANNER_NUM) {
        set look = 3
    } else {
        set look = (look % SHIP_LOOK_PER_BANNER) // SHIP_LOOK_PER_HULL
    }
    look
}

set ui_gfx_get_planet = func (look) { 8 }
set ui_gfx_get_rock = func (look) { 10 }
