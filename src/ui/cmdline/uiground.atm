;; Port of c/src/ui/cmdline/uiground.c.

include "../../ui.atm"
include "../../game/game.atm"
include "../../game/game_ground.atm"
include "../../game/game_str.atm"
include "../../game/game_tech.atm"
include "uiswitch.atm"

func ui_ground_print_troops (gr, strrace) {
    io.write(string.format("Ground | %i %s %s", gr.s@(1).pop1, strrace@(1), game_str_gr_troops))
    loop i in gr.s@(1).strnum {
        io.write(string.format(", %s", cstr(gr.s@(1).str@(i))))
    }
    io.write("\n")
    io.write(string.format("Ground | %i %s %s", gr.s@(0).pop1, if gr.flag_rebel => game_str_gr_rebel => strrace@(0), game_str_gr_troops))
    loop i in gr.s@(0).strnum {
        io.write(string.format(", %s", cstr(gr.s@(0).str@(i))))
    }
    io.write("\n")
}

set ui_ground = func (g, gr) {
    pin strrace = [ nil, nil ]
    ui_switch_2(g, gr.s@(0).player, gr.s@(1).player)
    loop i in 2 {
        set strrace@(i) = game_str_tbl_race@(g.eto@(gr.s@(i).player).race)
    }
    io.write("Ground | ")
    io.write(string.format("%s %s\n", game_str_gr_gcon, cstr(g.planet@(gr.planet_i).name)))
    io.write("Ground | ")
    if !gr.flag_rebel {
        io.write(string.format("%i %s %i %s %s ", gr.inbound, game_str_gr_outof, gr.total_inbound, strrace@(if gr.flag_swap => 1 => 0), game_str_gr_transs))
        io.write(string.format("%s %s %s\n", game_str_gr_penetr, strrace@(if gr.flag_swap => 0 => 1), game_str_gr_defenss))
    } else {
        io.write(string.format("%i %s\n", gr.inbound, game_str_gr_reclaim))
    }
    ui_ground_print_troops(gr, strrace)
    io.write("Ground | ")
    io.write("(*BANG* *ZZZAP* etc)\n")
    loop {
        while (gr.s@(0).pop1 != 0) && (gr.s@(1).pop1 != 0)
        game_ground_kill(gr)
    }
    ui_ground_print_troops(gr, strrace)
    val pop = gr.s@(if gr.flag_swap => 1 => 0).pop1
    io.write("Ground | ")
    if pop != 0 {
        ifs {
            !gr.flag_swap => { io.write(string.format("%s%s ", strrace@(0), game_str_gr_scapt)) }
            gr.flag_rebel => { io.write(string.format("%s ", game_str_gr_itroops)) }
            else => { io.write(string.format("%s%s ", strrace@(1), game_str_gr_scapt)) }
        }
    } else {
        val s = ifs {
            !gr.flag_swap => strrace@(1)
            gr.flag_rebel => game_str_gr_rebel
            else => strrace@(0)
        }
        io.write(string.format("%s%s ", s, game_str_gr_succd))
    }
    io.write(string.format("%s\n", cstr(g.planet@(gr.planet_i).name)))
    if (pop > 0) && (!gr.flag_rebel) {
        if gr.fact > 0 {
            io.write("Ground | ")
            io.write(string.format("%i %s\n", gr.fact, game_str_gr_fcapt))
        }
        if gr.techchance > 0 {
            io.write("Ground | ")
            if gr.flag_swap == gr.s@(0).human {
                io.write(game_str_gr_tsteal)
                loop i in gr.techchance {
                    pin buf = carray(0x80)
                    game_tech_get_name(g.gaux, gr.got@(i).field, gr.got@(i).tech, buf, #buf)
                    io.write(string.format("%s %s", if i > 0 => "," => ":", cstr(buf)))
                }
            } else {
                io.write(game_str_gr_tnew)
            }
            io.write("\n")
        }
    }
    ui_switch_wait(g)
}
