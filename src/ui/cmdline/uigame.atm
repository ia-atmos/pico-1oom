set cmds_turn@(0).var_ = cmdsptr_turn

;; Gives (action, load_game_i): the `*load_game_i_ptr` of C.
func ui_game_turn (g, load_game_i, pi) {
    ui_switch_1_opts(g, pi)
    game_turn_start_messages(g, pi)
    ui_finished_print_all(g, pi)
    loop {
        val prompt = string.format("%s | %i | %s > ", cstr(g.emperor_names@(pi)), g.year + YEAR_BASE, ui_planet_str(g, pi, g.planet_focus_i@(pi)))
        val input = ui_input_line(prompt)
        if (ui_input_tokenize(input, cmdsptr_turn) == 0) && (ui_data.input.num > 0) {
            if ui_data.input.tok@(0).type == INPUT_TOKEN_COMMAND {
                val cmd = ui_data.input.tok@(0).data
                val v = cmd.handle(g, pi, ui_input_params(), ui_data.input.num - 1, cmd.var_)
                if v >= 0 {
                    if cmd.handle == cmd_next {
                        return (UI_TURN_ACT_NEXT_TURN, load_game_i)
                    }
                    if cmd.handle == ui_cmd_load {
                        return (UI_TURN_ACT_LOAD_GAME, v)
                    }
                    if cmd.handle == ui_cmd_quit {
                        return (UI_TURN_ACT_QUIT_GAME, load_game_i)
                    }
                }
            }
        }
    }
}

func ui_game_start (g) {
    BOOLVEC_CLEAR(ui_data.players_viewing, PLAYER_NUM)
    io.write("Welcome! Type ? to get the list of commands.\n")
}

func ui_game_end (g) {
}
