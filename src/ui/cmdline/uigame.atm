;; The commands of the screens that are not ported yet (#14): they throw.
func ui_cmd_not_ported (name) {
    func (g, api, param, num_param, var_) {
        throw "ui/cmdline: the command '" ++ name ++ "' is not ported yet"
    }
}

func cmd_next (g, api, param, num_param, var_) {
    0
}

