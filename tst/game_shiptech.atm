    set out@+ = string.format("tbl_shiptech_special[%i].space =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.space@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_special[%i].power =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.power@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_special[%i].tech_i = %i\n", i, if e.tech_i == true => 1 => (if e.tech_i == false => 0 => e.tech_i))
    set out@+ = string.format("tbl_shiptech_special[%i].field = %i\n", i, if e.field == true => 1 => (if e.field == false => 0 => e.field))
    set out@+ = string.format("tbl_shiptech_special[%i].type = %i\n", i, if e.type == true => 1 => (if e.type == false => 0 => e.type))
    set out@+ = string.format("tbl_shiptech_special[%i].repair = %i\n", i, if e.repair == true => 1 => (if e.repair == false => 0 => e.repair))
    set out@+ = string.format("tbl_shiptech_special[%i].extraman = %i\n", i, if e.extraman == true => 1 => (if e.extraman == false => 0 => e.extraman))
    set out@+ = string.format("tbl_shiptech_special[%i].misshield = %i\n", i, if e.misshield == true => 1 => (if e.misshield == false => 0 => e.misshield))
    set out@+ = string.format("tbl_shiptech_special[%i].extrarange = %i\n", i, if e.extrarange == true => 1 => (if e.extrarange == false => 0 => e.extrarange))
    set out@+ = string.format("tbl_shiptech_special[%i].pulsar = %i\n", i, if e.pulsar == true => 1 => (if e.pulsar == false => 0 => e.pulsar))
    set out@+ = string.format("tbl_shiptech_special[%i].stream = %i\n", i, if e.stream == true => 1 => (if e.stream == false => 0 => e.stream))
    set out@+ = string.format("tbl_shiptech_special[%i].boolmask = %i\n", i, if e.boolmask == true => 1 => (if e.boolmask == false => 0 => e.boolmask))
}
loop i in #tbl_shiptech_hull {
    val e = tbl_shiptech_hull@(i)
    set out@+ = string.format("tbl_shiptech_hull[%i].nameptr = %s\n", i, e.nameptr())
    set out@+ = string.format("tbl_shiptech_hull[%i].cost = %i\n", i, if e.cost == true => 1 => (if e.cost == false => 0 => e.cost))
    set out@+ = string.format("tbl_shiptech_hull[%i].space = %i\n", i, if e.space == true => 1 => (if e.space == false => 0 => e.space))
