loop i in #tbl_shiptech_special {
    val e = tbl_shiptech_special@(i)
    set out@+ = string.format("tbl_shiptech_special[%i].nameptr = %s\n", i, e.nameptr())
    set out@+ = string.format("tbl_shiptech_special[%i].extratextptr = %s\n", i, e.extratextptr())
    set out@+ = string.format("tbl_shiptech_special[%i].cost =", i)
