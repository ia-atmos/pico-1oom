;; game_shiptech.atm of the port: every field of its tables, as
;; tst/c/game_shiptech.c prints them. Generated with it.

include "../src/game/game_shiptech.atm"

pin out = []

loop i in #tbl_shiptech_weap {
    val e = tbl_shiptech_weap@(i)
    set out@+ = string.format("tbl_shiptech_weap[%i].nameptr = %s\n", i, e.nameptr())
    set out@+ = string.format("tbl_shiptech_weap[%i].extratextptr = %s\n", i, e.extratextptr())
    set out@+ = string.format("tbl_shiptech_weap[%i].damagemin = %i\n", i, if e.damagemin == true => 1 => (if e.damagemin == false => 0 => e.damagemin))
    set out@+ = string.format("tbl_shiptech_weap[%i].damagemax = %i\n", i, if e.damagemax == true => 1 => (if e.damagemax == false => 0 => e.damagemax))
    set out@+ = string.format("tbl_shiptech_weap[%i].range = %i\n", i, if e.range == true => 1 => (if e.range == false => 0 => e.range))
    set out@+ = string.format("tbl_shiptech_weap[%i].extraacc = %i\n", i, if e.extraacc == true => 1 => (if e.extraacc == false => 0 => e.extraacc))
    set out@+ = string.format("tbl_shiptech_weap[%i].halveshield = %i\n", i, if e.halveshield == true => 1 => (if e.halveshield == false => 0 => e.halveshield))
    set out@+ = string.format("tbl_shiptech_weap[%i].is_bomb = %i\n", i, if e.is_bomb == true => 1 => (if e.is_bomb == false => 0 => e.is_bomb))
    set out@+ = string.format("tbl_shiptech_weap[%i].damagefade = %i\n", i, if e.damagefade == true => 1 => (if e.damagefade == false => 0 => e.damagefade))
    set out@+ = string.format("tbl_shiptech_weap[%i].misstype = %i\n", i, if e.misstype == true => 1 => (if e.misstype == false => 0 => e.misstype))
    set out@+ = string.format("tbl_shiptech_weap[%i].damagemul = %i\n", i, if e.damagemul == true => 1 => (if e.damagemul == false => 0 => e.damagemul))
    set out@+ = string.format("tbl_shiptech_weap[%i].numfire = %i\n", i, if e.numfire == true => 1 => (if e.numfire == false => 0 => e.numfire))
    set out@+ = string.format("tbl_shiptech_weap[%i].numshots = %i\n", i, if e.numshots == true => 1 => (if e.numshots == false => 0 => e.numshots))
    set out@+ = string.format("tbl_shiptech_weap[%i].cost = %i\n", i, if e.cost == true => 1 => (if e.cost == false => 0 => e.cost))
    set out@+ = string.format("tbl_shiptech_weap[%i].space = %i\n", i, if e.space == true => 1 => (if e.space == false => 0 => e.space))
    set out@+ = string.format("tbl_shiptech_weap[%i].power = %i\n", i, if e.power == true => 1 => (if e.power == false => 0 => e.power))
    set out@+ = string.format("tbl_shiptech_weap[%i].is_bio = %i\n", i, if e.is_bio == true => 1 => (if e.is_bio == false => 0 => e.is_bio))
    set out@+ = string.format("tbl_shiptech_weap[%i].tech_i = %i\n", i, if e.tech_i == true => 1 => (if e.tech_i == false => 0 => e.tech_i))
    set out@+ = string.format("tbl_shiptech_weap[%i].v24 = %i\n", i, if e.v24 == true => 1 => (if e.v24 == false => 0 => e.v24))
    set out@+ = string.format("tbl_shiptech_weap[%i].dtbl =", i)
    loop k in 7 { set out@+ = string.format(" %i", e.dtbl@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_weap[%i].sound = %i\n", i, if e.sound == true => 1 => (if e.sound == false => 0 => e.sound))
    set out@+ = string.format("tbl_shiptech_weap[%i].nummiss = %i\n", i, if e.nummiss == true => 1 => (if e.nummiss == false => 0 => e.nummiss))
}
loop i in #tbl_shiptech_comp {
    val e = tbl_shiptech_comp@(i)
    set out@+ = string.format("tbl_shiptech_comp[%i].nameptr = %s\n", i, e.nameptr())
    set out@+ = string.format("tbl_shiptech_comp[%i].power =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.power@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_comp[%i].space =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.space@(k)) }
