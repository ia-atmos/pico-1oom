    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_armor[%i].space =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.space@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_armor[%i].armor = %i\n", i, if e.armor == true => 1 => (if e.armor == false => 0 => e.armor))
    set out@+ = string.format("tbl_shiptech_armor[%i].tech_i = %i\n", i, if e.tech_i == true => 1 => (if e.tech_i == false => 0 => e.tech_i))
}
loop i in #tbl_shiptech_shield {
    val e = tbl_shiptech_shield@(i)
    set out@+ = string.format("tbl_shiptech_shield[%i].nameptr = %s\n", i, e.nameptr())
    set out@+ = string.format("tbl_shiptech_shield[%i].cost =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.cost@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_shield[%i].space =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.space@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_shield[%i].power =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.power@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_shield[%i].absorb = %i\n", i, if e.absorb == true => 1 => (if e.absorb == false => 0 => e.absorb))
    set out@+ = string.format("tbl_shiptech_shield[%i].tech_i = %i\n", i, if e.tech_i == true => 1 => (if e.tech_i == false => 0 => e.tech_i))
}
loop i in #tbl_shiptech_jammer {
    val e = tbl_shiptech_jammer@(i)
    set out@+ = string.format("tbl_shiptech_jammer[%i].nameptr = %s\n", i, e.nameptr())
    set out@+ = string.format("tbl_shiptech_jammer[%i].power =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.power@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_jammer[%i].space =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.space@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_jammer[%i].cost =", i)
    loop k in SHIP_HULL_NUM { set out@+ = string.format(" %i", e.cost@(k)) }
    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_jammer[%i].tech_i = %i\n", i, if e.tech_i == true => 1 => (if e.tech_i == false => 0 => e.tech_i))
    set out@+ = string.format("tbl_shiptech_jammer[%i].level = %i\n", i, if e.level == true => 1 => (if e.level == false => 0 => e.level))
