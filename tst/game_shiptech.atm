    set out@+ = string.format("tbl_shiptech_engine[%i].space = %i\n", i, if e.space == true => 1 => (if e.space == false => 0 => e.space))
    set out@+ = string.format("tbl_shiptech_engine[%i].cost = %i\n", i, if e.cost == true => 1 => (if e.cost == false => 0 => e.cost))
    set out@+ = string.format("tbl_shiptech_engine[%i].warp = %i\n", i, if e.warp == true => 1 => (if e.warp == false => 0 => e.warp))
    set out@+ = string.format("tbl_shiptech_engine[%i].tech_i = %i\n", i, if e.tech_i == true => 1 => (if e.tech_i == false => 0 => e.tech_i))
}
loop i in #tbl_shiptech_armor {
    val e = tbl_shiptech_armor@(i)
    set out@+ = string.format("tbl_shiptech_armor[%i].nameptr = %s\n", i, e.nameptr())
    set out@+ = string.format("tbl_shiptech_armor[%i].cost =", i)
