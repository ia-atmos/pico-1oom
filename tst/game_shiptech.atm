    set out@+ = "\n"
    set out@+ = string.format("tbl_shiptech_comp[%i].tech_i = %i\n", i, if e.tech_i == true => 1 => (if e.tech_i == false => 0 => e.tech_i))
    set out@+ = string.format("tbl_shiptech_comp[%i].level = %i\n", i, if e.level == true => 1 => (if e.level == false => 0 => e.level))
}
