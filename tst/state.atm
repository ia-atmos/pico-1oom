;; A state of the game, operations in order, and the whole state as text,
;; as tst/c/state.c does it (see that file for the usage).

include "../src/game/game_aux.atm"
include "../src/game/game_misc.atm"
include "../src/game/game_new.atm"
include "../src/game/game_save.atm"
include "gamedump.atm"

val args = [...]
os_set_path_data(args@0)
lbxfile_init()
pin gaux = game_aux_s()
pin g = game_s()
game_aux_init(gaux, g)

;; The `k`th argument after ':' of an operation, as `atoi`.
func arg (op, k) {
    val ps = string.split(op, ":")
    tonumber(ps@(k + 1) || "0") || 0
}

func do_op (op) {
    val name = string.split(op, ":")@0
    match name {
        "start" => game_aux_start(gaux, g)
        "have_reserve_fuel" => game_update_have_reserve_fuel(g)
        "maint_costs" => game_update_maint_costs(g)
        "production" => game_update_production(g)
        "total_research" => game_update_total_research(g)
        "eco_on_waste" => game_update_eco_on_waste(g, arg(op, 0), arg(op, 1) != 0)
        "seen_by_orbit" => game_update_seen_by_orbit(g, arg(op, 0))
        "within_range" => game_update_within_range(g)
        "reloc_dest" => game_update_reloc_dest(g)
        "empire_contact" => game_update_empire_contact(g)
        "visibility" => game_update_visibility(g)
        "rng_step" => game_rng_step(g)
        "planet_destroy" => game_planet_destroy(g, arg(op, 0), arg(op, 1))
        "adjust_percent2" => game_planet_adjust_percent2(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3) != 0)
        "adjust_percent" => game_planet_adjust_percent(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3))
        "update_home" => game_planet_update_home(g)
        "tech_util" => game_update_tech_util(g)
        "finish_new" => game_tech_finish_new(g, arg(op, 0))
        "start_next" => game_tech_start_next(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "set_to_max_bonus" => game_tech_set_to_max_bonus(g, arg(op, 0), arg(op, 1))
        "orion_loot" => game_tech_get_orion_loot(g, arg(op, 0))
        "artifact_loot" => game_tech_get_artifact_loot(g, arg(op, 0), arg(op, 1))
        "atmos_tform" => game_turn_atmos_tform(g.planet@(arg(op, 0)))
        "soil_enrich" => game_turn_soil_enrich(g.planet@(arg(op, 0)), arg(op, 1), arg(op, 2) != 0)
        "equalize_tech" => game_equalize_slider_group(g.eto@(arg(op, 0)).tech.slider, TECH_FIELD_NUM, g.eto@(arg(op, 0)).tech.slider_lock)
        "adjust_tech" => game_adjust_slider_group(g.eto@(arg(op, 0)).tech.slider, arg(op, 1), arg(op, 2), TECH_FIELD_NUM, g.eto@(arg(op, 0)).tech.slider_lock)
        else => {
            print("unknown op " ++ op)
            os.exit(1)
        }
    }
}

var k
if args@2 == "new" {
    pin opt = game_new_options_s()
    val o = tonumber(args@3)
    val races = tonumber(args@4)
    val banners = tonumber(args@5)
    val humans = tonumber(args@7)
    set opt.players = o // 100
    set opt.galaxy_size = (o // 10) % 10
    set opt.difficulty = o % 10
    set opt.galaxy_seed = tonumber(args@6)
    set opt.improved_galaxy_generator = tonumber(args@8) != 0
    set opt.nebulae = tonumber(args@9) != 0
    var m = 1
    loop i in PLAYER_NUM {
        val r = (races >> (4 * i)) & 0xf
        val b = (banners // m) % 10
        set opt.pdata@(i).race = if r != 0 => (r - 1) => RACE_RANDOM
        set opt.pdata@(i).banner = if b != 0 => (b - 1) => BANNER_RANDOM
        set opt.pdata@(i).is_ai = ((humans // m) % 10) == 0
        set m = m * 10
    }
    game_new(g, gaux, opt)
    set k = 10
} else {
    if game_save_do_load_fname(args@3, nil, g) != 0 {
        os.exit(1)
    }
    set k = 4
}
loop {
    while k < #args
    do_op(args@(k))
    set k = k + 1
}
pin f = io.open(args@1, "w")
io.write(f, gamedump(g))
io.close(f)
