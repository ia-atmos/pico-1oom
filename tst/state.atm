;; A state of the game, operations in order, and the whole state as text,
;; as tst/c/state.c does it (see that file for the usage). Some ops also
;; print, as the C does.

include "../src/game/game_aux.atm"
include "../src/game/game_misc.atm"
include "../src/game/game_new.atm"
include "../src/game/game_save.atm"
include "../src/game/game_audience.atm"
include "../src/game/game_bomb.atm"
include "../src/game/game_design.atm"
include "../src/game/game_election.atm"
include "../src/game/game_end.atm"
include "../src/game/game_event.atm"
include "../src/game/game_ground.atm"
include "../src/game/game_news.atm"
include "../src/game/game_diplo.atm"
include "../src/game/game_fleet.atm"
include "../src/game/game_spy.atm"
include "../src/game/game_stat.atm"
include "../src/game/game_turn.atm"
include "gamedump.atm"

val args = [...]
os_set_path_data(args@0)
lbxfile_init()
pin gaux = game_aux_s()
pin g = game_s()
game_aux_init(gaux, g)

;; The `k`th argument after ':' of an operation, as `atoi`.
func arg (op, k) {
    val ps = string.split(op, ":")
    tonumber(ps@(k + 1) || "0") || 0
}

pin outs = []
pin spy_st = spy_turn_s()
func out (fmt, ...) {
    set outs@+ = string.format(fmt, ...)
}

;; Every table of the design screen, for a design of a player.
func design_fit (op) {
    pin gd = game_design_s()
    pin d = design_data_s()
    pin buf = carray(WEAPON_NUM)
    val pi = arg(op, 0)
    game_design_prepare(g, gd, pi, g.srd@(pi).design@(arg(op, 1)))
    out("prepare %d %d:", gd.lookbase, gd.sd_num)
    loop i in SHIP_HULL_NUM {
        out(" %d %s", gd.tbl_shiplook_hull@(i), cstr(gd.names@(i)))
    }
    out("\n")
    set d.g = g
    set d.gd = gd
    set d.api = pi
    game_design_init_maxtech_haveflags(d)
    out("flags %d %d %d %d %d %d %d %d %d:", d.last_avail_tech_weap, d.last_avail_tech_special, cint(d.flag_disable_cspeed), cint(d.flag_disable_comp), cint(d.flag_disable_jammer), cint(d.flag_disable_shield), cint(d.flag_disable_armor), cint(d.flag_disable_engine), gd.sd.hp)
    loop i in WEAPON_SLOT_NUM {
        out(" %d,%d,%d", cint(d.flag_tbl_weapon@(i)), d.flag_tbl_weap_up@(i), d.flag_tbl_weap_dn@(i))
    }
    loop i in SPECIAL_SLOT_NUM {
        out(" %d", cint(d.flag_tbl_special@(i)))
    }
    loop i in SHIP_HULL_NUM {
        out(" %d", cint(d.flag_tbl_hull@(i)))
    }
    out("\n")
    func fit (name, last) {
        out("%s %d:", name, last)
        loop i in (0, last) {
            out(" %d", buf@(i))
        }
        out("\n")
    }
    fit("comp", game_design_build_tbl_fit_comp(g, gd, buf))
    fit("shield", game_design_build_tbl_fit_shield(g, gd, buf))
    fit("jammer", game_design_build_tbl_fit_jammer(g, gd, buf))
    fit("armor", game_design_build_tbl_fit_armor(g, gd, buf))
    fit("engine", game_design_build_tbl_fit_engine(g, gd, buf))
    fit("man", game_design_build_tbl_fit_man(g, gd, buf))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 0, WEAPON_GROUP_ALL))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 1, WEAPON_GROUP_BEAMS))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 2, WEAPON_GROUP_MISSILES))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 3, WEAPON_GROUP_BOMBS))
    fit("special", game_design_build_tbl_fit_special(g, gd, buf, 0))
    fit("special", game_design_build_tbl_fit_special(g, gd, buf, 2))
    loop i in 13 {
        out(" %d/%d", game_design_calc_cost_item(gd, i, 1), game_design_calc_space_item(gd, i, 1))
    }
    out("\n")
    game_design_look_next(gd)
    out("look %d", gd.sd.look)
    game_design_look_prev(gd)
    game_design_look_prev(gd)
    out(" %d", gd.sd.look)
    game_design_look_fix(g, pi, gd.sd)
    out(" %d", gd.sd.look)
    game_design_compact_slots(gd.sd)
    game_design_clear(gd)
    out(" %s %d %d\n", cstr(gd.sd.name), gd.sd.space, gd.sd.cost)
}

;; The interface (ui.atm) that the logic calls, as tst/c/state.c has it.
set ui_explore = func (g_, pi, planet_i, by_scanner, flag_colony_ship) {
    out("explore %d %d %d %d\n", pi, planet_i, cint(by_scanner), cint(flag_colony_ship))
    (planet_i & 1) != 0
}
set ui_landing = func (g_, pi, planet_i) {
    out("landing %d %d\n", pi, planet_i)
}
set ui_turn_msg = func (g_, pi, str) {
    out("msg %d %s\n", pi, cstr(str))
}

set ui_newtech = func (g_, pi) {
    out("newtech %d\n", pi)
}
set ui_spy_steal = func (g_, spy, target, flags_field) {
    var f = 0
    loop {
        while (f < TECH_FIELD_NUM) && ((flags_field & (1 << f)) == 0)
        set f = f + 1
    }
    out("steal %d %d %d -> %d\n", spy, target, flags_field, f)
    f
}
set ui_spy_stolen = func (g_, pi, spy, field, tech) {
    out("stolen %d %d %d %d\n", pi, spy, field, tech)
}
set ui_spy_sabotage_ask = func (g_, spy, target) {
    var pl = 0
    loop i in g_.galaxy_stars {
        if g_.planet@(i).owner == target {
            set pl = i
            break
        }
    }
    out("sabotage_ask %d %d -> %d %d\n", spy, target, (spy + target) % 4, pl)
    return ((spy + target) % 4, pl)
}
set ui_spy_sabotage_done = func (g_, pi, spy, target, act, other1, other2, planet, snum) {
    out("sabotage_done %d %d %d %d %d %d %d %d\n", pi, spy, target, act, other1, other2, planet, snum)
    other1
}
set ui_bomb_ask = func (g_, pi, planet_i, pop_inbound) {
    out("bomb_ask %d %d %d\n", pi, planet_i, pop_inbound)
    (planet_i & 1) == 0
}
set ui_bomb_show = func (g_, pi, attacker_i, owner_i, planet_i, popdmg, factdmg, play_music, hide_other) {
    out("bomb_show %d %d %d %d %d %d %d %d\n", pi, attacker_i, owner_i, planet_i, popdmg, factdmg, cint(play_music), cint(hide_other))
}
set ui_ground = func (g_, gr) {
    out("ground %d %d %d %d %d %d %d %d", gr.seed, gr.planet_i, cint(gr.flag_swap), cint(gr.flag_rebel), gr.inbound, gr.total_inbound, gr.fact, gr.techchance)
    loop i in TECH_SPY_MAX {
        out(" %d,%d", gr.got@(i).tech, gr.got@(i).field)
    }
    loop i in 2 {
        val s = gr.s@(i)
        out(" | %d %d %d %d %d %d %d %d %d %d", s.player, cint(s.human), s.force, s.pop1, s.pop2, s.armori, s.suiti, s.shieldi, s.weapi, s.strnum)
        loop j in s.strnum {
            out(" '%s'", cstr(s.str@(j)))
        }
    }
    out("\n")
}

func el_print (what, el) {
    val str = if el.str == nil => "(null)" => cstr(el.str)
    out("%s %d %d %d %d %d %d %d %d %d %d %d '%s'\n", what, el.num, el.candidate@(0), el.candidate@(1), el.total_votes, el.got_votes@(0), el.got_votes@(1), el.first_human, el.last_human, el.cur_i, cint(el.flag_show_votes), el.ui_delay, str)
}
;; ui_delay is not set yet at the start (garbage of the stack in C)
set ui_election_start = func (el) {
    val d = el.ui_delay
    set el.ui_delay = -1
    el_print("el_start", el)
    set el.ui_delay = d
}
set ui_election_show = func (el) { el_print("el_show", el) }
set ui_election_delay = func (el, delay) {
    out("el_delay %d\n", delay)
    el_print("el_delay", el)
}
set ui_election_vote = func (el, player_i) {
    el_print("el_vote", el)
    (player_i + 1) % 3
}
set ui_election_accept = func (el, player_i) {
    el_print("el_accept", el)
    (player_i & 1) == 0
}
set ui_election_end = func (el) { el_print("el_end", el) }

set ui_news_start = func () { out("news_start\n") }
set ui_news_end = func () { out("news_end\n") }
set ui_news = func (g_, ns) {
    pin buf = carray(0x200)
    game_news_get_msg(g_, ns, buf, #buf)
    out("ui_news %d %d '%s' %d", ns.type, ns.subtype, cstr(buf), ns.statsnum)
    loop i in ns.statsnum {
        out(" %s", ns.stats@(i))
    }
    out("\n")
}

;; The audiences, as tst/c/state.c has them.
var aud_n = 0
func au_print (what, au) {
    val buf = if au.buf == nil => "(null)" => cstr(au.buf)
    out("%s %d %d %d %d %d %d %d '%s'", what, au.ph, au.pa, au.mode, au.dtype, au.dtype_next, au.gfxi, au.musi, buf)
    var i = 0
    loop {
        while (i < AUDIENCE_STR_MAX) && (au.strtbl@(i) != false)
        ;; condtbl is valid only while a menu asks (it points to the stack in C)
        val asks = string.sub(what, 0, 5) == "au_ask"
        out(" [%s]%d", au.strtbl@(i), if asks && (au.condtbl != nil) => cint(au.condtbl@(i)) => 1)
        set i = i + 1
    }
    out("\n")
}
func au_ask (what, au) {
    au_print(what, au)
    var n = 0
    loop {
        while (n < AUDIENCE_STR_MAX) && (au.strtbl@(n) != false)
        set n = n + 1
    }
    set aud_n = aud_n + 1
    var v = ((aud_n * 3) % (n + 1)) - 1
    if (v >= 0) && (au.condtbl != nil) && (!au.condtbl@(v)) {
        set v = -1
    }
    out("-> %d\n", v)
    v
}
set ui_audience_start = func (au) { out("au_start %d %d\n", au.ph, au.pa) }
set ui_audience_show1 = func (au) { au_print("au_show1", au) }
set ui_audience_show2 = func (au) { au_print("au_show2", au) }
set ui_audience_show3 = func (au) { au_print("au_show3", au) }
set ui_audience_ask2a = func (au) { au_ask("au_ask2a", au) }
set ui_audience_ask2b = func (au) { au_ask("au_ask2b", au) }
set ui_audience_ask3 = func (au) { au_ask("au_ask3", au) }
set ui_audience_ask4 = func (au) { au_ask("au_ask4", au) }
set ui_audience_newtech = func (au, pi) { out("au_newtech %d\n", pi) }
set ui_audience_end = func (au) { au_print("au_end", au) }

func test_ai_aud_si (what, au) {
    set aud_n = aud_n + 1
    out("ai_%s %d\n", what, aud_n % 4)
    aud_n % 4
}

;; The functions of the AI that are not ported yet, replaced by fixed answers
;; that print each call, as tst/c/state.c does.
set game_ai = [
    id            = game_ai.id,
    name          = game_ai.name,
    new_game_init = game_ai.new_game_init,
    new_game_tech = game_ai.new_game_tech,
    bomb          = func (g_, player, planet, pop_inbound) {
        out("ai_bomb %d %d %d\n", player, planet, pop_inbound)
        ((planet + player) & 1) == 0
    },
    tech_next     = func (g_, player, field, tbl, num) {
        out("ai_tech_next %d %d %d\n", player, field, num)
        tbl@((player + field) % num)
    },
    vote          = func (el, player) {
        out("ai_vote %d\n", player)
        (player + el.g.year) % 3
    },
    plague        = func (g_, planet) { out("ai_plague %d\n", planet) },
    nova          = func (g_, planet) { out("ai_nova %d\n", planet) },
    comet         = func (g_, planet) { out("ai_comet %d\n", planet) },
    pirates       = func (g_, planet) { out("ai_pirates %d\n", planet) },
    aud_start_human = func (au) {
        out("ai_aud_start_human\n")
        set au.dtype = 22
        set au.mode = 0
    },
    aud_treaty_nap = func (au) { test_ai_aud_si("aud_nap", au) },
    aud_treaty_alliance = func (au) { test_ai_aud_si("aud_alliance", au) },
    aud_treaty_peace = func (au) { test_ai_aud_si("aud_peace", au) },
    aud_treaty_declare_war = func (au) { test_ai_aud_si("aud_declare_war", au) },
    aud_treaty_break_alliance = func (au) { test_ai_aud_si("aud_break_alliance", au) },
    aud_trade = func (au) { test_ai_aud_si("aud_trade", au) },
    aud_sweeten = func (au) {
        set aud_n = aud_n + 1
        val bc = 25 * (aud_n % 3)
        out("ai_aud_sweeten %d\n", bc)
        return ((aud_n % 2) == 0, bc, 0, 0)
    },
    aud_threaten = func (au) {
        out("ai_aud_threaten\n")
        73
    },
    aud_tribute_bc = func (au, selected, bc) {
        out("ai_aud_tribute_bc %d %d\n", selected, bc)
        set au.tribute_bc = bc
    },
    aud_tribute_tech = func (au, selected, field, tech) {
        out("ai_aud_tribute_tech %d %d %d\n", selected, field, tech)
        set au.tribute_field = field
        set au.tribute_tech = tech
    },
    aud_tech_scale = func (au) {
        out("ai_aud_tech_scale\n")
        100
    },
    aud_get_dtype = func (au, dtype, a2) {
        out("ai_aud_get_dtype %d %d\n", dtype, a2)
        dtype
    },
    aud_later = func (au) {
        set aud_n = aud_n + 1
        out("ai_aud_later %d\n", cint((aud_n % 5) == 4))
        (aud_n % 5) == 4
    },
    ground        = func (g_, def, att, planet, pop_killed, owner_changed) {
        out("ai_ground %d %d %d %d %d\n", def, att, planet, pop_killed, cint(owner_changed))
    },
]
set ui_gmap_basic_init = func (g_, show_player_switch) { nil }
set ui_gmap_basic_start_player = func (ctx, pi) { nil }
set ui_gmap_basic_start_frame = func (ctx, pi) { nil }
set ui_gmap_basic_draw_frame = func (ctx, pi) { nil }
set ui_gmap_basic_finish_frame = func (ctx, pi) { nil }
set ui_gmap_basic_shutdown = func (ctx) { nil }

func do_op (op) {
    val name = string.split(op, ":")@0
    match name {
        "start" => game_aux_start(gaux, g)
        "have_reserve_fuel" => game_update_have_reserve_fuel(g)
        "maint_costs" => game_update_maint_costs(g)
        "production" => game_update_production(g)
        "total_research" => game_update_total_research(g)
        "eco_on_waste" => game_update_eco_on_waste(g, arg(op, 0), arg(op, 1) != 0)
        "seen_by_orbit" => game_update_seen_by_orbit(g, arg(op, 0))
        "within_range" => game_update_within_range(g)
        "reloc_dest" => game_update_reloc_dest(g)
        "empire_contact" => game_update_empire_contact(g)
        "visibility" => game_update_visibility(g)
        "rng_step" => game_rng_step(g)
        "planet_destroy" => game_planet_destroy(g, arg(op, 0), arg(op, 1))
        "adjust_percent2" => game_planet_adjust_percent2(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3) != 0)
        "adjust_percent" => game_planet_adjust_percent(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3))
        "update_home" => game_planet_update_home(g)
        "tech_util" => game_update_tech_util(g)
        "finish_new" => game_tech_finish_new(g, arg(op, 0))
        "start_next" => game_tech_start_next(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "set_to_max_bonus" => game_tech_set_to_max_bonus(g, arg(op, 0), arg(op, 1))
        "orion_loot" => game_tech_get_orion_loot(g, arg(op, 0))
        "artifact_loot" => game_tech_get_artifact_loot(g, arg(op, 0), arg(op, 1))
        "atmos_tform" => game_turn_atmos_tform(g.planet@(arg(op, 0)))
        "soil_enrich" => game_turn_soil_enrich(g.planet@(arg(op, 0)), arg(op, 1), arg(op, 2) != 0)
        "equalize_tech" => game_equalize_slider_group(g.eto@(arg(op, 0)).tech.slider, TECH_FIELD_NUM, g.eto@(arg(op, 0)).tech.slider_lock)
        "adjust_tech" => game_adjust_slider_group(g.eto@(arg(op, 0)).tech.slider, arg(op, 1), arg(op, 2), TECH_FIELD_NUM, g.eto@(arg(op, 0)).tech.slider_lock)
        "limit_ships" => game_turn_limit_ships(g)
        "countdown_ceasefire" => game_turn_countdown_ceasefire(g)
        "mood_blunder" => game_turn_update_mood_blunder(g)
        "init_z_finished" => game_turn_init_z_finished(g)
        "send_transport" => game_turn_send_transport(g)
        "build_eco" => game_turn_build_eco(g)
        "update_trade" => game_turn_update_trade(g)
        "build_def" => game_turn_build_def(g)
        "build_ship" => game_turn_build_ship(g)
        "reserve" => game_turn_reserve(g)
        "build_ind" => game_turn_build_ind(g)
        "disable_slider" => game_turn_finished_disable_slider(g, g.planet@(arg(op, 0)), arg(op, 1), arg(op, 2) != 0)
        "remove_empty_fleets" => game_remove_empty_fleets(g)
        "remove_player_fleets" => game_remove_player_fleets(g, arg(op, 0))
        "fleet_unrefuel" => game_fleet_unrefuel(g)
        "any_dest" => out("any_dest %d\n", cint(game_fleet_any_dest_player(g, arg(op, 0), arg(op, 1))))
        "send_half" => {
            ;; half of the ships of each design of a player at a planet
            val pi = arg(op, 0)
            val from = arg(op, 1)
            val n = g.eto@(pi).shipdesigns_num
            pin ships = carray(NUM_SHIPDESIGNS)
            pin types = carray(NUM_SHIPDESIGNS)
            loop i in n {
                set types@(i) = n - 1 - i
                set ships@(i) = g.eto@(pi).orbit@(from).ships@(n - 1 - i) // 2
            }
            val r = if arg(op, 3) != 0 => game_send_fleet_retreat(g, pi, from, arg(op, 2), ships, types, n) => game_send_fleet_from_orbit(g, pi, from, arg(op, 2), ships, types, n)
            out("send %d\n", cint(r))
        }
        "redirect" => {
            if arg(op, 0) < g.enroute_num {
                game_fleet_redirect(g, g.enroute@(arg(op, 0)), arg(op, 1), arg(op, 2))
            }
        }
        "fleet_speed" => {
            if arg(op, 0) < g.enroute_num {
                out("speed %d\n", game_fleet_get_speed(g, g.enroute@(arg(op, 0)), arg(op, 1), arg(op, 2)))
            }
        }
        "stats" => {
            pin d = game_stats_s()
            game_stats_all(g, arg(op, 0), d)
            out("stats %d:", d.num)
            loop i in d.num {
                out(" %d", d.p@(i))
                loop s in 6 {
                    out(",%d", d.v@(s)@(i))
                }
            }
            out("\n")
        }
        "design_ai" => {
            pin gd = game_design_s()
            ;; the look: arg 2 within those of the hull and banner of the player
            game_design_prepare_ai(g, gd, arg(op, 0), arg(op, 1), (g.eto@(arg(op, 0)).banner * SHIP_LOOK_PER_BANNER) + (arg(op, 1) * SHIP_LOOK_PER_HULL) + arg(op, 2))
            out("design_ai %s %d %d %d\n", cstr(gd.sd.name), gd.sd.space, gd.sd.cost, gd.sd.engines)
            game_design_add(g, arg(op, 0), gd.sd, true)
        }
        "design_scrap" => game_design_scrap(g, arg(op, 0), arg(op, 1), arg(op, 2) != 0)
        "design_fit" => design_fit(op)
        "diplo_adjust" => game_turn_diplo_adjust(g)
        "set_trans" => {
            ;; transports of the k-th planet of a player (arg 1) to: the
            ;; planet itself (mode 0), the nearest planet of another or no
            ;; owner (1), the nearest planet of another player (2)
            val pi = arg(op, 0)
            var k = arg(op, 1)
            val mode = arg(op, 2)
            loop i in g.galaxy_stars {
                val p = g.planet@(i)
                if p.owner == pi {
                    if k == 0 {
                        var best = i
                        var bestd = 0x7fffffff
                        if mode != 0 {
                            loop j in g.galaxy_stars {
                                val q = g.planet@(j)
                                val d = ((q.x - p.x) * (q.x - p.x)) + ((q.y - p.y) * (q.y - p.y))
                                if (q.owner != pi) && ((mode == 1) || (q.owner != PLAYER_NONE)) && (d < bestd) {
                                    set best = j
                                    set bestd = d
                                }
                            }
                        }
                        set p.trans_dest = best
                        set p.trans_num = arg(op, 3)
                        break
                    }
                    set k = k - 1
                }
            }
        }
        "contact_broken" => {
            pin bv = BOOLVEC_DECLARE(PLAYER_NUM)
            set bv@(0) = arg(op, 1)
            game_turn_contact_broken(g, arg(op, 0), bv)
        }
        "update_seen" => game_turn_update_seen(g)
        "finished_slider" => game_turn_finished_slider(g)
        "claim" => game_turn_claim(g)
        "final_war" => game_turn_update_final_war(g)
        "set_end" => { set g.end = arg(op, 0) }
        "set_refuse" => { set g.refuse@(0) = arg(op, 0) }
        "set_spy" => {
            val e = g.eto@(arg(op, 0))
            val t = arg(op, 1)
            set e.spying@(t) = arg(op, 2)
            set e.spymode@(t) = arg(op, 3)
            set e.spies@(t) = arg(op, 4)
        }
        "spy_build" => game_spy_build(g)
        "spy_report" => game_spy_report(g)
        "spy_turn" => game_spy_turn(g, spy_st)
        "spy_esp_human" => game_spy_esp_human(g, spy_st)
        "spy_sab_human" => game_spy_sab_human(g)
        "bomb" => game_turn_bomb(g)
        "ground" => {
            val buf = game_turn_ground_resolve_all(g)
            out("ground_show %d\n", game_turn_ground_show_all(g, buf))
        }
        "election" => game_election(g)
        "news" => {
            ;; the message of a news item: type subtype num1 num2 race planet
            pin ns = news_s()
            pin buf = carray(0x200)
            set ns.type = arg(op, 0)
            set ns.subtype = arg(op, 1)
            set ns.num1 = arg(op, 2)
            set ns.num2 = arg(op, 3)
            set ns.race = arg(op, 4)
            set ns.planet_i = arg(op, 5)
            game_news_get_msg(g, ns, buf, #buf)
            out("news '%s' %d", cstr(buf), ns.statsnum)
            loop i in ns.statsnum {
                out(" %s", ns.stats@(i))
            }
            out("\n")
        }
        "set_winner" => { set g.winner = arg(op, 0) }
        "check_end" => {
            pin ge = game_end_s()
            val r = game_turn_check_end(g, ge)
            out("check_end %d %d %d %d '%s'\n", cint(r), ge.type, ge.race, ge.banner_dead, if ge.name == nil => "(null)" => cstr(ge.name))
        }
        "audience" => {
            set g.eto@(arg(op, 0)).diplo_type@(arg(op, 1)) = arg(op, 2)
            game_audience(g, arg(op, 0), arg(op, 1))
        }
        "set_diplo_type" => { set g.eto@(arg(op, 0)).diplo_type@(arg(op, 1)) = arg(op, 2) }
        "audiences" => game_turn_audiences(g)
        "set_event_roll" => { set game_num_event_roll = arg(op, 0) }
        "set_year" => { set g.year = arg(op, 0) }
        "event_new" => game_event_new(g)
        "event_run" => {
            pin ge = game_end_s()
            val r = game_event_run(g, ge)
            out("event_run %d %d %d %d\n", cint(r), ge.type, ge.race, ge.banner_dead)
        }
        "move_ships" => game_turn_move_ships(g)
        "explore" => game_turn_explore(g)
        "transport" => game_turn_transport(g)
        "coup" => game_turn_coup(g)
        "have_met" => game_turn_update_have_met(g)
        "transport_shoot" => out("killed %d\n", game_turn_transport_shoot(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3), arg(op, 4), arg(op, 5), arg(op, 6)))
        "diplo_act" => game_diplo_act(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3), arg(op, 4), arg(op, 5))
        "break_treaty" => game_diplo_break_treaty(g, arg(op, 0), arg(op, 1))
        "start_war" => game_diplo_start_war(g, arg(op, 0), arg(op, 1))
        "start_war_swap" => game_diplo_start_war_swap(g, arg(op, 0), arg(op, 1))
        "break_trade" => game_diplo_break_trade(g, arg(op, 0), arg(op, 1))
        "annoy" => game_diplo_annoy(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "battle_finish" => game_diplo_battle_finish(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3), arg(op, 4), arg(op, 5), arg(op, 6))
        "set_treaty" => game_diplo_set_treaty(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "set_trade" => game_diplo_set_trade(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "stop_war" => game_diplo_stop_war(g, arg(op, 0), arg(op, 1))
        "esp_frame" => game_diplo_esp_frame(g, arg(op, 0), arg(op, 1))
        "limit_mood_treaty" => game_diplo_limit_mood_treaty(g)
        "mood_relax" => game_diplo_mood_relax(g)
        "moods" => {
            ;; the mood and is_gone of each pair
            out("moods")
            loop i in g.players {
                loop j in g.players {
                    out(" %d,%d", game_diplo_get_mood(g, i, j), cint(game_diplo_is_gone(g, i, j)))
                }
            }
            out("\n")
        }
        else => {
            print("unknown op " ++ op)
            os.exit(1)
        }
    }
}

var k
if args@2 == "new" {
    pin opt = game_new_options_s()
    val o = tonumber(args@3)
    val races = tonumber(args@4)
    val banners = tonumber(args@5)
    val humans = tonumber(args@7)
    set opt.players = o // 100
    set opt.galaxy_size = (o // 10) % 10
    set opt.difficulty = o % 10
    set opt.galaxy_seed = tonumber(args@6)
    set opt.improved_galaxy_generator = tonumber(args@8) != 0
    set opt.nebulae = tonumber(args@9) != 0
    var m = 1
    loop i in PLAYER_NUM {
        val r = (races >> (4 * i)) & 0xf
        val b = (banners // m) % 10
        set opt.pdata@(i).race = if r != 0 => (r - 1) => RACE_RANDOM
        set opt.pdata@(i).banner = if b != 0 => (b - 1) => BANNER_RANDOM
        set opt.pdata@(i).is_ai = ((humans // m) % 10) == 0
        set m = m * 10
    }
    game_new(g, gaux, opt)
    set k = 10
} else {
    if game_save_do_load_fname(args@3, nil, g) != 0 {
        os.exit(1)
    }
    set k = 4
}
loop {
    while k < #args
    do_op(args@(k))
    set k = k + 1
}
io.write(vector.join(outs, ""))
pin f = io.open(args@1, "w")
io.write(f, gamedump(g))
io.close(f)
