;; A state of the game, operations in order, and the whole state as text,
;; as tst/c/state.c does it (see that file for the usage). Some ops also
;; print, as the C does.

include "../src/game/game_aux.atm"
include "../src/game/game_misc.atm"
include "../src/game/game_new.atm"
include "../src/game/game_save.atm"
include "../src/game/game_design.atm"
include "../src/game/game_diplo.atm"
include "../src/game/game_fleet.atm"
include "../src/game/game_stat.atm"
include "../src/game/game_turn.atm"
include "gamedump.atm"

val args = [...]
os_set_path_data(args@0)
lbxfile_init()
pin gaux = game_aux_s()
pin g = game_s()
game_aux_init(gaux, g)

;; The `k`th argument after ':' of an operation, as `atoi`.
func arg (op, k) {
    val ps = string.split(op, ":")
    tonumber(ps@(k + 1) || "0") || 0
}

pin outs = []
func out (fmt, ...) {
    set outs@+ = string.format(fmt, ...)
}

;; Every table of the design screen, for a design of a player.
func design_fit (op) {
    pin gd = game_design_s()
    pin d = design_data_s()
    pin buf = carray(WEAPON_NUM)
    val pi = arg(op, 0)
    game_design_prepare(g, gd, pi, g.srd@(pi).design@(arg(op, 1)))
    out("prepare %d %d:", gd.lookbase, gd.sd_num)
    loop i in SHIP_HULL_NUM {
        out(" %d %s", gd.tbl_shiplook_hull@(i), cstr(gd.names@(i)))
    }
    out("\n")
    set d.g = g
    set d.gd = gd
    set d.api = pi
    game_design_init_maxtech_haveflags(d)
    out("flags %d %d %d %d %d %d %d %d %d:", d.last_avail_tech_weap, d.last_avail_tech_special, cint(d.flag_disable_cspeed), cint(d.flag_disable_comp), cint(d.flag_disable_jammer), cint(d.flag_disable_shield), cint(d.flag_disable_armor), cint(d.flag_disable_engine), gd.sd.hp)
    loop i in WEAPON_SLOT_NUM {
        out(" %d,%d,%d", cint(d.flag_tbl_weapon@(i)), d.flag_tbl_weap_up@(i), d.flag_tbl_weap_dn@(i))
    }
    loop i in SPECIAL_SLOT_NUM {
        out(" %d", cint(d.flag_tbl_special@(i)))
    }
    loop i in SHIP_HULL_NUM {
        out(" %d", cint(d.flag_tbl_hull@(i)))
    }
    out("\n")
    func fit (name, last) {
        out("%s %d:", name, last)
        loop i in (0, last) {
            out(" %d", buf@(i))
        }
        out("\n")
    }
    fit("comp", game_design_build_tbl_fit_comp(g, gd, buf))
    fit("shield", game_design_build_tbl_fit_shield(g, gd, buf))
    fit("jammer", game_design_build_tbl_fit_jammer(g, gd, buf))
    fit("armor", game_design_build_tbl_fit_armor(g, gd, buf))
    fit("engine", game_design_build_tbl_fit_engine(g, gd, buf))
    fit("man", game_design_build_tbl_fit_man(g, gd, buf))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 0, WEAPON_GROUP_ALL))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 1, WEAPON_GROUP_BEAMS))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 2, WEAPON_GROUP_MISSILES))
    fit("weapon", game_design_build_tbl_fit_weapon(g, gd, buf, 3, WEAPON_GROUP_BOMBS))
    fit("special", game_design_build_tbl_fit_special(g, gd, buf, 0))
    fit("special", game_design_build_tbl_fit_special(g, gd, buf, 2))
    loop i in 13 {
        out(" %d/%d", game_design_calc_cost_item(gd, i, 1), game_design_calc_space_item(gd, i, 1))
    }
    out("\n")
    game_design_look_next(gd)
    out("look %d", gd.sd.look)
    game_design_look_prev(gd)
    game_design_look_prev(gd)
    out(" %d", gd.sd.look)
    game_design_look_fix(g, pi, gd.sd)
    out(" %d", gd.sd.look)
    game_design_compact_slots(gd.sd)
    game_design_clear(gd)
    out(" %s %d %d\n", cstr(gd.sd.name), gd.sd.space, gd.sd.cost)
}

;; The interface (ui.atm) that the logic calls, as tst/c/state.c has it.
set ui_explore = func (g_, pi, planet_i, by_scanner, flag_colony_ship) {
    out("explore %d %d %d %d\n", pi, planet_i, cint(by_scanner), cint(flag_colony_ship))
    (planet_i & 1) != 0
}
set ui_landing = func (g_, pi, planet_i) {
    out("landing %d %d\n", pi, planet_i)
}
set ui_turn_msg = func (g_, pi, str) {
    out("msg %d %s\n", pi, cstr(str))
}

set ui_gmap_basic_init = func (g_, show_player_switch) { nil }
set ui_gmap_basic_start_player = func (ctx, pi) { nil }
set ui_gmap_basic_start_frame = func (ctx, pi) { nil }
set ui_gmap_basic_draw_frame = func (ctx, pi) { nil }
set ui_gmap_basic_finish_frame = func (ctx, pi) { nil }
set ui_gmap_basic_shutdown = func (ctx) { nil }

func do_op (op) {
    val name = string.split(op, ":")@0
    match name {
        "start" => game_aux_start(gaux, g)
        "have_reserve_fuel" => game_update_have_reserve_fuel(g)
        "maint_costs" => game_update_maint_costs(g)
        "production" => game_update_production(g)
        "total_research" => game_update_total_research(g)
        "eco_on_waste" => game_update_eco_on_waste(g, arg(op, 0), arg(op, 1) != 0)
        "seen_by_orbit" => game_update_seen_by_orbit(g, arg(op, 0))
        "within_range" => game_update_within_range(g)
        "reloc_dest" => game_update_reloc_dest(g)
        "empire_contact" => game_update_empire_contact(g)
        "visibility" => game_update_visibility(g)
        "rng_step" => game_rng_step(g)
        "planet_destroy" => game_planet_destroy(g, arg(op, 0), arg(op, 1))
        "adjust_percent2" => game_planet_adjust_percent2(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3) != 0)
        "adjust_percent" => game_planet_adjust_percent(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3))
        "update_home" => game_planet_update_home(g)
        "tech_util" => game_update_tech_util(g)
        "finish_new" => game_tech_finish_new(g, arg(op, 0))
        "start_next" => game_tech_start_next(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "set_to_max_bonus" => game_tech_set_to_max_bonus(g, arg(op, 0), arg(op, 1))
        "orion_loot" => game_tech_get_orion_loot(g, arg(op, 0))
        "artifact_loot" => game_tech_get_artifact_loot(g, arg(op, 0), arg(op, 1))
        "atmos_tform" => game_turn_atmos_tform(g.planet@(arg(op, 0)))
        "soil_enrich" => game_turn_soil_enrich(g.planet@(arg(op, 0)), arg(op, 1), arg(op, 2) != 0)
        "equalize_tech" => game_equalize_slider_group(g.eto@(arg(op, 0)).tech.slider, TECH_FIELD_NUM, g.eto@(arg(op, 0)).tech.slider_lock)
        "adjust_tech" => game_adjust_slider_group(g.eto@(arg(op, 0)).tech.slider, arg(op, 1), arg(op, 2), TECH_FIELD_NUM, g.eto@(arg(op, 0)).tech.slider_lock)
        "limit_ships" => game_turn_limit_ships(g)
        "countdown_ceasefire" => game_turn_countdown_ceasefire(g)
        "mood_blunder" => game_turn_update_mood_blunder(g)
        "init_z_finished" => game_turn_init_z_finished(g)
        "send_transport" => game_turn_send_transport(g)
        "build_eco" => game_turn_build_eco(g)
        "update_trade" => game_turn_update_trade(g)
        "build_def" => game_turn_build_def(g)
        "build_ship" => game_turn_build_ship(g)
        "reserve" => game_turn_reserve(g)
        "build_ind" => game_turn_build_ind(g)
        "disable_slider" => game_turn_finished_disable_slider(g, g.planet@(arg(op, 0)), arg(op, 1), arg(op, 2) != 0)
        "remove_empty_fleets" => game_remove_empty_fleets(g)
        "remove_player_fleets" => game_remove_player_fleets(g, arg(op, 0))
        "fleet_unrefuel" => game_fleet_unrefuel(g)
        "any_dest" => out("any_dest %d\n", cint(game_fleet_any_dest_player(g, arg(op, 0), arg(op, 1))))
        "send_half" => {
            ;; half of the ships of each design of a player at a planet
            val pi = arg(op, 0)
            val from = arg(op, 1)
            val n = g.eto@(pi).shipdesigns_num
            pin ships = carray(NUM_SHIPDESIGNS)
            pin types = carray(NUM_SHIPDESIGNS)
            loop i in n {
                set types@(i) = n - 1 - i
                set ships@(i) = g.eto@(pi).orbit@(from).ships@(n - 1 - i) // 2
            }
            val r = if arg(op, 3) != 0 => game_send_fleet_retreat(g, pi, from, arg(op, 2), ships, types, n) => game_send_fleet_from_orbit(g, pi, from, arg(op, 2), ships, types, n)
            out("send %d\n", cint(r))
        }
        "redirect" => {
            if arg(op, 0) < g.enroute_num {
                game_fleet_redirect(g, g.enroute@(arg(op, 0)), arg(op, 1), arg(op, 2))
            }
        }
        "fleet_speed" => {
            if arg(op, 0) < g.enroute_num {
                out("speed %d\n", game_fleet_get_speed(g, g.enroute@(arg(op, 0)), arg(op, 1), arg(op, 2)))
            }
        }
        "stats" => {
            pin d = game_stats_s()
            game_stats_all(g, arg(op, 0), d)
            out("stats %d:", d.num)
            loop i in d.num {
                out(" %d", d.p@(i))
                loop s in 6 {
                    out(",%d", d.v@(s)@(i))
                }
            }
            out("\n")
        }
        "design_ai" => {
            pin gd = game_design_s()
            ;; the look: arg 2 within those of the hull and banner of the player
            game_design_prepare_ai(g, gd, arg(op, 0), arg(op, 1), (g.eto@(arg(op, 0)).banner * SHIP_LOOK_PER_BANNER) + (arg(op, 1) * SHIP_LOOK_PER_HULL) + arg(op, 2))
            out("design_ai %s %d %d %d\n", cstr(gd.sd.name), gd.sd.space, gd.sd.cost, gd.sd.engines)
            game_design_add(g, arg(op, 0), gd.sd, true)
        }
        "design_scrap" => game_design_scrap(g, arg(op, 0), arg(op, 1), arg(op, 2) != 0)
        "design_fit" => design_fit(op)
        "diplo_adjust" => game_turn_diplo_adjust(g)
        "set_trans" => {
            ;; transports of the k-th planet of a player (arg 1) to: the
            ;; planet itself (mode 0), the nearest planet of another or no
            ;; owner (1), the nearest planet of another player (2)
            val pi = arg(op, 0)
            var k = arg(op, 1)
            val mode = arg(op, 2)
            loop i in g.galaxy_stars {
                val p = g.planet@(i)
                if p.owner == pi {
                    if k == 0 {
                        var best = i
                        var bestd = 0x7fffffff
                        if mode != 0 {
                            loop j in g.galaxy_stars {
                                val q = g.planet@(j)
                                val d = ((q.x - p.x) * (q.x - p.x)) + ((q.y - p.y) * (q.y - p.y))
                                if (q.owner != pi) && ((mode == 1) || (q.owner != PLAYER_NONE)) && (d < bestd) {
                                    set best = j
                                    set bestd = d
                                }
                            }
                        }
                        set p.trans_dest = best
                        set p.trans_num = arg(op, 3)
                        break
                    }
                    set k = k - 1
                }
            }
        }
        "move_ships" => game_turn_move_ships(g)
        "explore" => game_turn_explore(g)
        "transport" => game_turn_transport(g)
        "coup" => game_turn_coup(g)
        "have_met" => game_turn_update_have_met(g)
        "transport_shoot" => out("killed %d\n", game_turn_transport_shoot(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3), arg(op, 4), arg(op, 5), arg(op, 6)))
        "diplo_act" => game_diplo_act(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3), arg(op, 4), arg(op, 5))
        "break_treaty" => game_diplo_break_treaty(g, arg(op, 0), arg(op, 1))
        "start_war" => game_diplo_start_war(g, arg(op, 0), arg(op, 1))
        "start_war_swap" => game_diplo_start_war_swap(g, arg(op, 0), arg(op, 1))
        "break_trade" => game_diplo_break_trade(g, arg(op, 0), arg(op, 1))
        "annoy" => game_diplo_annoy(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "battle_finish" => game_diplo_battle_finish(g, arg(op, 0), arg(op, 1), arg(op, 2), arg(op, 3), arg(op, 4), arg(op, 5), arg(op, 6))
        "set_treaty" => game_diplo_set_treaty(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "set_trade" => game_diplo_set_trade(g, arg(op, 0), arg(op, 1), arg(op, 2))
        "stop_war" => game_diplo_stop_war(g, arg(op, 0), arg(op, 1))
        "esp_frame" => game_diplo_esp_frame(g, arg(op, 0), arg(op, 1))
        "limit_mood_treaty" => game_diplo_limit_mood_treaty(g)
        "mood_relax" => game_diplo_mood_relax(g)
        "moods" => {
            ;; the mood and is_gone of each pair
            out("moods")
            loop i in g.players {
                loop j in g.players {
                    out(" %d,%d", game_diplo_get_mood(g, i, j), cint(game_diplo_is_gone(g, i, j)))
                }
            }
            out("\n")
        }
        else => {
            print("unknown op " ++ op)
            os.exit(1)
        }
    }
}

var k
if args@2 == "new" {
    pin opt = game_new_options_s()
    val o = tonumber(args@3)
    val races = tonumber(args@4)
    val banners = tonumber(args@5)
    val humans = tonumber(args@7)
    set opt.players = o // 100
    set opt.galaxy_size = (o // 10) % 10
    set opt.difficulty = o % 10
    set opt.galaxy_seed = tonumber(args@6)
    set opt.improved_galaxy_generator = tonumber(args@8) != 0
    set opt.nebulae = tonumber(args@9) != 0
    var m = 1
    loop i in PLAYER_NUM {
        val r = (races >> (4 * i)) & 0xf
        val b = (banners // m) % 10
        set opt.pdata@(i).race = if r != 0 => (r - 1) => RACE_RANDOM
        set opt.pdata@(i).banner = if b != 0 => (b - 1) => BANNER_RANDOM
        set opt.pdata@(i).is_ai = ((humans // m) % 10) == 0
        set m = m * 10
    }
    game_new(g, gaux, opt)
    set k = 10
} else {
    if game_save_do_load_fname(args@3, nil, g) != 0 {
        os.exit(1)
    }
    set k = 4
}
loop {
    while k < #args
    do_op(args@(k))
    set k = k + 1
}
io.write(vector.join(outs, ""))
pin f = io.open(args@1, "w")
io.write(f, gamedump(g))
io.close(f)
