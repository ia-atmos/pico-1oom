loop i0 in #game_num_ng_tech { loop i1 in #game_num_ng_tech@(i0) { loop i2 in #game_num_ng_tech@(i0)@(i1) { set out@+ = string.format("game_num_ng_tech[%i][%i][%i] = %i\n", i0, i1, i2, game_num_ng_tech@(i0)@(i1)@(i2)) } } }
loop i0 in #game_num_tbl_trait1 { loop i1 in #game_num_tbl_trait1@(i0) { set out@+ = string.format("game_num_tbl_trait1[%i][%i] = %i\n", i0, i1, game_num_tbl_trait1@(i0)@(i1)) } }
loop i0 in #game_num_tbl_trait2 { loop i1 in #game_num_tbl_trait2@(i0) { set out@+ = string.format("game_num_tbl_trait2[%i][%i] = %i\n", i0, i1, game_num_tbl_trait2@(i0)@(i1)) } }
loop i0 in #game_num_tbl_tech_autoadj { set out@+ = string.format("game_num_tbl_tech_autoadj[%i] = %i\n", i0, game_num_tbl_tech_autoadj@(i0)) }
io.write(string.join(out, ""))
