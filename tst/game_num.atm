loop i0 in #game_num_tbl_hull_w { set out@+ = string.format("game_num_tbl_hull_w[%i] = %i\n", i0, game_num_tbl_hull_w@(i0)) }
loop i0 in #game_num_base_hp { set out@+ = string.format("game_num_base_hp[%i] = %i\n", i0, game_num_base_hp@(i0)) }
loop i0 in #game_num_pshield_cost { set out@+ = string.format("game_num_pshield_cost[%i] = %i\n", i0, game_num_pshield_cost@(i0)) }
