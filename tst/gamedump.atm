;; The whole state of the game as text (generated by tools/gamedump.py).
;; The same lines as gamedump() of tst/c/gamedump.h.

func dbool (v) {
    if v == true => 1 => (if v == false => 0 => v)
}

func gamedump (g) {
    val out = []
    set out@+ = string.format("g.enroute_num = %d\n", g.enroute_num)
    set out@+ = string.format("g.transport_num = %d\n", g.transport_num)
    set out@+ = string.format("g.year = %d\n", g.year)
    set out@+ = string.format("g.players = %d\n", g.players)
    set out@+ = string.format("g.ai_id = %d\n", g.ai_id)
    loop i1 in 1 {
        set out@+ = string.format("g.is_ai[%i] = %d\n", i1, g.is_ai@(i1))
    }
    set out@+ = string.format("g.active_player = %d\n", g.active_player)
    set out@+ = string.format("g.difficulty = %d\n", g.difficulty)
    set out@+ = string.format("g.galaxy_size = %d\n", g.galaxy_size)
    set out@+ = string.format("g.galaxy_w = %d\n", g.galaxy_w)
    set out@+ = string.format("g.galaxy_h = %d\n", g.galaxy_h)
    set out@+ = string.format("g.galaxy_stars = %d\n", g.galaxy_stars)
    set out@+ = string.format("g.galaxy_maxx = %d\n", g.galaxy_maxx)
    set out@+ = string.format("g.galaxy_maxy = %d\n", g.galaxy_maxy)
    set out@+ = string.format("g.seed = %d\n", g.seed)
    set out@+ = string.format("g.galaxy_seed = %d\n", g.galaxy_seed)
    set out@+ = string.format("g.end = %d\n", g.end)
    set out@+ = string.format("g.winner = %d\n", g.winner)
    set out@+ = string.format("g.guardian_killer = %d\n", g.guardian_killer)
    set out@+ = string.format("g.election_held = %d\n", dbool(g.election_held))
    loop i2 in 1 {
        set out@+ = string.format("g.refuse[%i] = %d\n", i2, g.refuse@(i2))
    }
    loop i3 in 6 {
        set out@+ = string.format("g.planet_focus_i[%i] = %d\n", i3, g.planet_focus_i@(i3))
    }
    set out@+ = string.format("g.nebula_num = %d\n", g.nebula_num)
    loop i4 in 4 {
        set out@+ = string.format("g.nebula_type[%i] = %d\n", i4, g.nebula_type@(i4))
    }
    loop i5 in 4 {
        set out@+ = string.format("g.nebula_x[%i] = %d\n", i5, g.nebula_x@(i5))
    }
    loop i6 in 4 {
        set out@+ = string.format("g.nebula_y[%i] = %d\n", i6, g.nebula_y@(i6))
    }
    loop i7 in 4 {
        loop i8 in 4 {
            set out@+ = string.format("g.nebula_x0[%i][%i] = %d\n", i7, i8, g.nebula_x0@(i7)@(i8))
        }
    }
    loop i9 in 4 {
        loop i10 in 4 {
            set out@+ = string.format("g.nebula_x1[%i][%i] = %d\n", i9, i10, g.nebula_x1@(i9)@(i10))
        }
    }
    loop i11 in 4 {
        loop i12 in 4 {
            set out@+ = string.format("g.nebula_y0[%i][%i] = %d\n", i11, i12, g.nebula_y0@(i11)@(i12))
        }
    }
    loop i13 in 4 {
        loop i14 in 4 {
            set out@+ = string.format("g.nebula_y1[%i][%i] = %d\n", i13, i14, g.nebula_y1@(i13)@(i14))
        }
    }
    loop i15 in 108 {
        loop i16 in 12 {
            set out@+ = string.format("g.planet[%i].name[%i] = %d\n", i15, i16, g.planet@(i15).name@(i16))
        }
        set out@+ = string.format("g.planet[%i].x = %d\n", i15, g.planet@(i15).x)
        set out@+ = string.format("g.planet[%i].y = %d\n", i15, g.planet@(i15).y)
        set out@+ = string.format("g.planet[%i].star_type = %d\n", i15, g.planet@(i15).star_type)
        set out@+ = string.format("g.planet[%i].look = %d\n", i15, g.planet@(i15).look)
        set out@+ = string.format("g.planet[%i].frame = %d\n", i15, g.planet@(i15).frame)
        set out@+ = string.format("g.planet[%i].rocks = %d\n", i15, g.planet@(i15).rocks)
        set out@+ = string.format("g.planet[%i].max_pop1 = %d\n", i15, g.planet@(i15).max_pop1)
        set out@+ = string.format("g.planet[%i].max_pop2 = %d\n", i15, g.planet@(i15).max_pop2)
        set out@+ = string.format("g.planet[%i].max_pop3 = %d\n", i15, g.planet@(i15).max_pop3)
        set out@+ = string.format("g.planet[%i].type = %d\n", i15, g.planet@(i15).type)
        set out@+ = string.format("g.planet[%i].battlebg = %d\n", i15, g.planet@(i15).battlebg)
        set out@+ = string.format("g.planet[%i].infogfx = %d\n", i15, g.planet@(i15).infogfx)
        set out@+ = string.format("g.planet[%i].growth = %d\n", i15, g.planet@(i15).growth)
        set out@+ = string.format("g.planet[%i].special = %d\n", i15, g.planet@(i15).special)
        set out@+ = string.format("g.planet[%i].bc_to_ecoproj = %d\n", i15, g.planet@(i15).bc_to_ecoproj)
        set out@+ = string.format("g.planet[%i].bc_to_ship = %d\n", i15, g.planet@(i15).bc_to_ship)
        set out@+ = string.format("g.planet[%i].bc_to_factory = %d\n", i15, g.planet@(i15).bc_to_factory)
        set out@+ = string.format("g.planet[%i].reserve = %d\n", i15, g.planet@(i15).reserve)
        set out@+ = string.format("g.planet[%i].waste = %d\n", i15, g.planet@(i15).waste)
        set out@+ = string.format("g.planet[%i].owner = %d\n", i15, g.planet@(i15).owner)
        set out@+ = string.format("g.planet[%i].prev_owner = %d\n", i15, g.planet@(i15).prev_owner)
        set out@+ = string.format("g.planet[%i].claim = %d\n", i15, g.planet@(i15).claim)
        set out@+ = string.format("g.planet[%i].pop = %d\n", i15, g.planet@(i15).pop)
        set out@+ = string.format("g.planet[%i].pop_prev = %d\n", i15, g.planet@(i15).pop_prev)
        set out@+ = string.format("g.planet[%i].factories = %d\n", i15, g.planet@(i15).factories)
        set out@+ = string.format("g.planet[%i].prod_after_maint = %d\n", i15, g.planet@(i15).prod_after_maint)
        set out@+ = string.format("g.planet[%i].total_prod = %d\n", i15, g.planet@(i15).total_prod)
        loop i17 in 5 {
            set out@+ = string.format("g.planet[%i].slider[%i] = %d\n", i15, i17, g.planet@(i15).slider@(i17))
        }
        loop i18 in 5 {
            set out@+ = string.format("g.planet[%i].slider_lock[%i] = %d\n", i15, i18, g.planet@(i15).slider_lock@(i18))
        }
        set out@+ = string.format("g.planet[%i].buildship = %d\n", i15, g.planet@(i15).buildship)
        set out@+ = string.format("g.planet[%i].reloc = %d\n", i15, g.planet@(i15).reloc)
        set out@+ = string.format("g.planet[%i].missile_bases = %d\n", i15, g.planet@(i15).missile_bases)
        set out@+ = string.format("g.planet[%i].bc_to_base = %d\n", i15, g.planet@(i15).bc_to_base)
        set out@+ = string.format("g.planet[%i].bc_upgrade_base = %d\n", i15, g.planet@(i15).bc_upgrade_base)
        set out@+ = string.format("g.planet[%i].have_stargate = %d\n", i15, dbool(g.planet@(i15).have_stargate))
        set out@+ = string.format("g.planet[%i].shield = %d\n", i15, g.planet@(i15).shield)
        set out@+ = string.format("g.planet[%i].bc_to_shield = %d\n", i15, g.planet@(i15).bc_to_shield)
        set out@+ = string.format("g.planet[%i].trans_num = %d\n", i15, g.planet@(i15).trans_num)
        set out@+ = string.format("g.planet[%i].trans_dest = %d\n", i15, g.planet@(i15).trans_dest)
        set out@+ = string.format("g.planet[%i].pop_tenths = %d\n", i15, g.planet@(i15).pop_tenths)
        loop i19 in 1 {
            set out@+ = string.format("g.planet[%i].explored[%i] = %d\n", i15, i19, g.planet@(i15).explored@(i19))
        }
        loop i20 in 1 {
            set out@+ = string.format("g.planet[%i].within_srange[%i] = %d\n", i15, i20, g.planet@(i15).within_srange@(i20))
        }
        loop i21 in 6 {
            set out@+ = string.format("g.planet[%i].within_frange[%i] = %d\n", i15, i21, g.planet@(i15).within_frange@(i21))
        }
        set out@+ = string.format("g.planet[%i].pop_oper_fact = %d\n", i15, g.planet@(i15).pop_oper_fact)
        set out@+ = string.format("g.planet[%i].bc_to_refit = %d\n", i15, g.planet@(i15).bc_to_refit)
        set out@+ = string.format("g.planet[%i].rebels = %d\n", i15, g.planet@(i15).rebels)
        set out@+ = string.format("g.planet[%i].unrest = %d\n", i15, g.planet@(i15).unrest)
        set out@+ = string.format("g.planet[%i].unrest_reported = %d\n", i15, dbool(g.planet@(i15).unrest_reported))
        loop i22 in 1 {
            set out@+ = string.format("g.planet[%i].unrefuel[%i] = %d\n", i15, i22, g.planet@(i15).unrefuel@(i22))
        }
        loop i23 in 1 {
            set out@+ = string.format("g.planet[%i].finished[%i] = %d\n", i15, i23, g.planet@(i15).finished@(i23))
        }
        loop i24 in 6 {
            set out@+ = string.format("g.planet[%i].inbound[%i] = %d\n", i15, i24, g.planet@(i15).inbound@(i24))
        }
        loop i25 in 6 {
            set out@+ = string.format("g.planet[%i].total_inbound[%i] = %d\n", i15, i25, g.planet@(i15).total_inbound@(i25))
        }
        set out@+ = string.format("g.planet[%i].artifact_looter = %d\n", i15, g.planet@(i15).artifact_looter)
    }
    loop i26 in 260 {
        set out@+ = string.format("g.enroute[%i].owner = %d\n", i26, g.enroute@(i26).owner)
        set out@+ = string.format("g.enroute[%i].x = %d\n", i26, g.enroute@(i26).x)
        set out@+ = string.format("g.enroute[%i].y = %d\n", i26, g.enroute@(i26).y)
        set out@+ = string.format("g.enroute[%i].dest = %d\n", i26, g.enroute@(i26).dest)
        set out@+ = string.format("g.enroute[%i].speed = %d\n", i26, g.enroute@(i26).speed)
        set out@+ = string.format("g.enroute[%i].retreat = %d\n", i26, dbool(g.enroute@(i26).retreat))
        loop i27 in 1 {
            set out@+ = string.format("g.enroute[%i].visible[%i] = %d\n", i26, i27, g.enroute@(i26).visible@(i27))
        }
        loop i28 in 6 {
            set out@+ = string.format("g.enroute[%i].ships[%i] = %d\n", i26, i28, g.enroute@(i26).ships@(i28))
        }
    }
    loop i29 in 100 {
        set out@+ = string.format("g.transport[%i].owner = %d\n", i29, g.transport@(i29).owner)
        set out@+ = string.format("g.transport[%i].x = %d\n", i29, g.transport@(i29).x)
        set out@+ = string.format("g.transport[%i].y = %d\n", i29, g.transport@(i29).y)
        set out@+ = string.format("g.transport[%i].dest = %d\n", i29, g.transport@(i29).dest)
        set out@+ = string.format("g.transport[%i].speed = %d\n", i29, g.transport@(i29).speed)
        loop i30 in 1 {
            set out@+ = string.format("g.transport[%i].visible[%i] = %d\n", i29, i30, g.transport@(i29).visible@(i30))
        }
        set out@+ = string.format("g.transport[%i].pop = %d\n", i29, g.transport@(i29).pop)
    }
    loop i31 in 6 {
        set out@+ = string.format("g.eto[%i].race = %d\n", i31, g.eto@(i31).race)
        set out@+ = string.format("g.eto[%i].banner = %d\n", i31, g.eto@(i31).banner)
        set out@+ = string.format("g.eto[%i].trait1 = %d\n", i31, g.eto@(i31).trait1)
        set out@+ = string.format("g.eto[%i].trait2 = %d\n", i31, g.eto@(i31).trait2)
        set out@+ = string.format("g.eto[%i].ai_p3_countdown = %d\n", i31, g.eto@(i31).ai_p3_countdown)
        set out@+ = string.format("g.eto[%i].ai_p2_countdown = %d\n", i31, g.eto@(i31).ai_p2_countdown)
        loop i32 in 1 {
            set out@+ = string.format("g.eto[%i].contact[%i] = %d\n", i31, i32, g.eto@(i31).contact@(i32))
        }
        loop i33 in 1 {
            set out@+ = string.format("g.eto[%i].contact_broken[%i] = %d\n", i31, i33, g.eto@(i31).contact_broken@(i33))
        }
        loop i34 in 6 {
            set out@+ = string.format("g.eto[%i].relation1[%i] = %d\n", i31, i34, g.eto@(i31).relation1@(i34))
        }
        loop i35 in 6 {
            set out@+ = string.format("g.eto[%i].relation2[%i] = %d\n", i31, i35, g.eto@(i31).relation2@(i35))
        }
        loop i36 in 6 {
            set out@+ = string.format("g.eto[%i].diplo_type[%i] = %d\n", i31, i36, g.eto@(i31).diplo_type@(i36))
        }
        loop i37 in 6 {
            set out@+ = string.format("g.eto[%i].diplo_val[%i] = %d\n", i31, i37, g.eto@(i31).diplo_val@(i37))
        }
        loop i38 in 6 {
            set out@+ = string.format("g.eto[%i].diplo_p1[%i] = %d\n", i31, i38, g.eto@(i31).diplo_p1@(i38))
        }
        loop i39 in 6 {
            set out@+ = string.format("g.eto[%i].diplo_p2[%i] = %d\n", i31, i39, g.eto@(i31).diplo_p2@(i39))
        }
        loop i40 in 6 {
            set out@+ = string.format("g.eto[%i].trust[%i] = %d\n", i31, i40, g.eto@(i31).trust@(i40))
        }
        loop i41 in 6 {
            set out@+ = string.format("g.eto[%i].broken_treaty[%i] = %d\n", i31, i41, g.eto@(i31).broken_treaty@(i41))
        }
        loop i42 in 6 {
            set out@+ = string.format("g.eto[%i].blunder[%i] = %d\n", i31, i42, g.eto@(i31).blunder@(i42))
        }
        loop i43 in 6 {
            set out@+ = string.format("g.eto[%i].tribute_field[%i] = %d\n", i31, i43, g.eto@(i31).tribute_field@(i43))
        }
        loop i44 in 6 {
            set out@+ = string.format("g.eto[%i].tribute_tech[%i] = %d\n", i31, i44, g.eto@(i31).tribute_tech@(i44))
        }
        loop i45 in 6 {
            set out@+ = string.format("g.eto[%i].mood_treaty[%i] = %d\n", i31, i45, g.eto@(i31).mood_treaty@(i45))
        }
        loop i46 in 6 {
            set out@+ = string.format("g.eto[%i].mood_trade[%i] = %d\n", i31, i46, g.eto@(i31).mood_trade@(i46))
        }
        loop i47 in 6 {
            set out@+ = string.format("g.eto[%i].mood_tech[%i] = %d\n", i31, i47, g.eto@(i31).mood_tech@(i47))
        }
        loop i48 in 6 {
