        }
    }
    loop i146 in 6 {
        loop i147 in 108 {
            set out@+ = string.format("g.seen[%i][%i].owner = %d\n", i146, i147, g.seen@(i146)@(i147).owner)
            set out@+ = string.format("g.seen[%i][%i].pop = %d\n", i146, i147, g.seen@(i146)@(i147).pop)
            set out@+ = string.format("g.seen[%i][%i].bases = %d\n", i146, i147, g.seen@(i146)@(i147).bases)
            set out@+ = string.format("g.seen[%i][%i].factories = %d\n", i146, i147, g.seen@(i146)@(i147).factories)
        }
    }
    loop i148 in 6 {
        loop i149 in 12 {
            set out@+ = string.format("g.current_design[%i].name[%i] = %d\n", i148, i149, g.current_design@(i148).name@(i149))
