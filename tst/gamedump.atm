        }
        set out@+ = string.format("g.eto[%i].have_planet_shield = %d\n", i31, g.eto@(i31).have_planet_shield)
        set out@+ = string.format("g.eto[%i].planet_shield_cost = %d\n", i31, g.eto@(i31).planet_shield_cost)
