        }
        loop i53 in 6 {
            set out@+ = string.format("g.eto[%i].au_want_trade[%i] = %d\n", i31, i53, g.eto@(i31).au_want_trade@(i53))
        }
        loop i54 in 6 {
            set out@+ = string.format("g.eto[%i].au_want_field[%i] = %d\n", i31, i54, g.eto@(i31).au_want_field@(i54))
